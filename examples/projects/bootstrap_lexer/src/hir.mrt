module bootstrap_hir
import bootstrap_tokens;
import bootstrap_syntax;
import bootstrap_mir_functions;

pub struct HirExpressionRecord {
    kind: i32;
    start: i64;
    length: i64;
    left: i64;
    right: i64;
    symbol: i32;
    type_code: i32;
    numeric_policy: i32;
    binding_id: i64;
}

pub fn hir_kind(borrow node: HirExpressionRecord) -> i32 { return node.kind; }
pub fn hir_start(borrow node: HirExpressionRecord) -> i64 { return node.start; }
pub fn hir_length(borrow node: HirExpressionRecord) -> i64 { return node.length; }
pub fn hir_left(borrow node: HirExpressionRecord) -> i64 { return node.left; }
pub fn hir_right(borrow node: HirExpressionRecord) -> i64 { return node.right; }
pub fn hir_symbol(borrow node: HirExpressionRecord) -> i32 { return node.symbol; }
pub fn hir_type_code(borrow node: HirExpressionRecord) -> i32 { return node.type_code; }
pub fn hir_numeric_policy(borrow node: HirExpressionRecord) -> i32 { return node.numeric_policy; }
pub fn hir_binding_id(borrow node: HirExpressionRecord) -> i64 { return node.binding_id; }
pub fn hir_invalid_kind() -> i32 { return 0; }
pub fn hir_literal_kind() -> i32 { return 1; }
pub fn hir_arithmetic_kind() -> i32 { return 2; }
pub fn hir_group_alias_kind() -> i32 { return 3; }
pub fn hir_identifier_kind() -> i32 { return 4; }
pub fn hir_comparison_kind() -> i32 { return 5; }
pub fn hir_call_kind() -> i32 { return 6; }
pub fn hir_field_kind() -> i32 { return 7; }
pub fn hir_argument_sequence_kind() -> i32 { return 8; }
pub fn hir_symbol_reference_kind() -> i32 { return 9; }
pub fn hir_constructor_kind() -> i32 { return 10; }
pub fn hir_field_initializer_kind() -> i32 { return 11; }
pub fn hir_string_literal_kind() -> i32 { return 12; }
pub fn hir_type_unresolved() -> i32 { return 0; }
pub fn hir_type_i64() -> i32 { return 1; }
pub fn hir_type_bool() -> i32 { return 2; }
pub fn hir_numeric_policy_none() -> i32 { return 0; }
pub fn hir_numeric_policy_exact() -> i32 { return 1; }
pub fn hir_numeric_policy_checked() -> i32 { return 2; }
pub fn hir_symbol_none() -> i32 { return 0; }
pub fn hir_symbol_add() -> i32 { return 1; }
pub fn hir_symbol_subtract() -> i32 { return 2; }
pub fn hir_symbol_multiply() -> i32 { return 3; }
pub fn hir_symbol_divide() -> i32 { return 4; }
pub fn hir_symbol_equal() -> i32 { return 5; }
pub fn hir_symbol_not_equal() -> i32 { return 6; }
pub fn hir_symbol_greater_equal() -> i32 { return 7; }
pub fn hir_symbol_less_equal() -> i32 { return 8; }
pub fn hir_symbol_greater() -> i32 { return 9; }
pub fn hir_symbol_less() -> i32 { return 10; }
pub fn hir_is_numeric_literal(borrow node:HirExpressionRecord)->i32{if(node.kind==hir_literal_kind()){return 1;}return 0;}
pub fn hir_is_binary(borrow node:HirExpressionRecord)->i32{if(node.kind==hir_arithmetic_kind()){return 1;}return 0;}
pub fn hir_is_comparison(borrow node:HirExpressionRecord)->i32{if(node.kind==hir_comparison_kind()){return 1;}return 0;}
pub fn hir_is_group(borrow node:HirExpressionRecord)->i32{if(node.kind==hir_group_alias_kind()){return 1;}return 0;}
pub fn hir_is_identifier(borrow node:HirExpressionRecord)->i32{if(node.kind==hir_identifier_kind()){return 1;}return 0;}
pub fn hir_is_call(borrow node: HirExpressionRecord) -> i32 { if (node.kind == hir_call_kind()) { return 1; } return 0; }
pub fn hir_is_field_access(borrow node: HirExpressionRecord) -> i32 { if (node.kind == hir_field_kind()) { return 1; } return 0; }
pub fn hir_is_pair(borrow node: HirExpressionRecord) -> i32 { if (node.kind == hir_argument_sequence_kind()) { return 1; } return 0; }
pub fn hir_is_struct_constructor(borrow node: HirExpressionRecord) -> i32 { if (node.kind == hir_constructor_kind()) { return 1; } return 0; }
pub fn hir_is_field_initializer(borrow node: HirExpressionRecord) -> i32 { if (node.kind == hir_field_initializer_kind()) { return 1; } return 0; }
pub fn hir_is_symbol_reference(borrow node: HirExpressionRecord) -> i32 { if (node.kind == hir_symbol_reference_kind()) { return 1; } return 0; }
pub fn hir_symbol_reference_binding_id() -> i64 { return -2; }
pub fn hir_result_reference_binding_id() -> i64 { return -3; }
pub fn hir_is_string_literal(borrow node:HirExpressionRecord)->i32{
    if(node.kind==hir_string_literal_kind()){return 1;}
    return 0;
}
pub fn hir_with_type(borrow node:HirExpressionRecord,type_code:i32)->HirExpressionRecord{
    return HirExpressionRecord{
        kind:node.kind,start:node.start,length:node.length,left:node.left,right:node.right,
        symbol:node.symbol,type_code:type_code,numeric_policy:node.numeric_policy,binding_id:node.binding_id
    };
}

fn hir_binary_symbol(kind: i32) -> i32 {
    if (kind == ast_add_kind()) { return hir_symbol_add(); }
    if (kind == ast_subtract_kind()) { return hir_symbol_subtract(); }
    if (kind == ast_multiply_kind()) { return hir_symbol_multiply(); }
    if (kind == ast_divide_kind()) { return hir_symbol_divide(); }
    if (kind == ast_equal_kind()) { return hir_symbol_equal(); }
    if (kind == ast_not_equal_kind()) { return hir_symbol_not_equal(); }
    if (kind == ast_greater_equal_kind()) { return hir_symbol_greater_equal(); }
    if (kind == ast_less_equal_kind()) { return hir_symbol_less_equal(); }
    if (kind == ast_greater_kind()) { return hir_symbol_greater(); }
    if (kind == ast_less_kind()) { return hir_symbol_less(); }
    return hir_symbol_none();
}

pub fn hir_find_binding_id(
    borrow source: Buffer,
    borrow starts: Vec<i64>,
    borrow lengths: Vec<i64>,
    start: i64,
    length: i64
) -> i64
{
    var candidate: i64 = 0;
    while (candidate < vec_len<i64>(starts)) {
        let candidate_length: i64 = vec_get<i64>(lengths, candidate);
        if (candidate_length == length) {
            let candidate_start: i64 = vec_get<i64>(starts, candidate);
            var offset: i64 = 0;
            var equal: i32 = 1;
            while (offset < length) {
                if (buffer_get(source, checked_add(candidate_start, offset)) != buffer_get(source, checked_add(start, offset))) {
                    equal = 0;
                    offset = length;
                } else {
                    offset = checked_add(offset, 1);
                }
            }
            if (equal) { return candidate; }
        }
        candidate = checked_add(candidate, 1);
    }
    return -1;
}

fn hir_binding_scope_end(
    borrow source: Buffer, borrow tokens: Vec<Token>, declaration_start: i64
) -> i64 {
    var cursor: i64 = vec_len<Token>(tokens);
    var reverse_depth: i64 = 0;
    var open_index: i64 = -1;
    while (cursor > 0) {
        cursor = checked_sub(cursor, 1);
        let token: Token = vec_get<Token>(tokens, cursor);
        if (token_start(token) < declaration_start) {
            if (token_kind(token) == token_punctuation_kind()) {
                let byte: i64 = buffer_get(source, token_start(token));
                if (byte == token_close_brace_byte()) {
                    reverse_depth = checked_add(reverse_depth, 1);
                }
                if (byte == token_open_brace_byte()) {
                    if (reverse_depth == 0) {
                        open_index = cursor;
                        cursor = 0;
                    } else {
                        reverse_depth = checked_sub(reverse_depth, 1);
                    }
                }
            }
        }
    }
    if (open_index < 0) {
        cursor = 0;
        while (cursor < vec_len<Token>(tokens)) {
            let token: Token = vec_get<Token>(tokens, cursor);
            if (token_start(token) > declaration_start) {
                if (token_kind(token) == token_punctuation_kind()) {
                    if (buffer_get(source, token_start(token)) == token_open_brace_byte()) {
                        open_index = cursor;
                        cursor = vec_len<Token>(tokens);
                    }
                }
            }
            cursor = checked_add(cursor, 1);
        }
    }
    if (open_index < 0) { return buffer_len(source); }
    var depth: i64 = 0;
    cursor = open_index;
    while (cursor < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, cursor);
        if (token_kind(token) == token_punctuation_kind()) {
            let byte: i64 = buffer_get(source, token_start(token));
            if (byte == token_open_brace_byte()) { depth = checked_add(depth, 1); }
            if (byte == token_close_brace_byte()) {
                depth = checked_sub(depth, 1);
                if (depth == 0) { return token_start(token); }
            }
        }
        cursor = checked_add(cursor, 1);
    }
    return buffer_len(source);
}

pub fn hir_find_scoped_binding_id(
    borrow source: Buffer, borrow tokens: Vec<Token>,
    borrow starts: Vec<i64>, borrow lengths: Vec<i64>,
    start: i64, length: i64
) -> i64 {
    var selected: i64 = -1;
    var selected_start: i64 = -1;
    var candidate: i64 = 0;
    while (candidate < vec_len<i64>(starts)) {
        let candidate_start: i64 = vec_get<i64>(starts, candidate);
        if (candidate_start <= start) {
            if (vec_get<i64>(lengths, candidate) == length) {
                var offset: i64 = 0;
                var equal: i32 = 1;
                while (offset < length) {
                    if (buffer_get(source, checked_add(candidate_start, offset)) !=
                        buffer_get(source, checked_add(start, offset))) {
                        equal = 0;
                        offset = length;
                    } else { offset = checked_add(offset, 1); }
                }
                if (equal != 0) {
                    if (start < hir_binding_scope_end(source, tokens, candidate_start)) {
                        if (candidate_start > selected_start) {
                            selected = candidate;
                            selected_start = candidate_start;
                        }
                    }
                }
            }
        }
        candidate = checked_add(candidate, 1);
    }
    return selected;
}

// Executable bootstrap-hir-v1 flat record kinds.
// 1 literal, 2 arithmetic, 3 grouping alias, 4 value identifier, 5 comparison,
// 6 call, 7 field, 8 structural sequence, 9 symbol reference,
// 10 constructor, 11 field initializer.
pub fn lower_resolved_hir_record(
    ast_kind_code: i32,
    ast_start_value: i64,
    ast_length_value: i64,
    ast_left_value: i64,
    ast_right_value: i64,
    group_start_value: i64,
    group_length_value: i64,
    group_parent_value: i64,
    binding_id_value: i64,
    resolved_type_code: i32
) -> HirExpressionRecord
{
    if (group_parent_value >= 0) {
        return HirExpressionRecord {
            kind: hir_group_alias_kind(),
            start: group_start_value,
            length: group_length_value,
            left: group_parent_value,
            right: -1,
            symbol: hir_symbol_none(),
            type_code: resolved_type_code,
            numeric_policy: hir_numeric_policy_none(),
            binding_id: -1
        };
    }
    if (ast_kind_code == ast_exact_numeric_kind()) {
        return HirExpressionRecord {
            kind: hir_literal_kind(),
            start: ast_start_value,
            length: ast_length_value,
            left: -1,
            right: -1,
            symbol: hir_symbol_none(),
            type_code: resolved_type_code,
            numeric_policy: hir_numeric_policy_exact(),
            binding_id: -1
        };
    }
    if(ast_kind_code==ast_string_literal_kind()){
        return HirExpressionRecord{
            kind:hir_string_literal_kind(),start:ast_start_value,length:ast_length_value,left:-1,right:-1,
            symbol:hir_symbol_none(),type_code:resolved_type_code,numeric_policy:hir_numeric_policy_none(),binding_id:-1
        };
    }
    if (ast_kind_code == ast_identifier_kind()) {
        if (binding_id_value == hir_symbol_reference_binding_id()) {
            return HirExpressionRecord {
                kind: hir_symbol_reference_kind(),
                start: ast_start_value,
                length: ast_length_value,
                left: -1,
                right: -1,
                symbol: hir_symbol_none(),
                type_code: hir_type_unresolved(),
                numeric_policy: hir_numeric_policy_none(),
                binding_id: hir_symbol_reference_binding_id()
            };
        }
        return HirExpressionRecord {
            kind: hir_identifier_kind(),
            start: ast_start_value,
            length: ast_length_value,
            left: -1,
            right: -1,
            symbol: hir_symbol_none(),
            type_code: resolved_type_code,
            numeric_policy: hir_numeric_policy_none(),
            binding_id: binding_id_value
        };
    }
    if (ast_kind_code == ast_call_kind()) {
        return HirExpressionRecord {
            kind: hir_call_kind(),
            start: ast_start_value,
            length: ast_length_value,
            left: ast_left_value,
            right: ast_right_value,
            symbol: hir_symbol_none(),
            type_code: resolved_type_code,
            numeric_policy: hir_numeric_policy_none(),
            binding_id: -1
        };
    }
    if (ast_kind_code == ast_field_kind()) {
        return HirExpressionRecord {
            kind: hir_field_kind(),
            start: ast_start_value,
            length: ast_length_value,
            left: ast_left_value,
            right: ast_right_value,
            symbol: hir_symbol_none(),
            type_code: resolved_type_code,
            numeric_policy: hir_numeric_policy_none(),
            binding_id: -1
        };
    }
    if (ast_kind_code == ast_sequence_kind()) {
        return HirExpressionRecord {
            kind: hir_argument_sequence_kind(),
            start: ast_start_value,
            length: ast_length_value,
            left: ast_left_value,
            right: ast_right_value,
            symbol: hir_symbol_none(),
            type_code: hir_type_unresolved(),
            numeric_policy: hir_numeric_policy_none(),
            binding_id: -1
        };
    }
    if (ast_kind_code == ast_field_initializer_kind()) {
        return HirExpressionRecord {
            kind: hir_field_initializer_kind(),
            start: ast_start_value,
            length: ast_length_value,
            left: ast_left_value,
            right: ast_right_value,
            symbol: hir_symbol_none(),
            type_code: hir_type_unresolved(),
            numeric_policy: hir_numeric_policy_none(),
            binding_id: -1
        };
    }
    if (ast_kind_code == ast_constructor_kind()) {
        return HirExpressionRecord {
            kind: hir_constructor_kind(),
            start: ast_start_value,
            length: ast_length_value,
            left: ast_left_value,
            right: ast_right_value,
            symbol: hir_symbol_none(),
            type_code: resolved_type_code,
            numeric_policy: hir_numeric_policy_none(),
            binding_id: -1
        };
    }
    let binary_symbol: i32 = hir_binary_symbol(ast_kind_code);
    if (binary_symbol >= hir_symbol_add()) {
        if (binary_symbol <= hir_symbol_divide()) {
            return HirExpressionRecord {
                kind: hir_arithmetic_kind(),
                start: ast_start_value,
                length: ast_length_value,
                left: ast_left_value,
                right: ast_right_value,
                symbol: binary_symbol,
                type_code: resolved_type_code,
                numeric_policy: hir_numeric_policy_checked(),
                binding_id: -1
            };
        }
        return HirExpressionRecord {
            kind: hir_comparison_kind(),
            start: ast_start_value,
            length: ast_length_value,
            left: ast_left_value,
            right: ast_right_value,
            symbol: binary_symbol,
            type_code: hir_type_bool(),
            numeric_policy: hir_numeric_policy_exact(),
            binding_id: -1
        };
    }
    return HirExpressionRecord {
        kind: hir_invalid_kind(),
        start: ast_start_value,
        length: ast_length_value,
        left: -1,
        right: -1,
        symbol: hir_symbol_none(),
        type_code: resolved_type_code,
        numeric_policy: hir_numeric_policy_none(),
        binding_id: -1
    };
}

pub fn lower_primitive_hir_record(
    ast_kind_code: i32,
    ast_start_value: i64,
    ast_length_value: i64,
    ast_left_value: i64,
    ast_right_value: i64,
    group_start_value: i64,
    group_length_value: i64,
    group_parent_value: i64,
    binding_id_value: i64
) -> HirExpressionRecord
{
    return lower_resolved_hir_record(
        ast_kind_code,
        ast_start_value,
        ast_length_value,
        ast_left_value,
        ast_right_value,
        group_start_value,
        group_length_value,
        group_parent_value,
        binding_id_value,
        hir_type_i64()
    );
}

// Stable validation errors: 0 valid; 1 empty; 2 unsupported kind/type;
// 3 invalid span; 4 malformed literal; 5 malformed arithmetic/comparison;
// 6 bad policy; 7 malformed grouping alias; 8 malformed identifier;
// 9 malformed call/field; 10 malformed sequence; 11 malformed symbol;
// 12 malformed constructor; 13 malformed field initializer.
pub fn validate_primitive_hir_records(borrow nodes: Vec<HirExpressionRecord>) -> i32 {
    if (vec_len<HirExpressionRecord>(nodes) == 0) { return 1; }
    var index: i64 = 0;
    while (index < vec_len<HirExpressionRecord>(nodes)) {
        let node: HirExpressionRecord = vec_get<HirExpressionRecord>(nodes, index);
        if (node.kind == hir_invalid_kind()) { return 2; }
        if (node.start < 0) { return 3; }
        if (node.length < 0) { return 3; }
        if (node.kind == hir_literal_kind()) {
            if (node.type_code != hir_type_i64()) { return 2; }
            if (node.left != -1) { return 4; }
            if (node.right != -1) { return 4; }
            if (node.symbol != hir_symbol_none()) { return 4; }
            if (node.binding_id != -1) { return 4; }
            if (node.numeric_policy != hir_numeric_policy_exact()) { return 6; }
        } else {
            if (node.kind == hir_arithmetic_kind()) {
                if (node.type_code != hir_type_i64()) { return 2; }
                if (node.left < 0) { return 5; }
                if (node.right < 0) { return 5; }
                if (node.left >= index) { return 5; }
                if (node.right >= index) { return 5; }
                if (node.symbol < hir_symbol_add()) { return 5; }
                if (node.symbol > hir_symbol_divide()) { return 5; }
                if (node.binding_id != -1) { return 5; }
                if (node.numeric_policy != hir_numeric_policy_checked()) { return 6; }
            } else {
                if (node.kind == hir_group_alias_kind()) {
                    if (node.left < 0) { return 7; }
                    if (node.left >= index) { return 7; }
                    if (node.right != -1) { return 7; }
                    if (node.symbol != hir_symbol_none()) { return 7; }
                    if (node.binding_id != -1) { return 7; }
                    if (node.numeric_policy != hir_numeric_policy_none()) { return 7; }
                } else {
                    if (node.kind == hir_identifier_kind()) {
                        if (node.type_code <= 0) { return 2; }
                        if (node.left != -1) { return 8; }
                        if (node.right != -1) { return 8; }
                        if (node.symbol != hir_symbol_none()) { return 8; }
                        if (node.binding_id < 0) { return 8; }
                        if (node.numeric_policy != hir_numeric_policy_none()) { return 8; }
                    } else {
                        if (node.kind == hir_comparison_kind()) {
                            if (node.type_code != hir_type_bool()) { return 2; }
                            if (node.left < 0) { return 5; }
                            if (node.right < 0) { return 5; }
                            if (node.left >= index) { return 5; }
                            if (node.right >= index) { return 5; }
                            if (node.symbol < hir_symbol_equal()) { return 5; }
                            if (node.symbol > hir_symbol_less()) { return 5; }
                            if (node.binding_id != -1) { return 5; }
                            if (node.numeric_policy != hir_numeric_policy_exact()) { return 6; }
                        } else {
                            if (node.kind == hir_call_kind()) {
                                if (node.type_code <= 0) { return 2; }
                                if (node.left < 0) { return 9; }
                                if (node.left >= index) { return 9; }
                                if (node.right >= index) { return 9; }
                                if (node.symbol != hir_symbol_none()) { return 9; }
                                if (node.binding_id != -1) { return 9; }
                                if (node.numeric_policy != hir_numeric_policy_none()) { return 9; }
                            } else {
                                if (node.kind == hir_field_kind()) {
                                    if (node.type_code <= 0) { return 2; }
                                    if (node.left < 0) { return 9; }
                                    if (node.right < 0) { return 9; }
                                    if (node.left >= index) { return 9; }
                                    if (node.right >= index) { return 9; }
                                    if (node.symbol != hir_symbol_none()) { return 9; }
                                    if (node.binding_id != -1) { return 9; }
                                    if (node.numeric_policy != hir_numeric_policy_none()) { return 9; }
                                } else {
                                    if (node.kind == hir_argument_sequence_kind()) {
                                        if (node.type_code != hir_type_unresolved()) { return 10; }
                                        if (node.left < 0) { return 10; }
                                        if (node.right < 0) { return 10; }
                                        if (node.left >= index) { return 10; }
                                        if (node.right >= index) { return 10; }
                                        if (node.symbol != hir_symbol_none()) { return 10; }
                                        if (node.binding_id != -1) { return 10; }
                                        if (node.numeric_policy != hir_numeric_policy_none()) { return 10; }
                                    } else {
                                        if (node.kind == hir_symbol_reference_kind()) {
                                            if (node.type_code != hir_type_unresolved()) { return 11; }
                                            if (node.left != -1) { return 11; }
                                            if (node.right != -1) { return 11; }
                                            if (node.symbol != hir_symbol_none()) { return 11; }
                                            if (node.binding_id != -2) { return 11; }
                                            if (node.numeric_policy != hir_numeric_policy_none()) { return 11; }
                                        } else {
                                            if (node.kind == hir_constructor_kind()) {
                                                if (node.type_code <= 0) { return 12; }
                                                if (node.left < 0) { return 12; }
                                                if (node.left >= index) { return 12; }
                                                if (node.right >= index) { return 12; }
                                                if (node.symbol != hir_symbol_none()) { return 12; }
                                                if (node.binding_id != -1) { return 12; }
                                                if (node.numeric_policy != hir_numeric_policy_none()) { return 12; }
                                            } else {
                                                if (node.kind == hir_field_initializer_kind()) {
                                                    if (node.type_code != hir_type_unresolved()) { return 13; }
                                                    if (node.left < 0) { return 13; }
                                                    if (node.right < 0) { return 13; }
                                                    if (node.left >= index) { return 13; }
                                                    if (node.right >= index) { return 13; }
                                                    if (node.symbol != hir_symbol_none()) { return 13; }
                                                    if (node.binding_id != -1) { return 13; }
                                                    if (node.numeric_policy != hir_numeric_policy_none()) { return 13; }
                                                } else {
                                                    if (hir_is_string_literal(node) != 0) {
                                                        if (node.type_code != function_mir_string_type_code()) { return 2; }
                                                        if (node.left != -1) { return 4; }
                                                        if (node.right != -1) { return 4; }
                                                        if (node.symbol != 0) { return 4; }
                                                        if (node.binding_id != -1) { return 4; }
                                                        if (node.numeric_policy != 0) { return 6; }
                                                    } else { return 2; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        index = checked_add(index, 1);
    }
    return 0;
}
