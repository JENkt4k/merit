module bootstrap_hir_strings

import bootstrap_hir;
pub fn hir_string_validation_invalid_kind_status()->i32{return 1;}
pub fn hir_string_validation_invalid_span_status()->i32{return 2;}
pub fn hir_string_validation_invalid_shape_status()->i32{return 3;}
pub fn hir_string_validation_invalid_type_status()->i32{return 4;}
pub fn hir_string_validation_invalid_policy_status()->i32{return 5;}

// Non-numeric literals carry semantic type information but no numeric policy.
// Type code 6 is the replacement-boundary fixture identity for `string`.
pub fn lower_string_hir_record(
    ast_start_value: i64,
    ast_length_value: i64,
    resolved_type_code: i32
) -> HirExpressionRecord
{
    return HirExpressionRecord {
        kind: hir_string_literal_kind(),
        start: ast_start_value,
        length: ast_length_value,
        left: -1,
        right: -1,
        symbol: hir_symbol_none(),
        type_code: resolved_type_code,
        numeric_policy: hir_numeric_policy_none(),
        binding_id: -1
    };
}

// Stable local validation for the additive non-numeric literal record.
pub fn validate_string_hir_record(borrow node: HirExpressionRecord) -> i32 {
    if (hir_kind(node) != hir_string_literal_kind()) { return hir_string_validation_invalid_kind_status(); }
    if (hir_start(node) < 0) { return hir_string_validation_invalid_span_status(); }
    if (hir_length(node) < 2) { return hir_string_validation_invalid_span_status(); }
    if (hir_left(node) != -1) { return hir_string_validation_invalid_shape_status(); }
    if (hir_right(node) != -1) { return hir_string_validation_invalid_shape_status(); }
    if (hir_symbol(node) != 0) { return hir_string_validation_invalid_shape_status(); }
    if (hir_type_code(node) <= 0) { return hir_string_validation_invalid_type_status(); }
    if (hir_numeric_policy(node) != 0) { return hir_string_validation_invalid_policy_status(); }
    if (hir_binding_id(node) != -1) { return hir_string_validation_invalid_shape_status(); }
    return 0;
}
