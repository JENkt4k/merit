module bootstrap_native_replacement_driver
import bootstrap_tokens;
import bootstrap_lexer_core;
import bootstrap_statements;
import bootstrap_statement_semantics;
import bootstrap_mir_functions;
import bootstrap_mir_function_clause_metadata;
import bootstrap_mir_function_contracts;
import bootstrap_mir_function_assembly_plan;
import bootstrap_mir_function_instruction_source;
import bootstrap_mir_match_capability_flow;
import bootstrap_mir_source_type_lifecycle;
import bootstrap_mir_source_function_records;
import bootstrap_mir_ownership_flow;
import bootstrap_mir_structured_lowering;
import bootstrap_mir_cfg;
import bootstrap_mir_cfg_placement;
import bootstrap_mir_source_type_lifecycle;
import bootstrap_mir_resolved_source_function_assembly;
import bootstrap_mir_resolved_source_function_bundle;

capability allocate;

// Production-shaped native frontend driver entrypoint.
//
// Keep source-unit discovery and declaration-catalog derivation in this
// entrypoint rather than adding bootstrap helper functions. The bootstrap
// project is itself fixture input for whole-function compiler tests, so new
// top-level helper functions change its semantic function inventory.
pub fn emit_replacement_bundle(source_text: String) -> i32 {
    with capability allocate {
        let allocator: Allocator = system_allocator();
        let source: Buffer = buffer_from_string(allocator, source_text);
        let tokens: Vec<Token> = lex(source, allocator);

        // First pass: count top-level function bodies. Once a function starts,
        // skip its complete balanced body so a future nested-function feature
        // cannot accidentally inflate the bundle header count.
        var function_count: i64 = 0;
        var scan: i64 = 0;
        while (scan < vec_len<Token>(tokens)) {
            let candidate: Token = vec_get<Token>(tokens, scan);
            var is_fn: i32 = 0;
            if (token_kind(candidate) == 1) {
                if (token_length(candidate) == 2) {
                    let start: i64 = token_start(candidate);
                    if (buffer_get(source, start) == 102) {
                        if (buffer_get(source, checked_add(start, 1)) == 110) {
                            is_fn = 1;
                        }
                    }
                }
            }
            if (is_fn != 0) {
                function_count = checked_add(function_count, 1);
                var depth: i64 = 0;
                var body_started: i32 = 0;
                var end_found: i32 = 0;
                var body_scan: i64 = scan;
                var next_scan: i64 = scan;
                while (body_scan < vec_len<Token>(tokens)) {
                    if (end_found == 0) {
                        let body_token: Token = vec_get<Token>(tokens, body_scan);
                        if (token_kind(body_token) == 4) {
                            if (token_length(body_token) == 1) {
                                let byte: i64 = buffer_get(source, token_start(body_token));
                                if (byte == 123) {
                                    body_started = 1;
                                    depth = checked_add(depth, 1);
                                } else {
                                    if (byte == 125) {
                                        if (body_started == 0) { return 902; }
                                        depth = checked_sub(depth, 1);
                                        if (depth == 0) {
                                            end_found = 1;
                                            next_scan = checked_add(body_scan, 1);
                                        }
                                    }
                                }
                            }
                        }
                        body_scan = checked_add(body_scan, 1);
                    } else {
                        body_scan = vec_len<Token>(tokens);
                    }
                }
                if (end_found == 0) { return 903; }
                scan = next_scan;
            } else {
                scan = checked_add(scan, 1);
            }
        }
        if (function_count <= 0) { return 901; }

        let header_status: i32 = print_resolved_source_function_bundle_header(function_count);
        if (header_status != 0) {
            return checked_add(2000, header_status);
        }

        // Second pass: materialize and lower each complete function token view.
        // Token source offsets are retained, so all emitted spans remain anchored
        // to the original source buffer.
        scan = 0;
        var emitted_functions: i64 = 0;
        while (scan < vec_len<Token>(tokens)) {
            let candidate: Token = vec_get<Token>(tokens, scan);
            var is_fn: i32 = 0;
            if (token_kind(candidate) == 1) {
                if (token_length(candidate) == 2) {
                    let start: i64 = token_start(candidate);
                    if (buffer_get(source, start) == 102) {
                        if (buffer_get(source, checked_add(start, 1)) == 110) {
                            is_fn = 1;
                        }
                    }
                }
            }
            if (is_fn == 0) {
                scan = checked_add(scan, 1);
            } else {
                var function_tokens: Vec<Token> = vec_new<Token>(allocator, 32);
                var depth: i64 = 0;
                var body_started: i32 = 0;
                var end_found: i32 = 0;
                var slice_status: i32 = 0;
                var function_scan: i64 = scan;
                var next_scan: i64 = scan;
                while (function_scan < vec_len<Token>(tokens)) {
                    if (end_found == 0) {
                        let body_token: Token = vec_get<Token>(tokens, function_scan);
                        if (token_kind(body_token) == 4) {
                            if (token_length(body_token) == 1) {
                                let byte: i64 = buffer_get(source, token_start(body_token));
                                if (byte == 123) {
                                    body_started = 1;
                                    depth = checked_add(depth, 1);
                                } else {
                                    if (byte == 125) {
                                        if (body_started == 0) {
                                            slice_status = 904;
                                            end_found = 1;
                                            next_scan = checked_add(function_scan, 1);
                                        } else {
                                            depth = checked_sub(depth, 1);
                                            if (depth == 0) {
                                                end_found = 1;
                                                next_scan = checked_add(function_scan, 1);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        vec_push<Token>(function_tokens, body_token);
                        function_scan = checked_add(function_scan, 1);
                    } else {
                        function_scan = vec_len<Token>(tokens);
                    }
                }
                if (slice_status == 0) {
                    if (end_found == 0) {
                        slice_status = 905;
                    }
                }
                scan = next_scan;

                // Parse the bounded token view before selecting the semantic path.
                // Even an unterminated view is bounded by the source token vector;
                // slice_status prevents semantic lowering and is returned after the
                // single cleanup epilogue below.
                let statements: Vec<StatementRecord> = parse_statement_records(source, function_tokens, allocator);
                let operands: Vec<StatementOperand> = parse_statement_operands(source, function_tokens, allocator);

                var variants: Vec<EnumVariantCatalogEntry> = vec_new<EnumVariantCatalogEntry>(allocator, 8);
                var structs: Vec<I64StructCatalogEntry> = vec_new<I64StructCatalogEntry>(allocator, 4);
                var type_descriptors: Vec<MirTypeDescriptor> = vec_new<MirTypeDescriptor>(allocator, 8);
                var destructor_descriptors: Vec<MirDestructorDescriptor> = vec_new<MirDestructorDescriptor>(allocator, 4);
                var destructor_body: Vec<MirFunctionRecord> = vec_new<MirFunctionRecord>(allocator, 64);
                var destructor_cfg: Vec<MirCfgRecord> = vec_new<MirCfgRecord>(allocator, 32);
                var destructor_placements: Vec<MirPlacementRecord> = vec_new<MirPlacementRecord>(allocator, 64);
                var capabilities: Vec<CapabilityCatalogEntry> = vec_new<CapabilityCatalogEntry>(allocator, 4);
                var ownership: Vec<MirOwnershipBinding> = vec_new<MirOwnershipBinding>(allocator, 16);
                var body: Vec<MirFunctionRecord> = vec_new<MirFunctionRecord>(allocator, 96);
                var metadata: Vec<MirFunctionClauseMetadata> = vec_new<MirFunctionClauseMetadata>(allocator, 8);
                var contracts: Vec<MirFunctionContractRecord> = vec_new<MirFunctionContractRecord>(allocator, 32);
                var arms: Vec<ResolvedMatchArm> = vec_new<ResolvedMatchArm>(allocator, 4);
                var scopes: Vec<ResolvedCapabilityScope> = vec_new<ResolvedCapabilityScope>(allocator, 4);
                var ownership_events: Vec<MirOwnershipEvent> = vec_new<MirOwnershipEvent>(allocator, 96);
                var effects: Vec<MirCapabilityEffect> = vec_new<MirCapabilityEffect>(allocator, 8);
                var ownership_records: Vec<MirOwnershipRecord> = vec_new<MirOwnershipRecord>(allocator, 64);
                var contract_locals: Vec<MirFunctionContractLocal> = vec_new<MirFunctionContractLocal>(allocator, 16);
                var required: Vec<i64> = vec_new<i64>(allocator, 8);
                var sources: Vec<MirFunctionInstructionSource> = vec_new<MirFunctionInstructionSource>(allocator, 128);
                var assembled: Vec<MirLowerEvent> = vec_new<MirLowerEvent>(allocator, 160);
                var cfg: Vec<MirCfgRecord> = vec_new<MirCfgRecord>(allocator, 64);
                var placements: Vec<MirPlacementRecord> = vec_new<MirPlacementRecord>(allocator, 128);

                var function_status: i32 = slice_status;
                if (function_status == 0) {
                    var struct_status: i32 = derive_i64_struct_catalog(source, tokens, structs);
                    if (struct_status == 0) {
                        if (vec_len<I64StructCatalogEntry>(structs) > 0) {
                            var represented_replace: i32 = 1;
                            var struct_entry: i64 = 0;
                            while (struct_entry < vec_len<I64StructCatalogEntry>(structs)) {
                                let catalog_entry: I64StructCatalogEntry = vec_get<I64StructCatalogEntry>(structs, struct_entry);
                                if (i64_struct_catalog_destructor_policy(catalog_entry) != 1) {
                                    let represented_type: i32 = source_i64_struct_type_code(
                                        source, structs,
                                        i64_struct_catalog_name_start(catalog_entry),
                                        i64_struct_catalog_name_length(catalog_entry)
                                    );
                                    if (represented_type < function_mir_owned_field_struct_type_code(0)) {
                                        represented_replace = 0;
                                    }
                                }
                                struct_entry = checked_add(struct_entry, 1);
                            }
                            var struct_statement: i64 = 0;
                            while (struct_statement < vec_len<StatementRecord>(statements)) {
                                let candidate_statement: StatementRecord = vec_get<StatementRecord>(statements, struct_statement);
                                if (statement_record_kind(candidate_statement) == 29) {
                                    if (represented_replace == 0) {
                                        struct_status = i64_struct_catalog_replace_unsupported_status();
                                    }
                                }
                                struct_statement = checked_add(struct_statement, 1);
                            }
                        }
                    }
                    if (struct_status != 0) {
                        function_status = i64_struct_catalog_driver_status(struct_status);
                    }
                    // Derive top-level payload-free enum declarations directly
                    // from the complete source unit. Enum identity is declaration
                    // ordinal; variant identity is deterministic source-unit
                    // variant ordinal. Payload-bearing variants remain fail-closed
                    // until recursive enum lifecycle metadata is represented.
                    var enum_scan: i64 = 0;
                    var enum_depth: i64 = 0;
                    var enum_ordinal: i64 = 0;
                    var variant_identity: i64 = 0;
                    var enum_status: i32 = 0;
                    while (enum_scan < vec_len<Token>(tokens)) {
                        let enum_token: Token = vec_get<Token>(tokens, enum_scan);
                        let enum_start: i64 = token_start(enum_token);
                        let enum_length: i64 = token_length(enum_token);
                        let enum_kind: i32 = token_kind(enum_token);
                        var is_enum_declaration: i32 = 0;

                        if (enum_status == 0) {
                            if (enum_depth == 0) {
                                if (enum_kind == 1) {
                                    if (enum_length == 4) {
                                        is_enum_declaration = 1;
                                        if (buffer_get(source, enum_start) != 101) { is_enum_declaration = 0; }
                                        if (buffer_get(source, checked_add(enum_start, 1)) != 110) { is_enum_declaration = 0; }
                                        if (buffer_get(source, checked_add(enum_start, 2)) != 117) { is_enum_declaration = 0; }
                                        if (buffer_get(source, checked_add(enum_start, 3)) != 109) { is_enum_declaration = 0; }
                                    }
                                }
                            }
                        }

                        if (is_enum_declaration != 0) {
                            let enum_name_index: i64 = checked_add(enum_scan, 1);
                            let enum_open_index: i64 = checked_add(enum_scan, 2);
                            if (enum_open_index >= vec_len<Token>(tokens)) {
                                enum_status = 1;
                            } else {
                                let enum_name: Token = vec_get<Token>(tokens, enum_name_index);
                                let enum_open: Token = vec_get<Token>(tokens, enum_open_index);
                                var enum_header_valid: i32 = 1;
                                if (token_kind(enum_name) != 1) { enum_header_valid = 0; }
                                if (token_kind(enum_open) != 4) { enum_header_valid = 0; }
                                if (token_length(enum_open) != 1) { enum_header_valid = 0; }
                                if (enum_header_valid != 0) {
                                    if (buffer_get(source, token_start(enum_open)) != 123) {
                                        enum_header_valid = 0;
                                    }
                                }
                                if (enum_header_valid == 0) {
                                    enum_status = 1;
                                } else {
                                    var variant_scan: i64 = checked_add(enum_open_index, 1);
                                    var variant_ordinal: i64 = 0;
                                    var enum_end_found: i32 = 0;
                                    while (variant_scan < vec_len<Token>(tokens)) {
                                        if (enum_end_found == 0) {
                                            let variant_token: Token = vec_get<Token>(tokens, variant_scan);
                                            var is_enum_close: i32 = 0;
                                            if (token_kind(variant_token) == 4) {
                                                if (token_length(variant_token) == 1) {
                                                    if (buffer_get(source, token_start(variant_token)) == 125) {
                                                        is_enum_close = 1;
                                                    }
                                                }
                                            }
                                            if (is_enum_close != 0) {
                                                enum_end_found = 1;
                                                enum_scan = variant_scan;
                                            } else {
                                                if (token_kind(variant_token) != 1) {
                                                    enum_status = 1;
                                                    enum_end_found = 1;
                                                } else {
                                                    let separator_index: i64 = checked_add(variant_scan, 1);
                                                    if (separator_index >= vec_len<Token>(tokens)) {
                                                        enum_status = 1;
                                                        enum_end_found = 1;
                                                    } else {
                                                        let separator_token: Token = vec_get<Token>(tokens, separator_index);
                                                        var separator_kind: i32 = 0;
                                                        var effective_separator_index: i64 = separator_index;
                                                        var variant_payload_owned: i32 = 0;
                                                        var variant_payload_type_code: i32 = function_mir_unresolved_type_code();
                                                        if (token_kind(separator_token) == 4) {
                                                            if (token_length(separator_token) == 1) {
                                                                let separator_byte: i64 = buffer_get(source, token_start(separator_token));
                                                                if (separator_byte == 44) { separator_kind = 1; }
                                                                if (separator_byte == 125) { separator_kind = 2; }
                                                                if (separator_byte == 40) { separator_kind = 3; }
                                                            }
                                                        }
                                                        if (separator_kind == 3) {
                                                            let payload_index: i64 = checked_add(separator_index, 1);
                                                            let payload_close_index: i64 = checked_add(separator_index, 2);
                                                            let payload_separator_index: i64 = checked_add(separator_index, 3);
                                                            if (payload_separator_index >= vec_len<Token>(tokens)) {
                                                                enum_status = 3;
                                                            } else {
                                                                let payload: Token = vec_get<Token>(tokens, payload_index);
                                                                let payload_close: Token = vec_get<Token>(tokens, payload_close_index);
                                                                let payload_separator: Token = vec_get<Token>(tokens, payload_separator_index);
                                                                var copy_payload: i32 = source_type_span_is_copy_builtin(
                                                                    source, token_start(payload), token_length(payload)
                                                                );
                                                                if (copy_payload != 0) { variant_payload_type_code = function_mir_i64_type_code(); }
                                                                if (copy_payload == 0) {
                                                                    variant_payload_type_code = sfr_builtin_type_code(
                                                                        source, token_start(payload), token_length(payload)
                                                                    );
                                                                    if (variant_payload_type_code == function_mir_buffer_type_code()) {
                                                                        variant_payload_owned = 1;
                                                                    }
                                                                    if (variant_payload_type_code == function_mir_unresolved_type_code()) {
                                                                        variant_payload_type_code = source_i64_struct_type_code(
                                                                            source, structs, token_start(payload), token_length(payload)
                                                                        );
                                                                    }
                                                                    if (variant_payload_type_code >= function_mir_destructor_i64_struct_type_code(0)) {
                                                                        variant_payload_owned = 1;
                                                                    }
                                                                    if (variant_payload_type_code != function_mir_unresolved_type_code()) { copy_payload = 1; }
                                                                }
                                                                if (token_kind(payload_close) != 4) { copy_payload = 0; }
                                                                if (token_length(payload_close) != 1) { copy_payload = 0; }
                                                                if (copy_payload != 0) {
                                                                    if (buffer_get(source, token_start(payload_close)) != 41) { copy_payload = 0; }
                                                                }
                                                                if (copy_payload == 0) {
                                                                    enum_status = 3;
                                                                } else {
                                                                    separator_kind = 0;
                                                                    if (token_kind(payload_separator) == 4) {
                                                                        if (token_length(payload_separator) == 1) {
                                                                            let payload_separator_byte: i64 = buffer_get(source, token_start(payload_separator));
                                                                            if (payload_separator_byte == 44) { separator_kind = 1; }
                                                                            if (payload_separator_byte == 125) { separator_kind = 2; }
                                                                        }
                                                                    }
                                                                    effective_separator_index = payload_separator_index;
                                                                    if (separator_kind == 0) { enum_status = 3; }
                                                                }
                                                            }
                                                        }
                                                        if (enum_status != 0) { enum_end_found = 1; }
                                                        if (enum_status == 0) {
                                                            if (separator_kind == 0) {
                                                                enum_status = 1;
                                                                enum_end_found = 1;
                                                            } else {
                                                                var duplicate_variant: i32 = 0;
                                                                var existing_variant: i64 = 0;
                                                                while (existing_variant < vec_len<EnumVariantCatalogEntry>(variants)) {
                                                                    let existing_entry: EnumVariantCatalogEntry = vec_get<EnumVariantCatalogEntry>(variants, existing_variant);
                                                                    if (existing_entry.enum_id == enum_ordinal) {
                                                                        if (existing_entry.name_length == token_length(variant_token)) {
                                                                            var variant_offset: i64 = 0;
                                                                            var same_variant: i32 = 1;
                                                                            while (variant_offset < token_length(variant_token)) {
                                                                                if (buffer_get(source, checked_add(existing_entry.name_start, variant_offset)) != buffer_get(source, checked_add(token_start(variant_token), variant_offset))) {
                                                                                    same_variant = 0;
                                                                                }
                                                                                variant_offset = checked_add(variant_offset, 1);
                                                                            }
                                                                            if (same_variant != 0) { duplicate_variant = 1; }
                                                                        }
                                                                    }
                                                                    existing_variant = checked_add(existing_variant, 1);
                                                                }
                                                                if (duplicate_variant != 0) {
                                                                    enum_status = 2;
                                                                    enum_end_found = 1;
                                                                } else {
                                                                    vec_push<EnumVariantCatalogEntry>(variants, EnumVariantCatalogEntry {
                                                                        enum_id: enum_ordinal,
                                                                        enum_name_start: token_start(enum_name),
                                                                        enum_name_length: token_length(enum_name),
                                                                        variant_id: variant_identity,
                                                                        ordinal: variant_ordinal,
                                                                        name_start: token_start(variant_token),
                                                                        name_length: token_length(variant_token),
                                                                        payload_owned: variant_payload_owned,
                                                                        payload_type_code: variant_payload_type_code
                                                                    });
                                                                    variant_identity = checked_add(variant_identity, 1);
                                                                    variant_ordinal = checked_add(variant_ordinal, 1);
                                                                    if (separator_kind == 1) {
                                                                        variant_scan = checked_add(effective_separator_index, 1);
                                                                    } else {
                                                                        enum_end_found = 1;
                                                                        enum_scan = effective_separator_index;
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        } else {
                                            variant_scan = vec_len<Token>(tokens);
                                        }
                                    }
                                    if (enum_status == 0) {
                                        if (enum_end_found == 0) { enum_status = 1; }
                                        if (variant_ordinal == 0) { enum_status = 1; }
                                    }
                                    if (enum_status == 0) {
                                        enum_ordinal = checked_add(enum_ordinal, 1);
                                    }
                                }
                            }
                        } else {
                            if (enum_kind == 4) {
                                if (enum_length == 1) {
                                    let enum_byte: i64 = buffer_get(source, enum_start);
                                    if (enum_byte == 123) {
                                        enum_depth = checked_add(enum_depth, 1);
                                    } else {
                                        if (enum_byte == 125) {
                                            if (enum_depth > 0) {
                                                enum_depth = checked_sub(enum_depth, 1);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        enum_scan = checked_add(enum_scan, 1);
                    }
                    if(enum_status==0){
                        enum_status=derive_predefined_filesystem_result_catalog(source,tokens,variants);
                    }

                    // A negative identity delegates match-subject -> declared-type
                    // resolution to the resolved semantic stage. The driver owns
                    // declaration catalog derivation, but no longer guesses which
                    // enum a match belongs to merely from source-unit cardinality.
                    let resolved_match_enum_id: i64 = -1;

                    // Derive top-level `capability name;` declarations from the
                    // complete source unit. IDs are stable declaration ordinals.
                    // Uses inside function bodies are excluded by brace depth.
                    var capability_scan: i64 = 0;
                    var capability_depth: i64 = 0;
                    var capability_ordinal: i64 = 0;
                    var capability_status: i32 = 0;
                    while (capability_scan < vec_len<Token>(tokens)) {
                        let capability_token: Token = vec_get<Token>(tokens, capability_scan);
                        let capability_start: i64 = token_start(capability_token);
                        let capability_length: i64 = token_length(capability_token);
                        let capability_kind: i32 = token_kind(capability_token);

                        if (capability_kind == 4) {
                            if (capability_length == 1) {
                                let capability_byte: i64 = buffer_get(source, capability_start);
                                if (capability_byte == 123) {
                                    capability_depth = checked_add(capability_depth, 1);
                                } else {
                                    if (capability_byte == 125) {
                                        if (capability_depth > 0) {
                                            capability_depth = checked_sub(capability_depth, 1);
                                        }
                                    }
                                }
                            }
                        }

                        var is_capability_declaration: i32 = 0;
                        if (capability_status == 0) {
                            if (capability_depth == 0) {
                                if (capability_kind == 1) {
                                    if (capability_length == 10) {
                                        is_capability_declaration = 1;
                                        if (buffer_get(source, capability_start) != 99) { is_capability_declaration = 0; }
                                        if (buffer_get(source, checked_add(capability_start, 1)) != 97) { is_capability_declaration = 0; }
                                        if (buffer_get(source, checked_add(capability_start, 2)) != 112) { is_capability_declaration = 0; }
                                        if (buffer_get(source, checked_add(capability_start, 3)) != 97) { is_capability_declaration = 0; }
                                        if (buffer_get(source, checked_add(capability_start, 4)) != 98) { is_capability_declaration = 0; }
                                        if (buffer_get(source, checked_add(capability_start, 5)) != 105) { is_capability_declaration = 0; }
                                        if (buffer_get(source, checked_add(capability_start, 6)) != 108) { is_capability_declaration = 0; }
                                        if (buffer_get(source, checked_add(capability_start, 7)) != 105) { is_capability_declaration = 0; }
                                        if (buffer_get(source, checked_add(capability_start, 8)) != 116) { is_capability_declaration = 0; }
                                        if (buffer_get(source, checked_add(capability_start, 9)) != 121) { is_capability_declaration = 0; }
                                    }
                                }
                            }
                        }

                        if (is_capability_declaration != 0) {
                            let name_index: i64 = checked_add(capability_scan, 1);
                            let semicolon_index: i64 = checked_add(capability_scan, 2);
                            if (semicolon_index >= vec_len<Token>(tokens)) {
                                capability_status = 1;
                            } else {
                                let name_token: Token = vec_get<Token>(tokens, name_index);
                                let semicolon_token: Token = vec_get<Token>(tokens, semicolon_index);
                                var declaration_valid: i32 = 1;
                                if (token_kind(name_token) != 1) { declaration_valid = 0; }
                                if (token_kind(semicolon_token) != 4) { declaration_valid = 0; }
                                if (token_length(semicolon_token) != 1) { declaration_valid = 0; }
                                if (declaration_valid != 0) {
                                    if (buffer_get(source, token_start(semicolon_token)) != 59) {
                                        declaration_valid = 0;
                                    }
                                }
                                if (declaration_valid == 0) {
                                    capability_status = 1;
                                } else {
                                    var existing: i64 = 0;
                                    var duplicate: i32 = 0;
                                    while (existing < vec_len<CapabilityCatalogEntry>(capabilities)) {
                                        let entry: CapabilityCatalogEntry = vec_get<CapabilityCatalogEntry>(capabilities, existing);
                                        if (entry.name_length == token_length(name_token)) {
                                            var offset: i64 = 0;
                                            var same: i32 = 1;
                                            while (offset < token_length(name_token)) {
                                                if (buffer_get(source, checked_add(entry.name_start, offset)) != buffer_get(source, checked_add(token_start(name_token), offset))) {
                                                    same = 0;
                                                }
                                                offset = checked_add(offset, 1);
                                            }
                                            if (same != 0) { duplicate = 1; }
                                        }
                                        existing = checked_add(existing, 1);
                                    }
                                    if (duplicate != 0) {
                                        capability_status = 2;
                                    } else {
                                        vec_push<CapabilityCatalogEntry>(capabilities, CapabilityCatalogEntry {
                                            capability_id: capability_ordinal,
                                            name_start: token_start(name_token),
                                            name_length: token_length(name_token)
                                        });
                                        capability_ordinal = checked_add(capability_ordinal, 1);
                                        capability_scan = semicolon_index;
                                    }
                                }
                            }
                        }
                        capability_scan = checked_add(capability_scan, 1);
                    }

                    if (function_status != 0) {
                    } else {
                    if (enum_status != 0) {
                        function_status = checked_add(920, enum_status);
                    } else {
                        if (capability_status != 0) {
                            function_status = checked_add(950, capability_status);
                        } else {
                            let descriptor_status: i32 = derive_source_type_descriptors(
                                source, structs, variants, type_descriptors
                            );
                            if (descriptor_status != 0) {
                                function_status = source_type_descriptor_driver_status(descriptor_status);
                            } else {
                            // Destructors are canonical executable programs, not
                            // type-name policies. Lower every top-level destructor
                            // through the same expression/statement/CFG records and
                            // frame those records separately from ordinary functions.
                            var destructor_scan: i64 = 0;
                            var destructor_depth: i64 = 0;
                            while (destructor_scan < vec_len<Token>(tokens)) {
                                let destructor_token: Token = vec_get<Token>(tokens, destructor_scan);
                                var is_destructor_declaration: i32 = 0;
                                if (destructor_depth == 0) {
                                    is_destructor_declaration = source_token_is_destructor(source, destructor_token);
                                }
                                if (is_destructor_declaration == 0) {
                                    if (token_kind(destructor_token) == token_punctuation_kind()) {
                                        if (token_length(destructor_token) == 1) {
                                            let destructor_byte: i64 = buffer_get(source, token_start(destructor_token));
                                            if (destructor_byte == token_open_brace_byte()) {
                                                destructor_depth = checked_add(destructor_depth, 1);
                                            } else {
                                                if (destructor_byte == token_close_brace_byte()) {
                                                    if (destructor_depth > 0) {
                                                        destructor_depth = checked_sub(destructor_depth, 1);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    destructor_scan = checked_add(destructor_scan, 1);
                                } else {
                                    let destructor_name_index: i64 = checked_add(destructor_scan, 1);
                                    let destructor_open_index: i64 = checked_add(destructor_scan, 2);
                                    if (destructor_open_index >= vec_len<Token>(tokens)) {
                                        function_status = function_mir_destructor_header_error();
                                    } else {
                                        let destructor_name: Token = vec_get<Token>(tokens, destructor_name_index);
                                        let destructor_type_code: i32 = source_i64_struct_type_code(
                                            source, structs, token_start(destructor_name), token_length(destructor_name)
                                        );
                                        if (destructor_type_code < function_mir_i64_struct_type_code(0)) {
                                            function_status = function_mir_destructor_type_error();
                                        } else {
                                            var destructor_tokens: Vec<Token> = vec_new<Token>(allocator, 32);
                                            var local_depth: i64 = 0;
                                            var local_started: i32 = 0;
                                            var local_closed: i32 = 0;
                                            var local_scan: i64 = destructor_scan;
                                            var next_destructor_scan: i64 = destructor_scan;
                                            while (local_scan < vec_len<Token>(tokens)) {
                                                if (local_closed == 0) {
                                                    let local_token: Token = vec_get<Token>(tokens, local_scan);
                                                    if (token_kind(local_token) == token_punctuation_kind()) {
                                                        if (token_length(local_token) == 1) {
                                                            let local_byte: i64 = buffer_get(source, token_start(local_token));
                                                            if (local_byte == token_open_brace_byte()) {
                                                                local_started = 1;
                                                                local_depth = checked_add(local_depth, 1);
                                                            } else {
                                                                if (local_byte == token_close_brace_byte()) {
                                                                    if (local_started == 0) { function_status = function_mir_destructor_unopened_body_error(); }
                                                                    local_depth = checked_sub(local_depth, 1);
                                                                    if (local_depth == 0) {
                                                                        local_closed = 1;
                                                                        next_destructor_scan = checked_add(local_scan, 1);
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                    vec_push<Token>(destructor_tokens, local_token);
                                                    local_scan = checked_add(local_scan, 1);
                                                } else {
                                                    local_scan = vec_len<Token>(tokens);
                                                }
                                            }
                                            if (local_closed == 0) { function_status = function_mir_destructor_unclosed_body_error(); }

                                            let destructor_statements: Vec<StatementRecord> = parse_statement_records(
                                                source, destructor_tokens, allocator
                                            );
                                            let destructor_operands: Vec<StatementOperand> = parse_statement_operands(
                                                source, destructor_tokens, allocator
                                            );
                                            var destructor_statement_index: i64 = 0;
                                            while (destructor_statement_index < vec_len<StatementRecord>(destructor_statements)) {
                                                let destructor_statement: StatementRecord = vec_get<StatementRecord>(
                                                    destructor_statements, destructor_statement_index
                                                );
                                                let destructor_statement_kind: i32 = statement_record_kind(destructor_statement);
                                                var destructor_statement_allowed: i32 = 0;
                                                if (destructor_statement_kind == statement_record_print_kind()) { destructor_statement_allowed = 1; }
                                                if (destructor_statement_kind == statement_record_if_kind()) { destructor_statement_allowed = 1; }
                                                if (destructor_statement_kind == statement_record_while_kind()) { destructor_statement_allowed = 1; }
                                                if (destructor_statement_kind == statement_record_assign_kind()) { destructor_statement_allowed = 1; }
                                                if (destructor_statement_kind == statement_record_expression_kind()) { destructor_statement_allowed = 1; }
                                                if (destructor_statement_allowed == 0) { function_status = function_mir_destructor_statement_error(); }
                                                destructor_statement_index = checked_add(destructor_statement_index, 1);
                                            }

                                            var local_body: Vec<MirFunctionRecord> = vec_new<MirFunctionRecord>(allocator, 64);
                                            var local_events: Vec<MirLowerEvent> = vec_new<MirLowerEvent>(allocator, 64);
                                            var local_cfg: Vec<MirCfgRecord> = vec_new<MirCfgRecord>(allocator, 32);
                                            var local_placements: Vec<MirPlacementRecord> = vec_new<MirPlacementRecord>(allocator, 64);
                                            var empty_destructor_arms: Vec<ResolvedMatchArm> = vec_new<ResolvedMatchArm>(allocator, 0);
                                            if (function_status == 0) {
                                                let destructor_body_status: i32 = lower_source_function_body_records(
                                                    source, destructor_tokens, destructor_statements, destructor_operands,
                                                    variants, structs, empty_destructor_arms, allocator, local_body, local_events
                                                );
                                                if (destructor_body_status != 0) {
                                                    function_status = function_mir_destructor_body_error(destructor_body_status);
                                                } else {
                                                    vec_push<MirLowerEvent>(local_events, mir_event_return(-1));
                                                    let destructor_cfg_status: i32 = lower_structured_mir(
                                                        local_events, allocator, local_cfg, local_placements
                                                    );
                                                    if (destructor_cfg_status != 0) {
                                                        function_status = function_mir_destructor_cfg_error(destructor_cfg_status);
                                                    }
                                                }
                                            }
                                            if (function_status == 0) {
                                                vec_push<MirDestructorDescriptor>(destructor_descriptors, function_mir_destructor_descriptor(
                                                    destructor_type_code,
                                                    vec_len<MirFunctionRecord>(destructor_body), vec_len<MirFunctionRecord>(local_body),
                                                    vec_len<MirCfgRecord>(destructor_cfg), vec_len<MirCfgRecord>(local_cfg),
                                                    vec_len<MirPlacementRecord>(destructor_placements), vec_len<MirPlacementRecord>(local_placements)
                                                ));
                                                var append_index: i64 = 0;
                                                while (append_index < vec_len<MirFunctionRecord>(local_body)) {
                                                    vec_push<MirFunctionRecord>(destructor_body, vec_get<MirFunctionRecord>(local_body, append_index));
                                                    append_index = checked_add(append_index, 1);
                                                }
                                                append_index = 0;
                                                while (append_index < vec_len<MirCfgRecord>(local_cfg)) {
                                                    vec_push<MirCfgRecord>(destructor_cfg, vec_get<MirCfgRecord>(local_cfg, append_index));
                                                    append_index = checked_add(append_index, 1);
                                                }
                                                append_index = 0;
                                                while (append_index < vec_len<MirPlacementRecord>(local_placements)) {
                                                    vec_push<MirPlacementRecord>(destructor_placements, vec_get<MirPlacementRecord>(local_placements, append_index));
                                                    append_index = checked_add(append_index, 1);
                                                }
                                            }
                                            drop(empty_destructor_arms);
                                            drop(local_placements); drop(local_cfg); drop(local_events); drop(local_body);
                                            drop(destructor_operands); drop(destructor_statements); drop(destructor_tokens);
                                            destructor_scan = next_destructor_scan;
                                        }
                                    }
                                    if (function_status != 0) { destructor_scan = vec_len<Token>(tokens); }
                                }
                            }
                            if (function_status == 0) {
                            let assembly_status: i32 = lower_resolved_source_function_assembly_from_source(
                                source, function_tokens, statements, operands,
                                variants, structs, resolved_match_enum_id, capabilities, allocator,
                                ownership, body, metadata, contracts, arms, scopes,
                                ownership_events, effects, ownership_records, contract_locals,
                                required, sources, assembled, cfg, placements
                            );
                            if (assembly_status != 0) {
                                function_status = checked_add(1000, assembly_status);
                            } else {
                                let item_status: i32 = print_resolved_source_function_bundle_item(
                                    body, contracts, contract_locals, sources, ownership,
                                    ownership_records, cfg, placements, required, type_descriptors,
                                    destructor_descriptors, destructor_body, destructor_cfg, destructor_placements
                                );
                                if (item_status != 0) {
                                    function_status = checked_add(3000, item_status);
                                } else {
                                    emitted_functions = checked_add(emitted_functions, 1);
                                }
                            }
                            }
                            }
                        }
                    }
                    }
                }

                // One ownership epilogue, one syntactic consumption per binding.
                // This avoids branch-merge ambiguity in the current checker while
                // still closing every scoped owned local before leaving the else.
                drop(placements);
                drop(cfg);
                drop(assembled);
                drop(sources);
                drop(required);
                drop(contract_locals);
                drop(ownership_records);
                drop(effects);
                drop(ownership_events);
                drop(scopes);
                drop(arms);
                drop(contracts);
                drop(metadata);
                drop(body);
                drop(ownership);
                drop(capabilities);
                drop(destructor_placements);
                drop(destructor_cfg);
                drop(destructor_body);
                drop(destructor_descriptors);
                drop(type_descriptors);
                drop(structs);
                drop(variants);
                drop(operands);
                drop(statements);
                drop(function_tokens);

                if (function_status != 0) { return function_status; }
            }
        }
        if (emitted_functions != function_count) { return 906; }
        return 0;
    }
}
