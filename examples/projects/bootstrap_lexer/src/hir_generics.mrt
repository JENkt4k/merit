module bootstrap_hir_generics

import bootstrap_hir;

// bootstrap-expression-v1 currently supports a single explicit type argument.
// Preserve the entire generic application source span as a structural symbol
// reference. Canonical HIR reconstruction resolves the base symbol and type
// argument from this immutable span.
pub fn lower_generic_apply_hir_record(
    ast_start_value: i64,
    ast_length_value: i64
) -> HirExpressionRecord
{
    return HirExpressionRecord {
        kind: hir_symbol_reference_kind(),
        start: ast_start_value,
        length: ast_length_value,
        left: -1,
        right: -1,
        symbol: hir_symbol_none(),
        type_code: hir_type_unresolved(),
        numeric_policy: hir_numeric_policy_none(),
        binding_id: -2
    };
}
