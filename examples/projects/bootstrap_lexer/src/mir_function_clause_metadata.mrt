module bootstrap_mir_function_clause_metadata
import bootstrap_clauses;
import bootstrap_statement_semantics;

capability allocate;

// Semantic function-clause metadata. Kinds: 1 effect, 2 required capability.
pub struct MirFunctionClauseMetadata {
    kind: i32;
    clause_ordinal: i64;
    operand_ordinal: i64;
    start: i64;
    length: i64;
    semantic_id: i64;
}

pub fn clause_metadata_kind(borrow value: MirFunctionClauseMetadata) -> i32 { return value.kind; }
pub fn clause_metadata_clause(borrow value: MirFunctionClauseMetadata) -> i64 { return value.clause_ordinal; }
pub fn clause_metadata_operand(borrow value: MirFunctionClauseMetadata) -> i64 { return value.operand_ordinal; }
pub fn clause_metadata_start(borrow value: MirFunctionClauseMetadata) -> i64 { return value.start; }
pub fn clause_metadata_length(borrow value: MirFunctionClauseMetadata) -> i64 { return value.length; }
pub fn clause_metadata_semantic_id(borrow value: MirFunctionClauseMetadata) -> i64 { return value.semantic_id; }

fn clause_metadata_equal(
    borrow source: Buffer,
    left_start: i64, left_length: i64,
    right_start: i64, right_length: i64
) -> i32 {
    if (left_length != right_length) { return 0; }
    var offset: i64 = 0;
    while (offset < left_length) {
        if (buffer_get(source, checked_add(left_start, offset)) != buffer_get(source, checked_add(right_start, offset))) { return 0; }
        offset = checked_add(offset, 1);
    }
    return 1;
}

fn clause_metadata_capability_id(
    borrow source: Buffer,
    borrow catalog: Vec<CapabilityCatalogEntry>,
    start: i64,
    length: i64
) -> i64 {
    var index: i64 = 0;
    while (index < vec_len<CapabilityCatalogEntry>(catalog)) {
        let entry: CapabilityCatalogEntry = vec_get<CapabilityCatalogEntry>(catalog, index);
        if (clause_metadata_equal(source, start, length, entry.name_start, entry.name_length) != 0) { return entry.capability_id; }
        index = checked_add(index, 1);
    }
    return -1;
}

pub fn lower_function_clause_metadata(
    borrow source: Buffer,
    borrow clauses: Vec<ClauseRecord>,
    borrow operands: Vec<ClauseOperand>,
    borrow capability_catalog: Vec<CapabilityCatalogEntry>,
    borrow_mut output: Vec<MirFunctionClauseMetadata>
) -> i32
requires_caps [allocate]
{
    var clause_index: i64 = 0;
    while (clause_index < vec_len<ClauseRecord>(clauses)) {
        let clause: ClauseRecord = vec_get<ClauseRecord>(clauses, clause_index);
        let kind: i32 = clause_record_kind(clause);
        if (kind == 11) {
            var offset: i64 = 0;
            while (offset < clause_record_operand_count(clause)) {
                let operand_index: i64 = checked_add(clause_record_first_operand(clause), offset);
                let operand: ClauseOperand = vec_get<ClauseOperand>(operands, operand_index);
                if (clause_operand_kind(operand) != 1) { return 1; }
                vec_push<MirFunctionClauseMetadata>(output, MirFunctionClauseMetadata {
                    kind: 1, clause_ordinal: clause_index, operand_ordinal: offset,
                    start: clause_operand_start(operand), length: clause_operand_length(operand), semantic_id: -1
                });
                offset = checked_add(offset, 1);
            }
        } else {
            if (kind == 12) {
                var offset: i64 = 0;
                while (offset < clause_record_operand_count(clause)) {
                    let operand_index: i64 = checked_add(clause_record_first_operand(clause), offset);
                    let operand: ClauseOperand = vec_get<ClauseOperand>(operands, operand_index);
                    if (clause_operand_kind(operand) != 2) { return 2; }
                    let capability_id: i64 = clause_metadata_capability_id(
                        source, capability_catalog, clause_operand_start(operand), clause_operand_length(operand)
                    );
                    if (capability_id < 0) { return 3; }
                    vec_push<MirFunctionClauseMetadata>(output, MirFunctionClauseMetadata {
                        kind: 2, clause_ordinal: clause_index, operand_ordinal: offset,
                        start: clause_operand_start(operand), length: clause_operand_length(operand), semantic_id: capability_id
                    });
                    offset = checked_add(offset, 1);
                }
            }
        }
        clause_index = checked_add(clause_index, 1);
    }
    return 0;
}

pub fn validate_function_clause_metadata(borrow values: Vec<MirFunctionClauseMetadata>) -> i32 {
    var index: i64 = 0;
    while (index < vec_len<MirFunctionClauseMetadata>(values)) {
        let value: MirFunctionClauseMetadata = vec_get<MirFunctionClauseMetadata>(values, index);
        if (value.kind < 1) { return 10; }
        if (value.kind > 2) { return 10; }
        if (value.clause_ordinal < 0) { return 11; }
        if (value.operand_ordinal < 0) { return 12; }
        if (value.start < 0) { return 13; }
        if (value.length <= 0) { return 13; }
        if (value.kind == 2) { if (value.semantic_id < 0) { return 14; } }
        index = checked_add(index, 1);
    }
    return 0;
}
