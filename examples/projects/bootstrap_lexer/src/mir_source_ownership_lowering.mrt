module bootstrap_mir_source_ownership_lowering
import bootstrap_tokens;
import bootstrap_syntax;
import bootstrap_statements;
import bootstrap_expression_spans;
import bootstrap_hir;
import bootstrap_mir_ownership_flow;

capability allocate;

// Native source/typed-statement -> ownership-event bridge. Ownership and
// mutability come only from explicit MirOwnershipBinding metadata; source type
// spelling never defines lifecycle semantics.
struct SourceOwnershipFrame {
    kind: i32;
    open_end: i64;
    body_depth: i64;
    state: i32;
}

fn source_ownership_token_end(borrow token: Token) -> i64 {
    return checked_add(token_start(token), token_length(token));
}

fn source_ownership_punctuation(
    borrow source: Buffer, borrow token: Token, byte: i64
) -> i32
{
    if (token_kind(token) != 4) { return 0; }
    if (token_length(token) != 1) { return 0; }
    if (buffer_get(source, token_start(token)) != byte) { return 0; }
    return 1;
}

fn source_ownership_else(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != 1) { return 0; }
    if (token_length(token) != 4) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != 101) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != 108) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != 115) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != 101) { return 0; }
    return 1;
}

fn source_ownership_operand(
    borrow statement: StatementRecord,
    borrow operands: Vec<StatementOperand>,
    operand_kind: i32,
    ordinal: i64
) -> i64
{
    var offset: i64 = 0;
    var seen: i64 = 0;
    while (offset < statement_record_operand_count(statement)) {
        let index: i64 = checked_add(statement_record_first_operand(statement), offset);
        let operand: StatementOperand = vec_get<StatementOperand>(operands, index);
        if (statement_operand_kind(operand) == operand_kind) {
            if (seen == ordinal) { return index; }
            seen = checked_add(seen, 1);
        }
        offset = checked_add(offset, 1);
    }
    return -1;
}

fn source_ownership_find_binding(
    borrow source: Buffer,
    borrow starts: Vec<i64>,
    borrow lengths: Vec<i64>,
    start: i64,
    length: i64
) -> i64
{
    return hir_find_binding_id(source, starts, lengths, start, length);
}

fn source_ownership_binding_index(
    borrow source: Buffer,
    borrow statement: StatementRecord,
    borrow operands: Vec<StatementOperand>,
    borrow starts: Vec<i64>,
    borrow lengths: Vec<i64>
) -> i64
{
    let operand_index: i64 = source_ownership_operand(statement, operands, 1, 0);
    if (operand_index < 0) { return -1; }
    let operand: StatementOperand = vec_get<StatementOperand>(operands, operand_index);
    return source_ownership_find_binding(
        source, starts, lengths,
        statement_operand_start(operand), statement_operand_length(operand)
    );
}

fn source_ownership_collect_bindings(
    borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>,
    borrow_mut starts: Vec<i64>,
    borrow_mut lengths: Vec<i64>,
    borrow metadata: Vec<MirOwnershipBinding>
) -> i32
requires_caps [allocate]
{
    var index: i64 = 0;
    while (index < vec_len<StatementRecord>(statements)) {
        let statement: StatementRecord = vec_get<StatementRecord>(statements, index);
        let kind: i32 = statement_record_kind(statement);
        if (kind == 20) {
            let operand_index: i64 = source_ownership_operand(statement, operands, 1, 0);
            if (operand_index < 0) { return 1; }
            let operand: StatementOperand = vec_get<StatementOperand>(operands, operand_index);
            vec_push<i64>(starts, statement_operand_start(operand));
            vec_push<i64>(lengths, statement_operand_length(operand));
        }
        if (kind == 21) {
            let operand_index: i64 = source_ownership_operand(statement, operands, 1, 0);
            if (operand_index < 0) { return 1; }
            let operand: StatementOperand = vec_get<StatementOperand>(operands, operand_index);
            vec_push<i64>(starts, statement_operand_start(operand));
            vec_push<i64>(lengths, statement_operand_length(operand));
        }
        index = checked_add(index, 1);
    }
    if (vec_len<i64>(starts) != vec_len<MirOwnershipBinding>(metadata)) { return 2; }
    var binding: i64 = 0;
    while (binding < vec_len<MirOwnershipBinding>(metadata)) {
        let semantic: MirOwnershipBinding = vec_get<MirOwnershipBinding>(metadata, binding);
        if (ownership_binding_id(semantic) != binding) { return 3; }
        if (ownership_binding_local_id(semantic) != binding) { return 4; }
        binding = checked_add(binding, 1);
    }
    return 0;
}

// counters[0] is the next temporary local. The ownership stage later assigns
// final dense instruction IDs, so ordinary placement IDs here are placeholders.
// direct_binding[0] is set only when the expression root is an identifier with
// optional grouping aliases.
fn source_ownership_expression(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow binding_starts: Vec<i64>,
    borrow binding_lengths: Vec<i64>,
    expression_start: i64,
    expression_length: i64,
    allocator: Allocator,
    borrow_mut counters: Vec<i64>,
    borrow_mut direct_binding: Vec<i64>,
    borrow_mut events: Vec<MirOwnershipEvent>
) -> i64
requires_caps [allocate]
{
    let expressions: Vec<ExpressionNode> = parse_expression_span(
        source, tokens, expression_start, expression_length, allocator
    );
    let ast_nodes: Vec<AstNodeRecord> = lower_expression_ast_records(expressions, allocator);
    let count: i64 = vec_len<AstNodeRecord>(ast_nodes);
    var hir_nodes: Vec<HirExpressionRecord> = vec_new<HirExpressionRecord>(allocator, count);

    var ast_index: i64 = 0;
    while (ast_index < count) {
        let ast: AstNodeRecord = vec_get<AstNodeRecord>(ast_nodes, ast_index);
        var binding_id: i64 = -1;
        if (ast_kind(ast) == 30) {
            binding_id = source_ownership_find_binding(
                source, binding_starts, binding_lengths, ast_start(ast), ast_length(ast)
            );
        }
        let hir: HirExpressionRecord = lower_resolved_hir_record(
            ast_kind(ast), ast_start(ast), ast_length(ast), ast_left(ast), ast_right(ast),
            ast_group_start(ast), ast_group_length(ast), ast_group_parent(ast), binding_id, 1
        );
        vec_push<HirExpressionRecord>(hir_nodes, hir);
        ast_index = checked_add(ast_index, 1);
    }

    var local_ids: Vec<i64> = vec_new<i64>(allocator, count);
    var initialize: i64 = 0;
    while (initialize < count) {
        vec_push<i64>(local_ids, -1);
        initialize = checked_add(initialize, 1);
    }

    // One owner and one cleanup site for the traversal stack. Structural errors
    // are carried in status rather than consuming stack on conditional returns.
    var stack: Vec<i64> = vec_new<i64>(allocator, checked_add(count, 1));
    var status: i64 = 0;
    if (count > 0) { vec_push<i64>(stack, checked_sub(count, 1)); }
    while (vec_len<i64>(stack) > 0) {
        let current_index: i64 = vec_pop<i64>(stack);
        if (status == 0) {
            let hir: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, current_index);
            let kind: i32 = hir_kind(hir);
            if (kind == 3) {
                let child: i64 = hir_left(hir);
                if (child < 0) { status = -2; }
                else { vec_push<i64>(stack, child); }
            } else {
                if (kind == 4) {
                    if (hir_binding_id(hir) < 0) { status = -3; }
                    else { vec_set<i64>(local_ids, current_index, hir_binding_id(hir)); }
                } else {
                    if (kind == 1) {
                        let next_local: i64 = vec_get<i64>(counters, 0);
                        vec_set<i64>(local_ids, current_index, next_local);
                        vec_set<i64>(counters, 0, checked_add(next_local, 1));
                    } else {
                        if (kind == 2) {
                            let next_local: i64 = vec_get<i64>(counters, 0);
                            vec_set<i64>(local_ids, current_index, next_local);
                            vec_set<i64>(counters, 0, checked_add(next_local, 1));
                            vec_push<i64>(stack, hir_right(hir));
                            vec_push<i64>(stack, hir_left(hir));
                        } else {
                            if (kind == 5) {
                                let next_local: i64 = vec_get<i64>(counters, 0);
                                vec_set<i64>(local_ids, current_index, next_local);
                                vec_set<i64>(counters, 0, checked_add(next_local, 1));
                                vec_push<i64>(stack, hir_right(hir));
                                vec_push<i64>(stack, hir_left(hir));
                            } else { status = -4; }
                        }
                    }
                }
            }
        }
    }
    drop(stack);

    if (status == 0) {
        var alias_index: i64 = 0;
        while (alias_index < count) {
            let alias: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, alias_index);
            if (hir_kind(alias) == 3) {
                let child: i64 = hir_left(alias);
                vec_set<i64>(local_ids, alias_index, vec_get<i64>(local_ids, child));
            }
            alias_index = checked_add(alias_index, 1);
        }

        var hir_index: i64 = 0;
        while (hir_index < count) {
            let hir: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, hir_index);
            let kind: i32 = hir_kind(hir);
            if (kind == 1) { vec_push<MirOwnershipEvent>(events, ownership_event_place(hir_index)); }
            if (kind == 2) { vec_push<MirOwnershipEvent>(events, ownership_event_place(hir_index)); }
            if (kind == 5) { vec_push<MirOwnershipEvent>(events, ownership_event_place(hir_index)); }
            hir_index = checked_add(hir_index, 1);
        }
    }

    var result_local: i64 = status;
    var root_binding: i64 = -1;
    if (status == 0) {
        if (count == 0) { result_local = -5; }
        else {
            let root_index: i64 = checked_sub(count, 1);
            result_local = vec_get<i64>(local_ids, root_index);
            var root: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, root_index);
            var root_kind: i32 = hir_kind(root);
            while (root_kind == 3) {
                root = vec_get<HirExpressionRecord>(hir_nodes, hir_left(root));
                root_kind = hir_kind(root);
            }
            if (root_kind == 4) { root_binding = hir_binding_id(root); }
        }
    }
    vec_set<i64>(direct_binding, 0, root_binding);
    drop(local_ids);
    drop(hir_nodes);
    drop(ast_nodes);
    drop(expressions);
    return result_local;
}

fn source_ownership_initialize_binding(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow statement: StatementRecord,
    borrow operands: Vec<StatementOperand>,
    borrow metadata: Vec<MirOwnershipBinding>,
    borrow binding_starts: Vec<i64>,
    borrow binding_lengths: Vec<i64>,
    allocator: Allocator,
    expected_mutable: i32,
    borrow_mut counters: Vec<i64>,
    borrow_mut direct_binding: Vec<i64>,
    borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    let destination: i64 = source_ownership_binding_index(
        source, statement, operands, binding_starts, binding_lengths
    );
    if (destination < 0) { return 10; }
    let semantic: MirOwnershipBinding = vec_get<MirOwnershipBinding>(metadata, destination);
    if (ownership_binding_mutable(semantic) != expected_mutable) { return 11; }
    let expression_index: i64 = source_ownership_operand(statement, operands, 3, 0);
    if (expression_index < 0) { return 12; }
    let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
    let result_local: i64 = source_ownership_expression(
        source, tokens, binding_starts, binding_lengths,
        statement_operand_start(expression), statement_operand_length(expression),
        allocator, counters, direct_binding, events
    );
    if (result_local < 0) { return 13; }
    let source_binding: i64 = vec_get<i64>(direct_binding, 0);
    if (ownership_binding_owned(semantic) != 0) {
        if (source_binding >= 0) {
            let source_semantic: MirOwnershipBinding = vec_get<MirOwnershipBinding>(metadata, source_binding);
            if (ownership_binding_owned(source_semantic) == 0) { return 14; }
            vec_push<MirOwnershipEvent>(events, ownership_event_move(source_binding, destination));
        } else {
            vec_push<MirOwnershipEvent>(events, ownership_event_place(0));
            vec_push<MirOwnershipEvent>(events, ownership_event_activate(destination));
        }
    } else {
        vec_push<MirOwnershipEvent>(events, ownership_event_place(0));
    }
    return 0;
}

fn source_ownership_expression_statement(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow statement: StatementRecord,
    borrow operands: Vec<StatementOperand>,
    borrow binding_starts: Vec<i64>,
    borrow binding_lengths: Vec<i64>,
    allocator: Allocator,
    borrow_mut counters: Vec<i64>,
    borrow_mut direct_binding: Vec<i64>,
    borrow_mut events: Vec<MirOwnershipEvent>
) -> i64
requires_caps [allocate]
{
    let expression_index: i64 = source_ownership_operand(statement, operands, 3, 0);
    if (expression_index < 0) { return -10; }
    let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
    return source_ownership_expression(
        source, tokens, binding_starts, binding_lengths,
        statement_operand_start(expression), statement_operand_length(expression),
        allocator, counters, direct_binding, events
    );
}

fn source_ownership_emit_statement(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow statement: StatementRecord,
    borrow operands: Vec<StatementOperand>,
    borrow metadata: Vec<MirOwnershipBinding>,
    allocator: Allocator,
    borrow binding_starts: Vec<i64>,
    borrow binding_lengths: Vec<i64>,
    borrow_mut frames: Vec<SourceOwnershipFrame>,
    borrow_mut counters: Vec<i64>,
    borrow_mut direct_binding: Vec<i64>,
    borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    let kind: i32 = statement_record_kind(statement);
    if (kind == 20) {
        return source_ownership_initialize_binding(
            source, tokens, statement, operands, metadata, binding_starts, binding_lengths,
            allocator, 0, counters, direct_binding, events
        );
    }
    if (kind == 21) {
        return source_ownership_initialize_binding(
            source, tokens, statement, operands, metadata, binding_starts, binding_lengths,
            allocator, 1, counters, direct_binding, events
        );
    }
    if (kind == 22) {
        let result: i64 = source_ownership_expression_statement(
            source, tokens, statement, operands, binding_starts, binding_lengths,
            allocator, counters, direct_binding, events
        );
        if (result < 0) { return 20; }
        vec_push<MirOwnershipEvent>(events, ownership_event_return(result));
        return 0;
    }
    if (kind == 24) {
        let result: i64 = source_ownership_expression_statement(
            source, tokens, statement, operands, binding_starts, binding_lengths,
            allocator, counters, direct_binding, events
        );
        if (result < 0) { return 21; }
        let binding: i64 = vec_get<i64>(direct_binding, 0);
        if (binding < 0) { return 22; }
        vec_push<MirOwnershipEvent>(events, ownership_event_drop(binding));
        return 0;
    }
    if (kind == 25) {
        let condition: i64 = source_ownership_expression_statement(
            source, tokens, statement, operands, binding_starts, binding_lengths,
            allocator, counters, direct_binding, events
        );
        if (condition < 0) { return 23; }
        vec_push<MirOwnershipEvent>(events, ownership_event_if(condition));
        vec_push<SourceOwnershipFrame>(frames, SourceOwnershipFrame {
            kind: 10,
            open_end: checked_add(statement_record_start(statement), statement_record_length(statement)),
            body_depth: -1,
            state: 0
        });
        return 0;
    }
    if (kind == 26) {
        let condition: i64 = source_ownership_expression_statement(
            source, tokens, statement, operands, binding_starts, binding_lengths,
            allocator, counters, direct_binding, events
        );
        if (condition < 0) { return 24; }
        vec_push<MirOwnershipEvent>(events, ownership_event_while(condition));
        vec_push<SourceOwnershipFrame>(frames, SourceOwnershipFrame {
            kind: 20,
            open_end: checked_add(statement_record_start(statement), statement_record_length(statement)),
            body_depth: -1,
            state: 0
        });
        return 0;
    }
    if (kind == 29) {
        let target_index: i64 = source_ownership_operand(statement, operands, 3, 0);
        let replacement_index: i64 = source_ownership_operand(statement, operands, 3, 1);
        if (target_index < 0) { return 25; }
        if (replacement_index < 0) { return 26; }
        let target_operand: StatementOperand = vec_get<StatementOperand>(operands, target_index);
        let target_local: i64 = source_ownership_expression(
            source, tokens, binding_starts, binding_lengths,
            statement_operand_start(target_operand), statement_operand_length(target_operand),
            allocator, counters, direct_binding, events
        );
        if (target_local < 0) { return 27; }
        let target_binding: i64 = vec_get<i64>(direct_binding, 0);
        if (target_binding < 0) { return 28; }
        let replacement_operand: StatementOperand = vec_get<StatementOperand>(operands, replacement_index);
        let replacement_local: i64 = source_ownership_expression(
            source, tokens, binding_starts, binding_lengths,
            statement_operand_start(replacement_operand), statement_operand_length(replacement_operand),
            allocator, counters, direct_binding, events
        );
        if (replacement_local < 0) { return 29; }
        let replacement_binding: i64 = vec_get<i64>(direct_binding, 0);
        if (replacement_binding >= 0) {
            let replacement_semantic: MirOwnershipBinding = vec_get<MirOwnershipBinding>(metadata, replacement_binding);
            if (ownership_binding_owned(replacement_semantic) == 0) { return 30; }
            vec_push<MirOwnershipEvent>(events, ownership_event_replace_binding(target_binding, replacement_binding));
        } else {
            vec_push<MirOwnershipEvent>(events, ownership_event_replace(target_binding, replacement_local));
        }
        return 0;
    }
    return checked_add(100, kind);
}

fn source_ownership_statement_worker(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>,
    borrow metadata: Vec<MirOwnershipBinding>,
    allocator: Allocator,
    borrow binding_starts: Vec<i64>,
    borrow binding_lengths: Vec<i64>,
    borrow_mut frames: Vec<SourceOwnershipFrame>,
    borrow_mut counters: Vec<i64>,
    borrow_mut direct_binding: Vec<i64>,
    borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    var statement_index: i64 = 0;
    var token_index: i64 = 0;
    var brace_depth: i64 = 0;
    while (token_index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, token_index);
        if (statement_index < vec_len<StatementRecord>(statements)) {
            let statement: StatementRecord = vec_get<StatementRecord>(statements, statement_index);
            if (token_start(token) == statement_record_start(statement)) {
                let status: i32 = source_ownership_emit_statement(
                    source, tokens, statement, operands, metadata, allocator,
                    binding_starts, binding_lengths, frames, counters, direct_binding, events
                );
                if (status != 0) { return status; }
                statement_index = checked_add(statement_index, 1);
            }
        }

        if (source_ownership_punctuation(source, token, 123)) {
            brace_depth = checked_add(brace_depth, 1);
            if (vec_len<SourceOwnershipFrame>(frames) > 0) {
                let frame_index: i64 = checked_sub(vec_len<SourceOwnershipFrame>(frames), 1);
                let frame: SourceOwnershipFrame = vec_get<SourceOwnershipFrame>(frames, frame_index);
                if (frame.state == 0) {
                    if (source_ownership_token_end(token) == frame.open_end) {
                        vec_set<SourceOwnershipFrame>(frames, frame_index, SourceOwnershipFrame {
                            kind: frame.kind, open_end: frame.open_end, body_depth: brace_depth, state: 1
                        });
                    }
                } else {
                    if (frame.state == 2) {
                        vec_set<SourceOwnershipFrame>(frames, frame_index, SourceOwnershipFrame {
                            kind: frame.kind, open_end: frame.open_end, body_depth: brace_depth, state: 1
                        });
                    }
                }
            }
        }

        if (source_ownership_punctuation(source, token, 125)) {
            if (vec_len<SourceOwnershipFrame>(frames) > 0) {
                let frame_index: i64 = checked_sub(vec_len<SourceOwnershipFrame>(frames), 1);
                let frame: SourceOwnershipFrame = vec_get<SourceOwnershipFrame>(frames, frame_index);
                if (frame.state == 1) {
                    if (frame.body_depth == brace_depth) {
                        var has_else: i32 = 0;
                        let next_token_index: i64 = checked_add(token_index, 1);
                        if (frame.kind == 10) {
                            if (next_token_index < vec_len<Token>(tokens)) {
                                let next_token: Token = vec_get<Token>(tokens, next_token_index);
                                has_else = source_ownership_else(source, next_token);
                            }
                        }
                        if (has_else != 0) {
                            vec_push<MirOwnershipEvent>(events, ownership_event_else());
                            vec_set<SourceOwnershipFrame>(frames, frame_index, SourceOwnershipFrame {
                                kind: frame.kind, open_end: frame.open_end, body_depth: -1, state: 2
                            });
                        } else {
                            let closed: SourceOwnershipFrame = vec_pop<SourceOwnershipFrame>(frames);
                            if (closed.kind == 10) {
                                vec_push<MirOwnershipEvent>(events, ownership_event_end_if());
                            } else {
                                if (closed.kind == 20) {
                                    vec_push<MirOwnershipEvent>(events, ownership_event_end_while());
                                } else { return 40; }
                            }
                        }
                    }
                }
            }
            if (brace_depth > 0) { brace_depth = checked_sub(brace_depth, 1); }
        }
        token_index = checked_add(token_index, 1);
    }
    if (statement_index != vec_len<StatementRecord>(statements)) { return 41; }
    if (vec_len<SourceOwnershipFrame>(frames) != 0) { return 42; }
    return 0;
}

pub fn lower_source_ownership_events(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>,
    borrow metadata: Vec<MirOwnershipBinding>,
    allocator: Allocator,
    borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    if (vec_len<StatementRecord>(statements) == 0) { return 1; }
    var starts: Vec<i64> = vec_new<i64>(allocator, 8);
    var lengths: Vec<i64> = vec_new<i64>(allocator, 8);
    let binding_status: i32 = source_ownership_collect_bindings(
        statements, operands, starts, lengths, metadata
    );
    var frames: Vec<SourceOwnershipFrame> = vec_new<SourceOwnershipFrame>(allocator, 8);
    var counters: Vec<i64> = vec_new<i64>(allocator, 1);
    vec_push<i64>(counters, vec_len<i64>(starts));
    var direct_binding: Vec<i64> = vec_new<i64>(allocator, 1);
    vec_push<i64>(direct_binding, -1);

    var status: i32 = binding_status;
    if (status == 0) {
        status = source_ownership_statement_worker(
            source, tokens, statements, operands, metadata, allocator,
            starts, lengths, frames, counters, direct_binding, events
        );
    }

    drop(direct_binding);
    drop(counters);
    drop(frames);
    drop(lengths);
    drop(starts);
    return status;
}