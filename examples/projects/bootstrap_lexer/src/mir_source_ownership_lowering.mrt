module bootstrap_mir_source_ownership_lowering
import bootstrap_tokens;
import bootstrap_statements;
import bootstrap_statement_semantics;
import bootstrap_mir_match_capability_flow;
import bootstrap_mir_ownership_flow;
import bootstrap_mir_source_ownership_control;

capability allocate;

// Stable public facade for source -> ownership/effect lowering. The control
// implementation owns structured source traversal; mir_ownership_flow remains
// the single owner of path-sensitive lifecycle state.
pub fn lower_source_ownership_events(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>,
    borrow metadata: Vec<MirOwnershipBinding>,
    allocator: Allocator,
    borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    return source_lower_legacy(
        source, tokens, statements, operands, metadata, allocator, events
    );
}

pub fn lower_resolved_source_ownership_events(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>,
    borrow metadata: Vec<MirOwnershipBinding>,
    borrow arms: Vec<ResolvedMatchArm>,
    borrow scopes: Vec<ResolvedCapabilityScope>,
    allocator: Allocator,
    borrow_mut events: Vec<MirOwnershipEvent>,
    borrow_mut effects: Vec<MirCapabilityEffect>
) -> i32
requires_caps [allocate]
{
    return source_lower_resolved(
        source, tokens, statements, operands, metadata,
        arms, scopes, allocator, events, effects
    );
}
