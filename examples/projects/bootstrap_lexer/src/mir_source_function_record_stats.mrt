module bootstrap_mir_source_function_record_stats
import bootstrap_mir_functions;

capability allocate;

pub fn source_function_stats_empty_records_status()->i32{return 1;}
pub fn source_function_stats_missing_header_status()->i32{return 2;}
pub fn source_function_stats_local_order_status()->i32{return 10;}
pub fn source_function_stats_temporary_order_status()->i32{return 11;}
pub fn source_function_stats_instruction_order_status()->i32{return 12;}
pub fn source_function_stats_unknown_instruction_status()->i32{return 13;}
pub fn source_function_stats_invalid_record_kind_status()->i32{return 14;}

// stats: binding_count, body_local_count, body_instruction_count, return_count.
pub fn source_function_record_stats(
    borrow records: Vec<MirFunctionRecord>,
    borrow_mut stats: Vec<i64>
) -> i32
requires_caps [allocate]
{
    if (vec_len<MirFunctionRecord>(records) == 0) { return source_function_stats_empty_records_status(); }
    let header: MirFunctionRecord = vec_get<MirFunctionRecord>(records, 0);
    if (function_mir_kind(header) != function_mir_kind_function()) { return source_function_stats_missing_header_status(); }
    var bindings: i64 = 0;
    var locals: i64 = 0;
    var instructions: i64 = 0;
    var returns: i64 = 0;
    var index: i64 = 1;
    while (index < vec_len<MirFunctionRecord>(records)) {
        let record: MirFunctionRecord = vec_get<MirFunctionRecord>(records, index);
        let kind: i32 = function_mir_kind(record);
        if (kind == 2) {
            if (function_mir_id(record) != locals) { return source_function_stats_local_order_status(); }
            bindings = checked_add(bindings, 1);
            locals = checked_add(locals, 1);
        } else {
            if (kind == function_mir_kind_parameter()) {
                if (function_mir_id(record) != locals) { return source_function_stats_local_order_status(); }
                bindings = checked_add(bindings, 1);
                locals = checked_add(locals, 1);
            } else {
            if (kind == 3) {
                if (function_mir_id(record) != locals) { return source_function_stats_temporary_order_status(); }
                locals = checked_add(locals, 1);
            } else {
                if (kind >= 4) {
                    if (kind <= 6) {
                        if (function_mir_id(record) != instructions) { return source_function_stats_instruction_order_status(); }
                        instructions = checked_add(instructions, 1);
                    } else {
                        if (kind == 7) { returns = checked_add(returns, 1); }
                        else {
                            if (kind == 8) {
                                if (function_mir_id(record) != instructions) { return source_function_stats_instruction_order_status(); }
                                instructions = checked_add(instructions, 1);
                            } else {
                                if (function_mir_is_enum_instruction(record) != 0) {
                                    if (function_mir_id(record) != instructions) { return source_function_stats_instruction_order_status(); }
                                    instructions = checked_add(instructions, 1);
                                } else {
                                    if (function_mir_is_struct_construct(record) != 0) {
                                        if (function_mir_id(record) != instructions) { return source_function_stats_instruction_order_status(); }
                                        instructions = checked_add(instructions, 1);
                                    } else {
                                        if (function_mir_is_struct_field_instruction(record) != 0) {
                                            if (function_mir_id(record) != instructions) { return source_function_stats_instruction_order_status(); }
                                            instructions = checked_add(instructions, 1);
                                        } else {
                                            if (kind == function_mir_kind_call()) {
                                                if (function_mir_id(record) != instructions) { return source_function_stats_instruction_order_status(); }
                                                instructions = checked_add(instructions, 1);
                                            } else {
                                                if (kind != function_mir_kind_call_argument()) { return source_function_stats_unknown_instruction_status(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                } else { return source_function_stats_invalid_record_kind_status(); }
            }
            }
        }
        index = checked_add(index, 1);
    }
    vec_push<i64>(stats, bindings);
    vec_push<i64>(stats, locals);
    vec_push<i64>(stats, instructions);
    vec_push<i64>(stats, returns);
    return 0;
}
