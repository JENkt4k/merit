module bootstrap_mir_source_ownership_control
import bootstrap_tokens;
import bootstrap_statements;
import bootstrap_statement_semantics;
import bootstrap_mir_match_capability_flow;
import bootstrap_mir_ownership_flow;
import bootstrap_mir_source_ownership_expression;

capability allocate;

fn source_control_expression_failure_status(status: i64) -> i32 {
    if (status == -1) { return 61; }
    if (status == -2) { return 62; }
    if (status == -3) { return 63; }
    if (status == -4) { return 64; }
    if (status == -5) { return 65; }
    return 66;
}

struct SourceOwnershipFrame { kind: i32; open_end: i64; body_depth: i64; state: i32; }

fn source_control_token_end(borrow token: Token) -> i64 { return checked_add(token_start(token), token_length(token)); }
fn source_control_punctuation(borrow source: Buffer, borrow token: Token, byte: i64) -> i32 {
    if (token_kind(token) != 4) { return 0; }
    if (token_length(token) != 1) { return 0; }
    if (buffer_get(source, token_start(token)) != byte) { return 0; }
    return 1;
}
fn source_control_is_else(borrow source: Buffer, token: Token) -> i32 {
    if (token_kind(token) != 1) { return 0; }
    if (token_length(token) != 4) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != 101) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != 108) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != 115) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != 101) { return 0; }
    return 1;
}

fn source_control_expression_statement(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow statement: StatementRecord,
    borrow operands: Vec<StatementOperand>, borrow starts: Vec<i64>, borrow lengths: Vec<i64>,
    allocator: Allocator, borrow_mut counters: Vec<i64>, borrow_mut direct: Vec<i64>,
    borrow_mut events: Vec<MirOwnershipEvent>
) -> i64
requires_caps [allocate]
{
    let index: i64 = source_ownership_operand(statement, operands, 3, 0);
    if (index < 0) { return -10; }
    let operand: StatementOperand = vec_get<StatementOperand>(operands, index);
    return source_expression(
        source, tokens, starts, lengths,
        statement_operand_start(operand), statement_operand_length(operand),
        allocator, counters, direct, events
    );
}

fn source_control_initialize_binding(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow statement: StatementRecord,
    borrow operands: Vec<StatementOperand>, borrow metadata: Vec<MirOwnershipBinding>,
    borrow starts: Vec<i64>, borrow lengths: Vec<i64>, allocator: Allocator,
    expected_mutable: i32, borrow_mut counters: Vec<i64>, borrow_mut direct: Vec<i64>,
    borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    let destination: i64 = source_binding_index(source, statement, operands, starts, lengths);
    if (destination < 0) { return 10; }
    let semantic: MirOwnershipBinding = vec_get<MirOwnershipBinding>(metadata, destination);
    if (ownership_binding_mutable(semantic) != expected_mutable) { return 11; }
    let expression_index: i64 = source_ownership_operand(statement, operands, 3, 0);
    if (expression_index < 0) { return 12; }
    let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
    let result_local: i64 = source_expression(
        source, tokens, starts, lengths,
        statement_operand_start(expression), statement_operand_length(expression),
        allocator, counters, direct, events
    );
    if (result_local < 0) { return source_control_expression_failure_status(result_local); }
    let source_binding: i64 = vec_get<i64>(direct, 0);
    if (ownership_binding_owned(semantic) != 0) {
        if (source_binding >= 0) {
            let source_semantic: MirOwnershipBinding = vec_get<MirOwnershipBinding>(metadata, source_binding);
            if (ownership_binding_owned(source_semantic) == 0) { return 14; }
            vec_push<MirOwnershipEvent>(events, ownership_event_move(source_binding, destination));
        } else {
            vec_push<MirOwnershipEvent>(events, ownership_event_place(0));
            vec_push<MirOwnershipEvent>(events, ownership_event_activate(destination));
        }
    } else { vec_push<MirOwnershipEvent>(events, ownership_event_place(0)); }
    return 0;
}

fn source_control_match_count(borrow arms: Vec<ResolvedMatchArm>, statement_index: i64) -> i64 {
    var count: i64 = 0;
    var index: i64 = 0;
    while (index < vec_len<ResolvedMatchArm>(arms)) {
        let arm: ResolvedMatchArm = vec_get<ResolvedMatchArm>(arms, index);
        if (resolved_match_statement(arm) == statement_index) { count = checked_add(count, 1); }
        index = checked_add(index, 1);
    }
    return count;
}
fn source_control_scope_exists(borrow scopes: Vec<ResolvedCapabilityScope>, statement_index: i64) -> i32 {
    var index: i64 = 0;
    while (index < vec_len<ResolvedCapabilityScope>(scopes)) {
        let scope: ResolvedCapabilityScope = vec_get<ResolvedCapabilityScope>(scopes, index);
        if (resolved_capability_statement(scope) == statement_index) { return 1; }
        index = checked_add(index, 1);
    }
    return 0;
}

fn source_control_emit_match_boundary(
    borrow source: Buffer, borrow token: Token, borrow arms: Vec<ResolvedMatchArm>,
    borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    let opening: i32 = source_control_punctuation(source, token, 123);
    let closing: i32 = source_control_punctuation(source, token, 125);
    if (opening == 0) { if (closing == 0) { return 0; } }
    var index: i64 = 0;
    while (index < vec_len<ResolvedMatchArm>(arms)) {
        let arm: ResolvedMatchArm = vec_get<ResolvedMatchArm>(arms, index);
        if (opening != 0) {
            if (source_control_token_end(token) == resolved_match_body_start(arm)) {
                vec_push<MirOwnershipEvent>(events, ownership_event_case(
                    resolved_match_variant_ordinal(arm), resolved_match_ordinal(arm)
                ));
            }
        }
        if (closing != 0) {
            if (token_start(token) == checked_add(
                resolved_match_body_start(arm), resolved_match_body_length(arm)
            )) {
                let count: i64 = source_control_match_count(arms, resolved_match_statement(arm));
                if (count <= 0) { return 50; }
                if (resolved_match_ordinal(arm) == checked_sub(count, 1)) {
                    vec_push<MirOwnershipEvent>(events, ownership_event_end_match());
                }
            }
        }
        index = checked_add(index, 1);
    }
    return 0;
}

fn source_control_emit_statement(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow statement: StatementRecord,
    statement_index: i64, borrow operands: Vec<StatementOperand>,
    borrow metadata: Vec<MirOwnershipBinding>, borrow arms: Vec<ResolvedMatchArm>,
    borrow scopes: Vec<ResolvedCapabilityScope>, allocator: Allocator,
    borrow starts: Vec<i64>, borrow lengths: Vec<i64>, borrow_mut frames: Vec<SourceOwnershipFrame>,
    borrow_mut counters: Vec<i64>, borrow_mut direct: Vec<i64>, borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    let kind: i32 = statement_record_kind(statement);
    if (kind == 20) { return source_control_initialize_binding(source,tokens,statement,operands,metadata,starts,lengths,allocator,0,counters,direct,events); }
    if (kind == 21) { return source_control_initialize_binding(source,tokens,statement,operands,metadata,starts,lengths,allocator,1,counters,direct,events); }
    if (kind == 22) {
        let result: i64 = source_control_expression_statement(source,tokens,statement,operands,starts,lengths,allocator,counters,direct,events);
        if (result < 0) { return 20; }
        vec_push<MirOwnershipEvent>(events, ownership_event_return(result)); return 0;
    }
    if (kind == 23) {
        let result: i64 = source_control_expression_statement(source,tokens,statement,operands,starts,lengths,allocator,counters,direct,events);
        if (result < 0) { return 44; }
        vec_push<MirOwnershipEvent>(events, ownership_event_print(result)); return 0;
    }
    if (kind == 24) {
        let result: i64 = source_control_expression_statement(source,tokens,statement,operands,starts,lengths,allocator,counters,direct,events);
        if (result < 0) { return 21; }
        let binding: i64 = vec_get<i64>(direct, 0); if (binding < 0) { return 22; }
        vec_push<MirOwnershipEvent>(events, ownership_event_drop(binding)); return 0;
    }
    if (kind == 25) {
        let condition: i64 = source_control_expression_statement(source,tokens,statement,operands,starts,lengths,allocator,counters,direct,events);
        if (condition < 0) { return 23; }
        vec_push<MirOwnershipEvent>(events, ownership_event_if(condition));
        vec_push<SourceOwnershipFrame>(frames, SourceOwnershipFrame { kind:10, open_end:checked_add(statement_record_start(statement),statement_record_length(statement)), body_depth:-1, state:0 });
        return 0;
    }
    if (kind == 26) {
        vec_push<MirOwnershipEvent>(events, ownership_event_begin_while());
        let condition: i64 = source_control_expression_statement(source,tokens,statement,operands,starts,lengths,allocator,counters,direct,events);
        if (condition < 0) { return 24; }
        vec_push<MirOwnershipEvent>(events, ownership_event_while(condition));
        vec_push<SourceOwnershipFrame>(frames, SourceOwnershipFrame { kind:20, open_end:checked_add(statement_record_start(statement),statement_record_length(statement)), body_depth:-1, state:0 });
        return 0;
    }
    if (kind == 27) {
        let count: i64 = source_control_match_count(arms, statement_index); if (count <= 0) { return 127; }
        let value_local: i64 = source_control_expression_statement(source,tokens,statement,operands,starts,lengths,allocator,counters,direct,events);
        if (value_local < 0) { return 32; }
        var match_local: i64 = value_local;
        var has_payload: i32 = 0;
        var arm_index: i64 = 0;
        while (arm_index < vec_len<ResolvedMatchArm>(arms)) {
            let arm: ResolvedMatchArm = vec_get<ResolvedMatchArm>(arms, arm_index);
            if (resolved_match_statement(arm) == statement_index) {
                if (resolved_match_binding_start(arm) >= 0) { has_payload = 1; }
            }
            arm_index = checked_add(arm_index, 1);
        }
        if (has_payload != 0) {
            match_local = vec_get<i64>(counters, 0);
            vec_set<i64>(counters, 0, checked_add(match_local, 1));
            vec_push<MirOwnershipEvent>(events, ownership_event_place(statement_index));
            arm_index = 0;
            while (arm_index < vec_len<ResolvedMatchArm>(arms)) {
                let arm: ResolvedMatchArm = vec_get<ResolvedMatchArm>(arms, arm_index);
                if (resolved_match_statement(arm) == statement_index) {
                    if (resolved_match_binding_start(arm) >= 0) { vec_push<MirOwnershipEvent>(events, ownership_event_place(arm_index)); }
                }
                arm_index = checked_add(arm_index, 1);
            }
        }
        vec_push<MirOwnershipEvent>(events, ownership_event_match(match_local, count)); return 0;
    }
    if (kind == 28) { if (source_control_scope_exists(scopes, statement_index) == 0) { return 128; } return 0; }
    if (kind == 29) {
        let target_index: i64 = source_ownership_operand(statement, operands, 3, 0);
        let replacement_index: i64 = source_ownership_operand(statement, operands, 3, 1);
        if (target_index < 0) { return 25; } if (replacement_index < 0) { return 26; }
        let target_operand: StatementOperand = vec_get<StatementOperand>(operands, target_index);
        let target_local: i64 = source_expression(source,tokens,starts,lengths,statement_operand_start(target_operand),statement_operand_length(target_operand),allocator,counters,direct,events);
        if (target_local < 0) { return 27; }
        let target_binding: i64 = vec_get<i64>(direct, 0); if (target_binding < 0) { return 28; }
        let replacement_operand: StatementOperand = vec_get<StatementOperand>(operands, replacement_index);
        let replacement_local: i64 = source_expression(source,tokens,starts,lengths,statement_operand_start(replacement_operand),statement_operand_length(replacement_operand),allocator,counters,direct,events);
        if (replacement_local < 0) { return 29; }
        let replacement_binding: i64 = vec_get<i64>(direct, 0);
        if (replacement_binding >= 0) {
            if (replacement_binding >= vec_len<MirOwnershipBinding>(metadata)) { return 30; }
            let source_semantic: MirOwnershipBinding = vec_get<MirOwnershipBinding>(metadata, replacement_binding);
            if (ownership_binding_owned(source_semantic) == 0) { return 31; }
            vec_push<MirOwnershipEvent>(events, ownership_event_replace_from_binding(target_binding, replacement_binding));
        } else { vec_push<MirOwnershipEvent>(events, ownership_event_replace(target_binding, replacement_local)); }
        return 0;
    }
    if (kind == 30) {
        let target_index: i64 = source_ownership_operand(statement, operands, 3, 0);
        let value_index: i64 = source_ownership_operand(statement, operands, 3, 1);
        if (target_index < 0) { return 33; }
        if (value_index < 0) { return 34; }
        let target_operand: StatementOperand = vec_get<StatementOperand>(operands, target_index);
        let target_local: i64 = source_expression(
            source, tokens, starts, lengths,
            statement_operand_start(target_operand), statement_operand_length(target_operand),
            allocator, counters, direct, events
        );
        if (target_local < 0) { return 35; }
        let target_binding: i64 = vec_get<i64>(direct, 0);
        if (target_binding < 0) { return 36; }
        let target_semantic: MirOwnershipBinding = vec_get<MirOwnershipBinding>(metadata, target_binding);
        if (ownership_binding_mutable(target_semantic) == 0) { return 37; }
        if (ownership_binding_owned(target_semantic) != 0) { return 38; }
        let value_operand: StatementOperand = vec_get<StatementOperand>(operands, value_index);
        let value_local: i64 = source_expression(
            source, tokens, starts, lengths,
            statement_operand_start(value_operand), statement_operand_length(value_operand),
            allocator, counters, direct, events
        );
        if (value_local < 0) { return 39; }
        vec_push<MirOwnershipEvent>(events, ownership_event_assign(target_binding, value_local));
        return 0;
    }
    if (kind == 31) {
        let result: i64 = source_control_expression_statement(
            source, tokens, statement, operands, starts, lengths,
            allocator, counters, direct, events
        );
        if (result < 0) { return 43; }
        return 0;
    }
    return checked_add(100, kind);
}

fn source_control_worker(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>, borrow metadata: Vec<MirOwnershipBinding>,
    borrow arms: Vec<ResolvedMatchArm>, borrow scopes: Vec<ResolvedCapabilityScope>, allocator: Allocator,
    borrow starts: Vec<i64>, borrow lengths: Vec<i64>, borrow_mut frames: Vec<SourceOwnershipFrame>,
    borrow_mut counters: Vec<i64>, borrow_mut direct: Vec<i64>, borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    var statement_index: i64 = 0; var token_index: i64 = 0; var brace_depth: i64 = 0;
    while (token_index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, token_index);
        if (statement_index < vec_len<StatementRecord>(statements)) {
            let statement: StatementRecord = vec_get<StatementRecord>(statements, statement_index);
            if (token_start(token) == statement_record_start(statement)) {
                let status: i32 = source_control_emit_statement(source,tokens,statement,statement_index,operands,metadata,arms,scopes,allocator,starts,lengths,frames,counters,direct,events);
                if (status != 0) { return status; }
                statement_index = checked_add(statement_index, 1);
            }
        }
        let boundary_status: i32 = source_control_emit_match_boundary(source, token, arms, events);
        if (boundary_status != 0) { return boundary_status; }
        if (source_control_punctuation(source, token, 123)) {
            brace_depth = checked_add(brace_depth, 1);
            if (vec_len<SourceOwnershipFrame>(frames) > 0) {
                let frame_index: i64 = checked_sub(vec_len<SourceOwnershipFrame>(frames), 1);
                let frame: SourceOwnershipFrame = vec_get<SourceOwnershipFrame>(frames, frame_index);
                if (frame.state == 0) {
                    if (source_control_token_end(token) == frame.open_end) { vec_set<SourceOwnershipFrame>(frames, frame_index, SourceOwnershipFrame { kind:frame.kind, open_end:frame.open_end, body_depth:brace_depth, state:1 }); }
                } else {
                    if (frame.state == 2) { vec_set<SourceOwnershipFrame>(frames, frame_index, SourceOwnershipFrame { kind:frame.kind, open_end:frame.open_end, body_depth:brace_depth, state:1 }); }
                }
            }
        }
        if (source_control_punctuation(source, token, 125)) {
            if (vec_len<SourceOwnershipFrame>(frames) > 0) {
                let frame_index: i64 = checked_sub(vec_len<SourceOwnershipFrame>(frames), 1);
                let frame: SourceOwnershipFrame = vec_get<SourceOwnershipFrame>(frames, frame_index);
                if (frame.state == 1) {
                    if (frame.body_depth == brace_depth) {
                        var has_else: i32 = 0; let next_token_index: i64 = checked_add(token_index, 1);
                        if (frame.kind == 10) { if (next_token_index < vec_len<Token>(tokens)) { has_else = source_control_is_else(source, vec_get<Token>(tokens, next_token_index)); } }
                        if (has_else != 0) {
                            vec_push<MirOwnershipEvent>(events, ownership_event_else());
                            vec_set<SourceOwnershipFrame>(frames, frame_index, SourceOwnershipFrame { kind:frame.kind, open_end:frame.open_end, body_depth:-1, state:2 });
                        } else {
                            let closed: SourceOwnershipFrame = vec_pop<SourceOwnershipFrame>(frames);
                            if (closed.kind == 10) { vec_push<MirOwnershipEvent>(events, ownership_event_end_if()); }
                            else { if (closed.kind == 20) { vec_push<MirOwnershipEvent>(events, ownership_event_end_while()); } else { return 40; } }
                        }
                    }
                }
            }
            if (brace_depth > 0) { brace_depth = checked_sub(brace_depth, 1); }
        }
        token_index = checked_add(token_index, 1);
    }
    if (statement_index != vec_len<StatementRecord>(statements)) { return 41; }
    if (vec_len<SourceOwnershipFrame>(frames) != 0) { return 42; }
    return 0;
}

fn source_control_lower_impl(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>, borrow metadata: Vec<MirOwnershipBinding>,
    borrow arms: Vec<ResolvedMatchArm>, borrow scopes: Vec<ResolvedCapabilityScope>,
    allocator: Allocator, borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    if (vec_len<StatementRecord>(statements) == 0) { return 1; }
    var starts: Vec<i64> = vec_new<i64>(allocator, 8); var lengths: Vec<i64> = vec_new<i64>(allocator, 8);
    let binding_status: i32 = source_collect_bindings(statements, operands, starts, lengths, metadata);
    var arm_index: i64 = 0;
    while (arm_index < vec_len<ResolvedMatchArm>(arms)) {
        let arm: ResolvedMatchArm = vec_get<ResolvedMatchArm>(arms, arm_index);
        if (resolved_match_binding_start(arm) >= 0) {
            vec_push<i64>(starts, resolved_match_binding_start(arm));
            vec_push<i64>(lengths, resolved_match_binding_length(arm));
        }
        arm_index = checked_add(arm_index, 1);
    }
    var frames: Vec<SourceOwnershipFrame> = vec_new<SourceOwnershipFrame>(allocator, 8);
    var counters: Vec<i64> = vec_new<i64>(allocator, 1); vec_push<i64>(counters, vec_len<i64>(starts));
    var direct: Vec<i64> = vec_new<i64>(allocator, 1); vec_push<i64>(direct, -1);
    var status: i32 = binding_status;
    if (status == 0) { status = source_control_worker(source,tokens,statements,operands,metadata,arms,scopes,allocator,starts,lengths,frames,counters,direct,events); }
    drop(direct); drop(counters); drop(frames); drop(lengths); drop(starts); return status;
}

pub fn source_lower_legacy(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>, borrow metadata: Vec<MirOwnershipBinding>,
    allocator: Allocator, borrow_mut events: Vec<MirOwnershipEvent>
) -> i32
requires_caps [allocate]
{
    var arms: Vec<ResolvedMatchArm> = vec_new<ResolvedMatchArm>(allocator, 0);
    var scopes: Vec<ResolvedCapabilityScope> = vec_new<ResolvedCapabilityScope>(allocator, 0);
    let status: i32 = source_control_lower_impl(source,tokens,statements,operands,metadata,arms,scopes,allocator,events);
    drop(scopes); drop(arms); return status;
}

pub fn source_lower_resolved(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>, borrow metadata: Vec<MirOwnershipBinding>,
    borrow arms: Vec<ResolvedMatchArm>, borrow scopes: Vec<ResolvedCapabilityScope>,
    allocator: Allocator, borrow_mut events: Vec<MirOwnershipEvent>, borrow_mut effects: Vec<MirCapabilityEffect>
) -> i32
requires_caps [allocate]
{
    let status: i32 = source_control_lower_impl(source,tokens,statements,operands,metadata,arms,scopes,allocator,events);
    if (status != 0) { return status; }
    return lower_capability_effects(scopes, effects);
}
