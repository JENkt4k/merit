module bootstrap_mir_ownership_flow
import bootstrap_mir_structured_lowering;

capability allocate;

// Ownership-aware pre-MIR event contract. This stage sits immediately before
// structured MIR placement. It owns lifecycle state and final instruction IDs;
// the downstream CFG walker only places the already-decided instructions.
//
// Event kinds:
//   1 ordinary instruction          a=provisional instruction id
//   2 activate owned binding        a=binding id
//   3 move binding                  a=source binding, b=destination binding
//   4 explicit drop                 a=binding id
//   5 replace from temporary        a=target binding, b=replacement local
//   6 replace from owned binding    a=target binding, b=source binding
//  10 return                        a=operand local (-1 for unit)
//  20 if                            a=condition local
//  21 else
//  22 end_if
//  30 while                         a=condition local
//  31 end_while
//
// State values: 0 inactive, 1 live, 2 moved, 3 dropped.
pub struct MirOwnershipBinding {
    binding_id: i64;
    local_id: i64;
    owned: i32;
    mutable: i32;
}

pub struct MirOwnershipEvent {
    kind: i32;
    a: i64;
    b: i64;
}

// Record kinds:
//   1 activate, 2 move, 3 explicit drop, 4 replace-old drop,
//   5 replace-new move, 6 implicit cleanup.
// For kind 5, other_binding_id is -1 for a temporary replacement and the
// consumed source binding id for an owned-binding replacement.
pub struct MirOwnershipRecord {
    kind: i32;
    instruction_id: i64;
    binding_id: i64;
    other_binding_id: i64;
    operand_local: i64;
    implicit: i32;
    state_before: i32;
    state_after: i32;
}

struct OwnershipFrame {
    kind: i32;
    entry_start: i64;
    then_start: i64;
    then_terminated: i32;
    seen_else: i32;
}

pub fn ownership_binding(binding_id: i64, local_id: i64, owned: i32, mutable: i32) -> MirOwnershipBinding {
    return MirOwnershipBinding { binding_id: binding_id, local_id: local_id, owned: owned, mutable: mutable };
}
pub fn ownership_binding_id(borrow value: MirOwnershipBinding) -> i64 { return value.binding_id; }
pub fn ownership_binding_local_id(borrow value: MirOwnershipBinding) -> i64 { return value.local_id; }
pub fn ownership_binding_owned(borrow value: MirOwnershipBinding) -> i32 { return value.owned; }
pub fn ownership_binding_mutable(borrow value: MirOwnershipBinding) -> i32 { return value.mutable; }

pub fn ownership_event_place(instruction_id: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 1, a: instruction_id, b: 0 }; }
pub fn ownership_event_activate(binding_id: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 2, a: binding_id, b: 0 }; }
pub fn ownership_event_move(source_binding: i64, destination_binding: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 3, a: source_binding, b: destination_binding }; }
pub fn ownership_event_drop(binding_id: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 4, a: binding_id, b: 0 }; }
pub fn ownership_event_replace(binding_id: i64, replacement_local: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 5, a: binding_id, b: replacement_local }; }
pub fn ownership_event_replace_from_binding(target_binding: i64, source_binding: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 6, a: target_binding, b: source_binding }; }
pub fn ownership_event_return(operand_local: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 10, a: operand_local, b: 0 }; }
pub fn ownership_event_if(condition_local: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 20, a: condition_local, b: 0 }; }
pub fn ownership_event_else() -> MirOwnershipEvent { return MirOwnershipEvent { kind: 21, a: 0, b: 0 }; }
pub fn ownership_event_end_if() -> MirOwnershipEvent { return MirOwnershipEvent { kind: 22, a: 0, b: 0 }; }
pub fn ownership_event_while(condition_local: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 30, a: condition_local, b: 0 }; }
pub fn ownership_event_end_while() -> MirOwnershipEvent { return MirOwnershipEvent { kind: 31, a: 0, b: 0 }; }

pub fn ownership_record_kind(borrow value: MirOwnershipRecord) -> i32 { return value.kind; }
pub fn ownership_record_instruction_id(borrow value: MirOwnershipRecord) -> i64 { return value.instruction_id; }
pub fn ownership_record_binding_id(borrow value: MirOwnershipRecord) -> i64 { return value.binding_id; }
pub fn ownership_record_other_binding_id(borrow value: MirOwnershipRecord) -> i64 { return value.other_binding_id; }
pub fn ownership_record_operand_local(borrow value: MirOwnershipRecord) -> i64 { return value.operand_local; }
pub fn ownership_record_implicit(borrow value: MirOwnershipRecord) -> i32 { return value.implicit; }
pub fn ownership_record_state_before(borrow value: MirOwnershipRecord) -> i32 { return value.state_before; }
pub fn ownership_record_state_after(borrow value: MirOwnershipRecord) -> i32 { return value.state_after; }

fn ownership_find_binding(borrow bindings: Vec<MirOwnershipBinding>, binding_id: i64) -> i64 {
    var index: i64 = 0;
    while (index < vec_len<MirOwnershipBinding>(bindings)) {
        let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, index);
        if (binding.binding_id == binding_id) { return index; }
        index = checked_add(index, 1);
    }
    return -1;
}

fn ownership_validate_bindings(borrow bindings: Vec<MirOwnershipBinding>) -> i32 {
    var index: i64 = 0;
    while (index < vec_len<MirOwnershipBinding>(bindings)) {
        let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, index);
        if (binding.binding_id != index) { return 2; }
        if (binding.local_id < 0) { return 3; }
        if (binding.owned < 0) { return 4; }
        if (binding.owned > 1) { return 4; }
        if (binding.mutable < 0) { return 5; }
        if (binding.mutable > 1) { return 5; }
        index = checked_add(index, 1);
    }
    return 0;
}

fn ownership_snapshot(borrow states: Vec<i32>, borrow_mut snapshots: Vec<i32>) -> i64
requires_caps [allocate]
{
    let start: i64 = vec_len<i32>(snapshots);
    var index: i64 = 0;
    while (index < vec_len<i32>(states)) {
        vec_push<i32>(snapshots, vec_get<i32>(states, index));
        index = checked_add(index, 1);
    }
    return start;
}

fn ownership_restore(borrow_mut states: Vec<i32>, borrow snapshots: Vec<i32>, start: i64) -> i32 {
    var index: i64 = 0;
    while (index < vec_len<i32>(states)) {
        vec_set<i32>(states, index, vec_get<i32>(snapshots, checked_add(start, index)));
        index = checked_add(index, 1);
    }
    return 0;
}

fn ownership_states_equal(borrow states: Vec<i32>, borrow snapshots: Vec<i32>, start: i64) -> i32 {
    var index: i64 = 0;
    while (index < vec_len<i32>(states)) {
        if (vec_get<i32>(states, index) != vec_get<i32>(snapshots, checked_add(start, index))) { return 0; }
        index = checked_add(index, 1);
    }
    return 1;
}

fn ownership_append_record(
    borrow_mut records: Vec<MirOwnershipRecord>, kind: i32, instruction_id: i64,
    binding_id: i64, other_binding_id: i64, operand_local: i64,
    implicit: i32, state_before: i32, state_after: i32
) -> i32
requires_caps [allocate]
{
    vec_push<MirOwnershipRecord>(records, MirOwnershipRecord {
        kind: kind, instruction_id: instruction_id, binding_id: binding_id,
        other_binding_id: other_binding_id, operand_local: operand_local,
        implicit: implicit, state_before: state_before, state_after: state_after
    });
    return 0;
}

fn ownership_emit_place(
    borrow_mut output: Vec<MirLowerEvent>, borrow_mut next_instruction: Vec<i64>
) -> i64
requires_caps [allocate]
{
    let instruction_id: i64 = vec_get<i64>(next_instruction, 0);
    vec_push<MirLowerEvent>(output, mir_event_place(instruction_id));
    vec_set<i64>(next_instruction, 0, checked_add(instruction_id, 1));
    return instruction_id;
}

fn ownership_cleanup_live(
    borrow bindings: Vec<MirOwnershipBinding>, borrow_mut states: Vec<i32>,
    borrow_mut output: Vec<MirLowerEvent>, borrow_mut records: Vec<MirOwnershipRecord>,
    borrow_mut next_instruction: Vec<i64>
) -> i32
requires_caps [allocate]
{
    var cursor: i64 = vec_len<MirOwnershipBinding>(bindings);
    while (cursor > 0) {
        cursor = checked_sub(cursor, 1);
        let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, cursor);
        if (binding.owned != 0) {
            let state: i32 = vec_get<i32>(states, cursor);
            if (state == 1) {
                let instruction_id: i64 = ownership_emit_place(output, next_instruction);
                ownership_append_record(records, 6, instruction_id, binding.binding_id, -1, binding.local_id, 1, 1, 3);
                vec_set<i32>(states, cursor, 3);
            }
        }
    }
    return 0;
}

fn ownership_merge_if(
    borrow bindings: Vec<MirOwnershipBinding>, borrow_mut states: Vec<i32>,
    borrow snapshots: Vec<i32>, borrow frame: OwnershipFrame,
    path_terminated: i32
) -> i32
{
    if (frame.seen_else == 0) {
        if (path_terminated != 0) {
            ownership_restore(states, snapshots, frame.entry_start);
            return 0;
        }
        if (ownership_states_equal(states, snapshots, frame.entry_start) == 0) { return 61; }
        return 0;
    }

    let else_terminated: i32 = path_terminated;
    if (frame.then_terminated != 0) {
        if (else_terminated != 0) {
            ownership_restore(states, snapshots, frame.entry_start);
            return 1;
        }
        return 0;
    }
    if (else_terminated != 0) {
        ownership_restore(states, snapshots, frame.then_start);
        return 0;
    }

    var index: i64 = 0;
    while (index < vec_len<MirOwnershipBinding>(bindings)) {
        if (vec_get<i32>(states, index) != vec_get<i32>(snapshots, checked_add(frame.then_start, index))) { return 62; }
        index = checked_add(index, 1);
    }
    return 0;
}

fn ownership_replace_from_binding(
    borrow event: MirOwnershipEvent,
    borrow bindings: Vec<MirOwnershipBinding>,
    borrow_mut states: Vec<i32>,
    borrow_mut output: Vec<MirLowerEvent>,
    borrow_mut records: Vec<MirOwnershipRecord>,
    borrow_mut next_instruction: Vec<i64>
) -> i32
requires_caps [allocate]
{
    let target_index: i64 = ownership_find_binding(bindings, event.a);
    let source_index: i64 = ownership_find_binding(bindings, event.b);
    if (target_index < 0) { return 66; }
    if (source_index < 0) { return 67; }
    if (target_index == source_index) { return 68; }
    let target: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, target_index);
    let source: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, source_index);
    if (target.owned == 0) { return 69; }
    if (target.mutable == 0) { return 70; }
    if (source.owned == 0) { return 71; }
    if (vec_get<i32>(states, target_index) != 1) { return 72; }
    if (vec_get<i32>(states, source_index) != 1) { return 73; }

    let drop_id: i64 = ownership_emit_place(output, next_instruction);
    ownership_append_record(records, 4, drop_id, event.a, -1, target.local_id, 0, 1, 3);
    let move_id: i64 = ownership_emit_place(output, next_instruction);
    ownership_append_record(records, 5, move_id, event.a, event.b, source.local_id, 0, 3, 1);
    vec_set<i32>(states, source_index, 2);
    vec_set<i32>(states, target_index, 1);
    return 0;
}

fn ownership_worker(
    borrow input: Vec<MirOwnershipEvent>, borrow bindings: Vec<MirOwnershipBinding>,
    borrow_mut states: Vec<i32>, borrow_mut snapshots: Vec<i32>,
    borrow_mut frames: Vec<OwnershipFrame>, borrow_mut next_instruction: Vec<i64>,
    borrow_mut output: Vec<MirLowerEvent>, borrow_mut records: Vec<MirOwnershipRecord>
) -> i32
requires_caps [allocate]
{
    var path_terminated: i32 = 0;
    var index: i64 = 0;
    while (index < vec_len<MirOwnershipEvent>(input)) {
        let event: MirOwnershipEvent = vec_get<MirOwnershipEvent>(input, index);

        if (event.kind == 1) {
            if (path_terminated != 0) { return 20; }
            ownership_emit_place(output, next_instruction);
        } else {
            if (event.kind == 2) {
                if (path_terminated != 0) { return 21; }
                let binding_index: i64 = ownership_find_binding(bindings, event.a);
                if (binding_index < 0) { return 22; }
                if (vec_get<i32>(states, binding_index) != 0) { return 23; }
                let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, binding_index);
                vec_set<i32>(states, binding_index, 1);
                ownership_append_record(records, 1, -1, event.a, -1, binding.local_id, 0, 0, 1);
            } else {
                if (event.kind == 3) {
                    if (path_terminated != 0) { return 24; }
                    let source_index: i64 = ownership_find_binding(bindings, event.a);
                    let destination_index: i64 = ownership_find_binding(bindings, event.b);
                    if (source_index < 0) { return 25; }
                    if (destination_index < 0) { return 26; }
                    let source_binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, source_index);
                    let destination_binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, destination_index);
                    if (source_binding.owned == 0) { return 27; }
                    if (destination_binding.owned == 0) { return 28; }
                    if (vec_get<i32>(states, source_index) != 1) { return 29; }
                    if (vec_get<i32>(states, destination_index) != 0) { return 30; }
                    let instruction_id: i64 = ownership_emit_place(output, next_instruction);
                    ownership_append_record(records, 2, instruction_id, event.a, event.b, source_binding.local_id, 0, 1, 2);
                    vec_set<i32>(states, source_index, 2);
                    vec_set<i32>(states, destination_index, 1);
                } else {
                    if (event.kind == 4) {
                        if (path_terminated != 0) { return 31; }
                        let binding_index: i64 = ownership_find_binding(bindings, event.a);
                        if (binding_index < 0) { return 32; }
                        let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, binding_index);
                        if (binding.owned == 0) { return 33; }
                        if (vec_get<i32>(states, binding_index) != 1) { return 34; }
                        let instruction_id: i64 = ownership_emit_place(output, next_instruction);
                        ownership_append_record(records, 3, instruction_id, event.a, -1, binding.local_id, 0, 1, 3);
                        vec_set<i32>(states, binding_index, 3);
                    } else {
                        if (event.kind == 5) {
                            if (path_terminated != 0) { return 35; }
                            let binding_index: i64 = ownership_find_binding(bindings, event.a);
                            if (binding_index < 0) { return 36; }
                            let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, binding_index);
                            if (binding.owned == 0) { return 37; }
                            if (binding.mutable == 0) { return 38; }
                            if (vec_get<i32>(states, binding_index) != 1) { return 39; }
                            if (event.b < 0) { return 40; }
                            let drop_id: i64 = ownership_emit_place(output, next_instruction);
                            ownership_append_record(records, 4, drop_id, event.a, -1, binding.local_id, 0, 1, 3);
                            let move_id: i64 = ownership_emit_place(output, next_instruction);
                            ownership_append_record(records, 5, move_id, event.a, -1, event.b, 0, 3, 1);
                            vec_set<i32>(states, binding_index, 1);
                        } else {
                            if (event.kind == 6) {
                                if (path_terminated != 0) { return 74; }
                                let replace_status: i32 = ownership_replace_from_binding(
                                    event, bindings, states, output, records, next_instruction
                                );
                                if (replace_status != 0) { return replace_status; }
                            } else {
                                if (event.kind == 10) {
                                    if (path_terminated != 0) { return 41; }
                                    if (event.a < -1) { return 42; }
                                    ownership_cleanup_live(bindings, states, output, records, next_instruction);
                                    vec_push<MirLowerEvent>(output, mir_event_return(event.a));
                                    path_terminated = 1;
                                } else {
                                    if (event.kind == 20) {
                                        if (path_terminated != 0) { return 43; }
                                        if (event.a < 0) { return 44; }
                                        let entry_start: i64 = ownership_snapshot(states, snapshots);
                                        vec_push<OwnershipFrame>(frames, OwnershipFrame { kind: 20, entry_start: entry_start, then_start: -1, then_terminated: 0, seen_else: 0 });
                                        vec_push<MirLowerEvent>(output, mir_event_if(event.a));
                                        path_terminated = 0;
                                    } else {
                                        if (event.kind == 21) {
                                            if (vec_len<OwnershipFrame>(frames) == 0) { return 45; }
                                            let frame_index: i64 = checked_sub(vec_len<OwnershipFrame>(frames), 1);
                                            let frame: OwnershipFrame = vec_get<OwnershipFrame>(frames, frame_index);
                                            if (frame.kind != 20) { return 46; }
                                            if (frame.seen_else != 0) { return 47; }
                                            let then_start: i64 = ownership_snapshot(states, snapshots);
                                            ownership_restore(states, snapshots, frame.entry_start);
                                            vec_set<OwnershipFrame>(frames, frame_index, OwnershipFrame { kind: 20, entry_start: frame.entry_start, then_start: then_start, then_terminated: path_terminated, seen_else: 1 });
                                            vec_push<MirLowerEvent>(output, mir_event_else());
                                            path_terminated = 0;
                                        } else {
                                            if (event.kind == 22) {
                                                if (vec_len<OwnershipFrame>(frames) == 0) { return 48; }
                                                let frame: OwnershipFrame = vec_pop<OwnershipFrame>(frames);
                                                if (frame.kind != 20) { return 49; }
                                                let merge_status: i32 = ownership_merge_if(bindings, states, snapshots, frame, path_terminated);
                                                if (merge_status == 61) { return 61; }
                                                if (merge_status == 62) { return 62; }
                                                vec_push<MirLowerEvent>(output, mir_event_end_if());
                                                if (merge_status == 1) { path_terminated = 1; } else { path_terminated = 0; }
                                            } else {
                                                if (event.kind == 30) {
                                                    if (path_terminated != 0) { return 50; }
                                                    if (event.a < 0) { return 51; }
                                                    let entry_start: i64 = ownership_snapshot(states, snapshots);
                                                    vec_push<OwnershipFrame>(frames, OwnershipFrame { kind: 30, entry_start: entry_start, then_start: -1, then_terminated: 0, seen_else: 0 });
                                                    vec_push<MirLowerEvent>(output, mir_event_while(event.a));
                                                    path_terminated = 0;
                                                } else {
                                                    if (event.kind == 31) {
                                                        if (vec_len<OwnershipFrame>(frames) == 0) { return 52; }
                                                        let frame: OwnershipFrame = vec_pop<OwnershipFrame>(frames);
                                                        if (frame.kind != 30) { return 53; }
                                                        if (path_terminated == 0) {
                                                            if (ownership_states_equal(states, snapshots, frame.entry_start) == 0) { return 63; }
                                                        }
                                                        ownership_restore(states, snapshots, frame.entry_start);
                                                        vec_push<MirLowerEvent>(output, mir_event_end_while());
                                                        path_terminated = 0;
                                                    } else { return 64; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        index = checked_add(index, 1);
    }
    if (vec_len<OwnershipFrame>(frames) != 0) { return 65; }
    return 0;
}

pub fn lower_ownership_flow(
    borrow input: Vec<MirOwnershipEvent>, borrow bindings: Vec<MirOwnershipBinding>,
    allocator: Allocator, borrow_mut output: Vec<MirLowerEvent>,
    borrow_mut records: Vec<MirOwnershipRecord>
) -> i32
requires_caps [allocate]
{
    if (vec_len<MirOwnershipEvent>(input) == 0) { return 1; }
    let binding_status: i32 = ownership_validate_bindings(bindings);
    if (binding_status != 0) { return binding_status; }

    var states: Vec<i32> = vec_new<i32>(allocator, vec_len<MirOwnershipBinding>(bindings));
    var index: i64 = 0;
    while (index < vec_len<MirOwnershipBinding>(bindings)) {
        vec_push<i32>(states, 0);
        index = checked_add(index, 1);
    }
    var snapshots: Vec<i32> = vec_new<i32>(allocator, 16);
    var frames: Vec<OwnershipFrame> = vec_new<OwnershipFrame>(allocator, 8);
    var next_instruction: Vec<i64> = vec_new<i64>(allocator, 1);
    vec_push<i64>(next_instruction, 0);
    let status: i32 = ownership_worker(input, bindings, states, snapshots, frames, next_instruction, output, records);
    drop(next_instruction);
    drop(frames);
    drop(snapshots);
    drop(states);
    return status;
}

pub fn validate_ownership_records(
    borrow records: Vec<MirOwnershipRecord>, borrow bindings: Vec<MirOwnershipBinding>
) -> i32
{
    var previous_instruction: i64 = -1;
    var index: i64 = 0;
    while (index < vec_len<MirOwnershipRecord>(records)) {
        let record: MirOwnershipRecord = vec_get<MirOwnershipRecord>(records, index);
        if (record.kind < 1) { return 1; }
        if (record.kind > 6) { return 1; }
        if (ownership_find_binding(bindings, record.binding_id) < 0) { return 2; }
        if (record.kind == 1) {
            if (record.instruction_id != -1) { return 3; }
            if (record.state_before != 0) { return 4; }
            if (record.state_after != 1) { return 4; }
        } else {
            if (record.instruction_id <= previous_instruction) { return 5; }
            previous_instruction = record.instruction_id;
            if (record.state_before < 1) { return 6; }
            if (record.state_after < 1) { return 6; }
        }
        if (record.kind == 5) {
            if (record.other_binding_id >= 0) {
                if (record.other_binding_id == record.binding_id) { return 8; }
                if (ownership_find_binding(bindings, record.other_binding_id) < 0) { return 9; }
            }
        }
        if (record.implicit < 0) { return 7; }
        if (record.implicit > 1) { return 7; }
        index = checked_add(index, 1);
    }
    return 0;
}