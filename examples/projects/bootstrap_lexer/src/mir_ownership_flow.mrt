fn find_binding(borrow bindings: Vec<MirOwnershipBinding>, id: i64) -> i64 {
    var i: i64 = 0;
    while (i < vec_len<MirOwnershipBinding>(bindings)) {
        let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, i);
        if (binding.binding_id == id) { return i; }
        i = checked_add(i, 1);
    }
    return ownership_binding_not_found();
}

fn find_owned_binding_by_local(
    borrow bindings: Vec<MirOwnershipBinding>, local_id: i64
) -> i64 {
    var index: i64 = 0;
    while (index < vec_len<MirOwnershipBinding>(bindings)) {
        let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, index);
        if (binding.local_id == local_id) {
            if (binding.owned != 0) { return index; }
        }
        index = checked_add(index, 1);
    }
    return ownership_binding_not_found();
}

fn validate_bindings(borrow bindings: Vec<MirOwnershipBinding>) -> i32 {
    var i: i64 = 0;
    while (i < vec_len<MirOwnershipBinding>(bindings)) {
        let b: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, i);
        if (b.binding_id != i) { return ownership_status_invalid_binding_id(); }
        if (b.local_id < 0) { return ownership_status_invalid_binding_local(); }
        if (b.owned < 0) { return ownership_status_invalid_owned_flag(); }
        if (b.owned > 1) { return ownership_status_invalid_owned_flag(); }
        if (b.mutable < 0) { return ownership_status_invalid_mutable_flag(); }
        if (b.mutable > 1) { return ownership_status_invalid_mutable_flag(); }
        i = checked_add(i, 1);
    }
    return 0;
}

fn snapshot(borrow states: Vec<i32>, borrow_mut snapshots: Vec<i32>) -> i64
requires_caps [allocate]
{
    let start: i64 = vec_len<i32>(snapshots);
    var i: i64 = 0;
    while (i < vec_len<i32>(states)) { vec_push<i32>(snapshots, vec_get<i32>(states, i)); i = checked_add(i, 1); }
    return start;
}

fn restore(borrow_mut states: Vec<i32>, borrow snapshots: Vec<i32>, start: i64) -> i32 {
    var i: i64 = 0;
    while (i < vec_len<i32>(states)) { vec_set<i32>(states, i, vec_get<i32>(snapshots, checked_add(start, i))); i = checked_add(i, 1); }
    return 0;
}

fn ownership_states_equivalent(left: i32, right: i32) -> i32 {
    if (left == right) { return 1; }
    var left_consumed: i32 = 0;
    if (left == ownership_state_moved()) { left_consumed = 1; }
    if (left == ownership_state_dropped()) { left_consumed = 1; }
    var right_consumed: i32 = 0;
    if (right == ownership_state_moved()) { right_consumed = 1; }
    if (right == ownership_state_dropped()) { right_consumed = 1; }
    if (left_consumed != 0) { if (right_consumed != 0) { return 1; } }
    return 0;
}

fn states_equal(borrow states: Vec<i32>, borrow snapshots: Vec<i32>, start: i64) -> i32 {
    var i: i64 = 0;
    while (i < vec_len<i32>(states)) {
        if (ownership_states_equivalent(
            vec_get<i32>(states, i), vec_get<i32>(snapshots, checked_add(start, i))
        ) == 0) { return 0; }
        i = checked_add(i, 1);
    }
    return 1;
}

fn append_record(
    borrow_mut records: Vec<MirOwnershipRecord>, kind: i32, instruction: i64,
    binding: i64, other: i64, local: i64, implicit: i32, before: i32, after: i32
) -> i32
requires_caps [allocate]
{
    vec_push<MirOwnershipRecord>(records, MirOwnershipRecord {
        kind: kind, instruction_id: instruction, binding_id: binding, other_binding_id: other,
        operand_local: local, implicit: implicit, state_before: before, state_after: after
    });
    return 0;
}

fn emit_place(borrow_mut output: Vec<MirLowerEvent>, borrow_mut next: Vec<i64>) -> i64
requires_caps [allocate]
{
    let id: i64 = vec_get<i64>(next, 0);
    vec_push<MirLowerEvent>(output, mir_event_place(id));
    vec_set<i64>(next, 0, checked_add(id, 1));
    return id;
}

fn cleanup_live(
    borrow bindings: Vec<MirOwnershipBinding>, borrow_mut states: Vec<i32>,
    borrow_mut output: Vec<MirLowerEvent>, borrow_mut records: Vec<MirOwnershipRecord>,
    borrow_mut next: Vec<i64>
) -> i32
requires_caps [allocate]
{
    var i: i64 = vec_len<MirOwnershipBinding>(bindings);
    while (i > 0) {
        i = checked_sub(i, 1);
        cleanup_binding(bindings,states,i,output,records,next);
    }
    return 0;
}

fn cleanup_binding(
    borrow bindings:Vec<MirOwnershipBinding>,borrow_mut states:Vec<i32>,index:i64,
    borrow_mut output:Vec<MirLowerEvent>,borrow_mut records:Vec<MirOwnershipRecord>,borrow_mut next:Vec<i64>
)->i32 requires_caps [allocate] {
        let b: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, index);
        if (b.owned != 0) {
            if (vec_get<i32>(states, index) == ownership_state_live()) {
                let id: i64 = emit_place(output, next);
                append_record(records, ownership_record_kind_implicit_drop(), id, b.binding_id, ownership_record_no_other_binding_id(), b.local_id, 1, ownership_state_live(), ownership_state_dropped());
                vec_set<i32>(states, index, ownership_state_dropped());
            }
        }
    return 0;
}

fn merge_if(
    borrow bindings: Vec<MirOwnershipBinding>, borrow_mut states: Vec<i32>,
    borrow snapshots: Vec<i32>, borrow frame: OwnershipFrame, terminated: i32
) -> i32
{
    if (frame.seen_else == 0) {
        if (terminated != 0) { restore(states, snapshots, frame.entry_start); return 0; }
        if (states_equal(states, snapshots, frame.entry_start) == 0) { return ownership_status_if_without_else_diverged(); }
        return 0;
    }
    if (frame.then_terminated != 0) {
        if (terminated != 0) { restore(states, snapshots, frame.entry_start); return 1; }
        return 0;
    }
    if (terminated != 0) { restore(states, snapshots, frame.then_start); return 0; }
    var i: i64 = 0;
    while (i < vec_len<MirOwnershipBinding>(bindings)) {
        if (ownership_states_equivalent(
            vec_get<i32>(states, i), vec_get<i32>(snapshots, checked_add(frame.then_start, i))
        ) == 0) { return ownership_status_if_branches_diverged(); }
        i = checked_add(i, 1);
    }
    return 0;
}

fn finish_match_arm(
    borrow_mut states: Vec<i32>, borrow_mut snapshots: Vec<i32>,
    survivor: i64, terminated: i32
) -> i64
requires_caps [allocate]
{
    if (terminated != 0) { return survivor; }
    if (survivor < 0) { return snapshot(states, snapshots); }
    if (states_equal(states, snapshots, survivor) == 0) { return -80; }
    return survivor;
}

fn replace_from_binding(
    borrow event: MirOwnershipEvent, borrow bindings: Vec<MirOwnershipBinding>,
    borrow_mut states: Vec<i32>, borrow_mut output: Vec<MirLowerEvent>,
    borrow_mut records: Vec<MirOwnershipRecord>, borrow_mut next: Vec<i64>
) -> i32
requires_caps [allocate]
{
    let target_index: i64 = find_binding(bindings, event.a);
    let source_index: i64 = find_binding(bindings, event.b);
    if (target_index < 0) { return ownership_status_missing_replace_target(); }
    if (source_index < 0) { return ownership_status_missing_replace_source(); }
    if (target_index == source_index) { return ownership_status_same_replace_bindings(); }
    let target: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, target_index);
    let source: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, source_index);
    if (target.owned == 0) { return ownership_status_replace_target_not_owned(); }
    if (target.mutable == 0) { return ownership_status_replace_target_immutable(); }
    if (source.owned == 0) { return ownership_status_replace_source_not_owned(); }
    if (vec_get<i32>(states, target_index) != ownership_state_live()) { return ownership_status_replace_target_not_live(); }
    if (vec_get<i32>(states, source_index) != ownership_state_live()) { return ownership_status_replace_source_not_live(); }
    let drop_id: i64 = emit_place(output, next);
    append_record(records, ownership_record_kind_replace_drop(), drop_id, event.a, ownership_record_no_other_binding_id(), target.local_id, 0, ownership_state_live(), ownership_state_dropped());
    let move_id: i64 = emit_place(output, next);
    append_record(records, ownership_record_kind_replace_move(), move_id, event.a, event.b, source.local_id, 0, ownership_state_dropped(), ownership_state_live());
    vec_set<i32>(states, source_index, ownership_state_moved());
    vec_set<i32>(states, target_index, ownership_state_live());
    return 0;
}

fn worker(
    borrow input: Vec<MirOwnershipEvent>, borrow bindings: Vec<MirOwnershipBinding>,
    borrow_mut states: Vec<i32>, borrow_mut snapshots: Vec<i32>,
    borrow_mut frames: Vec<OwnershipFrame>, borrow_mut next: Vec<i64>,
    borrow_mut output: Vec<MirLowerEvent>, borrow_mut records: Vec<MirOwnershipRecord>
) -> i32
requires_caps [allocate]
{
    var terminated: i32 = 0;
    var index: i64 = 0;
    while (index < vec_len<MirOwnershipEvent>(input)) {
        let event: MirOwnershipEvent = vec_get<MirOwnershipEvent>(input, index);
        let kind: i32 = event.kind;
        var handled: i32 = 0;

        if (kind == ownership_event_kind_place()) { handled = 1; if (terminated != 0) { return ownership_status_place_after_termination(); } emit_place(output, next); }
        if (kind == ownership_event_kind_activate()) {
            handled = 1; if (terminated != 0) { return ownership_status_activate_after_termination(); }
            let bi: i64 = find_binding(bindings, event.a); if (bi < 0) { return ownership_status_missing_activate_binding(); }
            if (vec_get<i32>(states, bi) != ownership_state_uninitialized()) { return ownership_status_activate_nonempty_binding(); }
            let b: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, bi);
            vec_set<i32>(states, bi, ownership_state_live()); append_record(records, ownership_record_kind_activate(), ownership_record_no_instruction_id(), event.a, ownership_record_no_other_binding_id(), b.local_id, 0, ownership_state_uninitialized(), ownership_state_live());
        }
        if (kind == ownership_event_kind_move()) {
            handled = 1; if (terminated != 0) { return ownership_status_move_after_termination(); }
            let si: i64 = find_binding(bindings, event.a); let di: i64 = find_binding(bindings, event.b);
            if (si < 0) { return ownership_status_missing_move_source(); } if (di < 0) { return ownership_status_missing_move_destination(); }
            let s: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, si);
            let d: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, di);
            if (s.owned == 0) { return ownership_status_move_source_not_owned(); } if (d.owned == 0) { return ownership_status_move_destination_not_owned(); }
            if (vec_get<i32>(states, si) != ownership_state_live()) { return ownership_status_move_source_not_live(); } if (vec_get<i32>(states, di) != ownership_state_uninitialized()) { return ownership_status_move_destination_initialized(); }
            let id: i64 = emit_place(output, next); append_record(records, ownership_record_kind_move(), id, event.a, event.b, s.local_id, 0, ownership_state_live(), ownership_state_moved());
            vec_set<i32>(states, si, ownership_state_moved()); vec_set<i32>(states, di, ownership_state_live());
        }
        if (kind == ownership_event_kind_assign()) {
            handled = 1; if (terminated != 0) { return ownership_status_assign_after_termination(); }
            let target_index: i64 = find_binding(bindings, event.a);
            if (target_index < 0) { return ownership_status_missing_assign_target(); }
            let target: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, target_index);
            if (target.mutable == 0) { return ownership_status_assign_target_immutable(); }
            if (event.b < 0) { return ownership_status_invalid_assign_local(); }
            emit_place(output, next);
        }
        if (kind == ownership_event_kind_print()) {
            handled = 1; if (terminated != 0) { return ownership_status_print_after_termination(); }
            if (event.a < 0) { return ownership_status_invalid_print_local(); }
            let binding_index: i64 = find_owned_binding_by_local(bindings, event.a);
            if (binding_index >= 0) {
                if (vec_get<i32>(states, binding_index) != ownership_state_live()) { return ownership_status_print_binding_not_live(); }
            }
            emit_place(output, next);
        }
        if (kind == ownership_event_kind_consume()) {
            handled = 1; if (terminated != 0) { return ownership_status_consume_after_termination(); }
            let binding_index: i64 = find_binding(bindings, event.a);
            if (binding_index < 0) { return ownership_status_missing_consume_binding(); }
            let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, binding_index);
            if (binding.owned == 0) { return ownership_status_consume_binding_not_owned(); }
            if (vec_get<i32>(states, binding_index) != ownership_state_live()) { return ownership_status_consume_binding_not_live(); }
            append_record(records, ownership_record_kind_nested_transfer(), ownership_record_no_instruction_id(), event.a, ownership_record_no_other_binding_id(), binding.local_id, 0, ownership_state_live(), ownership_state_moved());
            vec_set<i32>(states, binding_index, ownership_state_moved());
        }
        if (kind == ownership_event_kind_use()) {
            handled = 1; if (terminated != 0) { return ownership_status_use_after_termination(); }
            let binding_index: i64 = find_binding(bindings, event.a);
            if (binding_index < 0) { return ownership_status_missing_use_binding(); }
            let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, binding_index);
            if (binding.owned != 0) {
                if (vec_get<i32>(states, binding_index) != ownership_state_live()) { return ownership_status_use_binding_not_live(); }
            }
        }
        if (kind == ownership_event_kind_drop()) {
            handled = 1; if (terminated != 0) { return ownership_status_drop_after_termination(); }
            let bi: i64 = find_binding(bindings, event.a); if (bi < 0) { return ownership_status_missing_drop_binding(); }
            let b: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, bi); if (b.owned == 0) { return ownership_status_drop_binding_not_owned(); }
            if (vec_get<i32>(states, bi) != ownership_state_live()) { return ownership_status_drop_binding_not_live(); }
            let id: i64 = emit_place(output, next); append_record(records, ownership_record_kind_drop(), id, event.a, ownership_record_no_other_binding_id(), b.local_id, 0, ownership_state_live(), ownership_state_dropped()); vec_set<i32>(states, bi, ownership_state_dropped());
        }
        if (kind == ownership_event_kind_replace()) {
            handled = 1; if (terminated != 0) { return ownership_status_replace_after_termination(); }
            let bi: i64 = find_binding(bindings, event.a); if (bi < 0) { return ownership_status_missing_replace_binding(); }
            let b: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, bi);
            if (b.owned == 0) { return ownership_status_replace_binding_not_owned(); } if (b.mutable == 0) { return ownership_status_replace_binding_immutable(); }
            if (vec_get<i32>(states, bi) != ownership_state_live()) { return ownership_status_replace_binding_not_live(); } if (event.b < 0) { return ownership_status_invalid_replace_local(); }
            let drop_id: i64 = emit_place(output, next); append_record(records, ownership_record_kind_replace_drop(), drop_id, event.a, ownership_record_no_other_binding_id(), b.local_id, 0, ownership_state_live(), ownership_state_dropped());
            let move_id: i64 = emit_place(output, next); append_record(records, ownership_record_kind_replace_move(), move_id, event.a, ownership_record_no_other_binding_id(), event.b, 0, ownership_state_dropped(), ownership_state_live());
        }
        if (kind == ownership_event_kind_replace_from_binding()) { handled = 1; if (terminated != 0) { return ownership_status_replace_binding_after_termination(); } let s: i32 = replace_from_binding(event, bindings, states, output, records, next); if (s != 0) { return s; } }
        if (kind == ownership_event_kind_return()) { handled = 1; if (terminated != 0) { return ownership_status_return_after_termination(); } if (event.a < ownership_event_no_local_id()) { return ownership_status_invalid_return_local(); } cleanup_live(bindings, states, output, records, next); vec_push<MirLowerEvent>(output, mir_event_return(event.a)); terminated = 1; }
        var ending_scope:i32=0;
        if(kind==ownership_event_kind_end_scope()){ending_scope=1;}
        if(kind==ownership_event_kind_end_trivial_scope()){ending_scope=1;}
        if (ending_scope != 0) {
            handled = 1;
            let binding_index: i64 = find_binding(bindings, event.a);
            if (binding_index < 0) { return ownership_status_missing_scope_binding(); }
            let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, binding_index);
            if (binding.owned == 0) { return ownership_status_scope_binding_not_owned(); }
            let state: i32 = vec_get<i32>(states, binding_index);
            if (state == ownership_state_live()) {
                if(kind==ownership_event_kind_end_scope()){return ownership_status_live_at_scope_exit();}
                cleanup_binding(bindings,states,binding_index,output,records,next);
            }
            if (state == ownership_state_uninitialized()) { return ownership_status_scope_binding_uninitialized(); }
            vec_set<i32>(states, binding_index, ownership_state_uninitialized());
        }

        if (kind == ownership_event_kind_if()) {
            handled = 1; if (terminated != 0) { return ownership_status_if_after_termination(); } if (event.a < 0) { return ownership_status_invalid_if_condition(); }
            let entry: i64 = snapshot(states, snapshots);
            vec_push<OwnershipFrame>(frames, OwnershipFrame { kind: ownership_if_frame_kind(), entry_start: entry, then_start: ownership_frame_no_branch_start(), then_terminated: 0, seen_else: 0, match_count: 0, match_started: 0 });
            vec_push<MirLowerEvent>(output, mir_event_if(event.a)); terminated = 0;
        }
        if (kind == ownership_event_kind_else()) {
            handled = 1; if (vec_len<OwnershipFrame>(frames) == 0) { return ownership_status_else_without_if(); }
            let fi: i64 = checked_sub(vec_len<OwnershipFrame>(frames), 1); let f: OwnershipFrame = vec_get<OwnershipFrame>(frames, fi);
            if (f.kind != ownership_if_frame_kind()) { return ownership_status_else_wrong_frame(); } if (f.seen_else != 0) { return ownership_status_duplicate_else(); }
            let then_start: i64 = snapshot(states, snapshots); restore(states, snapshots, f.entry_start);
            vec_set<OwnershipFrame>(frames, fi, OwnershipFrame { kind: ownership_if_frame_kind(), entry_start: f.entry_start, then_start: then_start, then_terminated: terminated, seen_else: 1, match_count: 0, match_started: 0 });
            vec_push<MirLowerEvent>(output, mir_event_else()); terminated = 0;
        }
        if (kind == ownership_event_kind_end_if()) {
            handled = 1; if (vec_len<OwnershipFrame>(frames) == 0) { return ownership_status_end_if_without_if(); }
            let f: OwnershipFrame = vec_pop<OwnershipFrame>(frames); if (f.kind != ownership_if_frame_kind()) { return ownership_status_end_if_wrong_frame(); }
            let s: i32 = merge_if(bindings, states, snapshots, f, terminated); if (s == ownership_status_if_without_else_diverged()) { return ownership_status_if_without_else_diverged(); } if (s == ownership_status_if_branches_diverged()) { return ownership_status_if_branches_diverged(); }
            vec_push<MirLowerEvent>(output, mir_event_end_if()); if (s == 1) { terminated = 1; } else { terminated = 0; }
        }
        if (kind == ownership_event_kind_begin_while()) {
            handled = 1; if (terminated != 0) { return ownership_status_begin_while_after_termination(); }
            let entry: i64 = snapshot(states, snapshots);
            vec_push<OwnershipFrame>(frames, OwnershipFrame { kind: ownership_while_frame_kind(), entry_start: entry, then_start: ownership_frame_no_branch_start(), then_terminated: 0, seen_else: 0, match_count: 0, match_started: 0 });
            vec_push<MirLowerEvent>(output, mir_event_begin_while()); terminated = 0;
        }
        if (kind == ownership_event_kind_while()) {
            handled = 1; if (terminated != 0) { return ownership_status_while_after_termination(); } if (event.a < 0) { return ownership_status_invalid_while_condition(); }
            if (vec_len<OwnershipFrame>(frames) == 0) { return ownership_status_while_without_begin(); }
            let frame: OwnershipFrame = vec_get<OwnershipFrame>(frames, checked_sub(vec_len<OwnershipFrame>(frames), 1));
            if (frame.kind != ownership_while_frame_kind()) { return ownership_status_while_wrong_frame(); }
            vec_push<MirLowerEvent>(output, mir_event_while(event.a)); terminated = 0;
        }
        if (kind == ownership_event_kind_end_while()) {
            handled = 1; if (vec_len<OwnershipFrame>(frames) == 0) { return ownership_status_end_while_without_while(); }
            let f: OwnershipFrame = vec_pop<OwnershipFrame>(frames); if (f.kind != ownership_while_frame_kind()) { return ownership_status_end_while_wrong_frame(); }
            if (terminated == 0) { if (states_equal(states, snapshots, f.entry_start) == 0) { return ownership_status_loop_state_diverged(); } }
            restore(states, snapshots, f.entry_start); vec_push<MirLowerEvent>(output, mir_event_end_while()); terminated = 0;
        }

        if (kind == ownership_event_kind_match()) {
            handled = 1; if (terminated != 0) { return ownership_status_match_after_termination(); } if (event.a < 0) { return ownership_status_invalid_match_subject(); } if (event.b <= 0) { return ownership_status_invalid_match_arm_count(); }
            let entry: i64 = snapshot(states, snapshots);
            vec_push<OwnershipFrame>(frames, OwnershipFrame { kind: ownership_match_frame_kind(), entry_start: entry, then_start: ownership_frame_no_branch_start(), then_terminated: 0, seen_else: 0, match_count: event.b, match_started: 0 });
            vec_push<MirLowerEvent>(output, mir_event_match(event.a, checked_add(event.b, 1))); terminated = 1;
        }
        if (kind == ownership_event_kind_case()) {
            handled = 1; if (vec_len<OwnershipFrame>(frames) == 0) { return ownership_status_case_without_match(); }
            let fi: i64 = checked_sub(vec_len<OwnershipFrame>(frames), 1); let f: OwnershipFrame = vec_get<OwnershipFrame>(frames, fi);
            if (f.kind != ownership_match_frame_kind()) { return ownership_status_case_wrong_frame(); } if (event.b != f.match_started) { return ownership_status_invalid_case_ordinal(); } if (event.b >= f.match_count) { return ownership_status_excess_match_case(); }
            var survivor: i64 = f.then_start;
            if (f.match_started > 0) {
                survivor = finish_match_arm(states, snapshots, survivor, terminated); if (survivor == -80) { return ownership_status_match_arm_state_diverged(); }
                restore(states, snapshots, f.entry_start);
            }
            vec_set<OwnershipFrame>(frames, fi, OwnershipFrame { kind: ownership_match_frame_kind(), entry_start: f.entry_start, then_start: survivor, then_terminated: 0, seen_else: 0, match_count: f.match_count, match_started: checked_add(f.match_started, 1) });
            vec_push<MirLowerEvent>(output, mir_event_case(event.a)); terminated = 0;
        }
        if (kind == ownership_event_kind_end_match()) {
            handled = 1; if (vec_len<OwnershipFrame>(frames) == 0) { return ownership_status_end_match_without_match(); }
            let f: OwnershipFrame = vec_pop<OwnershipFrame>(frames); if (f.kind != ownership_match_frame_kind()) { return ownership_status_end_match_wrong_frame(); } if (f.match_started != f.match_count) { return ownership_status_incomplete_match_cases(); }
            let survivor: i64 = finish_match_arm(states, snapshots, f.then_start, terminated); if (survivor == -80) { return ownership_status_match_arm_state_diverged(); }
            vec_push<MirLowerEvent>(output, mir_event_default()); vec_push<MirLowerEvent>(output, mir_event_unreachable()); vec_push<MirLowerEvent>(output, mir_event_end_match());
            if (survivor < 0) { restore(states, snapshots, f.entry_start); terminated = 1; }
            else { restore(states, snapshots, survivor); terminated = 0; }
        }

        if (handled == 0) { return ownership_status_unknown_event(); }
        index = checked_add(index, 1);
    }
    if (vec_len<OwnershipFrame>(frames) != 0) { return ownership_status_unclosed_control_frame(); }
    return 0;
}

pub fn lower_ownership_flow(
    borrow input: Vec<MirOwnershipEvent>, borrow bindings: Vec<MirOwnershipBinding>,
    allocator: Allocator, borrow_mut output: Vec<MirLowerEvent>, borrow_mut records: Vec<MirOwnershipRecord>
) -> i32
requires_caps [allocate]
{
    if (vec_len<MirOwnershipEvent>(input) == 0) { return ownership_status_empty_event_stream(); }
    let binding_status: i32 = validate_bindings(bindings); if (binding_status != 0) { return binding_status; }
    var states: Vec<i32> = vec_new<i32>(allocator, vec_len<MirOwnershipBinding>(bindings));
    var i: i64 = 0; while (i < vec_len<MirOwnershipBinding>(bindings)) { vec_push<i32>(states, ownership_state_uninitialized()); i = checked_add(i, 1); }
    var snapshots: Vec<i32> = vec_new<i32>(allocator, 16);
    var frames: Vec<OwnershipFrame> = vec_new<OwnershipFrame>(allocator, 8);
    var next: Vec<i64> = vec_new<i64>(allocator, 1); vec_push<i64>(next, 0);
    let status: i32 = worker(input, bindings, states, snapshots, frames, next, output, records);
    drop(next); drop(frames); drop(snapshots); drop(states); return status;
}

pub fn validate_ownership_records(borrow records: Vec<MirOwnershipRecord>, borrow bindings: Vec<MirOwnershipBinding>) -> i32 {
    var previous: i64 = ownership_record_no_instruction_id(); var i: i64 = 0;
    while (i < vec_len<MirOwnershipRecord>(records)) {
        let r: MirOwnershipRecord = vec_get<MirOwnershipRecord>(records, i);
        if (r.kind < ownership_record_kind_activate()) { return ownership_record_status_invalid_kind(); } if (r.kind > ownership_record_kind_nested_transfer()) { return ownership_record_status_invalid_kind(); } if (find_binding(bindings, r.binding_id) < 0) { return ownership_record_status_missing_binding(); }
        if (r.kind == ownership_record_kind_activate()) { if (r.instruction_id != ownership_record_no_instruction_id()) { return ownership_record_status_activate_has_instruction(); } if (r.state_before != ownership_state_uninitialized()) { return ownership_record_status_invalid_activation_state(); } if (r.state_after != ownership_state_live()) { return ownership_record_status_invalid_activation_state(); } }
        else {
            if (r.kind == ownership_record_kind_nested_transfer()) { if (r.instruction_id != ownership_record_no_instruction_id()) { return ownership_record_status_nested_transfer_has_instruction(); } }
            else { if (r.instruction_id <= previous) { return ownership_record_status_unordered_instruction(); } previous = r.instruction_id; }
            if (r.state_before < ownership_state_live()) { return ownership_record_status_invalid_transfer_state(); } if (r.state_after < ownership_state_live()) { return ownership_record_status_invalid_transfer_state(); }
        }
        if (r.kind == ownership_record_kind_replace_move()) { if (r.other_binding_id >= 0) { if (r.other_binding_id == r.binding_id) { return ownership_record_status_self_transfer(); } if (find_binding(bindings, r.other_binding_id) < 0) { return ownership_record_status_missing_transfer_binding(); } } }
        if (r.implicit < 0) { return ownership_record_status_invalid_implicit_flag(); } if (r.implicit > 1) { return ownership_record_status_invalid_implicit_flag(); }
        i = checked_add(i, 1);
    }
    return 0;
}
