module bootstrap_mir_ownership_flow
import bootstrap_mir_structured_lowering;

capability allocate;

// Pre-MIR ownership events. Match uses semantic case values/ordinals and is
// exhaustive; structured MIR receives one defensive default/unreachable edge.
pub struct MirOwnershipBinding { binding_id: i64; local_id: i64; owned: i32; mutable: i32; }
pub struct MirOwnershipEvent { kind: i32; a: i64; b: i64; }
pub struct MirOwnershipRecord {
    kind: i32; instruction_id: i64; binding_id: i64; other_binding_id: i64;
    operand_local: i64; implicit: i32; state_before: i32; state_after: i32;
}

// if: entry, then snapshot, then terminated, seen else
// while: entry snapshot
// match: entry, surviving-arm snapshot, match_count, match_started
struct OwnershipFrame {
    kind: i32; entry_start: i64; then_start: i64; then_terminated: i32; seen_else: i32;
    match_count: i64; match_started: i64;
}

pub fn ownership_binding(binding_id: i64, local_id: i64, owned: i32, mutable: i32) -> MirOwnershipBinding {
    return MirOwnershipBinding { binding_id: binding_id, local_id: local_id, owned: owned, mutable: mutable };
}
pub fn ownership_binding_id(borrow value: MirOwnershipBinding) -> i64 { return value.binding_id; }
pub fn ownership_binding_local_id(borrow value: MirOwnershipBinding) -> i64 { return value.local_id; }
pub fn ownership_binding_owned(borrow value: MirOwnershipBinding) -> i32 { return value.owned; }
pub fn ownership_binding_mutable(borrow value: MirOwnershipBinding) -> i32 { return value.mutable; }

pub fn ownership_event_place(id: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 1, a: id, b: 0 }; }
pub fn ownership_event_activate(id: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 2, a: id, b: 0 }; }
pub fn ownership_event_move(source: i64, destination: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 3, a: source, b: destination }; }
pub fn ownership_event_drop(id: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 4, a: id, b: 0 }; }
pub fn ownership_event_replace(id: i64, local: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 5, a: id, b: local }; }
pub fn ownership_event_replace_from_binding(target: i64, source: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 6, a: target, b: source }; }
pub fn ownership_event_assign(target: i64, local: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 7, a: target, b: local }; }
pub fn ownership_event_print(local: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 8, a: local, b: 0 }; }
pub fn ownership_event_return(local: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 10, a: local, b: 0 }; }
pub fn ownership_event_if(local: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 20, a: local, b: 0 }; }
pub fn ownership_event_else() -> MirOwnershipEvent { return MirOwnershipEvent { kind: 21, a: 0, b: 0 }; }
pub fn ownership_event_end_if() -> MirOwnershipEvent { return MirOwnershipEvent { kind: 22, a: 0, b: 0 }; }
pub fn ownership_event_begin_while() -> MirOwnershipEvent { return MirOwnershipEvent { kind: 29, a: 0, b: 0 }; }
pub fn ownership_event_while(local: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 30, a: local, b: 0 }; }
pub fn ownership_event_end_while() -> MirOwnershipEvent { return MirOwnershipEvent { kind: 31, a: 0, b: 0 }; }
pub fn ownership_event_match(local: i64, arms: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 40, a: local, b: arms }; }
pub fn ownership_event_case(value: i64, ordinal: i64) -> MirOwnershipEvent { return MirOwnershipEvent { kind: 41, a: value, b: ordinal }; }
pub fn ownership_event_end_match() -> MirOwnershipEvent { return MirOwnershipEvent { kind: 42, a: 0, b: 0 }; }

pub fn ownership_record_kind(borrow value: MirOwnershipRecord) -> i32 { return value.kind; }
pub fn ownership_record_instruction_id(borrow value: MirOwnershipRecord) -> i64 { return value.instruction_id; }
pub fn ownership_record_binding_id(borrow value: MirOwnershipRecord) -> i64 { return value.binding_id; }
pub fn ownership_record_other_binding_id(borrow value: MirOwnershipRecord) -> i64 { return value.other_binding_id; }
pub fn ownership_record_operand_local(borrow value: MirOwnershipRecord) -> i64 { return value.operand_local; }
pub fn ownership_record_implicit(borrow value: MirOwnershipRecord) -> i32 { return value.implicit; }
pub fn ownership_record_state_before(borrow value: MirOwnershipRecord) -> i32 { return value.state_before; }
pub fn ownership_record_state_after(borrow value: MirOwnershipRecord) -> i32 { return value.state_after; }

fn find_binding(borrow bindings: Vec<MirOwnershipBinding>, id: i64) -> i64 {
    var i: i64 = 0;
    while (i < vec_len<MirOwnershipBinding>(bindings)) {
        let binding: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, i);
        if (binding.binding_id == id) { return i; }
        i = checked_add(i, 1);
    }
    return -1;
}

fn validate_bindings(borrow bindings: Vec<MirOwnershipBinding>) -> i32 {
    var i: i64 = 0;
    while (i < vec_len<MirOwnershipBinding>(bindings)) {
        let b: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, i);
        if (b.binding_id != i) { return 2; }
        if (b.local_id < 0) { return 3; }
        if (b.owned < 0) { return 4; }
        if (b.owned > 1) { return 4; }
        if (b.mutable < 0) { return 5; }
        if (b.mutable > 1) { return 5; }
        i = checked_add(i, 1);
    }
    return 0;
}

fn snapshot(borrow states: Vec<i32>, borrow_mut snapshots: Vec<i32>) -> i64
requires_caps [allocate]
{
    let start: i64 = vec_len<i32>(snapshots);
    var i: i64 = 0;
    while (i < vec_len<i32>(states)) { vec_push<i32>(snapshots, vec_get<i32>(states, i)); i = checked_add(i, 1); }
    return start;
}

fn restore(borrow_mut states: Vec<i32>, borrow snapshots: Vec<i32>, start: i64) -> i32 {
    var i: i64 = 0;
    while (i < vec_len<i32>(states)) { vec_set<i32>(states, i, vec_get<i32>(snapshots, checked_add(start, i))); i = checked_add(i, 1); }
    return 0;
}

fn states_equal(borrow states: Vec<i32>, borrow snapshots: Vec<i32>, start: i64) -> i32 {
    var i: i64 = 0;
    while (i < vec_len<i32>(states)) {
        if (vec_get<i32>(states, i) != vec_get<i32>(snapshots, checked_add(start, i))) { return 0; }
        i = checked_add(i, 1);
    }
    return 1;
}

fn append_record(
    borrow_mut records: Vec<MirOwnershipRecord>, kind: i32, instruction: i64,
    binding: i64, other: i64, local: i64, implicit: i32, before: i32, after: i32
) -> i32
requires_caps [allocate]
{
    vec_push<MirOwnershipRecord>(records, MirOwnershipRecord {
        kind: kind, instruction_id: instruction, binding_id: binding, other_binding_id: other,
        operand_local: local, implicit: implicit, state_before: before, state_after: after
    });
    return 0;
}

fn emit_place(borrow_mut output: Vec<MirLowerEvent>, borrow_mut next: Vec<i64>) -> i64
requires_caps [allocate]
{
    let id: i64 = vec_get<i64>(next, 0);
    vec_push<MirLowerEvent>(output, mir_event_place(id));
    vec_set<i64>(next, 0, checked_add(id, 1));
    return id;
}

fn cleanup_live(
    borrow bindings: Vec<MirOwnershipBinding>, borrow_mut states: Vec<i32>,
    borrow_mut output: Vec<MirLowerEvent>, borrow_mut records: Vec<MirOwnershipRecord>,
    borrow_mut next: Vec<i64>
) -> i32
requires_caps [allocate]
{
    var i: i64 = vec_len<MirOwnershipBinding>(bindings);
    while (i > 0) {
        i = checked_sub(i, 1);
        let b: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, i);
        if (b.owned != 0) {
            if (vec_get<i32>(states, i) == 1) {
                let id: i64 = emit_place(output, next);
                append_record(records, 6, id, b.binding_id, -1, b.local_id, 1, 1, 3);
                vec_set<i32>(states, i, 3);
            }
        }
    }
    return 0;
}

fn merge_if(
    borrow bindings: Vec<MirOwnershipBinding>, borrow_mut states: Vec<i32>,
    borrow snapshots: Vec<i32>, borrow frame: OwnershipFrame, terminated: i32
) -> i32
{
    if (frame.seen_else == 0) {
        if (terminated != 0) { restore(states, snapshots, frame.entry_start); return 0; }
        if (states_equal(states, snapshots, frame.entry_start) == 0) { return 61; }
        return 0;
    }
    if (frame.then_terminated != 0) {
        if (terminated != 0) { restore(states, snapshots, frame.entry_start); return 1; }
        return 0;
    }
    if (terminated != 0) { restore(states, snapshots, frame.then_start); return 0; }
    var i: i64 = 0;
    while (i < vec_len<MirOwnershipBinding>(bindings)) {
        if (vec_get<i32>(states, i) != vec_get<i32>(snapshots, checked_add(frame.then_start, i))) { return 62; }
        i = checked_add(i, 1);
    }
    return 0;
}

fn finish_match_arm(
    borrow_mut states: Vec<i32>, borrow_mut snapshots: Vec<i32>,
    survivor: i64, terminated: i32
) -> i64
requires_caps [allocate]
{
    if (terminated != 0) { return survivor; }
    if (survivor < 0) { return snapshot(states, snapshots); }
    if (states_equal(states, snapshots, survivor) == 0) { return -80; }
    return survivor;
}

fn replace_from_binding(
    borrow event: MirOwnershipEvent, borrow bindings: Vec<MirOwnershipBinding>,
    borrow_mut states: Vec<i32>, borrow_mut output: Vec<MirLowerEvent>,
    borrow_mut records: Vec<MirOwnershipRecord>, borrow_mut next: Vec<i64>
) -> i32
requires_caps [allocate]
{
    let target_index: i64 = find_binding(bindings, event.a);
    let source_index: i64 = find_binding(bindings, event.b);
    if (target_index < 0) { return 66; }
    if (source_index < 0) { return 67; }
    if (target_index == source_index) { return 68; }
    let target: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, target_index);
    let source: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, source_index);
    if (target.owned == 0) { return 69; }
    if (target.mutable == 0) { return 70; }
    if (source.owned == 0) { return 71; }
    if (vec_get<i32>(states, target_index) != 1) { return 72; }
    if (vec_get<i32>(states, source_index) != 1) { return 73; }
    let drop_id: i64 = emit_place(output, next);
    append_record(records, 4, drop_id, event.a, -1, target.local_id, 0, 1, 3);
    let move_id: i64 = emit_place(output, next);
    append_record(records, 5, move_id, event.a, event.b, source.local_id, 0, 3, 1);
    vec_set<i32>(states, source_index, 2);
    vec_set<i32>(states, target_index, 1);
    return 0;
}

fn worker(
    borrow input: Vec<MirOwnershipEvent>, borrow bindings: Vec<MirOwnershipBinding>,
    borrow_mut states: Vec<i32>, borrow_mut snapshots: Vec<i32>,
    borrow_mut frames: Vec<OwnershipFrame>, borrow_mut next: Vec<i64>,
    borrow_mut output: Vec<MirLowerEvent>, borrow_mut records: Vec<MirOwnershipRecord>
) -> i32
requires_caps [allocate]
{
    var terminated: i32 = 0;
    var index: i64 = 0;
    while (index < vec_len<MirOwnershipEvent>(input)) {
        let event: MirOwnershipEvent = vec_get<MirOwnershipEvent>(input, index);
        let kind: i32 = event.kind;
        var handled: i32 = 0;

        if (kind == 1) { handled = 1; if (terminated != 0) { return 20; } emit_place(output, next); }
        if (kind == 2) {
            handled = 1; if (terminated != 0) { return 21; }
            let bi: i64 = find_binding(bindings, event.a); if (bi < 0) { return 22; }
            if (vec_get<i32>(states, bi) != 0) { return 23; }
            let b: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, bi);
            vec_set<i32>(states, bi, 1); append_record(records, 1, -1, event.a, -1, b.local_id, 0, 0, 1);
        }
        if (kind == 3) {
            handled = 1; if (terminated != 0) { return 24; }
            let si: i64 = find_binding(bindings, event.a); let di: i64 = find_binding(bindings, event.b);
            if (si < 0) { return 25; } if (di < 0) { return 26; }
            let s: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, si);
            let d: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, di);
            if (s.owned == 0) { return 27; } if (d.owned == 0) { return 28; }
            if (vec_get<i32>(states, si) != 1) { return 29; } if (vec_get<i32>(states, di) != 0) { return 30; }
            let id: i64 = emit_place(output, next); append_record(records, 2, id, event.a, event.b, s.local_id, 0, 1, 2);
            vec_set<i32>(states, si, 2); vec_set<i32>(states, di, 1);
        }
        if (kind == 7) {
            handled = 1; if (terminated != 0) { return 90; }
            let target_index: i64 = find_binding(bindings, event.a);
            if (target_index < 0) { return 91; }
            let target: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, target_index);
            if (target.mutable == 0) { return 92; }
            if (target.owned != 0) { return 93; }
            if (event.b < 0) { return 94; }
            emit_place(output, next);
        }
        if (kind == 8) {
            handled = 1; if (terminated != 0) { return 95; }
            if (event.a < 0) { return 96; }
            emit_place(output, next);
        }
        if (kind == 4) {
            handled = 1; if (terminated != 0) { return 31; }
            let bi: i64 = find_binding(bindings, event.a); if (bi < 0) { return 32; }
            let b: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, bi); if (b.owned == 0) { return 33; }
            if (vec_get<i32>(states, bi) != 1) { return 34; }
            let id: i64 = emit_place(output, next); append_record(records, 3, id, event.a, -1, b.local_id, 0, 1, 3); vec_set<i32>(states, bi, 3);
        }
        if (kind == 5) {
            handled = 1; if (terminated != 0) { return 35; }
            let bi: i64 = find_binding(bindings, event.a); if (bi < 0) { return 36; }
            let b: MirOwnershipBinding = vec_get<MirOwnershipBinding>(bindings, bi);
            if (b.owned == 0) { return 37; } if (b.mutable == 0) { return 38; }
            if (vec_get<i32>(states, bi) != 1) { return 39; } if (event.b < 0) { return 40; }
            let drop_id: i64 = emit_place(output, next); append_record(records, 4, drop_id, event.a, -1, b.local_id, 0, 1, 3);
            let move_id: i64 = emit_place(output, next); append_record(records, 5, move_id, event.a, -1, event.b, 0, 3, 1);
        }
        if (kind == 6) { handled = 1; if (terminated != 0) { return 74; } let s: i32 = replace_from_binding(event, bindings, states, output, records, next); if (s != 0) { return s; } }
        if (kind == 10) { handled = 1; if (terminated != 0) { return 41; } if (event.a < -1) { return 42; } cleanup_live(bindings, states, output, records, next); vec_push<MirLowerEvent>(output, mir_event_return(event.a)); terminated = 1; }

        if (kind == 20) {
            handled = 1; if (terminated != 0) { return 43; } if (event.a < 0) { return 44; }
            let entry: i64 = snapshot(states, snapshots);
            vec_push<OwnershipFrame>(frames, OwnershipFrame { kind: 20, entry_start: entry, then_start: -1, then_terminated: 0, seen_else: 0, match_count: 0, match_started: 0 });
            vec_push<MirLowerEvent>(output, mir_event_if(event.a)); terminated = 0;
        }
        if (kind == 21) {
            handled = 1; if (vec_len<OwnershipFrame>(frames) == 0) { return 45; }
            let fi: i64 = checked_sub(vec_len<OwnershipFrame>(frames), 1); let f: OwnershipFrame = vec_get<OwnershipFrame>(frames, fi);
            if (f.kind != 20) { return 46; } if (f.seen_else != 0) { return 47; }
            let then_start: i64 = snapshot(states, snapshots); restore(states, snapshots, f.entry_start);
            vec_set<OwnershipFrame>(frames, fi, OwnershipFrame { kind: 20, entry_start: f.entry_start, then_start: then_start, then_terminated: terminated, seen_else: 1, match_count: 0, match_started: 0 });
            vec_push<MirLowerEvent>(output, mir_event_else()); terminated = 0;
        }
        if (kind == 22) {
            handled = 1; if (vec_len<OwnershipFrame>(frames) == 0) { return 48; }
            let f: OwnershipFrame = vec_pop<OwnershipFrame>(frames); if (f.kind != 20) { return 49; }
            let s: i32 = merge_if(bindings, states, snapshots, f, terminated); if (s == 61) { return 61; } if (s == 62) { return 62; }
            vec_push<MirLowerEvent>(output, mir_event_end_if()); if (s == 1) { terminated = 1; } else { terminated = 0; }
        }
        if (kind == 29) {
            handled = 1; if (terminated != 0) { return 50; }
            let entry: i64 = snapshot(states, snapshots);
            vec_push<OwnershipFrame>(frames, OwnershipFrame { kind: 30, entry_start: entry, then_start: -1, then_terminated: 0, seen_else: 0, match_count: 0, match_started: 0 });
            vec_push<MirLowerEvent>(output, mir_event_begin_while()); terminated = 0;
        }
        if (kind == 30) {
            handled = 1; if (terminated != 0) { return 51; } if (event.a < 0) { return 54; }
            if (vec_len<OwnershipFrame>(frames) == 0) { return 55; }
            let frame: OwnershipFrame = vec_get<OwnershipFrame>(frames, checked_sub(vec_len<OwnershipFrame>(frames), 1));
            if (frame.kind != 30) { return 56; }
            vec_push<MirLowerEvent>(output, mir_event_while(event.a)); terminated = 0;
        }
        if (kind == 31) {
            handled = 1; if (vec_len<OwnershipFrame>(frames) == 0) { return 52; }
            let f: OwnershipFrame = vec_pop<OwnershipFrame>(frames); if (f.kind != 30) { return 53; }
            if (terminated == 0) { if (states_equal(states, snapshots, f.entry_start) == 0) { return 63; } }
            restore(states, snapshots, f.entry_start); vec_push<MirLowerEvent>(output, mir_event_end_while()); terminated = 0;
        }

        if (kind == 40) {
            handled = 1; if (terminated != 0) { return 75; } if (event.a < 0) { return 76; } if (event.b <= 0) { return 77; }
            let entry: i64 = snapshot(states, snapshots);
            vec_push<OwnershipFrame>(frames, OwnershipFrame { kind: 40, entry_start: entry, then_start: -1, then_terminated: 0, seen_else: 0, match_count: event.b, match_started: 0 });
            vec_push<MirLowerEvent>(output, mir_event_match(event.a, checked_add(event.b, 1))); terminated = 1;
        }
        if (kind == 41) {
            handled = 1; if (vec_len<OwnershipFrame>(frames) == 0) { return 78; }
            let fi: i64 = checked_sub(vec_len<OwnershipFrame>(frames), 1); let f: OwnershipFrame = vec_get<OwnershipFrame>(frames, fi);
            if (f.kind != 40) { return 79; } if (event.b != f.match_started) { return 81; } if (event.b >= f.match_count) { return 82; }
            var survivor: i64 = f.then_start;
            if (f.match_started > 0) {
                survivor = finish_match_arm(states, snapshots, survivor, terminated); if (survivor == -80) { return 80; }
                restore(states, snapshots, f.entry_start);
            }
            vec_set<OwnershipFrame>(frames, fi, OwnershipFrame { kind: 40, entry_start: f.entry_start, then_start: survivor, then_terminated: 0, seen_else: 0, match_count: f.match_count, match_started: checked_add(f.match_started, 1) });
            vec_push<MirLowerEvent>(output, mir_event_case(event.a)); terminated = 0;
        }
        if (kind == 42) {
            handled = 1; if (vec_len<OwnershipFrame>(frames) == 0) { return 83; }
            let f: OwnershipFrame = vec_pop<OwnershipFrame>(frames); if (f.kind != 40) { return 84; } if (f.match_started != f.match_count) { return 85; }
            let survivor: i64 = finish_match_arm(states, snapshots, f.then_start, terminated); if (survivor == -80) { return 80; }
            vec_push<MirLowerEvent>(output, mir_event_default()); vec_push<MirLowerEvent>(output, mir_event_unreachable()); vec_push<MirLowerEvent>(output, mir_event_end_match());
            if (survivor < 0) { restore(states, snapshots, f.entry_start); terminated = 1; }
            else { restore(states, snapshots, survivor); terminated = 0; }
        }

        if (handled == 0) { return 64; }
        index = checked_add(index, 1);
    }
    if (vec_len<OwnershipFrame>(frames) != 0) { return 65; }
    return 0;
}

pub fn lower_ownership_flow(
    borrow input: Vec<MirOwnershipEvent>, borrow bindings: Vec<MirOwnershipBinding>,
    allocator: Allocator, borrow_mut output: Vec<MirLowerEvent>, borrow_mut records: Vec<MirOwnershipRecord>
) -> i32
requires_caps [allocate]
{
    if (vec_len<MirOwnershipEvent>(input) == 0) { return 1; }
    let binding_status: i32 = validate_bindings(bindings); if (binding_status != 0) { return binding_status; }
    var states: Vec<i32> = vec_new<i32>(allocator, vec_len<MirOwnershipBinding>(bindings));
    var i: i64 = 0; while (i < vec_len<MirOwnershipBinding>(bindings)) { vec_push<i32>(states, 0); i = checked_add(i, 1); }
    var snapshots: Vec<i32> = vec_new<i32>(allocator, 16);
    var frames: Vec<OwnershipFrame> = vec_new<OwnershipFrame>(allocator, 8);
    var next: Vec<i64> = vec_new<i64>(allocator, 1); vec_push<i64>(next, 0);
    let status: i32 = worker(input, bindings, states, snapshots, frames, next, output, records);
    drop(next); drop(frames); drop(snapshots); drop(states); return status;
}

pub fn validate_ownership_records(borrow records: Vec<MirOwnershipRecord>, borrow bindings: Vec<MirOwnershipBinding>) -> i32 {
    var previous: i64 = -1; var i: i64 = 0;
    while (i < vec_len<MirOwnershipRecord>(records)) {
        let r: MirOwnershipRecord = vec_get<MirOwnershipRecord>(records, i);
        if (r.kind < 1) { return 1; } if (r.kind > 6) { return 1; } if (find_binding(bindings, r.binding_id) < 0) { return 2; }
        if (r.kind == 1) { if (r.instruction_id != -1) { return 3; } if (r.state_before != 0) { return 4; } if (r.state_after != 1) { return 4; } }
        else { if (r.instruction_id <= previous) { return 5; } previous = r.instruction_id; if (r.state_before < 1) { return 6; } if (r.state_after < 1) { return 6; } }
        if (r.kind == 5) { if (r.other_binding_id >= 0) { if (r.other_binding_id == r.binding_id) { return 8; } if (find_binding(bindings, r.other_binding_id) < 0) { return 9; } } }
        if (r.implicit < 0) { return 7; } if (r.implicit > 1) { return 7; }
        i = checked_add(i, 1);
    }
    return 0;
}
