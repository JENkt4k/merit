module bootstrap_mir_ownership_flow
import bootstrap_mir_structured_lowering;

capability allocate;

// Pre-MIR ownership events. Match uses semantic case values/ordinals and is
// exhaustive; structured MIR receives one defensive default/unreachable edge.
pub struct MirOwnershipBinding { binding_id: i64; local_id: i64; owned: i32; mutable: i32; needs_drop: i32; }
pub struct MirOwnershipEvent { kind: i32; a: i64; b: i64; }
pub struct MirOwnershipRecord {
    kind: i32; instruction_id: i64; binding_id: i64; other_binding_id: i64;
    operand_local: i64; implicit: i32; state_before: i32; state_after: i32;
}

// if: entry, then snapshot, then terminated, seen else
// while: entry snapshot
// match: entry, surviving-arm snapshot, match_count, match_started
struct OwnershipFrame {
    kind: i32; entry_start: i64; then_start: i64; then_terminated: i32; seen_else: i32;
    match_count: i64; match_started: i64;
}

pub fn ownership_binding(binding_id: i64, local_id: i64, owned: i32, mutable: i32) -> MirOwnershipBinding {
    return MirOwnershipBinding { binding_id: binding_id, local_id: local_id, owned: owned, mutable: mutable, needs_drop: owned };
}
pub fn ownership_binding_with_drop(
    binding_id:i64,local_id:i64,owned:i32,mutable:i32,needs_drop:i32
)->MirOwnershipBinding{
    return MirOwnershipBinding{
        binding_id:binding_id,local_id:local_id,owned:owned,mutable:mutable,needs_drop:needs_drop
    };
}
pub fn ownership_binding_id(borrow value: MirOwnershipBinding) -> i64 { return value.binding_id; }
pub fn ownership_binding_local_id(borrow value: MirOwnershipBinding) -> i64 { return value.local_id; }
pub fn ownership_binding_owned(borrow value: MirOwnershipBinding) -> i32 { return value.owned; }
pub fn ownership_binding_mutable(borrow value: MirOwnershipBinding) -> i32 { return value.mutable; }
pub fn ownership_binding_needs_drop(borrow value:MirOwnershipBinding)->i32{return value.needs_drop;}

