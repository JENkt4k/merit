module bootstrap_tokens

pub struct Token {
    kind: i32;
    start: i64;
    length: i64;
}

pub fn token_identifier_kind() -> i32 { return 1; }
pub fn token_number_kind() -> i32 { return 2; }
pub fn token_string_kind() -> i32 { return 3; }
pub fn token_punctuation_kind() -> i32 { return 4; }
pub fn token_invalid_string_kind() -> i32 { return 5; }

// Canonical ASCII representation used by the bootstrap lexer. Merit does not
// yet expose byte literals at this stage, so grammar consumers reference these
// symbols instead of duplicating the numeric encoding.
pub fn token_horizontal_tab_byte() -> i64 { return 9; }
pub fn token_line_feed_byte() -> i64 { return 10; }
pub fn token_carriage_return_byte() -> i64 { return 13; }
pub fn token_space_byte() -> i64 { return 32; }
pub fn token_exclamation_byte() -> i64 { return 33; }
pub fn token_quote_byte() -> i64 { return 34; }
pub fn token_open_paren_byte() -> i64 { return 40; }
pub fn token_close_paren_byte() -> i64 { return 41; }
pub fn token_asterisk_byte() -> i64 { return 42; }
pub fn token_plus_byte() -> i64 { return 43; }
pub fn token_comma_byte() -> i64 { return 44; }
pub fn token_minus_byte() -> i64 { return 45; }
pub fn token_dot_byte() -> i64 { return 46; }
pub fn token_slash_byte() -> i64 { return 47; }
pub fn token_digit_zero_byte() -> i64 { return 48; }
pub fn token_digit_nine_byte() -> i64 { return 57; }
pub fn token_colon_byte() -> i64 { return 58; }
pub fn token_semicolon_byte() -> i64 { return 59; }
pub fn token_less_than_byte() -> i64 { return 60; }
pub fn token_equals_byte() -> i64 { return 61; }
pub fn token_greater_than_byte() -> i64 { return 62; }
pub fn token_uppercase_a_byte() -> i64 { return 65; }
pub fn token_uppercase_e_byte() -> i64 { return 69; }
pub fn token_uppercase_z_byte() -> i64 { return 90; }
pub fn token_backslash_byte() -> i64 { return 92; }
pub fn token_underscore_byte() -> i64 { return 95; }
pub fn token_lowercase_a_byte() -> i64 { return 97; }
pub fn token_lowercase_e_byte() -> i64 { return 101; }
pub fn token_lowercase_z_byte() -> i64 { return 122; }
pub fn token_open_brace_byte() -> i64 { return 123; }
pub fn token_close_brace_byte() -> i64 { return 125; }

pub fn token_kind(borrow token: Token) -> i32 {
    return token.kind;
}

pub fn token_start(borrow token: Token) -> i64 {
    return token.start;
}

pub fn token_length(borrow token: Token) -> i64 {
    return token.length;
}
