module bootstrap_mir_resolved_source_function_bundle
import bootstrap_mir_functions;
import bootstrap_mir_function_contracts;
import bootstrap_mir_function_assembly_plan;
import bootstrap_mir_function_instruction_source;
import bootstrap_mir_ownership_flow;
import bootstrap_mir_cfg;
import bootstrap_mir_cfg_placement;
import bootstrap_mir_resolved_source_function_snapshot;
import bootstrap_statement_semantics;

// resolved-source-function-bundle-v3/v4
// magic "MRBF", version, function count, then for each function:
// snapshot value count followed by a bootstrap-resolved-source-function-
// snapshot-v9 payload. The first payload carries the canonical effective
// source; later payloads use an empty source section and inherit the first.

fn resolved_source_function_bundle_magic()->i64{return 1297236550;}
fn resolved_source_function_bundle_version()->i64{return 2;}
fn resolved_source_function_project_bundle_version()->i64{return 3;}
fn resolved_source_function_project_artifact_bundle_version()->i64{return 4;}
fn resolved_source_function_bundle_metadata_magic()->i64{return 1296389185;}
fn resolved_source_function_project_artifact_magic()->i64{return 1296253266;}

pub fn resolved_source_function_snapshot_value_count(
    borrow effective_source: Buffer,
    borrow body: Vec<MirFunctionRecord>,
    borrow contracts: Vec<MirFunctionContractRecord>,
    borrow contract_locals: Vec<MirFunctionContractLocal>,
    borrow sources: Vec<MirFunctionInstructionSource>,
    borrow ownership_bindings: Vec<MirOwnershipBinding>,
    borrow ownership_records: Vec<MirOwnershipRecord>,
    borrow cfg: Vec<MirCfgRecord>,
    borrow placements: Vec<MirPlacementRecord>,
    borrow capabilities: Vec<i64>,
    borrow type_descriptors: Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors: Vec<MirNumericTypeDescriptor>,
    borrow destructor_descriptors: Vec<MirDestructorDescriptor>,
    borrow destructor_body: Vec<MirFunctionRecord>,
    borrow destructor_cfg: Vec<MirCfgRecord>,
    borrow destructor_placements: Vec<MirPlacementRecord>
) -> i64 {
    var count: i64 = 18; // magic + version + sixteen section counts
    count = checked_add(count, checked_mul(vec_len<MirFunctionRecord>(body), 16));
    count = checked_add(count, checked_mul(vec_len<MirFunctionContractRecord>(contracts), 12));
    count = checked_add(count, checked_mul(vec_len<MirFunctionContractLocal>(contract_locals), 5));
    count = checked_add(count, checked_mul(vec_len<MirFunctionInstructionSource>(sources), 8));
    count = checked_add(count, checked_mul(vec_len<MirOwnershipBinding>(ownership_bindings), 4));
    count = checked_add(count, checked_mul(vec_len<MirOwnershipRecord>(ownership_records), 8));
    count = checked_add(count, checked_mul(vec_len<MirCfgRecord>(cfg), 7));
    count = checked_add(count, checked_mul(vec_len<MirPlacementRecord>(placements), 3));
    count = checked_add(count, vec_len<i64>(capabilities));
    count = checked_add(count, checked_mul(vec_len<MirTypeDescriptor>(type_descriptors), 11));
    count = checked_add(count, checked_mul(vec_len<MirNumericTypeDescriptor>(numeric_type_descriptors), 11));
    count = checked_add(count, checked_mul(vec_len<MirDestructorDescriptor>(destructor_descriptors), 7));
    count = checked_add(count, checked_mul(vec_len<MirFunctionRecord>(destructor_body), 16));
    count = checked_add(count, checked_mul(vec_len<MirCfgRecord>(destructor_cfg), 7));
    count = checked_add(count, checked_mul(vec_len<MirPlacementRecord>(destructor_placements), 3));
    count = checked_add(count, buffer_len(effective_source));
    return count;
}

pub fn print_resolved_source_function_bundle_header(function_count: i64) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_bundle_version());
    print(function_count);
    return 0;
}

pub fn print_resolved_source_function_project_bundle_header(function_count: i64) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_project_bundle_version());
    print(function_count);
    return 0;
}

pub fn print_resolved_source_function_project_artifact_bundle_header(
    function_count: i64
) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_project_artifact_bundle_version());
    print(function_count);
    return 0;
}

fn print_resolved_source_function_artifact_bytes(borrow value: Buffer) -> i32 {
    if (buffer_len(value) <= 0) { return 1; }
    print(buffer_len(value));
    var offset: i64 = 0;
    while (offset < buffer_len(value)) {
        print(buffer_get(value, offset));
        offset = checked_add(offset, 1);
    }
    return 0;
}

pub fn print_resolved_source_function_project_artifacts(
    borrow canonical_mir: Buffer,
    borrow c_source: Buffer,
    borrow c_header: Buffer
) -> i32 {
    if (buffer_len(canonical_mir) <= 0) { return 1; }
    if (buffer_len(c_source) <= 0) { return 2; }
    if (buffer_len(c_header) <= 0) { return 3; }
    print(resolved_source_function_project_artifact_magic());
    let mir_status: i32 = print_resolved_source_function_artifact_bytes(canonical_mir);
    if (mir_status != 0) { return checked_add(10, mir_status); }
    let source_status: i32 = print_resolved_source_function_artifact_bytes(c_source);
    if (source_status != 0) { return checked_add(20, source_status); }
    let header_status: i32 = print_resolved_source_function_artifact_bytes(c_header);
    if (header_status != 0) { return checked_add(30, header_status); }
    return 0;
}

// First SH3 canonical-MIR materializer slice. This writes the established
// bootstrap-mir-v1 canonical JSON directly from validated Merit-owned
// straight-line function records. It deliberately fails closed for record
// kinds outside this bounded slice; later SH3 slices extend this same writer.
fn canonical_mir_append_text(borrow_mut output:Buffer,value:String)->i32
requires_caps [allocate]
{
    var index:i64=0;
    while(index<string_len(value)){
        buffer_push(output,string_byte(value,index));
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_mir_append_i64(borrow_mut output:Buffer,value:i64)->i32
requires_caps [allocate]
{
    var magnitude:i64=value;
    if(magnitude<0){
        buffer_push(output,45);
        magnitude=checked_sub(0,magnitude);
    }
    if(magnitude==0){buffer_push(output,48);return 0;}
    var divisor:i64=1;
    while((magnitude/divisor)>=10){divisor=checked_mul(divisor,10);}
    while(divisor>0){
        let digit:i64=magnitude/divisor;
        if(digit==0){buffer_push(output,48);}
        if(digit==1){buffer_push(output,49);}
        if(digit==2){buffer_push(output,50);}
        if(digit==3){buffer_push(output,51);}
        if(digit==4){buffer_push(output,52);}
        if(digit==5){buffer_push(output,53);}
        if(digit==6){buffer_push(output,54);}
        if(digit==7){buffer_push(output,55);}
        if(digit==8){buffer_push(output,56);}
        if(digit==9){buffer_push(output,57);}
        magnitude=checked_sub(magnitude,checked_mul(digit,divisor));
        divisor=divisor/10;
    }
    return 0;
}

fn canonical_mir_append_i32(borrow_mut output:Buffer,value:i32)->i32
requires_caps [allocate]
{
    var magnitude:i32=value;
    if(magnitude<0){buffer_push(output,45);magnitude=checked_sub(0,magnitude);}
    if(magnitude==0){buffer_push(output,48);return 0;}
    var divisor:i32=1;
    while((magnitude/divisor)>=10){divisor=checked_mul(divisor,10);}
    while(divisor>0){
        let digit:i32=magnitude/divisor;
        if(digit==0){buffer_push(output,48);}if(digit==1){buffer_push(output,49);}
        if(digit==2){buffer_push(output,50);}if(digit==3){buffer_push(output,51);}
        if(digit==4){buffer_push(output,52);}if(digit==5){buffer_push(output,53);}
        if(digit==6){buffer_push(output,54);}if(digit==7){buffer_push(output,55);}
        if(digit==8){buffer_push(output,56);}if(digit==9){buffer_push(output,57);}
        magnitude=checked_sub(magnitude,checked_mul(digit,divisor));divisor=divisor/10;
    }
    return 0;
}

// Project assembly deliberately consumes the canonical single-function bytes
// produced by this module instead of reinterpreting the function records a
// second time.  The fixed wrapper is validated byte-for-byte and stripped;
// callers can therefore append functions while their lowering vectors are
// still live, then release those vectors before lowering the next function.
pub fn canonical_mir_begin_project(borrow_mut output:Buffer)->i32
requires_caps [allocate]
{
    if(buffer_len(output)!=0){return 1;}
    return canonical_mir_append_text(output,"{\"functions\":[");
}

pub fn canonical_mir_append_project_function(
    borrow single_function_module:Buffer,
    function_ordinal:i64,
    allocator:Allocator,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_ordinal<0){return 1;}
    let prefix:Buffer=buffer_from_string(allocator,"{\"functions\":[");
    let suffix:Buffer=buffer_from_string(allocator,"],\"name\":\"_\",\"schema\":\"bootstrap-mir-v1\"}");
    let prefix_length:i64=buffer_len(prefix);
    let suffix_length:i64=buffer_len(suffix);
    var status:i32=0;
    if(buffer_len(single_function_module)<=checked_add(prefix_length,suffix_length)){
        status=2;
    }
    var index:i64=0;
    if(status==0){
        while(index<prefix_length){
            if(buffer_get(single_function_module,index)!=buffer_get(prefix,index)){
                status=3;index=prefix_length;
            }else{
                index=checked_add(index,1);
            }
        }
    }
    index=0;
    if(status==0){
        while(index<suffix_length){
            let source_index:i64=checked_add(
                checked_sub(buffer_len(single_function_module),suffix_length),index
            );
            if(buffer_get(single_function_module,source_index)!=buffer_get(suffix,index)){
                status=4;index=suffix_length;
            }else{
                index=checked_add(index,1);
            }
        }
    }
    if(status==0){
        if(function_ordinal>0){buffer_push(output,44);}
        let body_end:i64=checked_sub(buffer_len(single_function_module),suffix_length);
        bootstrap_buffer_append(
            output,single_function_module,prefix_length,
            checked_sub(body_end,prefix_length)
        );
    }
    drop(suffix);drop(prefix);
    return status;
}

pub fn canonical_mir_finish_project(
    module_name:String,
    function_count:i64,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_count<=0){return 1;}
    canonical_mir_append_text(output,"],\"name\":");
    if(canonical_mir_append_json_string(output,module_name)!=0){return 2;}
    canonical_mir_append_text(output,",\"schema\":\"bootstrap-mir-v1\"}");
    return 0;
}

pub fn canonical_mir_finish_project_source(
    borrow source:Buffer,
    module_start:i64,
    module_length:i64,
    function_count:i64,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_count<=0){return 1;}
    canonical_mir_append_text(output,"],\"name\":");
    if(canonical_mir_append_json_source(output,source,module_start,module_length)!=0){return 2;}
    canonical_mir_append_text(output,",\"schema\":\"bootstrap-mir-v1\"}");
    return 0;
}

fn canonical_c_append_function_name(
    borrow source:Buffer,borrow header:MirFunctionRecord,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_mir_mutable(header)!=0){canonical_mir_append_text(output,"merit_");}
    bootstrap_buffer_append(
        output,source,function_mir_symbol_start(header),function_mir_symbol_length(header)
    );
    return 0;
}

fn canonical_c_append_scalar_type(borrow_mut output:Buffer,type_code:i32)->i32
requires_caps [allocate]
{
    if(type_code==function_mir_i64_type_code()){
        canonical_mir_append_text(output,"int64_t");return 0;
    }
    if(type_code==function_mir_i32_type_code()){
        canonical_mir_append_text(output,"int32_t");return 0;
    }
    if(type_code==function_mir_bool_type_code()){
        canonical_mir_append_text(output,"bool");return 0;
    }
    if(type_code==function_mir_unit_type_code()){
        canonical_mir_append_text(output,"void");return 0;
    }
    if(type_code==function_mir_string_type_code()){
        canonical_mir_append_text(output,"merit_String");return 0;
    }
    return 1;
}

fn canonical_c_append_scalar_prototype(
    borrow source:Buffer,borrow header:MirFunctionRecord,
    borrow records:Vec<MirFunctionRecord>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(canonical_c_append_scalar_type(output,function_mir_type_code(header))!=0){return 3;}
    buffer_push(output,32);
    canonical_c_append_function_name(source,header,output);
    if(canonical_c_append_scalar_parameters(records,output)!=0){return 4;}
    buffer_push(output,59);
    return 0;
}

fn canonical_c_append_scalar_parameters(
    borrow records:Vec<MirFunctionRecord>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    buffer_push(output,40);
    let header:MirFunctionRecord=vec_get<MirFunctionRecord>(records,0);
    let parameter_count:i64=function_mir_ordinal(header);
    if(parameter_count==0){canonical_mir_append_text(output,"void");}
    var ordinal:i64=0;
    while(ordinal<parameter_count){
        var found:i32=0;var index:i64=1;var matched_type:i32=0;
        while(index<vec_len<MirFunctionRecord>(records)){
            let parameter:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
            if(function_mir_kind(parameter)==function_mir_kind_parameter()){
                if(function_mir_ordinal(parameter)==ordinal){
                    if(found!=0){return 1;}
                    if(function_mir_id(parameter)!=ordinal){return 2;}
                    let parameter_type:i32=function_mir_type_code(parameter);
                    if(parameter_type!=function_mir_i64_type_code()){
                        if(parameter_type!=function_mir_i32_type_code()){
                            if(parameter_type!=function_mir_bool_type_code()){
                                if(parameter_type!=function_mir_string_type_code()){return 3;}
                            }
                        }
                    }
                    if(function_mir_symbol_code(parameter)!=function_mir_mode_value()){return 4;}
                    matched_type=parameter_type;found=1;
                }
            }
            index=checked_add(index,1);
        }
        if(found==0){return 5;}
        if(ordinal>0){canonical_mir_append_text(output,", ");}
        if(canonical_c_append_scalar_type(output,matched_type)!=0){return 3;}
        canonical_mir_append_text(output," m");canonical_mir_append_i64(output,ordinal);
        ordinal=checked_add(ordinal,1);
    }
    buffer_push(output,41);
    return 0;
}

fn canonical_c_checked_add_feature()->i64{return 1;}
fn canonical_c_i64_print_feature()->i64{return 2;}
fn canonical_c_checked_multiply_feature()->i64{return 3;}
fn canonical_c_checked_subtract_feature()->i64{return 4;}
fn canonical_c_checked_divide_feature()->i64{return 5;}
fn canonical_c_checked_i32_add_feature()->i64{return 6;}
fn canonical_c_checked_i32_multiply_feature()->i64{return 7;}
fn canonical_c_checked_i32_subtract_feature()->i64{return 8;}
fn canonical_c_checked_i32_divide_feature()->i64{return 9;}
fn canonical_c_text_feature()->i64{return 10;}
fn canonical_c_public_string_feature()->i64{return 11;}

fn canonical_c_require_feature(feature:i64,borrow_mut features:Vec<i64>)->i32
requires_caps [allocate]
{
    var index:i64=0;
    while(index<vec_len<i64>(features)){
        if(vec_get<i64>(features,index)==feature){return 0;}
        index=checked_add(index,1);
    }
    vec_push<i64>(features,feature);return 0;
}

fn canonical_c_has_feature(feature:i64,borrow features:Vec<i64>)->i32
{
    var index:i64=0;
    while(index<vec_len<i64>(features)){
        if(vec_get<i64>(features,index)==feature){return 1;}
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_c_has_checked_feature(borrow features:Vec<i64>)->i32
{
    if(canonical_c_has_feature(canonical_c_checked_add_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_subtract_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_multiply_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_divide_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_i32_add_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_i32_subtract_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_i32_multiply_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_i32_divide_feature(),features)!=0){return 1;}
    return 0;
}

fn canonical_c_scalar_local_type(borrow records:Vec<MirFunctionRecord>,local_id:i64)->i32
{
    var index:i64=1;
    while(index<vec_len<MirFunctionRecord>(records)){
        let record:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        let kind:i32=function_mir_kind(record);
        var is_local:i32=0;
        if(kind==function_mir_kind_parameter()){is_local=1;}
        if(kind==function_mir_kind_source_local()){is_local=1;}
        if(kind==function_mir_kind_temporary_local()){is_local=1;}
        if(is_local!=0){
            if(function_mir_id(record)==local_id){return function_mir_type_code(record);}
        }
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_c_append_boolean_literal(
    borrow source:Buffer,start:i64,length:i64,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(start<0){return 1;}
    if(length<=0){return 1;}
    if(checked_add(start,length)>buffer_len(source)){return 1;}
    // The byte values below are the ASCII source-spelling boundary.
    if(length==1){
        let value:i64=buffer_get(source,start);
        if(value==49){canonical_mir_append_text(output,"true");return 0;}
        if(value==48){canonical_mir_append_text(output,"false");return 0;}
    }
    if(length==4){
        if(buffer_get(source,start)==116){
            if(buffer_get(source,checked_add(start,1))==114){
                if(buffer_get(source,checked_add(start,2))==117){
                    if(buffer_get(source,checked_add(start,3))==101){
                        canonical_mir_append_text(output,"true");return 0;
                    }
                }
            }
        }
    }
    if(length==5){
        if(buffer_get(source,start)==102){
            if(buffer_get(source,checked_add(start,1))==97){
                if(buffer_get(source,checked_add(start,2))==108){
                    if(buffer_get(source,checked_add(start,3))==115){
                        if(buffer_get(source,checked_add(start,4))==101){
                            canonical_mir_append_text(output,"false");return 0;
                        }
                    }
                }
            }
        }
    }
    return 1;
}

fn canonical_c_append_scalar_integer_literal(
    borrow source:Buffer,start:i64,length:i64,type_code:i32,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(start<0){return 1;}
    if(length<=0){return 1;}
    if(checked_add(start,length)>buffer_len(source)){return 1;}
    var digit_start:i64=start;
    var negative:i32=0;
    let first:i64=buffer_get(source,start);
    if(first==45){negative=1;digit_start=checked_add(digit_start,1);}
    if(first==43){digit_start=checked_add(digit_start,1);}
    let end:i64=checked_add(start,length);
    if(digit_start>=end){return 1;}
    var index:i64=digit_start;
    while(index<end){
        let digit:i64=buffer_get(source,index);
        if(digit<48){return 1;}
        if(digit>57){return 1;}
        index=checked_add(index,1);
    }
    var scanning_zero:i32=1;
    while(scanning_zero!=0){
        if(digit_start>=checked_sub(end,1)){scanning_zero=0;}
        else{
            if(buffer_get(source,digit_start)==48){digit_start=checked_add(digit_start,1);}
            else{scanning_zero=0;}
        }
    }
    if(buffer_get(source,digit_start)==48){negative=0;}
    if(type_code!=function_mir_i32_type_code()){
        if(type_code!=function_mir_i64_type_code()){return 1;}
    }
    var limit:Buffer=buffer_new(system_allocator(),20);
    if(type_code==function_mir_i32_type_code()){
        if(negative!=0){canonical_mir_append_text(limit,"2147483648");}
        else{canonical_mir_append_text(limit,"2147483647");}
    }else{
        if(negative!=0){canonical_mir_append_text(limit,"9223372036854775808");}
        else{canonical_mir_append_text(limit,"9223372036854775807");}
    }
    let digits:i64=checked_sub(end,digit_start);
    var valid:i32=1;
    var minimum:i32=0;
    if(digits>buffer_len(limit)){valid=0;}
    if(digits==buffer_len(limit)){
        index=0;var comparison:i32=0;
        while(index<digits){
            let actual:i64=buffer_get(source,checked_add(digit_start,index));
            let maximum:i64=buffer_get(limit,index);
            if(comparison==0){
                if(actual>maximum){comparison=1;}
                if(actual<maximum){comparison=-1;}
            }
            index=checked_add(index,1);
        }
        if(comparison>0){valid=0;}
        if(comparison==0){
            if(negative!=0){minimum=1;}
        }
    }
    drop(limit);
    if(valid==0){return 1;}
    if(minimum!=0){
        if(type_code==function_mir_i32_type_code()){
            canonical_mir_append_text(output,"INT32_MIN");
        }else{canonical_mir_append_text(output,"INT64_MIN");}
        return 0;
    }
    if(type_code==function_mir_i32_type_code()){
        canonical_mir_append_text(output,"INT32_C(");
    }else{canonical_mir_append_text(output,"INT64_C(");}
    if(negative!=0){buffer_push(output,45);}
    bootstrap_buffer_append(output,source,digit_start,digits);
    buffer_push(output,41);
    return 0;
}

// ASCII JSON spelling and UTF-8 output are representation boundaries.
fn canonical_c_json_hex_digit(value:i64)->i64
{
    if(value>=48){if(value<=57){return checked_sub(value,48);}}
    if(value>=65){if(value<=70){return checked_sub(value,55);}}
    if(value>=97){if(value<=102){return checked_sub(value,87);}}
    return -1;
}

fn canonical_c_json_unicode_codepoint(borrow source:Buffer,start:i64,end:i64)->i64
{
    if(start<0){return -1;}
    if(checked_add(start,4)>end){return -1;}
    var codepoint:i64=0;var index:i64=0;
    while(index<4){
        let digit:i64=canonical_c_json_hex_digit(buffer_get(source,checked_add(start,index)));
        if(digit<0){return -1;}
        codepoint=checked_add(checked_mul(codepoint,16),digit);
        index=checked_add(index,1);
    }
    return codepoint;
}

fn canonical_c_append_hex_byte(value:i64,borrow_mut output:Buffer)->i32
requires_caps [allocate]
{
    if(value<0){return 1;}
    if(value>255){return 1;}
    buffer_push(output,92);buffer_push(output,120);
    let high:i64=value/16;
    let low:i64=checked_sub(value,checked_mul(high,16));
    let digits:String="0123456789abcdef";
    buffer_push(output,string_byte(digits,high));
    buffer_push(output,string_byte(digits,low));
    return 0;
}

fn canonical_c_append_utf8_codepoint(codepoint:i64,borrow_mut output:Buffer)->i64
requires_caps [allocate]
{
    if(codepoint<0){return -1;}
    if(codepoint>1114111){return -1;}
    if(codepoint>=55296){if(codepoint<=57343){return -1;}}
    if(codepoint<=127){canonical_c_append_hex_byte(codepoint,output);return 1;}
    if(codepoint<=2047){
        canonical_c_append_hex_byte(checked_add(192,codepoint/64),output);
        canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint,checked_mul(codepoint/64,64))),output);
        return 2;
    }
    if(codepoint<=65535){
        canonical_c_append_hex_byte(checked_add(224,codepoint/4096),output);
        canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint/64,checked_mul(codepoint/4096,64))),output);
        canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint,checked_mul(codepoint/64,64))),output);
        return 3;
    }
    canonical_c_append_hex_byte(checked_add(240,codepoint/262144),output);
    canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint/4096,checked_mul(codepoint/262144,64))),output);
    canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint/64,checked_mul(codepoint/4096,64))),output);
    canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint,checked_mul(codepoint/64,64))),output);
    return 4;
}

fn canonical_c_decode_json_string(
    borrow source:Buffer,start:i64,length:i64,borrow_mut output:Buffer
)->i64
requires_caps [allocate]
{
    if(start<0){return -1;}
    if(length<2){return -1;}
    let end:i64=checked_add(start,length);
    if(end>buffer_len(source)){return -1;}
    if(buffer_get(source,start)!=34){return -1;}
    let closing:i64=checked_sub(end,1);
    if(buffer_get(source,closing)!=34){return -1;}
    var cursor:i64=checked_add(start,1);
    var decoded_length:i64=0;
    while(cursor<closing){
        let byte:i64=buffer_get(source,cursor);
        if(byte<32){return -1;}
        if(byte==34){return -1;}
        if(byte!=92){
            canonical_c_append_hex_byte(byte,output);
            decoded_length=checked_add(decoded_length,1);
            cursor=checked_add(cursor,1);
        }else{
            cursor=checked_add(cursor,1);
            if(cursor>=closing){return -1;}
            let escaped:i64=buffer_get(source,cursor);
            if(escaped==117){
                let high:i64=canonical_c_json_unicode_codepoint(source,checked_add(cursor,1),closing);
                if(high<0){return -1;}
                cursor=checked_add(cursor,5);
                var codepoint:i64=high;
                if(high>=55296){
                    if(high<=56319){
                        if(checked_add(cursor,6)>closing){return -1;}
                        if(buffer_get(source,cursor)!=92){return -1;}
                        if(buffer_get(source,checked_add(cursor,1))!=117){return -1;}
                        let low:i64=canonical_c_json_unicode_codepoint(source,checked_add(cursor,2),closing);
                        if(low<56320){return -1;}
                        if(low>57343){return -1;}
                        codepoint=checked_add(65536,checked_add(
                            checked_mul(checked_sub(high,55296),1024),checked_sub(low,56320)
                        ));
                        cursor=checked_add(cursor,6);
                    }else{if(high<=57343){return -1;}}
                }
                let appended:i64=canonical_c_append_utf8_codepoint(codepoint,output);
                if(appended<0){return -1;}
                decoded_length=checked_add(decoded_length,appended);
            }else{
                var translated:i64=-1;
                if(escaped==34){translated=34;}
                if(escaped==47){translated=47;}
                if(escaped==92){translated=92;}
                if(escaped==98){translated=8;}
                if(escaped==102){translated=12;}
                if(escaped==110){translated=10;}
                if(escaped==114){translated=13;}
                if(escaped==116){translated=9;}
                if(translated<0){return -1;}
                canonical_c_append_hex_byte(translated,output);
                decoded_length=checked_add(decoded_length,1);
                cursor=checked_add(cursor,1);
            }
        }
    }
    return decoded_length;
}

fn canonical_c_append_string_literal(
    borrow source:Buffer,start:i64,length:i64,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(length<2){return 1;}
    canonical_mir_append_text(output,"(merit_String){ (const uint8_t *)\"");
    let decoded_length:i64=canonical_c_decode_json_string(source,start,length,output);
    if(decoded_length<0){return 1;}
    canonical_mir_append_text(output,"\", ");
    canonical_mir_append_i64(output,decoded_length);
    canonical_mir_append_text(output," }");
    return 0;
}

// Bounded deterministic backend: consume validated scalar records and explicit
// CFG placement, preserving the oracle's C/header bytes. Unsupported types,
// resource effects, and instruction shapes fail closed until ported in SH3.
pub fn canonical_c_append_scalar_function_with_catalog(
    borrow source:Buffer,
    borrow records:Vec<MirFunctionRecord>,
    borrow callable_headers:Vec<MirFunctionRecord>,
    borrow cfg:Vec<MirCfgRecord>,
    borrow placements:Vec<MirPlacementRecord>,
    borrow_mut prototypes:Buffer,
    borrow_mut bodies:Buffer,
    borrow_mut public_header:Buffer,
    borrow_mut features:Vec<i64>
)->i32
requires_caps [allocate]
{
    if(vec_len<MirFunctionRecord>(records)<2){return 1;}
    let header:MirFunctionRecord=vec_get<MirFunctionRecord>(records,0);
    if(function_mir_kind(header)!=function_mir_kind_function()){return 2;}
    let unit_return:i32=function_mir_type_code(header)==function_mir_unit_type_code();
    let exported:i32=function_mir_mutable(header);
    if(function_mir_type_code(header)==function_mir_string_type_code()){
        canonical_c_require_feature(canonical_c_text_feature(),features);
        if(exported!=0){canonical_c_require_feature(canonical_c_public_string_feature(),features);}
    }
    if(function_mir_type_code(header)!=function_mir_i64_type_code()){
        if(function_mir_type_code(header)!=function_mir_i32_type_code()){
            if(function_mir_type_code(header)!=function_mir_bool_type_code()){
                if(function_mir_type_code(header)!=function_mir_unit_type_code()){
                    if(function_mir_type_code(header)!=function_mir_string_type_code()){return 3;}
                }
            }
        }
    }
    let cfg_record_count:i64=vec_len<MirCfgRecord>(cfg);
    if(cfg_record_count<2){return 4;}
    var cfg_block_count:i64=0;
    var cfg_index:i64=0;
    while(cfg_index<cfg_record_count){
        let block:MirCfgRecord=vec_get<MirCfgRecord>(cfg,cfg_index);
        if(cfg_kind(block)!=cfg_block_kind()){return 5;}
        if(cfg_block_id(block)!=cfg_block_count){return 6;}
        cfg_index=checked_add(cfg_index,1);
        if(cfg_index>=cfg_record_count){return 4;}
        let terminator:MirCfgRecord=vec_get<MirCfgRecord>(cfg,cfg_index);
        if(cfg_block_id(terminator)!=cfg_block_count){return 8;}
        let term_kind:i32=cfg_kind(terminator);
        if(term_kind==cfg_return_kind()){
            if(function_mir_type_code(header)==function_mir_unit_type_code()){
                if(cfg_operand(terminator)!=-1){return 17;}
            }else{if(cfg_operand(terminator)<0){return 17;}}
        }else{if(term_kind!=cfg_jump_kind()){
            if(term_kind!=cfg_branch_kind()){
                if(term_kind!=cfg_switch_case_kind()){
                    if(term_kind!=cfg_switch_default_kind()){
                        if(term_kind!=cfg_unreachable_kind()){return 7;}
                    }
                }
            }
        }}
        if(term_kind==cfg_switch_case_kind()){
            var switch_ordinal:i64=0;
            var default_found:i32=0;
            let switch_operand:i64=cfg_operand(terminator);
            let switch_start:i64=cfg_index;
            while(default_found==0){
                if(cfg_index>=cfg_record_count){return 92;}
                let item:MirCfgRecord=vec_get<MirCfgRecord>(cfg,cfg_index);
                if(cfg_kind(item)==cfg_switch_case_kind()){
                    if(cfg_block_id(item)!=cfg_block_count){return 8;}
                    if(cfg_operand(item)!=switch_operand){return 90;}
                    if(cfg_ordinal(item)!=switch_ordinal){return 91;}
                    var previous_case:i64=switch_start;
                    while(previous_case<cfg_index){
                        let previous:MirCfgRecord=vec_get<MirCfgRecord>(cfg,previous_case);
                        if(cfg_case_value(previous)==cfg_case_value(item)){return 94;}
                        previous_case=checked_add(previous_case,1);
                    }
                    switch_ordinal=checked_add(switch_ordinal,1);
                    cfg_index=checked_add(cfg_index,1);
                }else{if(cfg_kind(item)==cfg_switch_default_kind()){
                    if(cfg_block_id(item)!=cfg_block_count){return 8;}
                    if(cfg_operand(item)!=switch_operand){return 90;}
                    if(cfg_ordinal(item)!=switch_ordinal){return 91;}
                    default_found=1;cfg_index=checked_add(cfg_index,1);
                }else{return 92;}}
            }
        }else{
            if(term_kind==cfg_switch_default_kind()){
                if(cfg_ordinal(terminator)!=0){return 91;}
            }
            cfg_index=checked_add(cfg_index,1);
        }
        cfg_block_count=checked_add(cfg_block_count,1);
    }
    var local_count:i64=0;
    var instruction_count:i64=0;
    var record_index:i64=1;
    while(record_index<vec_len<MirFunctionRecord>(records)){
        let record:MirFunctionRecord=vec_get<MirFunctionRecord>(records,record_index);
        let kind:i32=function_mir_kind(record);
        if(kind==function_mir_kind_parameter()){
            if(function_mir_type_code(record)==function_mir_string_type_code()){
                canonical_c_require_feature(canonical_c_text_feature(),features);
                if(exported!=0){canonical_c_require_feature(canonical_c_public_string_feature(),features);}
            }
            if(function_mir_type_code(record)!=function_mir_i64_type_code()){
                if(function_mir_type_code(record)!=function_mir_i32_type_code()){
                    if(function_mir_type_code(record)!=function_mir_bool_type_code()){
                        if(function_mir_type_code(record)!=function_mir_string_type_code()){return 9;}
                    }
                }
            }
            if(function_mir_symbol_code(record)!=function_mir_mode_value()){return 24;}
            if(function_mir_id(record)!=local_count){return 25;}
            local_count=checked_add(local_count,1);
        }else{if(kind==function_mir_kind_source_local()){
            if(function_mir_type_code(record)==function_mir_string_type_code()){
                canonical_c_require_feature(canonical_c_text_feature(),features);
            }
            if(function_mir_type_code(record)!=function_mir_i64_type_code()){
                if(function_mir_type_code(record)!=function_mir_i32_type_code()){
                    if(function_mir_type_code(record)!=function_mir_bool_type_code()){
                        if(function_mir_type_code(record)!=function_mir_string_type_code()){return 10;}
                    }
                }
            }
            if(function_mir_id(record)!=local_count){return 11;}
            local_count=checked_add(local_count,1);
        }else{
            if(kind==function_mir_kind_temporary_local()){
                if(function_mir_type_code(record)==function_mir_string_type_code()){
                    canonical_c_require_feature(canonical_c_text_feature(),features);
                }
                if(function_mir_type_code(record)!=function_mir_i64_type_code()){
                    if(function_mir_type_code(record)!=function_mir_bool_type_code()){
                        if(function_mir_type_code(record)!=function_mir_i32_type_code()){
                            if(function_mir_type_code(record)!=function_mir_string_type_code()){return 12;}
                        }
                    }
                }
                if(function_mir_id(record)!=local_count){return 13;}
                local_count=checked_add(local_count,1);
            }else{
                if(kind==function_mir_kind_const()){
                    instruction_count=checked_add(instruction_count,1);
                }else{
                    if(kind==function_mir_kind_copy_to_binding()){
                        instruction_count=checked_add(instruction_count,1);
                    }else{
                        if(kind==function_mir_kind_binary()){
                            instruction_count=checked_add(instruction_count,1);
                        }else{
                            if(kind==function_mir_kind_print()){
                                instruction_count=checked_add(instruction_count,1);
                            }else{
                                if(kind==function_mir_kind_call()){
                                    if(function_mir_type_code(record)==function_mir_unit_type_code()){
                                        if(function_mir_result(record)!=-1){return 60;}
                                    }else{if(function_mir_result(record)<0){return 60;}}
                                    if(function_mir_type_code(record)!=function_mir_i64_type_code()){
                                        if(function_mir_type_code(record)!=function_mir_i32_type_code()){
                                            if(function_mir_type_code(record)!=function_mir_bool_type_code()){
                                                if(function_mir_type_code(record)!=function_mir_unit_type_code()){
                                                    if(function_mir_type_code(record)!=function_mir_string_type_code()){return 61;}
                                                }
                                            }
                                        }
                                    }
                                    if(function_mir_numeric_policy(record)!=function_mir_mode_value()){return 62;}
                                    instruction_count=checked_add(instruction_count,1);
                                }else{
                                    if(kind!=function_mir_kind_call_argument()){
                                        if(kind!=function_mir_kind_return()){return 14;}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }}
        record_index=checked_add(record_index,1);
    }
    if(local_count<=0){
        if(function_mir_type_code(header)!=function_mir_unit_type_code()){return 15;}
    }
    if(instruction_count!=vec_len<MirPlacementRecord>(placements)){return 16;}
    var placement_scan:i64=0;
    while(placement_scan<vec_len<MirPlacementRecord>(placements)){
        let placement:MirPlacementRecord=vec_get<MirPlacementRecord>(placements,placement_scan);
        if(placement_block_id(placement)<0){return 87;}
        if(placement_block_id(placement)>=cfg_block_count){return 87;}
        var matching_placements:i64=0;
        var duplicate_scan:i64=0;
        while(duplicate_scan<vec_len<MirPlacementRecord>(placements)){
            let candidate:MirPlacementRecord=vec_get<MirPlacementRecord>(placements,duplicate_scan);
            if(placement_instruction_id(candidate)==placement_instruction_id(placement)){
                matching_placements=checked_add(matching_placements,1);
            }
            duplicate_scan=checked_add(duplicate_scan,1);
        }
        if(matching_placements!=1){return 88;}
        placement_scan=checked_add(placement_scan,1);
    }
    cfg_index=0;
    while(cfg_index<cfg_record_count){
        let terminator:MirCfgRecord=vec_get<MirCfgRecord>(cfg,cfg_index);
        let term_kind:i32=cfg_kind(terminator);
        if(term_kind==cfg_branch_kind()){
            if(canonical_c_scalar_local_type(records,cfg_operand(terminator))!=function_mir_bool_type_code()){return 86;}
            if(cfg_target_b(terminator)<0){return 80;}
            if(cfg_target_b(terminator)>=cfg_block_count){return 80;}
        }
        if(term_kind==cfg_return_kind()){
            if(function_mir_type_code(header)!=function_mir_unit_type_code()){
                if(canonical_c_scalar_local_type(records,cfg_operand(terminator))!=function_mir_type_code(header)){return 89;}
            }
        }
        if(term_kind==cfg_switch_case_kind()){
            if(canonical_c_scalar_local_type(records,cfg_operand(terminator))!=function_mir_i64_type_code()){return 93;}
        }
        if(term_kind==cfg_switch_default_kind()){
            if(canonical_c_scalar_local_type(records,cfg_operand(terminator))!=function_mir_i64_type_code()){return 93;}
        }
        var has_target:i32=0;
        if(term_kind==cfg_jump_kind()){has_target=1;}
        if(term_kind==cfg_branch_kind()){has_target=1;}
        if(term_kind==cfg_switch_case_kind()){has_target=1;}
        if(term_kind==cfg_switch_default_kind()){has_target=1;}
        if(has_target!=0){
            if(cfg_target_a(terminator)<0){return 27;}
            if(cfg_target_a(terminator)>=cfg_block_count){return 27;}
        }
        cfg_index=checked_add(cfg_index,1);
    }
    if(function_mir_ordinal(header)>local_count){return 26;}
    let prototype_status:i32=canonical_c_append_scalar_prototype(source,header,records,prototypes);
    if(prototype_status!=0){return checked_add(30,prototype_status);}
    buffer_push(prototypes,10);
    if(function_mir_mutable(header)!=0){
        let header_status:i32=canonical_c_append_scalar_prototype(source,header,records,public_header);
        if(header_status!=0){return checked_add(40,header_status);}
        buffer_push(public_header,10);
    }
    if(buffer_len(bodies)>0){canonical_mir_append_text(bodies,"\n\n");}
    if(canonical_c_append_scalar_type(bodies,function_mir_type_code(header))!=0){return 3;}
    buffer_push(bodies,32);
    canonical_c_append_function_name(source,header,bodies);
    let parameters_status:i32=canonical_c_append_scalar_parameters(records,bodies);
    if(parameters_status!=0){return checked_add(50,parameters_status);}
    canonical_mir_append_text(bodies," {\n");
    var local_id:i64=function_mir_ordinal(header);
    while(local_id<local_count){
        canonical_mir_append_text(bodies,"    ");
        if(canonical_c_append_scalar_type(
            bodies,canonical_c_scalar_local_type(records,local_id)
        )!=0){return 12;}
        canonical_mir_append_text(bodies," m");
        canonical_mir_append_i64(bodies,local_id);
        if(canonical_c_scalar_local_type(records,local_id)==function_mir_string_type_code()){
            canonical_mir_append_text(bodies," = {0};\n");
        }else{canonical_mir_append_text(bodies," = 0;\n");}
        local_id=checked_add(local_id,1);
    }
    canonical_mir_append_text(bodies,"    goto b0;\n");
    var emitted_placements:i64=0;
    var active_block_id:i64=0;
    var cfg_emit_index:i64=0;
    while(active_block_id<cfg_block_count){
        let active_block:MirCfgRecord=vec_get<MirCfgRecord>(cfg,cfg_emit_index);
        if(cfg_kind(active_block)!=cfg_block_kind()){return 5;}
        if(cfg_block_id(active_block)!=active_block_id){return 6;}
        canonical_mir_append_text(bodies,"b");canonical_mir_append_i64(bodies,active_block_id);
        canonical_mir_append_text(bodies,":\n");
        var block_placement_count:i64=0;placement_scan=0;
        while(placement_scan<vec_len<MirPlacementRecord>(placements)){
            let counted:MirPlacementRecord=vec_get<MirPlacementRecord>(placements,placement_scan);
            if(placement_block_id(counted)==active_block_id){
                block_placement_count=checked_add(block_placement_count,1);
            }
            placement_scan=checked_add(placement_scan,1);
        }
        var active_ordinal:i64=0;
        while(active_ordinal<block_placement_count){
        var placement_found:i32=0;var instruction_id:i64=-1;var placement_index:i64=0;
        while(placement_index<vec_len<MirPlacementRecord>(placements)){
            let placement:MirPlacementRecord=vec_get<MirPlacementRecord>(placements,placement_index);
            if(placement_block_id(placement)==active_block_id){
                if(placement_ordinal(placement)==active_ordinal){
                    if(placement_found!=0){return 18;}
                    placement_found=1;instruction_id=placement_instruction_id(placement);
                }
            }
            placement_index=checked_add(placement_index,1);
        }
        if(placement_found==0){return 19;}
        var instruction_found:i32=0;record_index=1;
        while(record_index<vec_len<MirFunctionRecord>(records)){
            let instruction:MirFunctionRecord=vec_get<MirFunctionRecord>(records,record_index);
            let instruction_kind:i32=function_mir_kind(instruction);
            var supported_instruction:i32=0;
            if(instruction_kind==function_mir_kind_const()){supported_instruction=1;}
            if(instruction_kind==function_mir_kind_copy_to_binding()){supported_instruction=1;}
            if(instruction_kind==function_mir_kind_binary()){supported_instruction=1;}
            if(instruction_kind==function_mir_kind_print()){supported_instruction=1;}
            if(instruction_kind==function_mir_kind_call()){supported_instruction=1;}
            if(supported_instruction!=0){
                if(function_mir_id(instruction)==instruction_id){
                    if(instruction_found!=0){return 20;}
                    instruction_found=1;
                    if(instruction_kind==function_mir_kind_const()){
                        canonical_mir_append_text(bodies,"    m");
                        canonical_mir_append_i64(bodies,function_mir_result(instruction));
                        let constant_type:i32=canonical_c_scalar_local_type(records,function_mir_result(instruction));
                        if(function_mir_type_code(instruction)!=constant_type){return 97;}
                        if(constant_type==function_mir_bool_type_code()){
                            canonical_mir_append_text(bodies," = ");
                            if(canonical_c_append_boolean_literal(
                                source,function_mir_start(instruction),function_mir_length(instruction),bodies
                            )!=0){return 100;}
                        }
                        else{if(constant_type==function_mir_string_type_code()){
                            canonical_mir_append_text(bodies," = ");
                            if(canonical_c_append_string_literal(
                                source,function_mir_start(instruction),function_mir_length(instruction),bodies
                            )!=0){return 107;}
                        }else{
                            canonical_mir_append_text(bodies," = ");
                            if(canonical_c_append_scalar_integer_literal(
                                source,function_mir_start(instruction),function_mir_length(instruction),constant_type,bodies
                            )!=0){return 106;}
                        }}
                        canonical_mir_append_text(bodies,";\n");
                    }
                    if(instruction_kind==function_mir_kind_copy_to_binding()){
                        let copied_type:i32=canonical_c_scalar_local_type(records,function_mir_left(instruction));
                        if(copied_type==0){return 101;}
                        if(copied_type!=canonical_c_scalar_local_type(records,function_mir_result(instruction))){return 102;}
                        canonical_mir_append_text(bodies,"    m");canonical_mir_append_i64(bodies,function_mir_result(instruction));
                        canonical_mir_append_text(bodies," = m");canonical_mir_append_i64(bodies,function_mir_left(instruction));
                        canonical_mir_append_text(bodies,";\n");
                    }
                    if(instruction_kind==function_mir_kind_binary()){
                        let binary_symbol:i32=function_mir_symbol_code(instruction);
                        if(binary_symbol!=function_mir_binary_add_symbol()){
                            if(binary_symbol!=function_mir_binary_subtract_symbol()){
                                if(binary_symbol!=function_mir_binary_multiply_symbol()){
                                    if(binary_symbol!=function_mir_binary_divide_symbol()){
                                        if(binary_symbol!=function_mir_binary_equal_symbol()){
                                            if(binary_symbol!=function_mir_binary_not_equal_symbol()){
                                                if(binary_symbol!=function_mir_binary_greater_equal_symbol()){
                                                    if(binary_symbol!=function_mir_binary_less_equal_symbol()){
                                                        if(binary_symbol!=function_mir_binary_greater_symbol()){
                                                            if(binary_symbol!=function_mir_binary_less_symbol()){return 22;}
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        canonical_mir_append_text(bodies,"    m");canonical_mir_append_i64(bodies,function_mir_result(instruction));
                        var is_comparison:i32=0;
                        if(binary_symbol==function_mir_binary_equal_symbol()){is_comparison=1;}
                        if(binary_symbol==function_mir_binary_not_equal_symbol()){is_comparison=1;}
                        if(binary_symbol==function_mir_binary_greater_equal_symbol()){is_comparison=1;}
                        if(binary_symbol==function_mir_binary_less_equal_symbol()){is_comparison=1;}
                        if(binary_symbol==function_mir_binary_greater_symbol()){is_comparison=1;}
                        if(binary_symbol==function_mir_binary_less_symbol()){is_comparison=1;}
                        let result_type:i32=canonical_c_scalar_local_type(records,function_mir_result(instruction));
                        let left_type:i32=canonical_c_scalar_local_type(records,function_mir_left(instruction));
                        let right_type:i32=canonical_c_scalar_local_type(records,function_mir_right(instruction));
                        if(result_type!=function_mir_type_code(instruction)){return 98;}
                        if(left_type==0){return 103;}
                        if(left_type!=right_type){return 98;}
                        if(is_comparison!=0){
                            if(left_type!=function_mir_i64_type_code()){
                                if(left_type!=function_mir_i32_type_code()){
                                    if(left_type!=function_mir_bool_type_code()){return 98;}
                                    if(binary_symbol!=function_mir_binary_equal_symbol()){
                                        if(binary_symbol!=function_mir_binary_not_equal_symbol()){return 98;}
                                    }
                                }
                            }
                        }else{
                            if(result_type!=left_type){return 98;}
                            if(left_type==function_mir_bool_type_code()){return 104;}
                        }
                        if(is_comparison!=0){
                            if(function_mir_numeric_policy(instruction)!=function_mir_exact_numeric_policy()){return 76;}
                            if(canonical_c_scalar_local_type(records,function_mir_result(instruction))!=function_mir_bool_type_code()){return 77;}
                            canonical_mir_append_text(bodies," = m");canonical_mir_append_i64(bodies,function_mir_left(instruction));
                            if(binary_symbol==function_mir_binary_equal_symbol()){canonical_mir_append_text(bodies," == m");}
                            if(binary_symbol==function_mir_binary_not_equal_symbol()){canonical_mir_append_text(bodies," != m");}
                            if(binary_symbol==function_mir_binary_greater_equal_symbol()){canonical_mir_append_text(bodies," >= m");}
                            if(binary_symbol==function_mir_binary_less_equal_symbol()){canonical_mir_append_text(bodies," <= m");}
                            if(binary_symbol==function_mir_binary_greater_symbol()){canonical_mir_append_text(bodies," > m");}
                            if(binary_symbol==function_mir_binary_less_symbol()){canonical_mir_append_text(bodies," < m");}
                            canonical_mir_append_i64(bodies,function_mir_right(instruction));
                            canonical_mir_append_text(bodies,";\n");
                        }else{
                        if(function_mir_numeric_policy(instruction)==function_mir_checked_numeric_policy()){
                            if(binary_symbol==function_mir_binary_add_symbol()){
                                if(result_type==function_mir_i32_type_code()){
                                    canonical_c_require_feature(canonical_c_checked_i32_add_feature(),features);
                                    canonical_mir_append_text(bodies," = merit_checked_add_i32(m");
                                }else{
                                    canonical_c_require_feature(canonical_c_checked_add_feature(),features);
                                    canonical_mir_append_text(bodies," = merit_checked_add_i64(m");
                                }
                            }
                            if(binary_symbol==function_mir_binary_multiply_symbol()){
                                if(result_type==function_mir_i32_type_code()){
                                    canonical_c_require_feature(canonical_c_checked_i32_multiply_feature(),features);
                                    canonical_mir_append_text(bodies," = merit_checked_mul_i32(m");
                                }else{
                                    canonical_c_require_feature(canonical_c_checked_multiply_feature(),features);
                                    canonical_mir_append_text(bodies," = merit_checked_mul_i64(m");
                                }
                            }
                            if(binary_symbol==function_mir_binary_divide_symbol()){
                                if(result_type==function_mir_i32_type_code()){
                                    canonical_c_require_feature(canonical_c_checked_i32_divide_feature(),features);
                                    canonical_mir_append_text(bodies," = merit_checked_div_i32(m");
                                }else{
                                    canonical_c_require_feature(canonical_c_checked_divide_feature(),features);
                                    canonical_mir_append_text(bodies," = merit_checked_div_i64(m");
                                }
                            }
                            if(binary_symbol==function_mir_binary_subtract_symbol()){
                                if(result_type==function_mir_i32_type_code()){
                                    canonical_c_require_feature(canonical_c_checked_i32_subtract_feature(),features);
                                    canonical_mir_append_text(bodies," = merit_checked_sub_i32(m");
                                }else{
                                    canonical_c_require_feature(canonical_c_checked_subtract_feature(),features);
                                    canonical_mir_append_text(bodies," = merit_checked_sub_i64(m");
                                }
                            }
                            canonical_mir_append_i64(bodies,function_mir_left(instruction));canonical_mir_append_text(bodies,", m");
                            canonical_mir_append_i64(bodies,function_mir_right(instruction));canonical_mir_append_text(bodies,");\n");
                        }else{
                            if(function_mir_numeric_policy(instruction)!=function_mir_exact_numeric_policy()){return 23;}
                            canonical_mir_append_text(bodies," = m");canonical_mir_append_i64(bodies,function_mir_left(instruction));
                            if(binary_symbol==function_mir_binary_add_symbol()){canonical_mir_append_text(bodies," + m");}
                            if(binary_symbol==function_mir_binary_subtract_symbol()){canonical_mir_append_text(bodies," - m");}
                            if(binary_symbol==function_mir_binary_multiply_symbol()){canonical_mir_append_text(bodies," * m");}
                            if(binary_symbol==function_mir_binary_divide_symbol()){canonical_mir_append_text(bodies," / m");}
                            canonical_mir_append_i64(bodies,function_mir_right(instruction));
                            canonical_mir_append_text(bodies,";\n");
                        }
                        }
                    }
                    if(instruction_kind==function_mir_kind_print()){
                        let printed_type:i32=canonical_c_scalar_local_type(records,function_mir_left(instruction));
                        if(printed_type==0){return 105;}
                        canonical_c_require_feature(canonical_c_i64_print_feature(),features);
                        if(printed_type==function_mir_string_type_code()){
                            canonical_mir_append_text(bodies,"    fwrite(m");
                            canonical_mir_append_i64(bodies,function_mir_left(instruction));
                            canonical_mir_append_text(bodies,".data, 1, m");
                            canonical_mir_append_i64(bodies,function_mir_left(instruction));
                            canonical_mir_append_text(bodies,".len, stdout);\n    putchar('\\n');\n");
                        }else{
                            canonical_mir_append_text(bodies,"    printf(\"%lld\\n\", (long long)m");
                            canonical_mir_append_i64(bodies,function_mir_left(instruction));canonical_mir_append_text(bodies,");\n");
                        }
                    }
                    if(instruction_kind==function_mir_kind_call()){
                        var callee_found:i32=0;var callee_header:MirFunctionRecord=header;var callee_index:i64=0;
                        var candidate_index:i64=0;
                        while(candidate_index<vec_len<MirFunctionRecord>(callable_headers)){
                            let candidate:MirFunctionRecord=vec_get<MirFunctionRecord>(callable_headers,candidate_index);
                            if(function_mir_kind(candidate)!=function_mir_kind_function()){
                                if(function_mir_kind(candidate)!=function_mir_kind_parameter()){return 63;}
                            }
                            if(function_mir_kind(candidate)==function_mir_kind_function()){
                            if(function_mir_symbol_length(candidate)==function_mir_symbol_length(instruction)){
                                var same:i32=1;var name_offset:i64=0;
                                while(name_offset<function_mir_symbol_length(instruction)){
                                    let left_byte:i64=buffer_get(source,checked_add(function_mir_symbol_start(candidate),name_offset));
                                    let right_byte:i64=buffer_get(source,checked_add(function_mir_symbol_start(instruction),name_offset));
                                    if(left_byte!=right_byte){same=0;}
                                    name_offset=checked_add(name_offset,1);
                                }
                                if(same!=0){
                                    if(callee_found!=0){return 64;}
                                    callee_found=1;callee_header=candidate;callee_index=candidate_index;
                                }
                            }}
                            candidate_index=checked_add(candidate_index,1);
                        }
                        if(callee_found==0){return 65;}
                        if(function_mir_type_code(callee_header)!=function_mir_type_code(instruction)){return 66;}
                        if(function_mir_type_code(instruction)!=function_mir_unit_type_code()){
                            if(canonical_c_scalar_local_type(records,function_mir_result(instruction))!=function_mir_type_code(instruction)){return 95;}
                        }
                        var callee_parameter_ordinal:i64=0;
                        while(callee_parameter_ordinal<function_mir_ordinal(callee_header)){
                            let catalog_index:i64=checked_add(checked_add(callee_index,1),callee_parameter_ordinal);
                            if(catalog_index>=vec_len<MirFunctionRecord>(callable_headers)){return 75;}
                            let parameter:MirFunctionRecord=vec_get<MirFunctionRecord>(callable_headers,catalog_index);
                            if(function_mir_kind(parameter)!=function_mir_kind_parameter()){return 71;}
                            if(function_mir_ordinal(parameter)!=callee_parameter_ordinal){return 72;}
                            if(function_mir_type_code(parameter)!=function_mir_i64_type_code()){
                                if(function_mir_type_code(parameter)!=function_mir_i32_type_code()){
                                    if(function_mir_type_code(parameter)!=function_mir_bool_type_code()){
                                        if(function_mir_type_code(parameter)!=function_mir_string_type_code()){return 73;}
                                    }
                                }
                            }
                            if(function_mir_symbol_code(parameter)!=function_mir_mode_value()){return 74;}
                            callee_parameter_ordinal=checked_add(callee_parameter_ordinal,1);
                        }
                        canonical_mir_append_text(bodies,"    ");
                        if(function_mir_type_code(instruction)!=function_mir_unit_type_code()){
                            canonical_mir_append_text(bodies,"m");canonical_mir_append_i64(bodies,function_mir_result(instruction));
                            canonical_mir_append_text(bodies," = ");
                        }
                        canonical_c_append_function_name(source,callee_header,bodies);
                        buffer_push(bodies,40);
                        var argument_ordinal:i64=0;
                        while(argument_ordinal<function_mir_ordinal(callee_header)){
                            var argument_found:i32=0;var argument_index:i64=1;
                            while(argument_index<vec_len<MirFunctionRecord>(records)){
                                let argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,argument_index);
                                if(function_mir_kind(argument)==function_mir_kind_call_argument()){
                                    if(function_mir_id(argument)==function_mir_id(instruction)){
                                        if(function_mir_ordinal(argument)==argument_ordinal){
                                            if(argument_found!=0){return 67;}
                                            if(function_mir_symbol_code(argument)!=function_mir_mode_value()){return 68;}
                                            let catalog_index:i64=checked_add(
                                                checked_add(callee_index,1),argument_ordinal
                                            );
                                            let parameter:MirFunctionRecord=vec_get<MirFunctionRecord>(callable_headers,catalog_index);
                                            if(canonical_c_scalar_local_type(records,function_mir_left(argument))!=function_mir_type_code(parameter)){return 96;}
                                            if(argument_ordinal>0){canonical_mir_append_text(bodies,", ");}
                                            canonical_mir_append_text(bodies,"m");canonical_mir_append_i64(bodies,function_mir_left(argument));
                                            argument_found=1;
                                        }
                                    }
                                }
                                argument_index=checked_add(argument_index,1);
                            }
                            if(argument_found==0){return 69;}
                            argument_ordinal=checked_add(argument_ordinal,1);
                        }
                        var argument_count:i64=0;var remaining_index:i64=1;
                        while(remaining_index<vec_len<MirFunctionRecord>(records)){
                            let argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,remaining_index);
                            if(function_mir_kind(argument)==function_mir_kind_call_argument()){
                                if(function_mir_id(argument)==function_mir_id(instruction)){
                                    argument_count=checked_add(argument_count,1);
                                }
                            }
                            remaining_index=checked_add(remaining_index,1);
                        }
                        if(argument_count!=function_mir_ordinal(callee_header)){return 70;}
                        canonical_mir_append_text(bodies,");\n");
                    }
                }
            }
            record_index=checked_add(record_index,1);
        }
        if(instruction_found==0){return 21;}
        active_ordinal=checked_add(active_ordinal,1);
        emitted_placements=checked_add(emitted_placements,1);
    }
        let terminator:MirCfgRecord=vec_get<MirCfgRecord>(cfg,checked_add(cfg_emit_index,1));
        if(cfg_kind(terminator)==cfg_return_kind()){
            if(unit_return!=0){
                canonical_mir_append_text(bodies,"    return;\n");
            }else{
                canonical_mir_append_text(bodies,"    return m");
                canonical_mir_append_i64(bodies,cfg_operand(terminator));
                canonical_mir_append_text(bodies,";\n");
            }
        }
        if(cfg_kind(terminator)==cfg_jump_kind()){
            canonical_mir_append_text(bodies,"    goto b");
            canonical_mir_append_i64(bodies,cfg_target_a(terminator));
            canonical_mir_append_text(bodies,";\n");
        }
        if(cfg_kind(terminator)==cfg_branch_kind()){
            canonical_mir_append_text(bodies,"    if (m");
            canonical_mir_append_i64(bodies,cfg_operand(terminator));
            canonical_mir_append_text(bodies,") goto b");
            canonical_mir_append_i64(bodies,cfg_target_a(terminator));
            canonical_mir_append_text(bodies,";\n    goto b");
            canonical_mir_append_i64(bodies,cfg_target_b(terminator));
            canonical_mir_append_text(bodies,";\n");
        }
        if(cfg_kind(terminator)==cfg_unreachable_kind()){
            canonical_mir_append_text(bodies,"    abort();\n");
        }
        var is_switch:i32=0;
        if(cfg_kind(terminator)==cfg_switch_case_kind()){is_switch=1;}
        if(cfg_kind(terminator)==cfg_switch_default_kind()){is_switch=1;}
        if(is_switch!=0){
            canonical_mir_append_text(bodies,"    switch (m");
            canonical_mir_append_i64(bodies,cfg_operand(terminator));
            canonical_mir_append_text(bodies,") {\n");
            var switch_index:i64=checked_add(cfg_emit_index,1);
            var default_emitted:i32=0;
            while(default_emitted==0){
                let item:MirCfgRecord=vec_get<MirCfgRecord>(cfg,switch_index);
                if(cfg_kind(item)==cfg_switch_case_kind()){
                    canonical_mir_append_text(bodies,"    case ");
                    canonical_mir_append_i64(bodies,cfg_case_value(item));
                    canonical_mir_append_text(bodies,": goto b");
                }else{
                    canonical_mir_append_text(bodies,"    default: goto b");
                    default_emitted=1;
                }
                canonical_mir_append_i64(bodies,cfg_target_a(item));
                canonical_mir_append_text(bodies,";\n");
                switch_index=checked_add(switch_index,1);
            }
            canonical_mir_append_text(bodies,"    }\n");
            cfg_emit_index=switch_index;
        }else{cfg_emit_index=checked_add(cfg_emit_index,2);}
        active_block_id=checked_add(active_block_id,1);
    }
    if(emitted_placements!=vec_len<MirPlacementRecord>(placements)){return 87;}
    canonical_mir_append_text(bodies,"}");
    return 0;
}

pub fn canonical_c_append_scalar_function(
    borrow source:Buffer,borrow records:Vec<MirFunctionRecord>,
    borrow cfg:Vec<MirCfgRecord>,borrow placements:Vec<MirPlacementRecord>,
    borrow_mut prototypes:Buffer,borrow_mut bodies:Buffer,
    borrow_mut public_header:Buffer,borrow_mut features:Vec<i64>
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    let empty_headers:Vec<MirFunctionRecord>=vec_new<MirFunctionRecord>(allocator,0);
    let status:i32=canonical_c_append_scalar_function_with_catalog(
        source,records,empty_headers,cfg,placements,prototypes,bodies,public_header,features
    );
    drop(empty_headers);return status;
}

pub fn canonical_c_finish_scalar_module(
    borrow prototypes:Buffer,borrow bodies:Buffer,borrow features:Vec<i64>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(buffer_len(prototypes)<=0){return 1;}
    if(buffer_len(bodies)<=0){return 2;}
    let needs_text:i32=canonical_c_has_feature(canonical_c_text_feature(),features);
    canonical_mir_append_text(output,"/* generated from bootstrap-mir-v1; deterministic, do not edit */\n#include <stdbool.h>\n");
    if(needs_text!=0){canonical_mir_append_text(output,"#include <stddef.h>\n");}
    canonical_mir_append_text(output,"#include <stdint.h>\n");
    var needs_stdio:i32=canonical_c_has_checked_feature(features);
    if(canonical_c_has_feature(canonical_c_i64_print_feature(),features)!=0){needs_stdio=1;}
    if(needs_text!=0){needs_stdio=1;}
    if(needs_stdio!=0){canonical_mir_append_text(output,"#include <stdio.h>\n");}
    canonical_mir_append_text(output,"#include <stdlib.h>\n\n");
    if(needs_text!=0){
        canonical_mir_append_text(output,"typedef struct { const uint8_t *data; size_t len; } merit_String;\ntypedef struct { const uint8_t *data; size_t len; } merit_ByteSlice;\nstatic inline int64_t merit_string_len(merit_String value) { return (int64_t)value.len; }\nstatic inline uint8_t merit_string_byte(merit_String value, int64_t index) {\n    if (index < 0 || (size_t)index >= value.len) return 0;\n    return value.data[index];\n}\n\n");
    }
    bootstrap_buffer_append(output,prototypes,0,buffer_len(prototypes));buffer_push(output,10);
    let needs_checked:i32=canonical_c_has_checked_feature(features);
    if(needs_checked!=0){
        canonical_mir_append_text(output,"static void merit_numeric_failure(const char *operation) { fprintf(stderr, \"Merit %s\\n\", operation); exit(70); }\n");
    }
    var needs_divide:i32=canonical_c_has_feature(canonical_c_checked_divide_feature(),features);
    if(canonical_c_has_feature(canonical_c_checked_i32_divide_feature(),features)!=0){needs_divide=1;}
    if(needs_divide!=0){
        canonical_mir_append_text(output,"static void merit_division_by_zero(void) { fprintf(stderr, \"Merit division by zero\\n\"); exit(72); }\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_i32_multiply_feature(),features)!=0){
        canonical_mir_append_text(output,"static int32_t merit_checked_mul_i32(int32_t a, int32_t b) {\n    __int128 result = (__int128)a * (__int128)b;\n    if (result < INT32_MIN || result > INT32_MAX) merit_numeric_failure(\"i32 multiplication overflow\");\n    return (int32_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_i32_add_feature(),features)!=0){
        canonical_mir_append_text(output,"static int32_t merit_checked_add_i32(int32_t a, int32_t b) {\n    __int128 result = (__int128)a + (__int128)b;\n    if (result < INT32_MIN || result > INT32_MAX) merit_numeric_failure(\"i32 addition overflow\");\n    return (int32_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_i32_subtract_feature(),features)!=0){
        canonical_mir_append_text(output,"static int32_t merit_checked_sub_i32(int32_t a, int32_t b) {\n    __int128 result = (__int128)a - (__int128)b;\n    if (result < INT32_MIN || result > INT32_MAX) merit_numeric_failure(\"i32 subtraction overflow\");\n    return (int32_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_i32_divide_feature(),features)!=0){
        canonical_mir_append_text(output,"static int32_t merit_checked_div_i32(int32_t a, int32_t b) {\n    if (b == 0) merit_division_by_zero();\n    if (a == INT32_MIN && b == -1) merit_numeric_failure(\"division overflow\");\n    return (int32_t)(a / b);\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_multiply_feature(),features)!=0){
        canonical_mir_append_text(output,"static int64_t merit_checked_mul_i64(int64_t a, int64_t b) {\n    __int128 result = (__int128)a * (__int128)b;\n    if (result < INT64_MIN || result > INT64_MAX) merit_numeric_failure(\"i64 multiplication overflow\");\n    return (int64_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_add_feature(),features)!=0){
        canonical_mir_append_text(output,"static int64_t merit_checked_add_i64(int64_t a, int64_t b) {\n    __int128 result = (__int128)a + (__int128)b;\n    if (result < INT64_MIN || result > INT64_MAX) merit_numeric_failure(\"i64 addition overflow\");\n    return (int64_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_subtract_feature(),features)!=0){
        canonical_mir_append_text(output,"static int64_t merit_checked_sub_i64(int64_t a, int64_t b) {\n    __int128 result = (__int128)a - (__int128)b;\n    if (result < INT64_MIN || result > INT64_MAX) merit_numeric_failure(\"i64 subtraction overflow\");\n    return (int64_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_divide_feature(),features)!=0){
        canonical_mir_append_text(output,"static int64_t merit_checked_div_i64(int64_t a, int64_t b) {\n    if (b == 0) merit_division_by_zero();\n    if (a == INT64_MIN && b == -1) merit_numeric_failure(\"division overflow\");\n    return (int64_t)(a / b);\n}\n");
    }
    if(needs_checked!=0){buffer_push(output,10);}
    bootstrap_buffer_append(output,bodies,0,buffer_len(bodies));buffer_push(output,10);
    return 0;
}

pub fn canonical_c_finish_public_header(
    borrow declarations:Buffer,borrow features:Vec<i64>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    canonical_mir_append_text(output,"#pragma once\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n");
    if(canonical_c_has_feature(canonical_c_public_string_feature(),features)!=0){
        canonical_mir_append_text(output,"typedef struct { const uint8_t *data; size_t len; } merit_String;\n\n");
    }
    bootstrap_buffer_append(output,declarations,0,buffer_len(declarations));
    return 0;
}

