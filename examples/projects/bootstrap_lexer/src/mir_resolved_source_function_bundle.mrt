module bootstrap_mir_resolved_source_function_bundle
import bootstrap_mir_functions;
import bootstrap_mir_function_contracts;
import bootstrap_mir_function_assembly_plan;
import bootstrap_mir_function_instruction_source;
import bootstrap_mir_ownership_flow;
import bootstrap_mir_cfg;
import bootstrap_mir_cfg_placement;
import bootstrap_mir_resolved_source_function_snapshot;
import bootstrap_statement_semantics;

// resolved-source-function-bundle-v3/v4
// magic "MRBF", version, function count, then for each function:
// snapshot value count followed by a bootstrap-resolved-source-function-
// snapshot-v9 payload. The first payload carries the canonical effective
// source; later payloads use an empty source section and inherit the first.

fn resolved_source_function_bundle_magic()->i64{return 1297236550;}
fn resolved_source_function_bundle_version()->i64{return 2;}
fn resolved_source_function_project_bundle_version()->i64{return 3;}
fn resolved_source_function_project_artifact_bundle_version()->i64{return 4;}
fn resolved_source_function_bundle_metadata_magic()->i64{return 1296389185;}
fn resolved_source_function_project_artifact_magic()->i64{return 1296253266;}

pub fn resolved_source_function_snapshot_value_count(
    borrow effective_source: Buffer,
    borrow body: Vec<MirFunctionRecord>,
    borrow contracts: Vec<MirFunctionContractRecord>,
    borrow contract_locals: Vec<MirFunctionContractLocal>,
    borrow sources: Vec<MirFunctionInstructionSource>,
    borrow ownership_bindings: Vec<MirOwnershipBinding>,
    borrow ownership_records: Vec<MirOwnershipRecord>,
    borrow cfg: Vec<MirCfgRecord>,
    borrow placements: Vec<MirPlacementRecord>,
    borrow capabilities: Vec<i64>,
    borrow type_descriptors: Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors: Vec<MirNumericTypeDescriptor>,
    borrow destructor_descriptors: Vec<MirDestructorDescriptor>,
    borrow destructor_body: Vec<MirFunctionRecord>,
    borrow destructor_cfg: Vec<MirCfgRecord>,
    borrow destructor_placements: Vec<MirPlacementRecord>
) -> i64 {
    var count: i64 = 18; // magic + version + sixteen section counts
    count = checked_add(count, checked_mul(vec_len<MirFunctionRecord>(body), 16));
    count = checked_add(count, checked_mul(vec_len<MirFunctionContractRecord>(contracts), 12));
    count = checked_add(count, checked_mul(vec_len<MirFunctionContractLocal>(contract_locals), 5));
    count = checked_add(count, checked_mul(vec_len<MirFunctionInstructionSource>(sources), 8));
    count = checked_add(count, checked_mul(vec_len<MirOwnershipBinding>(ownership_bindings), 4));
    count = checked_add(count, checked_mul(vec_len<MirOwnershipRecord>(ownership_records), 8));
    count = checked_add(count, checked_mul(vec_len<MirCfgRecord>(cfg), 7));
    count = checked_add(count, checked_mul(vec_len<MirPlacementRecord>(placements), 3));
    count = checked_add(count, vec_len<i64>(capabilities));
    count = checked_add(count, checked_mul(vec_len<MirTypeDescriptor>(type_descriptors), 11));
    count = checked_add(count, checked_mul(vec_len<MirNumericTypeDescriptor>(numeric_type_descriptors), 11));
    count = checked_add(count, checked_mul(vec_len<MirDestructorDescriptor>(destructor_descriptors), 7));
    count = checked_add(count, checked_mul(vec_len<MirFunctionRecord>(destructor_body), 16));
    count = checked_add(count, checked_mul(vec_len<MirCfgRecord>(destructor_cfg), 7));
    count = checked_add(count, checked_mul(vec_len<MirPlacementRecord>(destructor_placements), 3));
    count = checked_add(count, buffer_len(effective_source));
    return count;
}

pub fn print_resolved_source_function_bundle_header(function_count: i64) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_bundle_version());
    print(function_count);
    return 0;
}

pub fn print_resolved_source_function_project_bundle_header(function_count: i64) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_project_bundle_version());
    print(function_count);
    return 0;
}

pub fn print_resolved_source_function_project_artifact_bundle_header(
    function_count: i64
) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_project_artifact_bundle_version());
    print(function_count);
    return 0;
}

fn print_resolved_source_function_artifact_bytes(borrow value: Buffer) -> i32 {
    if (buffer_len(value) <= 0) { return 1; }
    print(buffer_len(value));
    var offset: i64 = 0;
    while (offset < buffer_len(value)) {
        print(buffer_get(value, offset));
        offset = checked_add(offset, 1);
    }
    return 0;
}

pub fn print_resolved_source_function_project_artifacts(
    borrow canonical_mir: Buffer,
    borrow c_source: Buffer,
    borrow c_header: Buffer
) -> i32 {
    if (buffer_len(canonical_mir) <= 0) { return 1; }
    if (buffer_len(c_source) <= 0) { return 2; }
    if (buffer_len(c_header) <= 0) { return 3; }
    print(resolved_source_function_project_artifact_magic());
    let mir_status: i32 = print_resolved_source_function_artifact_bytes(canonical_mir);
    if (mir_status != 0) { return checked_add(10, mir_status); }
    let source_status: i32 = print_resolved_source_function_artifact_bytes(c_source);
    if (source_status != 0) { return checked_add(20, source_status); }
    let header_status: i32 = print_resolved_source_function_artifact_bytes(c_header);
    if (header_status != 0) { return checked_add(30, header_status); }
    return 0;
}

// First SH3 canonical-MIR materializer slice. This writes the established
// bootstrap-mir-v1 canonical JSON directly from validated Merit-owned
// straight-line function records. It deliberately fails closed for record
// kinds outside this bounded slice; later SH3 slices extend this same writer.
fn canonical_mir_append_text(borrow_mut output:Buffer,value:String)->i32
requires_caps [allocate]
{
    var index:i64=0;
    while(index<string_len(value)){
        buffer_push(output,string_byte(value,index));
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_mir_append_i64(borrow_mut output:Buffer,value:i64)->i32
requires_caps [allocate]
{
    var magnitude:i64=value;
    if(magnitude<0){
        buffer_push(output,45);
        magnitude=checked_sub(0,magnitude);
    }
    if(magnitude==0){buffer_push(output,48);return 0;}
    var divisor:i64=1;
    while((magnitude/divisor)>=10){divisor=checked_mul(divisor,10);}
    while(divisor>0){
        let digit:i64=magnitude/divisor;
        if(digit==0){buffer_push(output,48);}
        if(digit==1){buffer_push(output,49);}
        if(digit==2){buffer_push(output,50);}
        if(digit==3){buffer_push(output,51);}
        if(digit==4){buffer_push(output,52);}
        if(digit==5){buffer_push(output,53);}
        if(digit==6){buffer_push(output,54);}
        if(digit==7){buffer_push(output,55);}
        if(digit==8){buffer_push(output,56);}
        if(digit==9){buffer_push(output,57);}
        magnitude=checked_sub(magnitude,checked_mul(digit,divisor));
        divisor=divisor/10;
    }
    return 0;
}

fn canonical_mir_push_identifier_or_numeric_byte(
    borrow_mut output:Buffer,value:i64
)->i32
requires_caps [allocate]
{
    if(value==48){buffer_push(output,48);return 0;}
    if(value==49){buffer_push(output,49);return 0;}
    if(value==50){buffer_push(output,50);return 0;}
    if(value==51){buffer_push(output,51);return 0;}
    if(value==52){buffer_push(output,52);return 0;}
    if(value==53){buffer_push(output,53);return 0;}
    if(value==54){buffer_push(output,54);return 0;}
    if(value==55){buffer_push(output,55);return 0;}
    if(value==56){buffer_push(output,56);return 0;}
    if(value==57){buffer_push(output,57);return 0;}
    if(value==65){buffer_push(output,65);return 0;}
    if(value==66){buffer_push(output,66);return 0;}
    if(value==67){buffer_push(output,67);return 0;}
    if(value==68){buffer_push(output,68);return 0;}
    if(value==69){buffer_push(output,69);return 0;}
    if(value==70){buffer_push(output,70);return 0;}
    if(value==71){buffer_push(output,71);return 0;}
    if(value==72){buffer_push(output,72);return 0;}
    if(value==73){buffer_push(output,73);return 0;}
    if(value==74){buffer_push(output,74);return 0;}
    if(value==75){buffer_push(output,75);return 0;}
    if(value==76){buffer_push(output,76);return 0;}
    if(value==77){buffer_push(output,77);return 0;}
    if(value==78){buffer_push(output,78);return 0;}
    if(value==79){buffer_push(output,79);return 0;}
    if(value==80){buffer_push(output,80);return 0;}
    if(value==81){buffer_push(output,81);return 0;}
    if(value==82){buffer_push(output,82);return 0;}
    if(value==83){buffer_push(output,83);return 0;}
    if(value==84){buffer_push(output,84);return 0;}
    if(value==85){buffer_push(output,85);return 0;}
    if(value==86){buffer_push(output,86);return 0;}
    if(value==87){buffer_push(output,87);return 0;}
    if(value==88){buffer_push(output,88);return 0;}
    if(value==89){buffer_push(output,89);return 0;}
    if(value==90){buffer_push(output,90);return 0;}
    if(value==95){buffer_push(output,95);return 0;}
    if(value==97){buffer_push(output,97);return 0;}
    if(value==98){buffer_push(output,98);return 0;}
    if(value==99){buffer_push(output,99);return 0;}
    if(value==100){buffer_push(output,100);return 0;}
    if(value==101){buffer_push(output,101);return 0;}
    if(value==102){buffer_push(output,102);return 0;}
    if(value==103){buffer_push(output,103);return 0;}
    if(value==104){buffer_push(output,104);return 0;}
    if(value==105){buffer_push(output,105);return 0;}
    if(value==106){buffer_push(output,106);return 0;}
    if(value==107){buffer_push(output,107);return 0;}
    if(value==108){buffer_push(output,108);return 0;}
    if(value==109){buffer_push(output,109);return 0;}
    if(value==110){buffer_push(output,110);return 0;}
    if(value==111){buffer_push(output,111);return 0;}
    if(value==112){buffer_push(output,112);return 0;}
    if(value==113){buffer_push(output,113);return 0;}
    if(value==114){buffer_push(output,114);return 0;}
    if(value==115){buffer_push(output,115);return 0;}
    if(value==116){buffer_push(output,116);return 0;}
    if(value==117){buffer_push(output,117);return 0;}
    if(value==118){buffer_push(output,118);return 0;}
    if(value==119){buffer_push(output,119);return 0;}
    if(value==120){buffer_push(output,120);return 0;}
    if(value==121){buffer_push(output,121);return 0;}
    if(value==122){buffer_push(output,122);return 0;}
    return 1;
}

fn canonical_mir_append_json_source(
    borrow_mut output:Buffer,borrow source:Buffer,start:i64,length:i64
)->i32
requires_caps [allocate]
{
    if(start<0){return 1;}
    if(length<0){return 1;}
    if(checked_add(start,length)>buffer_len(source)){return 1;}
    buffer_push(output,34);
    var offset:i64=0;
    while(offset<length){
        let byte:i64=buffer_get(source,checked_add(start,offset));
        // Identifiers, operators, and exact numeric spellings in this first
        // slice must not require JSON escaping. Reject instead of guessing.
        if(byte<32){return 2;}
        if(byte==34){return 2;}
        if(byte==92){return 2;}
        if(canonical_mir_push_identifier_or_numeric_byte(output,byte)!=0){return 3;}
        offset=checked_add(offset,1);
    }
    buffer_push(output,34);
    return 0;
}

fn canonical_mir_append_json_string(borrow_mut output:Buffer,value:String)->i32
requires_caps [allocate]
{
    buffer_push(output,34);
    var index:i64=0;
    while(index<string_len(value)){
        let byte:u8=string_byte(value,index);
        if(byte<32){return 1;}
        if(byte==34){return 1;}
        if(byte==92){return 1;}
        buffer_push(output,byte);
        index=checked_add(index,1);
    }
    buffer_push(output,34);
    return 0;
}

fn canonical_mir_append_type(borrow_mut output:Buffer,type_code:i32)->i32
requires_caps [allocate]
{
    canonical_mir_append_text(output,"{\"name\":\"");
    if(type_code==function_mir_i64_type_code()){canonical_mir_append_text(output,"i64");}
    else{
        if(type_code==function_mir_bool_type_code()){canonical_mir_append_text(output,"bool");}
        else{return 1;}
    }
    canonical_mir_append_text(output,"\"}");
    return 0;
}

fn canonical_mir_append_symbol(borrow_mut output:Buffer,symbol_code:i32)->i32
requires_caps [allocate]
{
    if(symbol_code==function_mir_binary_add_symbol()){canonical_mir_append_text(output,"+");return 0;}
    if(symbol_code==function_mir_binary_subtract_symbol()){canonical_mir_append_text(output,"-");return 0;}
    if(symbol_code==function_mir_binary_multiply_symbol()){canonical_mir_append_text(output,"*");return 0;}
    if(symbol_code==function_mir_binary_divide_symbol()){canonical_mir_append_text(output,"/");return 0;}
    if(symbol_code==function_mir_binary_equal_symbol()){canonical_mir_append_text(output,"==");return 0;}
    if(symbol_code==function_mir_binary_not_equal_symbol()){canonical_mir_append_text(output,"!=");return 0;}
    if(symbol_code==function_mir_binary_greater_equal_symbol()){canonical_mir_append_text(output,">=");return 0;}
    if(symbol_code==function_mir_binary_less_equal_symbol()){canonical_mir_append_text(output,"<=");return 0;}
    if(symbol_code==function_mir_binary_greater_symbol()){canonical_mir_append_text(output,">");return 0;}
    if(symbol_code==function_mir_binary_less_symbol()){canonical_mir_append_text(output,"<");return 0;}
    return 1;
}

pub fn materialize_straight_line_canonical_mir(
    borrow source:Buffer,module_name:String,borrow records:Vec<MirFunctionRecord>,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(validate_function_mir_records(records)!=0){return 1;}
    if(vec_len<MirFunctionRecord>(records)<2){return 2;}
    let header:MirFunctionRecord=vec_get<MirFunctionRecord>(records,0);
    if(function_mir_kind(header)!=function_mir_kind_function()){return 3;}

    canonical_mir_append_text(output,"{\"functions\":[{\"blocks\":[{\"id\":0,\"instructions\":[");
    var index:i64=1;
    var instruction_count:i64=0;
    while(index<vec_len<MirFunctionRecord>(records)){
        let record:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        let kind:i32=function_mir_kind(record);
        var is_instruction:i32=0;
        if(kind==function_mir_kind_const()){is_instruction=1;}
        if(kind==function_mir_kind_binary()){is_instruction=1;}
        if(kind==function_mir_kind_copy_to_binding()){is_instruction=1;}
        if(kind==function_mir_kind_print()){is_instruction=1;}
        if(is_instruction!=0){
            if(instruction_count>0){buffer_push(output,44);}
            canonical_mir_append_text(output,"{\"contract_kind\":\"none\",\"conversion_policy\":\"none\",\"id\":");
            canonical_mir_append_i64(output,function_mir_id(record));
            if(kind==function_mir_kind_const()){
                canonical_mir_append_text(output,",\"kind\":\"const\",\"numeric_policy\":\"none\",\"operands\":[],\"ownership\":\"value\",\"result\":");
                canonical_mir_append_i64(output,function_mir_result(record));
                canonical_mir_append_text(output,",\"span\":[");
                canonical_mir_append_i64(output,function_mir_start(record));buffer_push(output,44);
                canonical_mir_append_i64(output,function_mir_length(record));
                canonical_mir_append_text(output,"],\"value\":");
                let value_status:i32=canonical_mir_append_json_source(output,source,function_mir_start(record),function_mir_length(record));
                if(value_status!=0){return checked_add(20,value_status);}
            }else{
                if(kind==function_mir_kind_binary()){
                    canonical_mir_append_text(output,",\"kind\":\"binary\",\"numeric_policy\":\"");
                    if(function_mir_numeric_policy(record)==function_mir_exact_numeric_policy()){canonical_mir_append_text(output,"exact");}
                    else{if(function_mir_numeric_policy(record)==function_mir_checked_numeric_policy()){canonical_mir_append_text(output,"checked");}else{return 30;}}
                    canonical_mir_append_text(output,"\",\"operands\":[");
                    canonical_mir_append_i64(output,function_mir_left(record));buffer_push(output,44);
                    canonical_mir_append_i64(output,function_mir_right(record));
                    canonical_mir_append_text(output,"],\"ownership\":\"none\",\"result\":");
                    canonical_mir_append_i64(output,function_mir_result(record));
                    canonical_mir_append_text(output,",\"span\":[");
                    canonical_mir_append_i64(output,function_mir_start(record));buffer_push(output,44);
                    canonical_mir_append_i64(output,function_mir_length(record));
                    canonical_mir_append_text(output,"],\"symbol\":\"");
                    let symbol_status:i32=canonical_mir_append_symbol(output,function_mir_symbol_code(record));
                    if(symbol_status!=0){return 31;}
                    buffer_push(output,34);
                }else{
                    if(kind==function_mir_kind_print()){
                        canonical_mir_append_text(output,",\"kind\":\"print\",\"numeric_policy\":\"none\",\"operands\":[");
                        canonical_mir_append_i64(output,function_mir_left(record));
                        canonical_mir_append_text(output,"],\"ownership\":\"none\",\"span\":[");
                        canonical_mir_append_i64(output,function_mir_start(record));buffer_push(output,44);
                        canonical_mir_append_i64(output,function_mir_length(record));buffer_push(output,93);
                    }else{
                    canonical_mir_append_text(output,",\"kind\":\"copy\",\"numeric_policy\":\"none\",\"operands\":[");
                    canonical_mir_append_i64(output,function_mir_left(record));
                    canonical_mir_append_text(output,"],\"ownership\":\"none\",\"result\":");
                    canonical_mir_append_i64(output,function_mir_result(record));
                    canonical_mir_append_text(output,",\"span\":[");
                    canonical_mir_append_i64(output,function_mir_start(record));buffer_push(output,44);
                    canonical_mir_append_i64(output,function_mir_length(record));buffer_push(output,93);
                    }
                }
            }
            buffer_push(output,125);
            instruction_count=checked_add(instruction_count,1);
        }
        index=checked_add(index,1);
    }
    canonical_mir_append_text(output,"],\"terminator\":{\"kind\":\"return\",\"operands\":[");
    let tail:MirFunctionRecord=vec_get<MirFunctionRecord>(records,checked_sub(vec_len<MirFunctionRecord>(records),1));
    if(function_mir_kind(tail)!=function_mir_kind_return()){return 40;}
    if(function_mir_left(tail)>=0){canonical_mir_append_i64(output,function_mir_left(tail));}
    canonical_mir_append_text(output,"],\"span\":[");
    canonical_mir_append_i64(output,function_mir_start(tail));buffer_push(output,44);
    canonical_mir_append_i64(output,function_mir_length(tail));
    canonical_mir_append_text(output,"],\"targets\":[]}}],\"capabilities\":[],\"entry_block\":0,\"locals\":[");

    index=1;
    var local_count:i64=0;
    while(index<vec_len<MirFunctionRecord>(records)){
        let local:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        let local_kind:i32=function_mir_kind(local);
        if(local_kind==function_mir_kind_source_local()){
            if(local_count>0){buffer_push(output,44);}
            canonical_mir_append_text(output,"{\"id\":");canonical_mir_append_i64(output,function_mir_id(local));
            canonical_mir_append_text(output,",\"mutable\":");
            if(function_mir_mutable(local)==0){canonical_mir_append_text(output,"false");}else{canonical_mir_append_text(output,"true");}
            canonical_mir_append_text(output,",\"name\":");
            let name_status:i32=canonical_mir_append_json_source(output,source,function_mir_symbol_start(local),function_mir_symbol_length(local));
            if(name_status!=0){return checked_add(50,name_status);}
            canonical_mir_append_text(output,",\"ownership\":\"value\",\"source_binding_id\":");
            canonical_mir_append_i64(output,function_mir_binding_id(local));
            canonical_mir_append_text(output,",\"type\":");
            if(canonical_mir_append_type(output,function_mir_type_code(local))!=0){return 53;}
            buffer_push(output,125);local_count=checked_add(local_count,1);
        }
        if(local_kind==function_mir_kind_temporary_local()){
            if(local_count>0){buffer_push(output,44);}
            canonical_mir_append_text(output,"{\"id\":");canonical_mir_append_i64(output,function_mir_id(local));
            canonical_mir_append_text(output,",\"mutable\":false,\"name\":\"_t");
            canonical_mir_append_i64(output,function_mir_hir_node_id(local));
            canonical_mir_append_text(output,"\",\"ownership\":\"value\",\"type\":");
            if(canonical_mir_append_type(output,function_mir_type_code(local))!=0){return 54;}
            buffer_push(output,125);local_count=checked_add(local_count,1);
        }
        index=checked_add(index,1);
    }
    canonical_mir_append_text(output,"],\"name\":");
    let function_name_status:i32=canonical_mir_append_json_source(output,source,function_mir_symbol_start(header),function_mir_symbol_length(header));
    if(function_name_status!=0){return checked_add(60,function_name_status);}
    canonical_mir_append_text(output,",\"return_type\":");
    if(canonical_mir_append_type(output,function_mir_type_code(header))!=0){return 63;}
    canonical_mir_append_text(output,"}],\"name\":");
    if(canonical_mir_append_json_string(output,module_name)!=0){return 64;}
    canonical_mir_append_text(output,",\"schema\":\"bootstrap-mir-v1\"}");
    return 0;
}

pub fn print_resolved_source_function_bundle_item_with_source_policy(
    borrow effective_source: Buffer,
    include_effective_source: i32,
    borrow body: Vec<MirFunctionRecord>,
    borrow contracts: Vec<MirFunctionContractRecord>,
    borrow contract_locals: Vec<MirFunctionContractLocal>,
    borrow sources: Vec<MirFunctionInstructionSource>,
    borrow ownership_bindings: Vec<MirOwnershipBinding>,
    borrow ownership_records: Vec<MirOwnershipRecord>,
    borrow cfg: Vec<MirCfgRecord>,
    borrow placements: Vec<MirPlacementRecord>,
    borrow capabilities: Vec<i64>,
    borrow type_descriptors: Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors: Vec<MirNumericTypeDescriptor>,
    borrow destructor_descriptors: Vec<MirDestructorDescriptor>,
    borrow destructor_body: Vec<MirFunctionRecord>,
    borrow destructor_cfg: Vec<MirCfgRecord>,
    borrow destructor_placements: Vec<MirPlacementRecord>
) -> i32 {
    var value_count: i64 = resolved_source_function_snapshot_value_count(
        effective_source, body, contracts, contract_locals, sources, ownership_bindings,
        ownership_records, cfg, placements, capabilities, type_descriptors,
        numeric_type_descriptors,
        destructor_descriptors, destructor_body, destructor_cfg, destructor_placements
    );
    if (include_effective_source == 0) {
        value_count = checked_sub(value_count, buffer_len(effective_source));
    }
    if (value_count < 18) { return 1; }
    print(value_count);
    return print_resolved_source_function_snapshot_with_source_policy(
        effective_source, include_effective_source,
        body, contracts, contract_locals, sources, ownership_bindings,
        ownership_records, cfg, placements, capabilities, type_descriptors,
        numeric_type_descriptors,
        destructor_descriptors, destructor_body, destructor_cfg, destructor_placements
    );
}

pub fn print_resolved_source_function_bundle_item(
    borrow effective_source: Buffer,
    borrow body: Vec<MirFunctionRecord>,
    borrow contracts: Vec<MirFunctionContractRecord>,
    borrow contract_locals: Vec<MirFunctionContractLocal>,
    borrow sources: Vec<MirFunctionInstructionSource>,
    borrow ownership_bindings: Vec<MirOwnershipBinding>,
    borrow ownership_records: Vec<MirOwnershipRecord>,
    borrow cfg: Vec<MirCfgRecord>,
    borrow placements: Vec<MirPlacementRecord>,
    borrow capabilities: Vec<i64>,
    borrow type_descriptors: Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors: Vec<MirNumericTypeDescriptor>,
    borrow destructor_descriptors: Vec<MirDestructorDescriptor>,
    borrow destructor_body: Vec<MirFunctionRecord>,
    borrow destructor_cfg: Vec<MirCfgRecord>,
    borrow destructor_placements: Vec<MirPlacementRecord>
) -> i32 {
    return print_resolved_source_function_bundle_item_with_source_policy(
        effective_source, 1, body, contracts, contract_locals, sources,
        ownership_bindings, ownership_records, cfg, placements, capabilities,
        type_descriptors, numeric_type_descriptors, destructor_descriptors,
        destructor_body, destructor_cfg, destructor_placements
    );
}

pub fn print_resolved_source_function_bundle_metadata(
    borrow source: Buffer,
    module_start: i64,
    module_length: i64,
    borrow capabilities: Vec<CapabilityCatalogEntry>
) -> i32 {
    if (module_length <= 0) { return 1; }
    print(resolved_source_function_bundle_metadata_magic());
    print(module_length);
    var offset: i64 = 0;
    while (offset < module_length) {
        print(buffer_get(source, checked_add(module_start, offset)));
        offset = checked_add(offset, 1);
    }
    print(vec_len<CapabilityCatalogEntry>(capabilities));
    var index: i64 = 0;
    while (index < vec_len<CapabilityCatalogEntry>(capabilities)) {
        let entry: CapabilityCatalogEntry = vec_get<CapabilityCatalogEntry>(capabilities, index);
        print(entry.name_length);
        offset = 0;
        while (offset < entry.name_length) {
            print(buffer_get(source, checked_add(entry.name_start, offset)));
            offset = checked_add(offset, 1);
        }
        index = checked_add(index, 1);
    }
    return 0;
}
