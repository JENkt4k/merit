module bootstrap_mir_resolved_source_function_bundle
import bootstrap_mir_functions;
import bootstrap_mir_function_contracts;
import bootstrap_mir_function_assembly_plan;
import bootstrap_mir_function_instruction_source;
import bootstrap_mir_ownership_flow;
import bootstrap_mir_cfg;
import bootstrap_mir_cfg_placement;
import bootstrap_mir_resolved_source_function_snapshot;
import bootstrap_statement_semantics;

// resolved-source-function-bundle-v3/v4
// magic "MRBF", version, function count, then for each function:
// snapshot value count followed by a bootstrap-resolved-source-function-
// snapshot-v9 payload. The first payload carries the canonical effective
// source; later payloads use an empty source section and inherit the first.

fn resolved_source_function_bundle_magic()->i64{return 1297236550;}
fn resolved_source_function_bundle_version()->i64{return 2;}
fn resolved_source_function_project_bundle_version()->i64{return 3;}
fn resolved_source_function_project_artifact_bundle_version()->i64{return 4;}
fn resolved_source_function_bundle_metadata_magic()->i64{return 1296389185;}
fn resolved_source_function_project_artifact_magic()->i64{return 1296253266;}

pub fn resolved_source_function_snapshot_value_count(
    borrow effective_source: Buffer,
    borrow body: Vec<MirFunctionRecord>,
    borrow contracts: Vec<MirFunctionContractRecord>,
    borrow contract_locals: Vec<MirFunctionContractLocal>,
    borrow sources: Vec<MirFunctionInstructionSource>,
    borrow ownership_bindings: Vec<MirOwnershipBinding>,
    borrow ownership_records: Vec<MirOwnershipRecord>,
    borrow cfg: Vec<MirCfgRecord>,
    borrow placements: Vec<MirPlacementRecord>,
    borrow capabilities: Vec<i64>,
    borrow type_descriptors: Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors: Vec<MirNumericTypeDescriptor>,
    borrow destructor_descriptors: Vec<MirDestructorDescriptor>,
    borrow destructor_body: Vec<MirFunctionRecord>,
    borrow destructor_cfg: Vec<MirCfgRecord>,
    borrow destructor_placements: Vec<MirPlacementRecord>
) -> i64 {
    var count: i64 = 18; // magic + version + sixteen section counts
    count = checked_add(count, checked_mul(vec_len<MirFunctionRecord>(body), 16));
    count = checked_add(count, checked_mul(vec_len<MirFunctionContractRecord>(contracts), 12));
    count = checked_add(count, checked_mul(vec_len<MirFunctionContractLocal>(contract_locals), 5));
    count = checked_add(count, checked_mul(vec_len<MirFunctionInstructionSource>(sources), 8));
    count = checked_add(count, checked_mul(vec_len<MirOwnershipBinding>(ownership_bindings), 4));
    count = checked_add(count, checked_mul(vec_len<MirOwnershipRecord>(ownership_records), 8));
    count = checked_add(count, checked_mul(vec_len<MirCfgRecord>(cfg), 7));
    count = checked_add(count, checked_mul(vec_len<MirPlacementRecord>(placements), 3));
    count = checked_add(count, vec_len<i64>(capabilities));
    count = checked_add(count, checked_mul(vec_len<MirTypeDescriptor>(type_descriptors), 11));
    count = checked_add(count, checked_mul(vec_len<MirNumericTypeDescriptor>(numeric_type_descriptors), 11));
    count = checked_add(count, checked_mul(vec_len<MirDestructorDescriptor>(destructor_descriptors), 7));
    count = checked_add(count, checked_mul(vec_len<MirFunctionRecord>(destructor_body), 16));
    count = checked_add(count, checked_mul(vec_len<MirCfgRecord>(destructor_cfg), 7));
    count = checked_add(count, checked_mul(vec_len<MirPlacementRecord>(destructor_placements), 3));
    count = checked_add(count, buffer_len(effective_source));
    return count;
}

pub fn print_resolved_source_function_bundle_header(function_count: i64) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_bundle_version());
    print(function_count);
    return 0;
}

pub fn print_resolved_source_function_project_bundle_header(function_count: i64) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_project_bundle_version());
    print(function_count);
    return 0;
}

pub fn print_resolved_source_function_project_artifact_bundle_header(
    function_count: i64
) -> i32 {
    // V4 can carry only canonical MIR/C/header artifacts. Unlike legacy
    // bundles, no Python-consumed snapshot row is required.
    if (function_count < 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_project_artifact_bundle_version());
    print(function_count);
    return 0;
}

fn print_resolved_source_function_artifact_bytes(borrow value: Buffer) -> i32 {
    if (buffer_len(value) <= 0) { return 1; }
    print(buffer_len(value));
    var offset: i64 = 0;
    while (offset < buffer_len(value)) {
        print(buffer_get(value, offset));
        offset = checked_add(offset, 1);
    }
    return 0;
}

pub fn print_resolved_source_function_project_artifacts(
    borrow canonical_mir: Buffer,
    borrow c_source: Buffer,
    borrow c_header: Buffer
) -> i32 {
    if (buffer_len(canonical_mir) <= 0) { return 1; }
    if (buffer_len(c_source) <= 0) { return 2; }
    if (buffer_len(c_header) <= 0) { return 3; }
    print(resolved_source_function_project_artifact_magic());
    let mir_status: i32 = print_resolved_source_function_artifact_bytes(canonical_mir);
    if (mir_status != 0) { return checked_add(10, mir_status); }
    let source_status: i32 = print_resolved_source_function_artifact_bytes(c_source);
    if (source_status != 0) { return checked_add(20, source_status); }
    let header_status: i32 = print_resolved_source_function_artifact_bytes(c_header);
    if (header_status != 0) { return checked_add(30, header_status); }
    return 0;
}

// First SH3 canonical-MIR materializer slice. This writes the established
// bootstrap-mir-v1 canonical JSON directly from validated Merit-owned
// straight-line function records. It deliberately fails closed for record
// kinds outside this bounded slice; later SH3 slices extend this same writer.
fn canonical_mir_append_text(borrow_mut output:Buffer,value:String)->i32
requires_caps [allocate]
{
    var index:i64=0;
    while(index<string_len(value)){
        buffer_push(output,string_byte(value,index));
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_mir_append_i64(borrow_mut output:Buffer,value:i64)->i32
requires_caps [allocate]
{
    var magnitude:i64=value;
    if(magnitude<0){buffer_push(output,45);}
    else{magnitude=checked_sub(0,magnitude);}
    if(magnitude==0){buffer_push(output,48);return 0;}
    var divisor:i64=1;
    while((magnitude/divisor)<=-10){divisor=checked_mul(divisor,10);}
    while(divisor>0){
        let digit:i64=checked_sub(0,magnitude/divisor);
        if(digit==0){buffer_push(output,48);}
        if(digit==1){buffer_push(output,49);}
        if(digit==2){buffer_push(output,50);}
        if(digit==3){buffer_push(output,51);}
        if(digit==4){buffer_push(output,52);}
        if(digit==5){buffer_push(output,53);}
        if(digit==6){buffer_push(output,54);}
        if(digit==7){buffer_push(output,55);}
        if(digit==8){buffer_push(output,56);}
        if(digit==9){buffer_push(output,57);}
        magnitude=checked_add(magnitude,checked_mul(digit,divisor));
        divisor=divisor/10;
    }
    return 0;
}

fn canonical_mir_append_i32(borrow_mut output:Buffer,value:i32)->i32
requires_caps [allocate]
{
    var magnitude:i32=value;
    if(magnitude<0){buffer_push(output,45);}
    else{magnitude=checked_sub(0,magnitude);}
    if(magnitude==0){buffer_push(output,48);return 0;}
    var divisor:i32=1;
    while((magnitude/divisor)<=-10){divisor=checked_mul(divisor,10);}
    while(divisor>0){
        let digit:i32=checked_sub(0,magnitude/divisor);
        if(digit==0){buffer_push(output,48);}if(digit==1){buffer_push(output,49);}
        if(digit==2){buffer_push(output,50);}if(digit==3){buffer_push(output,51);}
        if(digit==4){buffer_push(output,52);}if(digit==5){buffer_push(output,53);}
        if(digit==6){buffer_push(output,54);}if(digit==7){buffer_push(output,55);}
        if(digit==8){buffer_push(output,56);}if(digit==9){buffer_push(output,57);}
        magnitude=checked_add(magnitude,checked_mul(digit,divisor));divisor=divisor/10;
    }
    return 0;
}

// Project assembly deliberately consumes the canonical single-function bytes
// produced by this module instead of reinterpreting the function records a
// second time.  The fixed wrapper is validated byte-for-byte and stripped;
// callers can therefore append functions while their lowering vectors are
// still live, then release those vectors before lowering the next function.
pub fn canonical_mir_begin_project(borrow_mut output:Buffer)->i32
requires_caps [allocate]
{
    if(buffer_len(output)!=0){return 1;}
    return canonical_mir_append_text(output,"{\"functions\":[");
}

pub fn canonical_mir_append_project_function(
    borrow single_function_module:Buffer,
    function_ordinal:i64,
    allocator:Allocator,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_ordinal<0){return 1;}
    let prefix:Buffer=buffer_from_string(allocator,"{\"functions\":[");
    let suffix:Buffer=buffer_from_string(allocator,"],\"name\":\"_\",\"schema\":\"bootstrap-mir-v1\"}");
    let prefix_length:i64=buffer_len(prefix);
    let suffix_length:i64=buffer_len(suffix);
    var status:i32=0;
    if(buffer_len(single_function_module)<=checked_add(prefix_length,suffix_length)){
        status=2;
    }
    var index:i64=0;
    if(status==0){
        while(index<prefix_length){
            if(buffer_get(single_function_module,index)!=buffer_get(prefix,index)){
                status=3;index=prefix_length;
            }else{
                index=checked_add(index,1);
            }
        }
    }
    index=0;
    if(status==0){
        while(index<suffix_length){
            let source_index:i64=checked_add(
                checked_sub(buffer_len(single_function_module),suffix_length),index
            );
            if(buffer_get(single_function_module,source_index)!=buffer_get(suffix,index)){
                status=4;index=suffix_length;
            }else{
                index=checked_add(index,1);
            }
        }
    }
    if(status==0){
        if(function_ordinal>0){buffer_push(output,44);}
        let body_end:i64=checked_sub(buffer_len(single_function_module),suffix_length);
        bootstrap_buffer_append(
            output,single_function_module,prefix_length,
            checked_sub(body_end,prefix_length)
        );
    }
    drop(suffix);drop(prefix);
    return status;
}

pub fn canonical_mir_finish_project(
    module_name:String,
    function_count:i64,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_count<=0){return 1;}
    canonical_mir_append_text(output,"],\"name\":");
    if(canonical_mir_append_json_string(output,module_name)!=0){return 2;}
    canonical_mir_append_text(output,",\"schema\":\"bootstrap-mir-v1\"}");
    return 0;
}

pub fn canonical_mir_finish_project_source(
    borrow source:Buffer,
    module_start:i64,
    module_length:i64,
    function_count:i64,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_count<=0){return 1;}
    canonical_mir_append_text(output,"],\"name\":");
    if(canonical_mir_append_json_source(output,source,module_start,module_length)!=0){return 2;}
    canonical_mir_append_text(output,",\"schema\":\"bootstrap-mir-v1\"}");
    return 0;
}

fn canonical_c_append_function_name(
    borrow source:Buffer,borrow header:MirFunctionRecord,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_mir_mutable(header)!=0){canonical_mir_append_text(output,"merit_");}
    bootstrap_buffer_append(
        output,source,function_mir_symbol_start(header),function_mir_symbol_length(header)
    );
    return 0;
}

fn canonical_c_append_scalar_type(borrow_mut output:Buffer,type_code:i32)->i32
requires_caps [allocate]
{
    if(type_code==function_mir_i64_type_code()){
        canonical_mir_append_text(output,"int64_t");return 0;
    }
    if(type_code==function_mir_i32_type_code()){
        canonical_mir_append_text(output,"int32_t");return 0;
    }
    if(type_code==function_mir_i8_type_code()){
        canonical_mir_append_text(output,"int8_t");return 0;
    }
    if(type_code==function_mir_i16_type_code()){
        canonical_mir_append_text(output,"int16_t");return 0;
    }
    if(type_code==function_mir_u8_type_code()){
        canonical_mir_append_text(output,"uint8_t");return 0;
    }
    if(type_code==function_mir_u16_type_code()){
        canonical_mir_append_text(output,"uint16_t");return 0;
    }
    if(type_code==function_mir_u32_type_code()){
        canonical_mir_append_text(output,"uint32_t");return 0;
    }
    if(type_code==function_mir_u64_type_code()){
        canonical_mir_append_text(output,"uint64_t");return 0;
    }
    if(type_code==function_mir_bool_type_code()){
        canonical_mir_append_text(output,"bool");return 0;
    }
    if(type_code==function_mir_unit_type_code()){
        canonical_mir_append_text(output,"void");return 0;
    }
    if(type_code==function_mir_string_type_code()){
        canonical_mir_append_text(output,"merit_String");return 0;
    }
    if(type_code==function_mir_byte_slice_type_code()){
        canonical_mir_append_text(output,"merit_ByteSlice");return 0;
    }
    if(type_code==function_mir_allocator_type_code()){
        canonical_mir_append_text(output,"merit_Allocator");return 0;
    }
    if(type_code==function_mir_buffer_type_code()){
        canonical_mir_append_text(output,"merit_Buffer");return 0;
    }
    return 1;
}

// Resolve vector identity from the native type catalog. The C spelling is the
// existing oracle's UTF-8 type-name mangle; no host-side type reconstruction
// or positional inference is allowed at this boundary.
pub fn canonical_c_append_vector_type_name(
    type_code:i32,borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(type_code<function_mir_vector_type_code(0)){return 1;}
    canonical_mir_append_text(output,"merit_Vec_");
    var current:i32=type_code;
    var depth:i64=0;
    while(current>=function_mir_vector_type_code(0)){
        if(depth>=vec_len<MirTypeDescriptor>(descriptors)){return 2;}
        var found:i32=0;
        var index:i64=0;
        var child:i32=0;
        while(index<vec_len<MirTypeDescriptor>(descriptors)){
            let descriptor:MirTypeDescriptor=vec_get<MirTypeDescriptor>(descriptors,index);
            if(function_mir_type_descriptor_code(descriptor)==current){
                if(found!=0){return 3;}
                if(function_mir_type_descriptor_kind(descriptor)!=function_mir_type_descriptor_vector_kind()){
                    return 4;
                }
                if(function_mir_type_descriptor_identity(descriptor)!=checked_sub(current,function_mir_vector_type_code(0))){
                    return 4;
                }
                if(function_mir_type_descriptor_destructor_policy(descriptor)!=0){return 4;}
                if(function_mir_type_descriptor_ordinal(descriptor)!=0){return 4;}
                child=function_mir_type_descriptor_child(descriptor);
                found=1;
            }
            index=checked_add(index,1);
        }
        if(found==0){return 5;}
        if(depth>0){canonical_mir_append_text(output,"566563_a_");}
        current=child;
        depth=checked_add(depth,1);
    }
    if(current==function_mir_i64_type_code()){canonical_mir_append_text(output,"693634");return 0;}
    if(current==function_mir_bool_type_code()){canonical_mir_append_text(output,"626f6f6c");return 0;}
    if(current==function_mir_allocator_type_code()){canonical_mir_append_text(output,"416c6c6f6361746f72");return 0;}
    if(current==function_mir_buffer_type_code()){canonical_mir_append_text(output,"427566666572");return 0;}
    if(current==function_mir_i8_type_code()){canonical_mir_append_text(output,"6938");return 0;}
    if(current==function_mir_i16_type_code()){canonical_mir_append_text(output,"693136");return 0;}
    if(current==function_mir_i32_type_code()){canonical_mir_append_text(output,"693332");return 0;}
    if(current==function_mir_u8_type_code()){canonical_mir_append_text(output,"7538");return 0;}
    if(current==function_mir_u16_type_code()){canonical_mir_append_text(output,"753136");return 0;}
    if(current==function_mir_u32_type_code()){canonical_mir_append_text(output,"753332");return 0;}
    if(current==function_mir_u64_type_code()){canonical_mir_append_text(output,"753634");return 0;}
    if(current==function_mir_string_type_code()){canonical_mir_append_text(output,"537472696e67");return 0;}
    if(current==function_mir_byte_slice_type_code()){canonical_mir_append_text(output,"42797465536c696365");return 0;}
    if(current==function_mir_unit_type_code()){canonical_mir_append_text(output,"756e6974");return 0;}
    return 6;
}

fn canonical_c_append_type_with_catalog(
    borrow_mut output:Buffer,type_code:i32,borrow descriptors:Vec<MirTypeDescriptor>
)->i32
requires_caps [allocate]
{
    if(type_code>=function_mir_vector_type_code(0)){
        return canonical_c_append_vector_type_name(type_code,descriptors,output);
    }
    return canonical_c_append_scalar_type(output,type_code);
}

// All fixed-width integer locals use the same scalar C declaration path.
// Keep resource and aggregate admission separate from this storage check.
fn canonical_c_supported_builtin_local_type(type_code:i32)->i32 {
    if(function_mir_type_is_integer(type_code)!=0){return 1;}
    if(type_code==function_mir_bool_type_code()){return 1;}
    if(type_code==function_mir_string_type_code()){return 1;}
    if(type_code==function_mir_allocator_type_code()){return 1;}
    if(type_code==function_mir_byte_slice_type_code()){return 1;}
    if(type_code==function_mir_buffer_type_code()){return 1;}
    return 0;
}

fn canonical_c_append_vector_symbol(
    borrow_mut output:Buffer,operation:String,borrow suffix:Buffer
)->i32
requires_caps [allocate]
{
    canonical_mir_append_text(output,"merit_vec_");
    canonical_mir_append_text(output,operation);
    buffer_push(output,95);
    bootstrap_buffer_append(output,suffix,0,buffer_len(suffix));
    return 0;
}

// Complete oracle-shaped runtime for vectors of Copy scalar elements. Owned
// element cleanup must use the separately proven recursive lifecycle path.
pub fn canonical_c_append_copy_vector_runtime(
    type_code:i32,borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    var vector_type:Buffer=buffer_new(allocator,64);
    let name_status:i32=canonical_c_append_vector_type_name(type_code,descriptors,vector_type);
    if(name_status!=0){return name_status;}
    var child:i32=function_mir_unresolved_type_code();
    var index:i64=0;
    while(index<vec_len<MirTypeDescriptor>(descriptors)){
        let descriptor:MirTypeDescriptor=vec_get<MirTypeDescriptor>(descriptors,index);
        if(function_mir_type_descriptor_code(descriptor)==type_code){
            child=function_mir_type_descriptor_child(descriptor);
        }
        index=checked_add(index,1);
    }
    if(function_mir_type_uses_ownership_transfer(child)!=0){return 7;}
    if(child==function_mir_unit_type_code()){return 7;}
    var element_type:Buffer=buffer_new(allocator,32);
    if(canonical_c_append_scalar_type(element_type,child)!=0){
        return 7;
    }
    var suffix:Buffer=buffer_new(allocator,64);
    let prefix_length:i64=string_len("merit_Vec_");
    bootstrap_buffer_append(suffix,vector_type,prefix_length,checked_sub(buffer_len(vector_type),prefix_length));
    // The vector typedef is emitted before prototypes; this complete helper
    // family follows prototypes, in the oracle's fixed order.
    canonical_mir_append_text(output,"static void ");canonical_c_append_vector_symbol(output,"reserve",suffix);
    buffer_push(output,40);bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *value, size_t needed) {\n    if (needed <= value->capacity) return;\n    size_t capacity = value->capacity ? value->capacity : 8;\n    while (capacity < needed) capacity *= 2;\n    void *data = realloc(value->data, capacity * sizeof(");
    bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    canonical_mir_append_text(output,"));\n    if (!data) { fprintf(stderr, \"Merit allocation failed\\n\"); exit(80); }\n    value->data = data; value->capacity = capacity;\n}\n");
    canonical_mir_append_text(output,"static ");bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    buffer_push(output,32);canonical_c_append_vector_symbol(output,"new",suffix);
    canonical_mir_append_text(output,"(merit_Allocator allocator, int64_t capacity) {\n    if (capacity < 0) { fprintf(stderr, \"Merit negative capacity\\n\"); exit(81); }\n    ");
    bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," result = {0}; result.allocator = allocator; ");
    canonical_c_append_vector_symbol(output,"reserve",suffix);
    canonical_mir_append_text(output,"(&result, (size_t)capacity);\n    return result;\n}\n");
    canonical_mir_append_text(output,"static void ");canonical_c_append_vector_symbol(output,"push",suffix);
    buffer_push(output,40);bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *value, ");bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    canonical_mir_append_text(output," element) {\n    ");canonical_c_append_vector_symbol(output,"reserve",suffix);
    canonical_mir_append_text(output,"(value, value->len + 1); ((");
    bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    canonical_mir_append_text(output," *)value->data)[value->len++] = element;\n}\n");
    canonical_mir_append_text(output,"static int64_t ");canonical_c_append_vector_symbol(output,"len",suffix);
    canonical_mir_append_text(output,"(const ");bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *value) { return (int64_t)value->len; }\n");
    canonical_mir_append_text(output,"static merit_Allocator ");canonical_c_append_vector_symbol(output,"allocator",suffix);
    canonical_mir_append_text(output,"(const ");bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *value) { return value->allocator; }\n");
    canonical_mir_append_text(output,"static ");bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    buffer_push(output,32);canonical_c_append_vector_symbol(output,"get",suffix);
    canonical_mir_append_text(output,"(const ");bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *value, int64_t index) {\n    if (index < 0 || (size_t)index >= value->len) { fprintf(stderr, \"Merit vector index out of bounds\\n\"); exit(86); }\n    return ((const ");
    bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    canonical_mir_append_text(output," *)value->data)[index];\n}\n");
    canonical_mir_append_text(output,"static void ");canonical_c_append_vector_symbol(output,"set",suffix);
    buffer_push(output,40);bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *value, int64_t index, ");bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    canonical_mir_append_text(output," element) {\n    if (index < 0 || (size_t)index >= value->len) { fprintf(stderr, \"Merit vector index out of bounds\\n\"); exit(86); }\n    ((");
    bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    canonical_mir_append_text(output," *)value->data)[index] = element;\n}\n");
    canonical_mir_append_text(output,"static void ");canonical_c_append_vector_symbol(output,"replace",suffix);
    buffer_push(output,40);bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *value, int64_t index, ");bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    canonical_mir_append_text(output," element) {\n    if (index < 0 || (size_t)index >= value->len) { fprintf(stderr, \"Merit vector index out of bounds\\n\"); exit(86); }\n    /* explicit no-op in scalar bootstrap C subset */\n    ((");
    bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    canonical_mir_append_text(output," *)value->data)[index] = element;\n}\n");
    canonical_mir_append_text(output,"static ");bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    buffer_push(output,32);canonical_c_append_vector_symbol(output,"pop",suffix);
    buffer_push(output,40);bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *value) {\n    if (!value->len) { fprintf(stderr, \"Merit vector pop from empty\\n\"); exit(86); }\n    return ((");
    bootstrap_buffer_append(output,element_type,0,buffer_len(element_type));
    canonical_mir_append_text(output," *)value->data)[--value->len];\n}\n");
    canonical_mir_append_text(output,"static void ");canonical_c_append_vector_symbol(output,"drop",suffix);
    buffer_push(output,40);bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *value) {\n    for (size_t index = 0; index < value->len; ++index) {\n        /* explicit no-op in scalar bootstrap C subset */\n    }\n    free(value->data); value->data = NULL; value->len = 0; value->capacity = 0;\n}\n");
    canonical_mir_append_text(output,"static void ");canonical_c_append_vector_symbol(output,"transfer",suffix);
    buffer_push(output,40);bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *destination, ");bootstrap_buffer_append(output,vector_type,0,buffer_len(vector_type));
    canonical_mir_append_text(output," *source) {\n    if (destination == source) { fprintf(stderr, \"Merit vector transfer aliases itself\\n\"); exit(90); }\n    if (!merit_allocator_compatible(destination->allocator, source->allocator)) { fprintf(stderr, \"Merit incompatible vector allocators\\n\"); exit(90); }\n    if (destination->len) { fprintf(stderr, \"Merit vector transfer destination is not empty\\n\"); exit(90); }\n    free(destination->data); destination->data = source->data; destination->len = source->len; destination->capacity = source->capacity;\n    source->data = NULL; source->len = 0; source->capacity = 0;\n}\n");
    drop(suffix);drop(element_type);drop(vector_type);
    return 0;
}

fn canonical_c_append_scalar_prototype(
    borrow source:Buffer,borrow header:MirFunctionRecord,
    borrow records:Vec<MirFunctionRecord>,borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(canonical_c_append_type_with_catalog(output,function_mir_type_code(header),descriptors)!=0){return 3;}
    buffer_push(output,32);
    canonical_c_append_function_name(source,header,output);
    if(canonical_c_append_scalar_parameters(records,descriptors,output)!=0){return 4;}
    buffer_push(output,59);
    return 0;
}

fn canonical_c_append_scalar_parameters(
    borrow records:Vec<MirFunctionRecord>,borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    buffer_push(output,40);
    let header:MirFunctionRecord=vec_get<MirFunctionRecord>(records,0);
    let parameter_count:i64=function_mir_ordinal(header);
    if(parameter_count==0){canonical_mir_append_text(output,"void");}
    var ordinal:i64=0;
    while(ordinal<parameter_count){
        var found:i32=0;var index:i64=1;var matched_type:i32=0;var matched_mode:i32=0;
        while(index<vec_len<MirFunctionRecord>(records)){
            let parameter:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
            if(function_mir_kind(parameter)==function_mir_kind_parameter()){
                if(function_mir_ordinal(parameter)==ordinal){
                    if(found!=0){return 1;}
                    if(function_mir_id(parameter)!=ordinal){return 2;}
                    let parameter_type:i32=function_mir_type_code(parameter);
                    if(parameter_type!=function_mir_i64_type_code()){
                        if(parameter_type!=function_mir_i32_type_code()){
                            if(parameter_type!=function_mir_bool_type_code()){
                                if(parameter_type!=function_mir_string_type_code()){
                                    if(parameter_type!=function_mir_allocator_type_code()){
                                    if(parameter_type!=function_mir_u8_type_code()){
                                        if(parameter_type!=function_mir_byte_slice_type_code()){
                                            if(parameter_type!=function_mir_buffer_type_code()){
                                                if(parameter_type<function_mir_vector_type_code(0)){return 3;}
                                            }
                                        }
                                    }
                                    }
                                }
                            }
                        }
                    }
                    let parameter_mode:i32=function_mir_symbol_code(parameter);
                    if(parameter_mode!=function_mir_mode_value()){
                        if(parameter_mode!=function_mir_mode_borrowed()){return 4;}
                        if(parameter_type!=function_mir_string_type_code()){
                            if(parameter_type!=function_mir_buffer_type_code()){return 4;}
                        }
                    }
                    matched_type=parameter_type;matched_mode=parameter_mode;found=1;
                }
            }
            index=checked_add(index,1);
        }
        if(found==0){return 5;}
        if(ordinal>0){canonical_mir_append_text(output,", ");}
        if(matched_mode==function_mir_mode_borrowed()){canonical_mir_append_text(output,"const ");}
        if(canonical_c_append_type_with_catalog(output,matched_type,descriptors)!=0){return 3;}
        if(matched_mode==function_mir_mode_borrowed()){canonical_mir_append_text(output," *");}
        canonical_mir_append_text(output," m");canonical_mir_append_i64(output,ordinal);
        ordinal=checked_add(ordinal,1);
    }
    buffer_push(output,41);
    return 0;
}

fn canonical_c_checked_add_feature()->i64{return 1;}
fn canonical_c_i64_print_feature()->i64{return 2;}
fn canonical_c_checked_multiply_feature()->i64{return 3;}
fn canonical_c_checked_subtract_feature()->i64{return 4;}
fn canonical_c_checked_divide_feature()->i64{return 5;}
fn canonical_c_checked_i32_add_feature()->i64{return 6;}
fn canonical_c_checked_i32_multiply_feature()->i64{return 7;}
fn canonical_c_checked_i32_subtract_feature()->i64{return 8;}
fn canonical_c_checked_i32_divide_feature()->i64{return 9;}
fn canonical_c_text_feature()->i64{return 10;}
fn canonical_c_public_string_feature()->i64{return 11;}
fn canonical_c_buffer_runtime_feature()->i64{return 12;}
fn canonical_c_slice_feature()->i64{return 13;}
fn canonical_c_vector_get_operation()->i32{return 1;}
fn canonical_c_vector_set_operation()->i32{return 2;}
fn canonical_c_vector_replace_operation()->i32{return 3;}
fn canonical_c_vector_pop_operation()->i32{return 4;}
fn canonical_c_vector_allocator_operation()->i32{return 5;}

fn canonical_c_source_name_equals(borrow source:Buffer,start:i64,length:i64,name:String)->i32
requires_caps [allocate]
{
    if(start<0){return 0;}
    if(length<0){return 0;}
    if(start>buffer_len(source)){return 0;}
    if(length>checked_sub(buffer_len(source),start)){return 0;}
    let expected:Buffer=buffer_from_string(system_allocator(),name);
    var index:i64=0;var same:i32=1;
    if(length!=buffer_len(expected)){same=0;}
    if(same!=0){
        while(index<length){
            if(buffer_get(source,checked_add(start,index))!=buffer_get(expected,index)){same=0;}
            index=checked_add(index,1);
        }
    }
    drop(expected);return same;
}

fn canonical_c_source_vector_call_name(
    borrow source:Buffer,start:i64,length:i64,operation:String
)->i32
requires_caps [allocate]
{
    if(start<0){return 0;}
    let prefix_length:i64=string_len(operation);
    if(length<=checked_add(prefix_length,2)){return 0;}
    if(checked_add(start,length)>buffer_len(source)){return 0;}
    var operation_bytes:Buffer=buffer_from_string(system_allocator(),operation);
    var matches:i32=1;
    var index:i64=0;
    while(index<prefix_length){
        if(buffer_get(source,checked_add(start,index))!=buffer_get(operation_bytes,index)){matches=0;}
        index=checked_add(index,1);
    }
    drop(operation_bytes);
    if(matches==0){return 0;}
    let separator:i64=buffer_get(source,checked_add(start,prefix_length));
    if(separator==95){
        if(buffer_get(source,checked_add(checked_add(start,prefix_length),1))==95){return 1;}
    }
    if(separator==60){
        if(buffer_get(source,checked_sub(checked_add(start,length),1))==62){return 1;}
    }
    return 0;
}

fn canonical_c_require_feature(feature:i64,borrow_mut features:Vec<i64>)->i32
requires_caps [allocate]
{
    var index:i64=0;
    while(index<vec_len<i64>(features)){
        if(vec_get<i64>(features,index)==feature){return 0;}
        index=checked_add(index,1);
    }
    vec_push<i64>(features,feature);return 0;
}

fn canonical_c_has_feature(feature:i64,borrow features:Vec<i64>)->i32
{
    var index:i64=0;
    while(index<vec_len<i64>(features)){
        if(vec_get<i64>(features,index)==feature){return 1;}
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_c_has_checked_feature(borrow features:Vec<i64>)->i32
{
    if(canonical_c_has_feature(canonical_c_checked_add_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_subtract_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_multiply_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_divide_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_i32_add_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_i32_subtract_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_i32_multiply_feature(),features)!=0){return 1;}
    if(canonical_c_has_feature(canonical_c_checked_i32_divide_feature(),features)!=0){return 1;}
    return 0;
}

fn canonical_c_scalar_local_type(borrow records:Vec<MirFunctionRecord>,local_id:i64)->i32
{
    var index:i64=1;
    while(index<vec_len<MirFunctionRecord>(records)){
        let record:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        let kind:i32=function_mir_kind(record);
        var is_local:i32=0;
        if(kind==function_mir_kind_parameter()){is_local=1;}
        if(kind==function_mir_kind_source_local()){is_local=1;}
        if(kind==function_mir_kind_temporary_local()){is_local=1;}
        if(is_local!=0){
            if(function_mir_id(record)==local_id){return function_mir_type_code(record);}
        }
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_c_local_access_mode(borrow records:Vec<MirFunctionRecord>,local_id:i64)->i32
{
    var index:i64=1;
    while(index<vec_len<MirFunctionRecord>(records)){
        let record:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        if(function_mir_id(record)==local_id){
            if(function_mir_kind(record)==function_mir_kind_parameter()){
                return function_mir_symbol_code(record);
            }
            if(function_mir_kind(record)==function_mir_kind_temporary_local()){
                return function_mir_numeric_policy(record);
            }
        }
        index=checked_add(index,1);
    }
    return function_mir_mode_value();
}

fn canonical_c_resource_unsupported_effect_status()->i32{return 1;}
fn canonical_c_resource_invalid_operand_status()->i32{return 2;}
fn canonical_c_resource_invalid_result_status()->i32{return 3;}
fn canonical_c_resource_invalid_instruction_status()->i32{return 4;}
fn canonical_c_resource_missing_catalog_status()->i32{return 108;}
fn canonical_c_resource_missing_placement_source_status()->i32{return 109;}
fn canonical_c_resource_missing_effect_status()->i32{return 110;}
fn canonical_c_resource_instruction_mismatch_status()->i32{return 111;}
fn canonical_c_resource_operand_mismatch_status()->i32{return 112;}
fn canonical_c_resource_effect_failure_status(status:i32)->i32{return checked_add(113,status);}

// Lower only explicit, already-validated Alpha.2 resource effects. The MIR
// effect remains independent of Buffer's physical allocation representation.
pub fn canonical_c_append_resource_effect(
    borrow effect:MirOwnershipRecord,result_local:i64,
    borrow records:Vec<MirFunctionRecord>,borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(ownership_record_instruction_id(effect)<0){return canonical_c_resource_invalid_instruction_status();}
    let effect_kind:i32=ownership_record_kind(effect);
    var is_move:i32=0;
    if(effect_kind==ownership_record_kind_move()){is_move=1;}
    if(effect_kind==ownership_record_kind_replace_move()){is_move=1;}
    var is_drop:i32=0;
    if(effect_kind==ownership_record_kind_drop()){is_drop=1;}
    if(effect_kind==ownership_record_kind_replace_drop()){is_drop=1;}
    if(effect_kind==ownership_record_kind_implicit_drop()){is_drop=1;}
    if(is_move==0){if(is_drop==0){return canonical_c_resource_unsupported_effect_status();}}
    let operand_local:i64=ownership_record_operand_local(effect);
    if(operand_local<0){return canonical_c_resource_invalid_operand_status();}
    let resource_type:i32=canonical_c_scalar_local_type(records,operand_local);
    if(resource_type!=function_mir_buffer_type_code()){
        if(resource_type<function_mir_vector_type_code(0)){
            return canonical_c_resource_invalid_operand_status();
        }
    }
    let allocator:Allocator=system_allocator();
    var vector_name:Buffer=buffer_new(allocator,64);
    if(resource_type>=function_mir_vector_type_code(0)){
        if(canonical_c_append_vector_type_name(resource_type,descriptors,vector_name)!=0){
            return canonical_c_resource_invalid_operand_status();
        }
    }
    if(is_move!=0){
        if(result_local<0){return canonical_c_resource_invalid_result_status();}
        if(canonical_c_scalar_local_type(records,result_local)!=resource_type){
            return canonical_c_resource_invalid_result_status();
        }
        canonical_mir_append_text(output,"    m");
        canonical_mir_append_i64(output,result_local);
        canonical_mir_append_text(output," = m");
        canonical_mir_append_i64(output,operand_local);
        canonical_mir_append_text(output,";\n");
    }else{
        if(result_local>=0){return canonical_c_resource_invalid_result_status();}
        if(resource_type==function_mir_buffer_type_code()){
            canonical_mir_append_text(output,"    merit_buffer_drop(&(m");
        }else{
            canonical_mir_append_text(output,"    merit_vec_drop_");
            let prefix_length:i64=string_len("merit_Vec_");
            bootstrap_buffer_append(output,vector_name,prefix_length,checked_sub(buffer_len(vector_name),prefix_length));
            canonical_mir_append_text(output,"(&(m");
        }
        canonical_mir_append_i64(output,operand_local);
        canonical_mir_append_text(output,"));\n");
    }
    drop(vector_name);
    return 0;
}

pub fn canonical_c_append_buffer_resource_effect(
    borrow effect:MirOwnershipRecord,result_local:i64,
    borrow records:Vec<MirFunctionRecord>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    var descriptors:Vec<MirTypeDescriptor>=vec_new<MirTypeDescriptor>(allocator,0);
    let status:i32=canonical_c_append_resource_effect(effect,result_local,records,descriptors,output);
    drop(descriptors);
    return status;
}

fn canonical_c_append_boolean_literal(
    borrow source:Buffer,start:i64,length:i64,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(start<0){return 1;}
    if(length<=0){return 1;}
    if(checked_add(start,length)>buffer_len(source)){return 1;}
    // The byte values below are the ASCII source-spelling boundary.
    if(length==1){
        let value:i64=buffer_get(source,start);
        if(value==49){canonical_mir_append_text(output,"true");return 0;}
        if(value==48){canonical_mir_append_text(output,"false");return 0;}
    }
    if(length==4){
        if(buffer_get(source,start)==116){
            if(buffer_get(source,checked_add(start,1))==114){
                if(buffer_get(source,checked_add(start,2))==117){
                    if(buffer_get(source,checked_add(start,3))==101){
                        canonical_mir_append_text(output,"true");return 0;
                    }
                }
            }
        }
    }
    if(length==5){
        if(buffer_get(source,start)==102){
            if(buffer_get(source,checked_add(start,1))==97){
                if(buffer_get(source,checked_add(start,2))==108){
                    if(buffer_get(source,checked_add(start,3))==115){
                        if(buffer_get(source,checked_add(start,4))==101){
                            canonical_mir_append_text(output,"false");return 0;
                        }
                    }
                }
            }
        }
    }
    return 1;
}

fn canonical_c_append_scalar_integer_literal(
    borrow source:Buffer,start:i64,length:i64,type_code:i32,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(start<0){return 1;}
    if(length<=0){return 1;}
    if(checked_add(start,length)>buffer_len(source)){return 1;}
    var digit_start:i64=start;
    var negative:i32=0;
    let first:i64=buffer_get(source,start);
    if(first==45){negative=1;digit_start=checked_add(digit_start,1);}
    if(first==43){digit_start=checked_add(digit_start,1);}
    let end:i64=checked_add(start,length);
    if(digit_start>=end){return 1;}
    var index:i64=digit_start;
    while(index<end){
        let digit:i64=buffer_get(source,index);
        if(digit<48){return 1;}
        if(digit>57){return 1;}
        index=checked_add(index,1);
    }
    var scanning_zero:i32=1;
    while(scanning_zero!=0){
        if(digit_start>=checked_sub(end,1)){scanning_zero=0;}
        else{
            if(buffer_get(source,digit_start)==48){digit_start=checked_add(digit_start,1);}
            else{scanning_zero=0;}
        }
    }
    if(buffer_get(source,digit_start)==48){negative=0;}
    if(function_mir_type_is_integer(type_code)==0){return 1;}
    if(type_code==function_mir_u8_type_code()){if(negative!=0){return 1;}}
    if(type_code==function_mir_u16_type_code()){if(negative!=0){return 1;}}
    if(type_code==function_mir_u32_type_code()){if(negative!=0){return 1;}}
    if(type_code==function_mir_u64_type_code()){if(negative!=0){return 1;}}
    var limit:Buffer=buffer_new(system_allocator(),20);
    if(type_code==function_mir_i8_type_code()){
        if(negative!=0){canonical_mir_append_text(limit,"128");}
        else{canonical_mir_append_text(limit,"127");}
    }
    if(type_code==function_mir_i16_type_code()){
        if(negative!=0){canonical_mir_append_text(limit,"32768");}
        else{canonical_mir_append_text(limit,"32767");}
    }
    if(type_code==function_mir_i32_type_code()){
        if(negative!=0){canonical_mir_append_text(limit,"2147483648");}
        else{canonical_mir_append_text(limit,"2147483647");}
    }
    if(type_code==function_mir_i64_type_code()){
        if(negative!=0){canonical_mir_append_text(limit,"9223372036854775808");}
        else{canonical_mir_append_text(limit,"9223372036854775807");}
    }
    if(type_code==function_mir_u8_type_code()){canonical_mir_append_text(limit,"255");}
    if(type_code==function_mir_u16_type_code()){canonical_mir_append_text(limit,"65535");}
    if(type_code==function_mir_u32_type_code()){canonical_mir_append_text(limit,"4294967295");}
    if(type_code==function_mir_u64_type_code()){canonical_mir_append_text(limit,"18446744073709551615");}
    let digits:i64=checked_sub(end,digit_start);
    var valid:i32=1;
    var minimum:i32=0;
    if(digits>buffer_len(limit)){valid=0;}
    if(digits==buffer_len(limit)){
        index=0;var comparison:i32=0;
        while(index<digits){
            let actual:i64=buffer_get(source,checked_add(digit_start,index));
            let maximum:i64=buffer_get(limit,index);
            if(comparison==0){
                if(actual>maximum){comparison=1;}
                if(actual<maximum){comparison=-1;}
            }
            index=checked_add(index,1);
        }
        if(comparison>0){valid=0;}
        if(comparison==0){
            if(negative!=0){minimum=1;}
        }
    }
    drop(limit);
    if(valid==0){return 1;}
    if(minimum!=0){
        if(type_code==function_mir_i8_type_code()){canonical_mir_append_text(output,"INT8_MIN");}
        if(type_code==function_mir_i16_type_code()){canonical_mir_append_text(output,"INT16_MIN");}
        if(type_code==function_mir_i32_type_code()){canonical_mir_append_text(output,"INT32_MIN");}
        if(type_code==function_mir_i64_type_code()){canonical_mir_append_text(output,"INT64_MIN");}
        return 0;
    }
    if(type_code==function_mir_i8_type_code()){canonical_mir_append_text(output,"INT8_C(");}
    if(type_code==function_mir_i16_type_code()){canonical_mir_append_text(output,"INT16_C(");}
    if(type_code==function_mir_i32_type_code()){canonical_mir_append_text(output,"INT32_C(");}
    if(type_code==function_mir_i64_type_code()){canonical_mir_append_text(output,"INT64_C(");}
    if(type_code==function_mir_u8_type_code()){canonical_mir_append_text(output,"UINT8_C(");}
    if(type_code==function_mir_u16_type_code()){canonical_mir_append_text(output,"UINT16_C(");}
    if(type_code==function_mir_u32_type_code()){canonical_mir_append_text(output,"UINT32_C(");}
    if(type_code==function_mir_u64_type_code()){canonical_mir_append_text(output,"UINT64_C(");}
    if(negative!=0){buffer_push(output,45);}
    bootstrap_buffer_append(output,source,digit_start,digits);
    buffer_push(output,41);
    return 0;
}

// ASCII JSON spelling and UTF-8 output are representation boundaries.
fn canonical_c_json_hex_digit(value:i64)->i64
{
    if(value>=48){if(value<=57){return checked_sub(value,48);}}
    if(value>=65){if(value<=70){return checked_sub(value,55);}}
    if(value>=97){if(value<=102){return checked_sub(value,87);}}
    return -1;
}

fn canonical_c_json_unicode_codepoint(borrow source:Buffer,start:i64,end:i64)->i64
{
    if(start<0){return -1;}
    if(checked_add(start,4)>end){return -1;}
    var codepoint:i64=0;var index:i64=0;
    while(index<4){
        let digit:i64=canonical_c_json_hex_digit(buffer_get(source,checked_add(start,index)));
        if(digit<0){return -1;}
        codepoint=checked_add(checked_mul(codepoint,16),digit);
        index=checked_add(index,1);
    }
    return codepoint;
}

fn canonical_c_append_hex_byte(value:i64,borrow_mut output:Buffer)->i32
requires_caps [allocate]
{
    if(value<0){return 1;}
    if(value>255){return 1;}
    buffer_push(output,92);buffer_push(output,120);
    let high:i64=value/16;
    let low:i64=checked_sub(value,checked_mul(high,16));
    let digits:String="0123456789abcdef";
    buffer_push(output,string_byte(digits,high));
    buffer_push(output,string_byte(digits,low));
    return 0;
}

fn canonical_c_append_utf8_codepoint(codepoint:i64,borrow_mut output:Buffer)->i64
requires_caps [allocate]
{
    if(codepoint<0){return -1;}
    if(codepoint>1114111){return -1;}
    if(codepoint>=55296){if(codepoint<=57343){return -1;}}
    if(codepoint<=127){canonical_c_append_hex_byte(codepoint,output);return 1;}
    if(codepoint<=2047){
        canonical_c_append_hex_byte(checked_add(192,codepoint/64),output);
        canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint,checked_mul(codepoint/64,64))),output);
        return 2;
    }
    if(codepoint<=65535){
        canonical_c_append_hex_byte(checked_add(224,codepoint/4096),output);
        canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint/64,checked_mul(codepoint/4096,64))),output);
        canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint,checked_mul(codepoint/64,64))),output);
        return 3;
    }
    canonical_c_append_hex_byte(checked_add(240,codepoint/262144),output);
    canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint/4096,checked_mul(codepoint/262144,64))),output);
    canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint/64,checked_mul(codepoint/4096,64))),output);
    canonical_c_append_hex_byte(checked_add(128,checked_sub(codepoint,checked_mul(codepoint/64,64))),output);
    return 4;
}

fn canonical_c_decode_json_string(
    borrow source:Buffer,start:i64,length:i64,borrow_mut output:Buffer
)->i64
requires_caps [allocate]
{
    if(start<0){return -1;}
    if(length<2){return -1;}
    let end:i64=checked_add(start,length);
    if(end>buffer_len(source)){return -1;}
    if(buffer_get(source,start)!=34){return -1;}
    let closing:i64=checked_sub(end,1);
    if(buffer_get(source,closing)!=34){return -1;}
    var cursor:i64=checked_add(start,1);
    var decoded_length:i64=0;
    while(cursor<closing){
        let byte:i64=buffer_get(source,cursor);
        if(byte<32){return -1;}
        if(byte==34){return -1;}
        if(byte!=92){
            canonical_c_append_hex_byte(byte,output);
            decoded_length=checked_add(decoded_length,1);
            cursor=checked_add(cursor,1);
        }else{
            cursor=checked_add(cursor,1);
            if(cursor>=closing){return -1;}
            let escaped:i64=buffer_get(source,cursor);
            if(escaped==117){
                let high:i64=canonical_c_json_unicode_codepoint(source,checked_add(cursor,1),closing);
                if(high<0){return -1;}
                cursor=checked_add(cursor,5);
                var codepoint:i64=high;
                if(high>=55296){
                    if(high<=56319){
                        if(checked_add(cursor,6)>closing){return -1;}
                        if(buffer_get(source,cursor)!=92){return -1;}
                        if(buffer_get(source,checked_add(cursor,1))!=117){return -1;}
                        let low:i64=canonical_c_json_unicode_codepoint(source,checked_add(cursor,2),closing);
                        if(low<56320){return -1;}
                        if(low>57343){return -1;}
                        codepoint=checked_add(65536,checked_add(
                            checked_mul(checked_sub(high,55296),1024),checked_sub(low,56320)
                        ));
                        cursor=checked_add(cursor,6);
                    }else{if(high<=57343){return -1;}}
                }
                let appended:i64=canonical_c_append_utf8_codepoint(codepoint,output);
                if(appended<0){return -1;}
                decoded_length=checked_add(decoded_length,appended);
            }else{
                var translated:i64=-1;
                if(escaped==34){translated=34;}
                if(escaped==47){translated=47;}
                if(escaped==92){translated=92;}
                if(escaped==98){translated=8;}
                if(escaped==102){translated=12;}
                if(escaped==110){translated=10;}
                if(escaped==114){translated=13;}
                if(escaped==116){translated=9;}
                if(translated<0){return -1;}
                canonical_c_append_hex_byte(translated,output);
                decoded_length=checked_add(decoded_length,1);
                cursor=checked_add(cursor,1);
            }
        }
    }
    return decoded_length;
}

fn canonical_c_append_string_literal(
    borrow source:Buffer,start:i64,length:i64,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(length<2){return 1;}
    canonical_mir_append_text(output,"(merit_String){ (const uint8_t *)\"");
    let decoded_length:i64=canonical_c_decode_json_string(source,start,length,output);
    if(decoded_length<0){return 1;}
    canonical_mir_append_text(output,"\", ");
    canonical_mir_append_i64(output,decoded_length);
    canonical_mir_append_text(output," }");
    return 0;
}

fn canonical_c_append_vec_len_call(
    borrow instruction:MirFunctionRecord,borrow records:Vec<MirFunctionRecord>,
    borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_mir_type_code(instruction)!=function_mir_i64_type_code()){return 66;}
    if(function_mir_numeric_policy(instruction)!=function_mir_mode_value()){return 66;}
    let result_local:i64=function_mir_result(instruction);
    if(result_local<0){return 66;}
    if(canonical_c_scalar_local_type(records,result_local)!=function_mir_i64_type_code()){return 95;}
    var argument_count:i64=0;
    var receiver_local:i64=-1;
    var index:i64=1;
    while(index<vec_len<MirFunctionRecord>(records)){
        let argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        if(function_mir_kind(argument)==function_mir_kind_call_argument()){
            if(function_mir_id(argument)==function_mir_id(instruction)){
                if(function_mir_ordinal(argument)!=0){return 68;}
                if(function_mir_symbol_code(argument)!=function_mir_mode_borrowed()){return 68;}
                receiver_local=function_mir_left(argument);
                argument_count=checked_add(argument_count,1);
            }
        }
        index=checked_add(index,1);
    }
    if(argument_count!=1){return 70;}
    let receiver_type:i32=canonical_c_scalar_local_type(records,receiver_local);
    if(receiver_type<function_mir_vector_type_code(0)){return 96;}
    let allocator:Allocator=system_allocator();
    var vector_name:Buffer=buffer_new(allocator,64);
    if(canonical_c_append_vector_type_name(receiver_type,descriptors,vector_name)!=0){return 96;}
    canonical_mir_append_text(output,"    m");
    canonical_mir_append_i64(output,result_local);
    canonical_mir_append_text(output," = merit_vec_len_");
    let prefix_length:i64=string_len("merit_Vec_");
    bootstrap_buffer_append(output,vector_name,prefix_length,checked_sub(buffer_len(vector_name),prefix_length));
    canonical_mir_append_text(output,"(&m");
    canonical_mir_append_i64(output,receiver_local);
    canonical_mir_append_text(output,");\n");
    drop(vector_name);
    return 0;
}

fn canonical_c_append_vec_new_call(
    borrow instruction:MirFunctionRecord,borrow records:Vec<MirFunctionRecord>,
    borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    let vector_type:i32=function_mir_type_code(instruction);
    if(vector_type<function_mir_vector_type_code(0)){return 66;}
    if(function_mir_numeric_policy(instruction)!=function_mir_mode_value()){return 66;}
    let result_local:i64=function_mir_result(instruction);
    if(result_local<0){return 66;}
    if(canonical_c_scalar_local_type(records,result_local)!=vector_type){return 95;}
    var allocator_local:i64=-1;var capacity_local:i64=-1;var argument_count:i64=0;
    var index:i64=1;
    while(index<vec_len<MirFunctionRecord>(records)){
        let argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        if(function_mir_kind(argument)==function_mir_kind_call_argument()){
            if(function_mir_id(argument)==function_mir_id(instruction)){
                if(function_mir_symbol_code(argument)!=function_mir_mode_value()){return 68;}
                if(function_mir_ordinal(argument)==0){allocator_local=function_mir_left(argument);}
                else{if(function_mir_ordinal(argument)==1){capacity_local=function_mir_left(argument);}
                else{return 68;}}
                argument_count=checked_add(argument_count,1);
            }
        }
        index=checked_add(index,1);
    }
    if(argument_count!=2){return 70;}
    if(canonical_c_scalar_local_type(records,allocator_local)!=function_mir_allocator_type_code()){return 96;}
    if(canonical_c_scalar_local_type(records,capacity_local)!=function_mir_i64_type_code()){return 96;}
    let allocator:Allocator=system_allocator();
    var vector_name:Buffer=buffer_new(allocator,64);
    if(canonical_c_append_vector_type_name(vector_type,descriptors,vector_name)!=0){return 96;}
    canonical_mir_append_text(output,"    m");canonical_mir_append_i64(output,result_local);
    canonical_mir_append_text(output," = merit_vec_new_");
    let prefix_length:i64=string_len("merit_Vec_");
    bootstrap_buffer_append(output,vector_name,prefix_length,checked_sub(buffer_len(vector_name),prefix_length));
    canonical_mir_append_text(output,"(m");canonical_mir_append_i64(output,allocator_local);
    canonical_mir_append_text(output,", m");canonical_mir_append_i64(output,capacity_local);
    canonical_mir_append_text(output,");\n");
    drop(vector_name);
    return 0;
}

fn canonical_c_append_vec_push_call(
    borrow instruction:MirFunctionRecord,borrow records:Vec<MirFunctionRecord>,
    borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_mir_type_code(instruction)!=function_mir_unit_type_code()){return 66;}
    if(function_mir_result(instruction)!=-1){return 66;}
    if(function_mir_numeric_policy(instruction)!=function_mir_mode_value()){return 66;}
    var receiver_local:i64=-1;var element_local:i64=-1;var argument_count:i64=0;
    var index:i64=1;
    while(index<vec_len<MirFunctionRecord>(records)){
        let argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        if(function_mir_kind(argument)==function_mir_kind_call_argument()){
            if(function_mir_id(argument)==function_mir_id(instruction)){
                if(function_mir_ordinal(argument)==0){
                    if(function_mir_symbol_code(argument)!=function_mir_mode_mutable_borrow()){return 68;}
                    receiver_local=function_mir_left(argument);
                }else{if(function_mir_ordinal(argument)==1){
                    if(function_mir_symbol_code(argument)!=function_mir_mode_value()){return 68;}
                    element_local=function_mir_left(argument);
                }else{return 68;}}
                argument_count=checked_add(argument_count,1);
            }
        }
        index=checked_add(index,1);
    }
    if(argument_count!=2){return 70;}
    let vector_type:i32=canonical_c_scalar_local_type(records,receiver_local);
    if(vector_type<function_mir_vector_type_code(0)){return 96;}
    let allocator:Allocator=system_allocator();
    var vector_name:Buffer=buffer_new(allocator,64);
    if(canonical_c_append_vector_type_name(vector_type,descriptors,vector_name)!=0){return 96;}
    var element_type:i32=function_mir_unresolved_type_code();
    index=0;
    while(index<vec_len<MirTypeDescriptor>(descriptors)){
        let descriptor:MirTypeDescriptor=vec_get<MirTypeDescriptor>(descriptors,index);
        if(function_mir_type_descriptor_code(descriptor)==vector_type){
            element_type=function_mir_type_descriptor_child(descriptor);
        }
        index=checked_add(index,1);
    }
    if(function_mir_type_uses_ownership_transfer(element_type)!=0){return 96;}
    if(canonical_c_scalar_local_type(records,element_local)!=element_type){return 96;}
    canonical_mir_append_text(output,"    merit_vec_push_");
    let prefix_length:i64=string_len("merit_Vec_");
    bootstrap_buffer_append(output,vector_name,prefix_length,checked_sub(buffer_len(vector_name),prefix_length));
    canonical_mir_append_text(output,"(&m");canonical_mir_append_i64(output,receiver_local);
    canonical_mir_append_text(output,", m");canonical_mir_append_i64(output,element_local);
    canonical_mir_append_text(output,");\n");
    drop(vector_name);
    return 0;
}

fn canonical_c_append_copy_vector_operation_call(
    operation:i32,borrow instruction:MirFunctionRecord,borrow records:Vec<MirFunctionRecord>,
    borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_mir_numeric_policy(instruction)!=function_mir_mode_value()){return 66;}
    var expected_count:i64=1;
    if(operation==canonical_c_vector_get_operation()){expected_count=2;}
    if(operation==canonical_c_vector_set_operation()){expected_count=3;}
    if(operation==canonical_c_vector_replace_operation()){expected_count=3;}
    var receiver_local:i64=-1;var index_local:i64=-1;var element_local:i64=-1;
    var argument_count:i64=0;var index:i64=1;
    while(index<vec_len<MirFunctionRecord>(records)){
        let argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        if(function_mir_kind(argument)==function_mir_kind_call_argument()){
            if(function_mir_id(argument)==function_mir_id(instruction)){
                let ordinal:i64=function_mir_ordinal(argument);
                if(ordinal<0){return 68;}
                if(ordinal>=expected_count){return 68;}
                var required_mode:i32=function_mir_mode_value();
                if(ordinal==0){
                    required_mode=function_mir_mode_borrowed();
                    if(operation==canonical_c_vector_set_operation()){required_mode=function_mir_mode_mutable_borrow();}
                    if(operation==canonical_c_vector_replace_operation()){required_mode=function_mir_mode_mutable_borrow();}
                    if(operation==canonical_c_vector_pop_operation()){required_mode=function_mir_mode_mutable_borrow();}
                }
                if(function_mir_symbol_code(argument)!=required_mode){return 68;}
                if(ordinal==0){receiver_local=function_mir_left(argument);}
                if(ordinal==1){
                    if(operation==canonical_c_vector_pop_operation()){return 68;}
                    if(operation==canonical_c_vector_allocator_operation()){return 68;}
                    index_local=function_mir_left(argument);
                }
                if(ordinal==2){element_local=function_mir_left(argument);}
                argument_count=checked_add(argument_count,1);
            }
        }
        index=checked_add(index,1);
    }
    if(argument_count!=expected_count){return 70;}
    let vector_type:i32=canonical_c_scalar_local_type(records,receiver_local);
    if(vector_type<function_mir_vector_type_code(0)){return 96;}
    let allocator:Allocator=system_allocator();
    var vector_name:Buffer=buffer_new(allocator,64);
    if(canonical_c_append_vector_type_name(vector_type,descriptors,vector_name)!=0){return 96;}
    var element_type:i32=function_mir_unresolved_type_code();
    index=0;
    while(index<vec_len<MirTypeDescriptor>(descriptors)){
        let descriptor:MirTypeDescriptor=vec_get<MirTypeDescriptor>(descriptors,index);
        if(function_mir_type_descriptor_code(descriptor)==vector_type){
            element_type=function_mir_type_descriptor_child(descriptor);
        }
        index=checked_add(index,1);
    }
    if(function_mir_type_uses_ownership_transfer(element_type)!=0){return 96;}
    if(operation==canonical_c_vector_get_operation()){
        if(canonical_c_scalar_local_type(records,index_local)!=function_mir_i64_type_code()){return 96;}
    }
    if(operation==canonical_c_vector_set_operation()){
        if(canonical_c_scalar_local_type(records,index_local)!=function_mir_i64_type_code()){return 96;}
        if(canonical_c_scalar_local_type(records,element_local)!=element_type){return 96;}
    }
    if(operation==canonical_c_vector_replace_operation()){
        if(canonical_c_scalar_local_type(records,index_local)!=function_mir_i64_type_code()){return 96;}
        if(canonical_c_scalar_local_type(records,element_local)!=element_type){return 96;}
    }
    let result_local:i64=function_mir_result(instruction);
    var expected_result:i32=element_type;
    if(operation==canonical_c_vector_allocator_operation()){
        expected_result=function_mir_allocator_type_code();
    }
    if(operation==canonical_c_vector_set_operation()){
        expected_result=function_mir_unit_type_code();
    }
    if(operation==canonical_c_vector_replace_operation()){
        expected_result=function_mir_unit_type_code();
    }
    if(function_mir_type_code(instruction)!=expected_result){return 66;}
    if(expected_result==function_mir_unit_type_code()){
        if(result_local!=-1){return 66;}
    }else{
        if(result_local<0){return 66;}
        if(canonical_c_scalar_local_type(records,result_local)!=expected_result){return 95;}
    }
    canonical_mir_append_text(output,"    ");
    if(expected_result!=function_mir_unit_type_code()){
        canonical_mir_append_text(output,"m");canonical_mir_append_i64(output,result_local);
        canonical_mir_append_text(output," = ");
    }
    let prefix_length:i64=string_len("merit_Vec_");
    var suffix:Buffer=buffer_new(allocator,64);
    bootstrap_buffer_append(suffix,vector_name,prefix_length,checked_sub(buffer_len(vector_name),prefix_length));
    if(operation==canonical_c_vector_get_operation()){
        canonical_c_append_vector_symbol(output,"get",suffix);
    }
    if(operation==canonical_c_vector_set_operation()){
        canonical_c_append_vector_symbol(output,"set",suffix);
    }
    if(operation==canonical_c_vector_replace_operation()){
        canonical_c_append_vector_symbol(output,"replace",suffix);
    }
    if(operation==canonical_c_vector_pop_operation()){
        canonical_c_append_vector_symbol(output,"pop",suffix);
    }
    if(operation==canonical_c_vector_allocator_operation()){
        canonical_c_append_vector_symbol(output,"allocator",suffix);
    }
    canonical_mir_append_text(output,"(&m");canonical_mir_append_i64(output,receiver_local);
    if(expected_count>1){
        canonical_mir_append_text(output,", m");canonical_mir_append_i64(output,index_local);
    }
    if(expected_count>2){
        canonical_mir_append_text(output,", m");canonical_mir_append_i64(output,element_local);
    }
    canonical_mir_append_text(output,");\n");
    drop(suffix);
    drop(vector_name);
    return 0;
}

// One deterministic backend core consumes validated function records, explicit
// resource effects, and CFG placement. Unsupported shapes fail closed.
fn canonical_c_append_function_core_ordered(
    borrow source:Buffer,
    borrow records:Vec<MirFunctionRecord>,
    borrow callable_headers:Vec<MirFunctionRecord>,
    borrow type_descriptors:Vec<MirTypeDescriptor>,
    borrow sources:Vec<MirFunctionInstructionSource>,
    borrow ownership_records:Vec<MirOwnershipRecord>,
    borrow cfg:Vec<MirCfgRecord>,
    borrow placements:Vec<MirPlacementRecord>,
    borrow_mut prototypes:Buffer,
    borrow_mut bodies:Buffer,
    borrow_mut public_header:Buffer,
    borrow_mut features:Vec<i64>,
    emit_public_header:i32
)->i32
requires_caps [allocate]
{
    if(vec_len<MirFunctionRecord>(records)<2){return 1;}
    let header:MirFunctionRecord=vec_get<MirFunctionRecord>(records,0);
    if(function_mir_kind(header)!=function_mir_kind_function()){return 2;}
    let unit_return:i32=function_mir_type_code(header)==function_mir_unit_type_code();
    var exported:i32=function_mir_mutable(header);
    if(emit_public_header==0){exported=0;}
    if(function_mir_type_code(header)==function_mir_string_type_code()){
        canonical_c_require_feature(canonical_c_text_feature(),features);
        if(exported!=0){canonical_c_require_feature(canonical_c_public_string_feature(),features);}
    }
    if(function_mir_type_code(header)==function_mir_allocator_type_code()){
        if(exported!=0){return 3;}
        canonical_c_require_feature(canonical_c_buffer_runtime_feature(),features);
    }
    if(function_mir_type_code(header)==function_mir_byte_slice_type_code()){
        if(exported!=0){return 3;}
        canonical_c_require_feature(canonical_c_slice_feature(),features);
    }
    if(function_mir_type_code(header)==function_mir_buffer_type_code()){
        if(exported!=0){return 3;}
        if(vec_len<MirOwnershipRecord>(ownership_records)==0){return 3;}
        canonical_c_require_feature(canonical_c_buffer_runtime_feature(),features);
    }
    if(function_mir_type_code(header)>=function_mir_vector_type_code(0)){
        if(exported!=0){return 3;}
        if(vec_len<MirOwnershipRecord>(ownership_records)==0){return 3;}
        canonical_c_require_feature(canonical_c_buffer_runtime_feature(),features);
    }
    if(function_mir_type_code(header)!=function_mir_i64_type_code()){
        if(function_mir_type_code(header)!=function_mir_i32_type_code()){
            if(function_mir_type_code(header)!=function_mir_bool_type_code()){
                if(function_mir_type_code(header)!=function_mir_unit_type_code()){
                    if(function_mir_type_code(header)!=function_mir_string_type_code()){
                        if(function_mir_type_code(header)!=function_mir_allocator_type_code()){
                            if(function_mir_type_code(header)!=function_mir_u8_type_code()){
                                if(function_mir_type_code(header)!=function_mir_byte_slice_type_code()){
                                    if(function_mir_type_code(header)!=function_mir_buffer_type_code()){
                                        if(function_mir_type_code(header)<function_mir_vector_type_code(0)){return 3;}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    let cfg_record_count:i64=vec_len<MirCfgRecord>(cfg);
    if(cfg_record_count<2){return 4;}
    var cfg_block_count:i64=0;
    var cfg_index:i64=0;
    while(cfg_index<cfg_record_count){
        let block:MirCfgRecord=vec_get<MirCfgRecord>(cfg,cfg_index);
        if(cfg_kind(block)!=cfg_block_kind()){cfg_index=cfg_record_count;}
        else{
        if(cfg_block_id(block)!=cfg_block_count){return 6;}
        if(cfg_ordinal(block)!=cfg_block_count){return 6;}
        cfg_block_count=checked_add(cfg_block_count,1);
        cfg_index=checked_add(cfg_index,1);
        }
    }
    if(cfg_block_count==0){return 5;}
    cfg_index=cfg_block_count;
    var terminator_block_id:i64=0;
    while(terminator_block_id<cfg_block_count){
        if(cfg_index>=cfg_record_count){return 4;}
        let terminator:MirCfgRecord=vec_get<MirCfgRecord>(cfg,cfg_index);
        if(cfg_block_id(terminator)!=terminator_block_id){return 8;}
        let term_kind:i32=cfg_kind(terminator);
        if(term_kind==cfg_return_kind()){
            if(function_mir_type_code(header)==function_mir_unit_type_code()){
                if(cfg_operand(terminator)!=-1){return 17;}
            }else{if(cfg_operand(terminator)<0){return 17;}}
        }else{if(term_kind!=cfg_jump_kind()){
            if(term_kind!=cfg_branch_kind()){
                if(term_kind!=cfg_switch_case_kind()){
                    if(term_kind!=cfg_switch_default_kind()){
                        if(term_kind!=cfg_unreachable_kind()){return 7;}
                    }
                }
            }
        }}
        if(term_kind==cfg_switch_case_kind()){
            var switch_ordinal:i64=0;
            var default_found:i32=0;
            let switch_operand:i64=cfg_operand(terminator);
            let switch_start:i64=cfg_index;
            while(default_found==0){
                if(cfg_index>=cfg_record_count){return 92;}
