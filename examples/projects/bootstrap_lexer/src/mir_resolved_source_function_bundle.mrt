                            var builtin_argument_count:i64=0;var builtin_argument_index:i64=1;
                            while(builtin_argument_index<vec_len<MirFunctionRecord>(records)){
                                let builtin_argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,builtin_argument_index);
                                if(function_mir_kind(builtin_argument)==function_mir_kind_call_argument()){
                                    if(function_mir_id(builtin_argument)==function_mir_id(instruction)){
                                        builtin_argument_count=checked_add(builtin_argument_count,1);
                                    }
                                }
                                builtin_argument_index=checked_add(builtin_argument_index,1);
                            }
                            if(builtin_argument_count!=builtin_operand_ordinal){return 70;}
                            if(buffer_push_builtin!=0){canonical_mir_append_text(bodies,"    ");}
                            else{if(bootstrap_append_builtin!=0){canonical_mir_append_text(bodies,"    ");}
                            else{
                                canonical_mir_append_text(bodies,"    m");
                                canonical_mir_append_i64(bodies,function_mir_result(instruction));
                                canonical_mir_append_text(bodies," = ");
                            }}
                            if(system_builtin!=0){canonical_mir_append_text(bodies,"merit_system_allocator");}
                            if(portable_builtin!=0){canonical_mir_append_text(bodies,"merit_portable_allocator");}
                            if(builtin_operand_count>0){
                                if(compatible_builtin!=0){canonical_mir_append_text(bodies,"merit_allocator_compatible(");}
                                if(string_len_builtin!=0){canonical_mir_append_text(bodies,"merit_string_len(");}
                                if(string_byte_builtin!=0){canonical_mir_append_text(bodies,"merit_string_byte(");}
                                if(slice_len_builtin!=0){canonical_mir_append_text(bodies,"merit_slice_len(");}
                                if(slice_get_builtin!=0){canonical_mir_append_text(bodies,"merit_slice_get(");}
                                if(buffer_new_builtin!=0){canonical_mir_append_text(bodies,"merit_buffer_new(");}
                                if(buffer_from_string_builtin!=0){canonical_mir_append_text(bodies,"merit_buffer_from_string(");}
                                if(buffer_len_builtin!=0){canonical_mir_append_text(bodies,"merit_buffer_len(");}
                                if(buffer_get_builtin!=0){canonical_mir_append_text(bodies,"merit_buffer_get(");}
                                if(buffer_allocator_builtin!=0){canonical_mir_append_text(bodies,"merit_buffer_allocator(");}
                                if(buffer_push_builtin!=0){canonical_mir_append_text(bodies,"merit_buffer_push(");}
                                if(bootstrap_append_builtin!=0){canonical_mir_append_text(bodies,"merit_bootstrap_buffer_append(");}
                                if(buffer_slice_builtin!=0){canonical_mir_append_text(bodies,"merit_buffer_slice(");}
                                var compatible_ordinal:i64=0;
                                while(compatible_ordinal<builtin_operand_count){
                                    var compatible_index:i64=1;var compatible_found:i32=0;
                                    while(compatible_index<vec_len<MirFunctionRecord>(records)){
                                        let compatible_argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,compatible_index);
                                        if(function_mir_kind(compatible_argument)==function_mir_kind_call_argument()){
                                            if(function_mir_id(compatible_argument)==function_mir_id(instruction)){
                                                if(function_mir_ordinal(compatible_argument)==compatible_ordinal){
                                                    if(compatible_ordinal>0){canonical_mir_append_text(bodies,", ");}
                                                    if(compatible_ordinal==0){
                                                        let access_mode:i32=canonical_c_local_access_mode(records,function_mir_left(compatible_argument));
                                                        if(string_len_builtin!=0){
                                                            if(access_mode==function_mir_mode_borrowed()){canonical_mir_append_text(bodies,"*");}
                                                        }
                                                        if(string_byte_builtin!=0){
                                                            if(access_mode==function_mir_mode_borrowed()){canonical_mir_append_text(bodies,"*");}
                                                        }
                                                        if(access_mode==function_mir_mode_value()){
                                                            if(buffer_len_builtin!=0){canonical_mir_append_text(bodies,"&");}
                                                            if(buffer_get_builtin!=0){canonical_mir_append_text(bodies,"&");}
                                                            if(buffer_allocator_builtin!=0){canonical_mir_append_text(bodies,"&");}
                                                            if(buffer_push_builtin!=0){canonical_mir_append_text(bodies,"&");}
                                                            if(bootstrap_append_builtin!=0){canonical_mir_append_text(bodies,"&");}
                                                            if(buffer_slice_builtin!=0){canonical_mir_append_text(bodies,"&");}
                                                        }
                                                    }
                                                    if(compatible_ordinal==1){
                                                        if(bootstrap_append_builtin!=0){
                                                            if(canonical_c_local_access_mode(records,function_mir_left(compatible_argument))==function_mir_mode_value()){
                                                                canonical_mir_append_text(bodies,"&");
                                                            }
                                                        }
                                                    }
                                                    canonical_mir_append_text(bodies,"m");
                                                    canonical_mir_append_i64(bodies,function_mir_left(compatible_argument));
                                                    compatible_found=1;
                                                }
                                            }
                                        }
                                        compatible_index=checked_add(compatible_index,1);
                                    }
                                    if(compatible_found==0){return 69;}
                                    compatible_ordinal=checked_add(compatible_ordinal,1);
                                }
                                canonical_mir_append_text(bodies,");\n");
                            }else{canonical_mir_append_text(bodies,"();\n");}
                            }
                            }}}
                        }else{
                        if(function_mir_type_code(callee_header)!=function_mir_type_code(instruction)){return 66;}
                        if(function_mir_type_code(instruction)!=function_mir_unit_type_code()){
                            if(canonical_c_scalar_local_type(records,function_mir_result(instruction))!=function_mir_type_code(instruction)){return 95;}
                        }
                        var callee_parameter_ordinal:i64=0;
                        while(callee_parameter_ordinal<function_mir_ordinal(callee_header)){
                            let catalog_index:i64=checked_add(checked_add(callee_index,1),callee_parameter_ordinal);
                            if(catalog_index>=vec_len<MirFunctionRecord>(callable_headers)){return 75;}
                            let parameter:MirFunctionRecord=vec_get<MirFunctionRecord>(callable_headers,catalog_index);
                            if(function_mir_kind(parameter)!=function_mir_kind_parameter()){return 71;}
                            if(function_mir_ordinal(parameter)!=callee_parameter_ordinal){return 72;}
                            if(function_mir_type_code(parameter)!=function_mir_i64_type_code()){
                                if(function_mir_type_code(parameter)!=function_mir_i32_type_code()){
                                    if(function_mir_type_code(parameter)!=function_mir_bool_type_code()){
                                        if(function_mir_type_code(parameter)!=function_mir_string_type_code()){
                                            if(function_mir_type_code(parameter)!=function_mir_buffer_type_code()){
                                                if(function_mir_type_code(parameter)!=function_mir_byte_slice_type_code()){return 73;}
                                            }
                                        }
                                    }
                                }
                            }
                            if(function_mir_symbol_code(parameter)!=function_mir_mode_value()){
                                if(function_mir_symbol_code(parameter)!=function_mir_mode_borrowed()){return 74;}
                                if(function_mir_type_code(parameter)!=function_mir_string_type_code()){
                                    if(function_mir_type_code(parameter)!=function_mir_buffer_type_code()){return 74;}
                                }
                            }
                            if(function_mir_type_code(parameter)==function_mir_buffer_type_code()){
                                if(function_mir_symbol_code(parameter)!=function_mir_mode_borrowed()){return 74;}
                            }
                            callee_parameter_ordinal=checked_add(callee_parameter_ordinal,1);
                        }
                        canonical_mir_append_text(bodies,"    ");
                        if(function_mir_type_code(instruction)!=function_mir_unit_type_code()){
                            canonical_mir_append_text(bodies,"m");canonical_mir_append_i64(bodies,function_mir_result(instruction));
                            canonical_mir_append_text(bodies," = ");
                        }
                        canonical_c_append_function_name(source,callee_header,bodies);
                        buffer_push(bodies,40);
                        var argument_ordinal:i64=0;
                        while(argument_ordinal<function_mir_ordinal(callee_header)){
                            var argument_found:i32=0;var argument_index:i64=1;
                            while(argument_index<vec_len<MirFunctionRecord>(records)){
                                let argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,argument_index);
                                if(function_mir_kind(argument)==function_mir_kind_call_argument()){
                                    if(function_mir_id(argument)==function_mir_id(instruction)){
                                        if(function_mir_ordinal(argument)==argument_ordinal){
                                            if(argument_found!=0){return 67;}
                                            let catalog_index:i64=checked_add(
                                                checked_add(callee_index,1),argument_ordinal
                                            );
                                            let parameter:MirFunctionRecord=vec_get<MirFunctionRecord>(callable_headers,catalog_index);
                                            if(function_mir_symbol_code(argument)!=function_mir_symbol_code(parameter)){return 68;}
                                            if(canonical_c_scalar_local_type(records,function_mir_left(argument))!=function_mir_type_code(parameter)){return 96;}
                                            let access_mode:i32=canonical_c_local_access_mode(records,function_mir_left(argument));
                                            if(function_mir_symbol_code(parameter)==function_mir_mode_value()){
                                                if(access_mode!=function_mir_mode_value()){return 68;}
                                            }
                                            if(argument_ordinal>0){canonical_mir_append_text(bodies,", ");}
                                            if(function_mir_symbol_code(parameter)==function_mir_mode_borrowed()){
                                                if(access_mode==function_mir_mode_value()){
                                                    canonical_mir_append_text(bodies,"&");
                                                }else{
                                                    if(access_mode!=function_mir_mode_borrowed()){return 68;}
                                                }
                                            }
                                            canonical_mir_append_text(bodies,"m");canonical_mir_append_i64(bodies,function_mir_left(argument));
                                            argument_found=1;
                                        }
                                    }
                                }
                                argument_index=checked_add(argument_index,1);
                            }
                            if(argument_found==0){return 69;}
                            argument_ordinal=checked_add(argument_ordinal,1);
                        }
                        var argument_count:i64=0;var remaining_index:i64=1;
                        while(remaining_index<vec_len<MirFunctionRecord>(records)){
                            let argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,remaining_index);
                            if(function_mir_kind(argument)==function_mir_kind_call_argument()){
                                if(function_mir_id(argument)==function_mir_id(instruction)){
                                    argument_count=checked_add(argument_count,1);
                                }
                            }
                            remaining_index=checked_add(remaining_index,1);
                        }
                        if(argument_count!=function_mir_ordinal(callee_header)){return 70;}
                        canonical_mir_append_text(bodies,");\n");
                        }
                    }
                }
            }
            record_index=checked_add(record_index,1);
        }
        if(instruction_found==0){return 21;}
        active_ordinal=checked_add(active_ordinal,1);
        emitted_placements=checked_add(emitted_placements,1);
    }
        let terminator:MirCfgRecord=vec_get<MirCfgRecord>(cfg,cfg_emit_index);
        if(cfg_kind(terminator)==cfg_return_kind()){
            if(unit_return!=0){
                canonical_mir_append_text(bodies,"    return;\n");
            }else{
                canonical_mir_append_text(bodies,"    return m");
                canonical_mir_append_i64(bodies,cfg_operand(terminator));
                canonical_mir_append_text(bodies,";\n");
            }
        }
        if(cfg_kind(terminator)==cfg_jump_kind()){
            canonical_mir_append_text(bodies,"    goto b");
            canonical_mir_append_i64(bodies,cfg_target_a(terminator));
            canonical_mir_append_text(bodies,";\n");
        }
        if(cfg_kind(terminator)==cfg_branch_kind()){
            canonical_mir_append_text(bodies,"    if (m");
            canonical_mir_append_i64(bodies,cfg_operand(terminator));
            canonical_mir_append_text(bodies,") goto b");
            canonical_mir_append_i64(bodies,cfg_target_a(terminator));
            canonical_mir_append_text(bodies,";\n    goto b");
            canonical_mir_append_i64(bodies,cfg_target_b(terminator));
            canonical_mir_append_text(bodies,";\n");
        }
        if(cfg_kind(terminator)==cfg_unreachable_kind()){
            canonical_mir_append_text(bodies,"    abort();\n");
        }
        var is_switch:i32=0;
        if(cfg_kind(terminator)==cfg_switch_case_kind()){is_switch=1;}
        if(cfg_kind(terminator)==cfg_switch_default_kind()){is_switch=1;}
        if(is_switch!=0){
            canonical_mir_append_text(bodies,"    switch (m");
            canonical_mir_append_i64(bodies,cfg_operand(terminator));
            canonical_mir_append_text(bodies,") {\n");
            var switch_index:i64=cfg_emit_index;
            var default_emitted:i32=0;
            while(default_emitted==0){
                let item:MirCfgRecord=vec_get<MirCfgRecord>(cfg,switch_index);
                if(cfg_kind(item)==cfg_switch_case_kind()){
                    canonical_mir_append_text(bodies,"    case ");
                    canonical_mir_append_i64(bodies,cfg_case_value(item));
                    canonical_mir_append_text(bodies,": goto b");
                }else{
                    canonical_mir_append_text(bodies,"    default: goto b");
                    default_emitted=1;
                }
                canonical_mir_append_i64(bodies,cfg_target_a(item));
                canonical_mir_append_text(bodies,";\n");
                switch_index=checked_add(switch_index,1);
            }
            canonical_mir_append_text(bodies,"    }\n");
            cfg_emit_index=switch_index;
        }else{cfg_emit_index=checked_add(cfg_emit_index,1);}
        active_block_id=checked_add(active_block_id,1);
    }
    if(emitted_placements!=vec_len<MirPlacementRecord>(placements)){return 87;}
    canonical_mir_append_text(bodies,"}");
    return 0;
}

fn canonical_c_append_function_core(
    borrow source:Buffer,
    borrow records:Vec<MirFunctionRecord>,
    borrow callable_headers:Vec<MirFunctionRecord>,
    borrow type_descriptors:Vec<MirTypeDescriptor>,
    borrow sources:Vec<MirFunctionInstructionSource>,
    borrow ownership_records:Vec<MirOwnershipRecord>,
    borrow cfg:Vec<MirCfgRecord>,
    borrow placements:Vec<MirPlacementRecord>,
    borrow_mut prototypes:Buffer,
    borrow_mut bodies:Buffer,
    borrow_mut public_header:Buffer,
    borrow_mut features:Vec<i64>,
    emit_public_header:i32
)->i32
requires_caps [allocate]
{
    // CFG source records may interleave blocks and terminators. Reconstruct
    // the established blocks-first, block-local terminator ordering once for
    // the C backend; never infer or synthesize a missing target or default.
    let allocator:Allocator=system_allocator();
    var ordered:Vec<MirCfgRecord>=vec_new<MirCfgRecord>(allocator,vec_len<MirCfgRecord>(cfg));
    var block_count:i64=0;
    var searching:i32=1;
    while(searching!=0){
        var found:i32=0;
        var index:i64=0;
        while(index<vec_len<MirCfgRecord>(cfg)){
            let record:MirCfgRecord=vec_get<MirCfgRecord>(cfg,index);
            if(cfg_kind(record)==cfg_block_kind()){
                if(cfg_block_id(record)==block_count){
                    if(found!=0){return 6;}
                    vec_push<MirCfgRecord>(ordered,record);found=1;
                }
            }
            index=checked_add(index,1);
        }
        if(found==0){searching=0;}
        else{block_count=checked_add(block_count,1);}
    }
    if(block_count==0){return 5;}
    var block_id:i64=0;
    while(block_id<block_count){
        var switch_rows:i64=0;
        var direct_rows:i64=0;
        var index:i64=0;
        while(index<vec_len<MirCfgRecord>(cfg)){
            let record:MirCfgRecord=vec_get<MirCfgRecord>(cfg,index);
            if(cfg_block_id(record)==block_id){
                if(cfg_kind(record)==cfg_switch_case_kind()){switch_rows=checked_add(switch_rows,1);}
                else{if(cfg_kind(record)==cfg_switch_default_kind()){switch_rows=checked_add(switch_rows,1);}
                else{if(cfg_kind(record)!=cfg_block_kind()){direct_rows=checked_add(direct_rows,1);}}}
            }
            index=checked_add(index,1);
        }
        if(switch_rows>0){
            if(direct_rows>0){return 92;}
            var ordinal:i64=0;
            while(ordinal<switch_rows){
                var found:i32=0;
                index=0;
                while(index<vec_len<MirCfgRecord>(cfg)){
                    let record:MirCfgRecord=vec_get<MirCfgRecord>(cfg,index);
                    let kind:i32=cfg_kind(record);
                    if(cfg_block_id(record)==block_id){
                        if(kind==cfg_switch_case_kind()){
                            if(cfg_ordinal(record)==ordinal){
                                if(found!=0){return 91;}
                                vec_push<MirCfgRecord>(ordered,record);found=1;
                            }
                        }else{if(kind==cfg_switch_default_kind()){
                            if(cfg_ordinal(record)==ordinal){
                                if(found!=0){return 91;}
                                vec_push<MirCfgRecord>(ordered,record);found=1;
                            }
                        }}
                    }
                    index=checked_add(index,1);
                }
                if(found==0){return 91;}
                ordinal=checked_add(ordinal,1);
            }
        }else{
            index=0;
            while(index<vec_len<MirCfgRecord>(cfg)){
                let record:MirCfgRecord=vec_get<MirCfgRecord>(cfg,index);
                if(cfg_block_id(record)==block_id){
                    if(cfg_kind(record)!=cfg_block_kind()){vec_push<MirCfgRecord>(ordered,record);}
                }
                index=checked_add(index,1);
            }
        }
        block_id=checked_add(block_id,1);
    }
    if(vec_len<MirCfgRecord>(ordered)!=vec_len<MirCfgRecord>(cfg)){return 7;}
    let status:i32=canonical_c_append_function_core_ordered(
        source,records,callable_headers,type_descriptors,sources,ownership_records,ordered,placements,
        prototypes,bodies,public_header,features,emit_public_header
    );
    drop(ordered);
    return status;
}

pub fn canonical_c_append_scalar_function_with_catalog(
    borrow source:Buffer,borrow records:Vec<MirFunctionRecord>,
    borrow callable_headers:Vec<MirFunctionRecord>,borrow cfg:Vec<MirCfgRecord>,
    borrow placements:Vec<MirPlacementRecord>,borrow_mut prototypes:Buffer,
    borrow_mut bodies:Buffer,borrow_mut public_header:Buffer,borrow_mut features:Vec<i64>
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    let empty_sources:Vec<MirFunctionInstructionSource>=vec_new<MirFunctionInstructionSource>(allocator,0);
    let empty_effects:Vec<MirOwnershipRecord>=vec_new<MirOwnershipRecord>(allocator,0);
    let empty_types:Vec<MirTypeDescriptor>=vec_new<MirTypeDescriptor>(allocator,0);
    let status:i32=canonical_c_append_function_core(
        source,records,callable_headers,empty_types,empty_sources,empty_effects,cfg,placements,
        prototypes,bodies,public_header,features,1
    );
    drop(empty_types);drop(empty_effects);drop(empty_sources);return status;
}

pub fn canonical_c_append_resource_function_with_type_catalog(
    borrow source:Buffer,borrow records:Vec<MirFunctionRecord>,
    borrow callable_headers:Vec<MirFunctionRecord>,
    borrow type_descriptors:Vec<MirTypeDescriptor>,
    borrow sources:Vec<MirFunctionInstructionSource>,
    borrow ownership_records:Vec<MirOwnershipRecord>,
    borrow cfg:Vec<MirCfgRecord>,borrow placements:Vec<MirPlacementRecord>,
    borrow_mut prototypes:Buffer,borrow_mut bodies:Buffer,
    borrow_mut public_header:Buffer,borrow_mut features:Vec<i64>
)->i32
requires_caps [allocate]
{
    if(vec_len<MirFunctionInstructionSource>(sources)==0){return canonical_c_resource_missing_catalog_status();}
    if(vec_len<MirOwnershipRecord>(ownership_records)==0){return canonical_c_resource_missing_effect_status();}
    return canonical_c_append_function_core(
        source,records,callable_headers,type_descriptors,sources,ownership_records,cfg,placements,
        prototypes,bodies,public_header,features,1
    );
}

// Production assembly passes the complete canonical catalogs for every
// function. The core decides which effects are required and fails closed when
// an owned resource lacks its represented lifecycle.
pub fn canonical_c_append_function_with_catalog(
    borrow source:Buffer,borrow records:Vec<MirFunctionRecord>,
    borrow callable_headers:Vec<MirFunctionRecord>,
    borrow type_descriptors:Vec<MirTypeDescriptor>,
    borrow sources:Vec<MirFunctionInstructionSource>,
    borrow ownership_records:Vec<MirOwnershipRecord>,
    borrow cfg:Vec<MirCfgRecord>,borrow placements:Vec<MirPlacementRecord>,
    borrow_mut prototypes:Buffer,borrow_mut bodies:Buffer,
    borrow_mut public_header:Buffer,borrow_mut features:Vec<i64>
)->i32
requires_caps [allocate]
{
    return canonical_c_append_function_with_catalog_header_selection(
        source,records,callable_headers,type_descriptors,sources,ownership_records,cfg,placements,
        prototypes,bodies,public_header,features,1
    );
}

// Public source visibility remains encoded in the function record. The header
// selection is a separate build-artifact decision and does not change MIR or C
// symbol identity.
pub fn canonical_c_append_function_with_catalog_header_selection(
    borrow source:Buffer,borrow records:Vec<MirFunctionRecord>,
    borrow callable_headers:Vec<MirFunctionRecord>,
    borrow type_descriptors:Vec<MirTypeDescriptor>,
    borrow sources:Vec<MirFunctionInstructionSource>,
    borrow ownership_records:Vec<MirOwnershipRecord>,
    borrow cfg:Vec<MirCfgRecord>,borrow placements:Vec<MirPlacementRecord>,
    borrow_mut prototypes:Buffer,borrow_mut bodies:Buffer,
    borrow_mut public_header:Buffer,borrow_mut features:Vec<i64>,
    emit_public_header:i32
)->i32
requires_caps [allocate]
{
    if(vec_len<MirOwnershipRecord>(ownership_records)==0){
        var source_index:i64=0;
        while(source_index<vec_len<MirFunctionInstructionSource>(sources)){
            let source_record:MirFunctionInstructionSource=vec_get<MirFunctionInstructionSource>(sources,source_index);
            if(assembly_source_kind(source_record)==assembly_source_ownership_kind()){
                return canonical_c_resource_missing_effect_status();
            }
            source_index=checked_add(source_index,1);
        }
    }
    return canonical_c_append_function_core(
        source,records,callable_headers,type_descriptors,sources,ownership_records,cfg,placements,
        prototypes,bodies,public_header,features,emit_public_header
    );
}

pub fn canonical_c_append_resource_function_with_catalog(
    borrow source:Buffer,borrow records:Vec<MirFunctionRecord>,
    borrow callable_headers:Vec<MirFunctionRecord>,
    borrow sources:Vec<MirFunctionInstructionSource>,
    borrow ownership_records:Vec<MirOwnershipRecord>,
    borrow cfg:Vec<MirCfgRecord>,borrow placements:Vec<MirPlacementRecord>,
    borrow_mut prototypes:Buffer,borrow_mut bodies:Buffer,
    borrow_mut public_header:Buffer,borrow_mut features:Vec<i64>
)->i32
requires_caps [allocate]
{
    let empty_types:Vec<MirTypeDescriptor>=vec_new<MirTypeDescriptor>(system_allocator(),0);
    let status:i32=canonical_c_append_resource_function_with_type_catalog(
        source,records,callable_headers,empty_types,sources,ownership_records,cfg,placements,
        prototypes,bodies,public_header,features
    );
    drop(empty_types);return status;
}

pub fn canonical_c_append_scalar_function(
    borrow source:Buffer,borrow records:Vec<MirFunctionRecord>,
    borrow cfg:Vec<MirCfgRecord>,borrow placements:Vec<MirPlacementRecord>,
    borrow_mut prototypes:Buffer,borrow_mut bodies:Buffer,
    borrow_mut public_header:Buffer,borrow_mut features:Vec<i64>
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    let empty_headers:Vec<MirFunctionRecord>=vec_new<MirFunctionRecord>(allocator,0);
    let status:i32=canonical_c_append_scalar_function_with_catalog(
        source,records,empty_headers,cfg,placements,prototypes,bodies,public_header,features
    );
    drop(empty_headers);return status;
}

fn canonical_c_append_buffer_runtime(borrow_mut output:Buffer)->i32
requires_caps [allocate]
{
    canonical_mir_append_text(output,"typedef struct { int32_t identity; } merit_Allocator;\n");
    canonical_mir_append_text(output,"typedef struct { uint8_t *data; size_t len; size_t capacity; merit_Allocator allocator; } merit_Buffer;\n");
    canonical_mir_append_text(output,"static inline merit_Allocator merit_system_allocator(void) { return (merit_Allocator){0}; }\n");
    canonical_mir_append_text(output,"static inline merit_Allocator merit_portable_allocator(void) { return (merit_Allocator){1}; }\n");
    canonical_mir_append_text(output,"static inline int32_t merit_allocator_compatible(merit_Allocator left, merit_Allocator right) { return left.identity == right.identity; }\n");
    canonical_mir_append_text(output,"static inline void merit_buffer_reserve(merit_Buffer *value, size_t needed) {\n");
    canonical_mir_append_text(output,"    if (needed <= value->capacity) return;\n");
    canonical_mir_append_text(output,"    size_t capacity = value->capacity ? value->capacity : 8;\n");
    canonical_mir_append_text(output,"    while (capacity < needed) capacity *= 2;\n");
    canonical_mir_append_text(output,"    void *data = realloc(value->data, capacity);\n");
    canonical_mir_append_text(output,"    if (!data) { fprintf(stderr, \"Merit allocation failed\\n\"); exit(80); }\n");
    canonical_mir_append_text(output,"    value->data = (uint8_t *)data; value->capacity = capacity;\n");
    canonical_mir_append_text(output,"}\n");
    canonical_mir_append_text(output,"static inline merit_Buffer merit_buffer_new(merit_Allocator allocator, int64_t capacity) {\n");
    canonical_mir_append_text(output,"    if (capacity < 0) { fprintf(stderr, \"Merit negative capacity\\n\"); exit(81); }\n");
    canonical_mir_append_text(output,"    merit_Buffer result = {0}; result.allocator = allocator; merit_buffer_reserve(&result, (size_t)capacity);\n");
    canonical_mir_append_text(output,"    return result;\n");
    canonical_mir_append_text(output,"}\n");
    canonical_mir_append_text(output,"static inline merit_Buffer merit_buffer_from_string(merit_Allocator allocator, merit_String value) {\n");
    canonical_mir_append_text(output,"    merit_Buffer result = merit_buffer_new(allocator, (int64_t)value.len);\n");
    canonical_mir_append_text(output,"    if (value.len) { memcpy(result.data, value.data, value.len); result.len = value.len; } return result;\n");
    canonical_mir_append_text(output,"}\n");
    canonical_mir_append_text(output,"static inline void merit_buffer_push(merit_Buffer *value, uint8_t byte) { merit_buffer_reserve(value, value->len + 1); value->data[value->len++] = byte; }\n");
    canonical_mir_append_text(output,"static inline void merit_bootstrap_buffer_append(merit_Buffer *destination, const merit_Buffer *source, int64_t start, int64_t length) {\n");
    canonical_mir_append_text(output,"    if (start < 0 || length < 0 || (size_t)start > source->len || (size_t)length > source->len - (size_t)start) { fprintf(stderr, \"Merit bootstrap buffer append range out of bounds\\n\"); exit(88); }\n");
    canonical_mir_append_text(output,"    size_t offset = (size_t)start; size_t count = (size_t)length; merit_buffer_reserve(destination, destination->len + count);\n");
    canonical_mir_append_text(output,"    if (count) { memcpy(destination->data + destination->len, source->data + offset, count); destination->len += count; }\n");
    canonical_mir_append_text(output,"}\n");
    canonical_mir_append_text(output,"static inline int64_t merit_buffer_len(const merit_Buffer *value) { return (int64_t)value->len; }\n");
    canonical_mir_append_text(output,"static inline int64_t merit_buffer_get(const merit_Buffer *value, int64_t index) {\n");
    canonical_mir_append_text(output,"    if (index < 0 || (size_t)index >= value->len) { fprintf(stderr, \"Merit buffer index out of bounds\\n\"); exit(82); }\n");
    canonical_mir_append_text(output,"    return (int64_t)value->data[index];\n");
    canonical_mir_append_text(output,"}\n");
    canonical_mir_append_text(output,"static inline merit_ByteSlice merit_buffer_slice(const merit_Buffer *value, int64_t start, int64_t length) {\n");
    canonical_mir_append_text(output,"    if (start < 0 || length < 0 || (size_t)start > value->len || (size_t)length > value->len - (size_t)start) { fprintf(stderr, \"Merit slice out of bounds\\n\"); exit(85); }\n");
    canonical_mir_append_text(output,"    return (merit_ByteSlice){value->data + (size_t)start, (size_t)length};\n");
    canonical_mir_append_text(output,"}\n");
    canonical_mir_append_text(output,"static inline merit_Allocator merit_buffer_allocator(const merit_Buffer *value) { return value->allocator; }\n");
    canonical_mir_append_text(output,"static inline int64_t merit_slice_len(merit_ByteSlice value) { return (int64_t)value.len; }\n");
    canonical_mir_append_text(output,"static inline int64_t merit_slice_get(merit_ByteSlice value, int64_t index) {\n");
    canonical_mir_append_text(output,"    if (index < 0 || (size_t)index >= value.len) { fprintf(stderr, \"Merit slice index out of bounds\\n\"); exit(85); }\n");
    canonical_mir_append_text(output,"    return (int64_t)value.data[index];\n");
    canonical_mir_append_text(output,"}\n");
    canonical_mir_append_text(output,"static inline void merit_buffer_drop(merit_Buffer *value) { free(value->data); value->data = NULL; value->len = 0; value->capacity = 0; }\n\n");
    return 0;
}

fn canonical_c_buffer_compare(borrow left:Buffer,borrow right:Buffer)->i32
requires_caps [allocate]
{
    var index:i64=0;
    while(index<buffer_len(left)){
        if(index>=buffer_len(right)){return 1;}
        let left_byte:i64=buffer_get(left,index);
        let right_byte:i64=buffer_get(right,index);
        if(left_byte<right_byte){return -1;}
        if(left_byte>right_byte){return 1;}
        index=checked_add(index,1);
    }
    if(index<buffer_len(right)){return -1;}
    return 0;
}

fn canonical_c_vector_code_selected(code:i32,borrow selected:Vec<i32>)->i32
requires_caps [allocate]
{
    var index:i64=0;
    while(index<vec_len<i32>(selected)){
        if(vec_get<i32>(selected,index)==code){return 1;}
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_c_finish_module_with_copy_vectors(
    borrow prototypes:Buffer,borrow bodies:Buffer,borrow features:Vec<i64>,
    borrow vector_type_codes:Vec<i32>,borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(buffer_len(prototypes)<=0){return 1;}
    if(buffer_len(bodies)<=0){return 2;}
    var needs_vector:i32=0;
    if(vec_len<i32>(vector_type_codes)>0){needs_vector=1;}
    let allocator:Allocator=system_allocator();
    var sorted_codes:Vec<i32>=vec_new<i32>(allocator,vec_len<i32>(vector_type_codes));
    var vector_typedefs:Buffer=buffer_new(allocator,1024);
    var vector_runtime:Buffer=buffer_new(allocator,4096);
    var selected_count:i64=0;
    while(selected_count<vec_len<i32>(vector_type_codes)){
        var best_code:i32=function_mir_unresolved_type_code();
        var candidate_index:i64=0;
        while(candidate_index<vec_len<i32>(vector_type_codes)){
            let candidate_code:i32=vec_get<i32>(vector_type_codes,candidate_index);
            if(candidate_code<function_mir_vector_type_code(0)){return 3;}
            if(canonical_c_vector_code_selected(candidate_code,sorted_codes)==0){
                var candidate_name:Buffer=buffer_new(allocator,64);
                let candidate_status:i32=canonical_c_append_vector_type_name(candidate_code,descriptors,candidate_name);
                if(candidate_status!=0){return candidate_status;}
                if(best_code==function_mir_unresolved_type_code()){
                    best_code=candidate_code;
                }else{
                    var best_name:Buffer=buffer_new(allocator,64);
                    let best_status:i32=canonical_c_append_vector_type_name(best_code,descriptors,best_name);
                    if(best_status!=0){return best_status;}
                    if(canonical_c_buffer_compare(candidate_name,best_name)<0){best_code=candidate_code;}
                    drop(best_name);
                }
                drop(candidate_name);
            }
            candidate_index=checked_add(candidate_index,1);
        }
        if(best_code==function_mir_unresolved_type_code()){return 6;}
        vec_push<i32>(sorted_codes,best_code);
        selected_count=checked_add(selected_count,1);
    }
    var sorted_index:i64=0;
    while(sorted_index<vec_len<i32>(sorted_codes)){
        let vector_type_code:i32=vec_get<i32>(sorted_codes,sorted_index);
        var vector_name:Buffer=buffer_new(allocator,64);
        let name_status:i32=canonical_c_append_vector_type_name(vector_type_code,descriptors,vector_name);
        if(name_status!=0){return name_status;}
        if(sorted_index>0){
            let prior_code:i32=vec_get<i32>(sorted_codes,checked_sub(sorted_index,1));
            var prior_name:Buffer=buffer_new(allocator,64);
            if(canonical_c_append_vector_type_name(prior_code,descriptors,prior_name)!=0){return 6;}
            if(canonical_c_buffer_compare(vector_name,prior_name)==0){return 6;}
            drop(prior_name);
        }
        canonical_mir_append_text(vector_typedefs,"typedef struct { void *data; size_t len; size_t capacity; merit_Allocator allocator; } ");
        bootstrap_buffer_append(vector_typedefs,vector_name,0,buffer_len(vector_name));
        canonical_mir_append_text(vector_typedefs,";\n");
        let runtime_status:i32=canonical_c_append_copy_vector_runtime(vector_type_code,descriptors,vector_runtime);
        if(runtime_status!=0){return runtime_status;}
        drop(vector_name);
        sorted_index=checked_add(sorted_index,1);
    }
    if(needs_vector!=0){buffer_push(vector_typedefs,10);}
    var needs_buffer:i32=canonical_c_has_feature(canonical_c_buffer_runtime_feature(),features);
    if(needs_vector!=0){needs_buffer=1;}
    let needs_slice:i32=canonical_c_has_feature(canonical_c_slice_feature(),features);
    var needs_text:i32=canonical_c_has_feature(canonical_c_text_feature(),features);
    if(needs_buffer!=0){needs_text=1;}
    if(needs_slice!=0){needs_text=1;}
    canonical_mir_append_text(output,"/* generated from bootstrap-mir-v1; deterministic, do not edit */\n#include <stdbool.h>\n");
    if(needs_text!=0){canonical_mir_append_text(output,"#include <stddef.h>\n");}
    canonical_mir_append_text(output,"#include <stdint.h>\n");
    var needs_stdio:i32=canonical_c_has_checked_feature(features);
    if(canonical_c_has_feature(canonical_c_i64_print_feature(),features)!=0){needs_stdio=1;}
    if(needs_text!=0){needs_stdio=1;}
    if(needs_stdio!=0){canonical_mir_append_text(output,"#include <stdio.h>\n");}
    canonical_mir_append_text(output,"#include <stdlib.h>\n");
    if(needs_buffer!=0){canonical_mir_append_text(output,"#include <string.h>\n");}
    buffer_push(output,10);
    if(needs_text!=0){
        canonical_mir_append_text(output,"typedef struct { const uint8_t *data; size_t len; } merit_String;\ntypedef struct { const uint8_t *data; size_t len; } merit_ByteSlice;\nstatic inline int64_t merit_string_len(merit_String value) { return (int64_t)value.len; }\nstatic inline uint8_t merit_string_byte(merit_String value, int64_t index) {\n    if (index < 0 || (size_t)index >= value.len) return 0;\n    return value.data[index];\n}\n\n");
    }
    if(needs_buffer!=0){canonical_c_append_buffer_runtime(output);}
    if(needs_slice!=0){if(needs_buffer==0){
        canonical_mir_append_text(output,"static inline int64_t merit_slice_len(merit_ByteSlice value) { return (int64_t)value.len; }\n");
        canonical_mir_append_text(output,"static inline int64_t merit_slice_get(merit_ByteSlice value, int64_t index) {\n");
        canonical_mir_append_text(output,"    if (index < 0 || (size_t)index >= value.len) { fprintf(stderr, \"Merit slice index out of bounds\\n\"); exit(85); }\n");
        canonical_mir_append_text(output,"    return (int64_t)value.data[index];\n");
        canonical_mir_append_text(output,"}\n\n");
    }}
    if(needs_vector!=0){
        bootstrap_buffer_append(output,vector_typedefs,0,buffer_len(vector_typedefs));
    }
    bootstrap_buffer_append(output,prototypes,0,buffer_len(prototypes));buffer_push(output,10);
    let needs_checked:i32=canonical_c_has_checked_feature(features);
    if(needs_checked!=0){
        canonical_mir_append_text(output,"static void merit_numeric_failure(const char *operation) { fprintf(stderr, \"Merit %s\\n\", operation); exit(70); }\n");
    }
    var needs_divide:i32=canonical_c_has_feature(canonical_c_checked_divide_feature(),features);
    if(canonical_c_has_feature(canonical_c_checked_i32_divide_feature(),features)!=0){needs_divide=1;}
    if(needs_divide!=0){
        canonical_mir_append_text(output,"static void merit_division_by_zero(void) { fprintf(stderr, \"Merit division by zero\\n\"); exit(72); }\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_i32_multiply_feature(),features)!=0){
        canonical_mir_append_text(output,"static int32_t merit_checked_mul_i32(int32_t a, int32_t b) {\n    __int128 result = (__int128)a * (__int128)b;\n    if (result < INT32_MIN || result > INT32_MAX) merit_numeric_failure(\"i32 multiplication overflow\");\n    return (int32_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_i32_add_feature(),features)!=0){
        canonical_mir_append_text(output,"static int32_t merit_checked_add_i32(int32_t a, int32_t b) {\n    __int128 result = (__int128)a + (__int128)b;\n    if (result < INT32_MIN || result > INT32_MAX) merit_numeric_failure(\"i32 addition overflow\");\n    return (int32_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_i32_subtract_feature(),features)!=0){
        canonical_mir_append_text(output,"static int32_t merit_checked_sub_i32(int32_t a, int32_t b) {\n    __int128 result = (__int128)a - (__int128)b;\n    if (result < INT32_MIN || result > INT32_MAX) merit_numeric_failure(\"i32 subtraction overflow\");\n    return (int32_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_i32_divide_feature(),features)!=0){
        canonical_mir_append_text(output,"static int32_t merit_checked_div_i32(int32_t a, int32_t b) {\n    if (b == 0) merit_division_by_zero();\n    if (a == INT32_MIN && b == -1) merit_numeric_failure(\"division overflow\");\n    return (int32_t)(a / b);\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_multiply_feature(),features)!=0){
        canonical_mir_append_text(output,"static int64_t merit_checked_mul_i64(int64_t a, int64_t b) {\n    __int128 result = (__int128)a * (__int128)b;\n    if (result < INT64_MIN || result > INT64_MAX) merit_numeric_failure(\"i64 multiplication overflow\");\n    return (int64_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_add_feature(),features)!=0){
        canonical_mir_append_text(output,"static int64_t merit_checked_add_i64(int64_t a, int64_t b) {\n    __int128 result = (__int128)a + (__int128)b;\n    if (result < INT64_MIN || result > INT64_MAX) merit_numeric_failure(\"i64 addition overflow\");\n    return (int64_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_subtract_feature(),features)!=0){
        canonical_mir_append_text(output,"static int64_t merit_checked_sub_i64(int64_t a, int64_t b) {\n    __int128 result = (__int128)a - (__int128)b;\n    if (result < INT64_MIN || result > INT64_MAX) merit_numeric_failure(\"i64 subtraction overflow\");\n    return (int64_t)result;\n}\n");
    }
    if(canonical_c_has_feature(canonical_c_checked_divide_feature(),features)!=0){
        canonical_mir_append_text(output,"static int64_t merit_checked_div_i64(int64_t a, int64_t b) {\n    if (b == 0) merit_division_by_zero();\n    if (a == INT64_MIN && b == -1) merit_numeric_failure(\"division overflow\");\n    return (int64_t)(a / b);\n}\n");
    }
    if(needs_vector!=0){
        bootstrap_buffer_append(output,vector_runtime,0,buffer_len(vector_runtime));
    }
    if(needs_checked!=0){buffer_push(output,10);}
    if(needs_vector!=0){if(needs_checked==0){buffer_push(output,10);}}
    bootstrap_buffer_append(output,bodies,0,buffer_len(bodies));buffer_push(output,10);
    drop(vector_runtime);drop(vector_typedefs);drop(sorted_codes);
    return 0;
}

pub fn canonical_c_finish_scalar_module(
    borrow prototypes:Buffer,borrow bodies:Buffer,borrow features:Vec<i64>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    var descriptors:Vec<MirTypeDescriptor>=vec_new<MirTypeDescriptor>(allocator,0);
    var vector_type_codes:Vec<i32>=vec_new<i32>(allocator,0);
    let status:i32=canonical_c_finish_module_with_copy_vectors(
        prototypes,bodies,features,vector_type_codes,descriptors,output
    );
    drop(vector_type_codes);drop(descriptors);
    return status;
}

pub fn canonical_c_finish_copy_vector_module(
    borrow prototypes:Buffer,borrow bodies:Buffer,borrow features:Vec<i64>,
    vector_type_code:i32,borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(vector_type_code<function_mir_vector_type_code(0)){return 3;}
    let allocator:Allocator=system_allocator();
    var vector_type_codes:Vec<i32>=vec_new<i32>(allocator,1);
    vec_push<i32>(vector_type_codes,vector_type_code);
    let status:i32=canonical_c_finish_module_with_copy_vectors(
        prototypes,bodies,features,vector_type_codes,descriptors,output
    );
    drop(vector_type_codes);
    return status;
}

// The canonical module assembler supplies only vector types used by its MIR;
// sorting and runtime validation remain native, with no C-text inference.
pub fn canonical_c_finish_copy_vector_catalog_module(
    borrow prototypes:Buffer,borrow bodies:Buffer,borrow features:Vec<i64>,
    borrow vector_type_codes:Vec<i32>,borrow descriptors:Vec<MirTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    return canonical_c_finish_module_with_copy_vectors(
        prototypes,bodies,features,vector_type_codes,descriptors,output
    );
}

// Collect the vector types represented by canonical function locals and return
// values. The project assembler can accumulate these across functions before
// finalizing a single module; the finisher validates descriptors and sorts them.
pub fn canonical_c_collect_vector_types_from_records(
    borrow records:Vec<MirFunctionRecord>,borrow_mut vector_type_codes:Vec<i32>
)->i32
requires_caps [allocate]
{
    if(vec_len<MirFunctionRecord>(records)<2){return 1;}
    let header:MirFunctionRecord=vec_get<MirFunctionRecord>(records,0);
    if(function_mir_kind(header)!=function_mir_kind_function()){return 2;}
    var index:i64=0;
    while(index<vec_len<MirFunctionRecord>(records)){
        let record:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        let kind:i32=function_mir_kind(record);
        var has_type:i32=0;
        if(kind==function_mir_kind_function()){has_type=1;}
        if(kind==function_mir_kind_parameter()){has_type=1;}
        if(kind==function_mir_kind_source_local()){has_type=1;}
        if(kind==function_mir_kind_temporary_local()){has_type=1;}
        if(has_type!=0){
            let type_code:i32=function_mir_type_code(record);
            if(type_code>=function_mir_vector_type_code(0)){
                if(canonical_c_vector_code_selected(type_code,vector_type_codes)==0){
                    vec_push<i32>(vector_type_codes,type_code);
                }
            }
        }
        index=checked_add(index,1);
    }
    return 0;
}

pub fn canonical_c_finish_public_header(
    borrow declarations:Buffer,borrow features:Vec<i64>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    canonical_mir_append_text(output,"#pragma once\n#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n\n");
    if(canonical_c_has_feature(canonical_c_public_string_feature(),features)!=0){
        canonical_mir_append_text(output,"typedef struct { const uint8_t *data; size_t len; } merit_String;\n\n");
    }
    bootstrap_buffer_append(output,declarations,0,buffer_len(declarations));
    return 0;
}

fn canonical_mir_push_identifier_or_numeric_byte(
    borrow_mut output:Buffer,value:i64
)->i32
requires_caps [allocate]
{
    if(value==32){buffer_push(output,32);return 0;}
    if(value==33){buffer_push(output,33);return 0;}
    if(value==35){buffer_push(output,35);return 0;}
    if(value==36){buffer_push(output,36);return 0;}
    if(value==37){buffer_push(output,37);return 0;}
    if(value==38){buffer_push(output,38);return 0;}
    if(value==39){buffer_push(output,39);return 0;}
    if(value==40){buffer_push(output,40);return 0;}
    if(value==41){buffer_push(output,41);return 0;}
    if(value==42){buffer_push(output,42);return 0;}
    if(value==48){buffer_push(output,48);return 0;}
    if(value==49){buffer_push(output,49);return 0;}
    if(value==50){buffer_push(output,50);return 0;}
    if(value==51){buffer_push(output,51);return 0;}
    if(value==52){buffer_push(output,52);return 0;}
    if(value==53){buffer_push(output,53);return 0;}
    if(value==54){buffer_push(output,54);return 0;}
    if(value==55){buffer_push(output,55);return 0;}
    if(value==56){buffer_push(output,56);return 0;}
    if(value==57){buffer_push(output,57);return 0;}
    if(value==43){buffer_push(output,43);return 0;}
    if(value==44){buffer_push(output,44);return 0;}
    if(value==45){buffer_push(output,45);return 0;}
    if(value==46){buffer_push(output,46);return 0;}
    if(value==47){buffer_push(output,47);return 0;}
    if(value==58){buffer_push(output,58);return 0;}
    if(value==59){buffer_push(output,59);return 0;}
    if(value==60){buffer_push(output,60);return 0;}
    if(value==61){buffer_push(output,61);return 0;}
    if(value==62){buffer_push(output,62);return 0;}
    if(value==63){buffer_push(output,63);return 0;}
    if(value==64){buffer_push(output,64);return 0;}
    if(value==65){buffer_push(output,65);return 0;}
    if(value==66){buffer_push(output,66);return 0;}
    if(value==67){buffer_push(output,67);return 0;}
    if(value==68){buffer_push(output,68);return 0;}
    if(value==69){buffer_push(output,69);return 0;}
    if(value==70){buffer_push(output,70);return 0;}
    if(value==71){buffer_push(output,71);return 0;}
    if(value==72){buffer_push(output,72);return 0;}
    if(value==73){buffer_push(output,73);return 0;}
    if(value==74){buffer_push(output,74);return 0;}
    if(value==75){buffer_push(output,75);return 0;}
    if(value==76){buffer_push(output,76);return 0;}
    if(value==77){buffer_push(output,77);return 0;}
    if(value==78){buffer_push(output,78);return 0;}
    if(value==79){buffer_push(output,79);return 0;}
    if(value==80){buffer_push(output,80);return 0;}
    if(value==81){buffer_push(output,81);return 0;}
    if(value==82){buffer_push(output,82);return 0;}
    if(value==83){buffer_push(output,83);return 0;}
    if(value==84){buffer_push(output,84);return 0;}
    if(value==85){buffer_push(output,85);return 0;}
    if(value==86){buffer_push(output,86);return 0;}
    if(value==87){buffer_push(output,87);return 0;}
    if(value==88){buffer_push(output,88);return 0;}
    if(value==89){buffer_push(output,89);return 0;}
    if(value==90){buffer_push(output,90);return 0;}
    if(value==91){buffer_push(output,91);return 0;}
    if(value==93){buffer_push(output,93);return 0;}
    if(value==94){buffer_push(output,94);return 0;}
    if(value==95){buffer_push(output,95);return 0;}
    if(value==96){buffer_push(output,96);return 0;}
    if(value==97){buffer_push(output,97);return 0;}
    if(value==98){buffer_push(output,98);return 0;}
    if(value==99){buffer_push(output,99);return 0;}
    if(value==100){buffer_push(output,100);return 0;}
    if(value==101){buffer_push(output,101);return 0;}
    if(value==102){buffer_push(output,102);return 0;}
    if(value==103){buffer_push(output,103);return 0;}
    if(value==104){buffer_push(output,104);return 0;}
    if(value==105){buffer_push(output,105);return 0;}
    if(value==106){buffer_push(output,106);return 0;}
    if(value==107){buffer_push(output,107);return 0;}
    if(value==108){buffer_push(output,108);return 0;}
    if(value==109){buffer_push(output,109);return 0;}
    if(value==110){buffer_push(output,110);return 0;}
    if(value==111){buffer_push(output,111);return 0;}
    if(value==112){buffer_push(output,112);return 0;}
    if(value==113){buffer_push(output,113);return 0;}
    if(value==114){buffer_push(output,114);return 0;}
    if(value==115){buffer_push(output,115);return 0;}
    if(value==116){buffer_push(output,116);return 0;}
    if(value==117){buffer_push(output,117);return 0;}
    if(value==118){buffer_push(output,118);return 0;}
    if(value==119){buffer_push(output,119);return 0;}
    if(value==120){buffer_push(output,120);return 0;}
    if(value==121){buffer_push(output,121);return 0;}
    if(value==122){buffer_push(output,122);return 0;}
    if(value==123){buffer_push(output,123);return 0;}
    if(value==124){buffer_push(output,124);return 0;}
    if(value==125){buffer_push(output,125);return 0;}
    if(value==126){buffer_push(output,126);return 0;}
    return 1;
}

pub fn canonical_mir_append_json_source(
    borrow_mut output:Buffer,borrow source:Buffer,start:i64,length:i64
)->i32
requires_caps [allocate]
{
    if(start<0){return 1;}
    if(length<0){return 1;}
    if(checked_add(start,length)>buffer_len(source)){return 1;}
    buffer_push(output,34);
    var offset:i64=0;
    while(offset<length){
        let byte:i64=buffer_get(source,checked_add(start,offset));
        // Identifiers, operators, and exact numeric spellings in this first
        // slice must not require JSON escaping. Reject instead of guessing.
        if(byte<32){return 2;}
        if(byte==34){buffer_push(output,92);buffer_push(output,34);}
        else{
            if(byte==92){buffer_push(output,92);buffer_push(output,92);}
            else{
        if(canonical_mir_push_identifier_or_numeric_byte(output,byte)!=0){return 3;}
            }
        }
        offset=checked_add(offset,1);
    }
    buffer_push(output,34);
    return 0;
}

fn canonical_mir_decoded_hex_byte(borrow encoded:Buffer,index:i64)->i64
{
    if(index<0){return -1;}
    if(checked_add(index,4)>buffer_len(encoded)){return -1;}
    if(buffer_get(encoded,index)!=92){return -1;}
    if(buffer_get(encoded,checked_add(index,1))!=120){return -1;}
    let high:i64=canonical_c_json_hex_digit(buffer_get(encoded,checked_add(index,2)));
    let low:i64=canonical_c_json_hex_digit(buffer_get(encoded,checked_add(index,3)));
    if(high<0){return -1;}
    if(low<0){return -1;}
    return checked_add(checked_mul(high,16),low);
}

fn canonical_mir_append_json_hex4(borrow_mut output:Buffer,value:i64)->i32
requires_caps [allocate]
{
    if(value<0){return 1;}
    if(value>65535){return 1;}
    buffer_push(output,92);buffer_push(output,117);
    let digits:String="0123456789abcdef";
    var divisor:i64=4096;
    var remainder:i64=value;
    var index:i64=0;
    while(index<4){
        let digit:i64=remainder/divisor;
        buffer_push(output,string_byte(digits,digit));
        remainder=checked_sub(remainder,checked_mul(digit,divisor));
        divisor=divisor/16;
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_mir_append_json_codepoint(borrow_mut output:Buffer,codepoint:i64)->i32
requires_caps [allocate]
{
    if(codepoint<0){return 1;}
    if(codepoint>1114111){return 1;}
    if(codepoint>=55296){if(codepoint<=57343){return 1;}}
    if(codepoint==34){buffer_push(output,92);buffer_push(output,34);return 0;}
    if(codepoint==92){buffer_push(output,92);buffer_push(output,92);return 0;}
    if(codepoint==8){buffer_push(output,92);buffer_push(output,98);return 0;}
    if(codepoint==9){buffer_push(output,92);buffer_push(output,116);return 0;}
    if(codepoint==10){buffer_push(output,92);buffer_push(output,110);return 0;}
    if(codepoint==12){buffer_push(output,92);buffer_push(output,102);return 0;}
    if(codepoint==13){buffer_push(output,92);buffer_push(output,114);return 0;}
    if(codepoint<32){return canonical_mir_append_json_hex4(output,codepoint);}
    if(codepoint<128){
        let printable:String=" !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
        buffer_push(output,string_byte(printable,checked_sub(codepoint,32)));
        return 0;
    }
    if(codepoint<=65535){return canonical_mir_append_json_hex4(output,codepoint);}
    let offset:i64=checked_sub(codepoint,65536);
    let high:i64=checked_add(55296,offset/1024);
    let low:i64=checked_add(56320,checked_sub(offset,checked_mul(offset/1024,1024)));
    if(canonical_mir_append_json_hex4(output,high)!=0){return 1;}
    return canonical_mir_append_json_hex4(output,low);
}

fn canonical_mir_append_decoded_json_string(
    borrow_mut output:Buffer,borrow encoded:Buffer,decoded_length:i64
)->i32
requires_caps [allocate]
{
    if(decoded_length<0){return 1;}
    if(buffer_len(encoded)!=checked_mul(decoded_length,4)){return 1;}
    buffer_push(output,34);
    var index:i64=0;
    while(index<decoded_length){
        let lead:i64=canonical_mir_decoded_hex_byte(encoded,checked_mul(index,4));
        if(lead<0){return 1;}
        var codepoint:i64=lead;
        var width:i64=1;
        if(lead>=128){
            if(lead<194){return 1;}
            if(lead<224){width=2;codepoint=checked_sub(lead,192);}
            else{if(lead<240){width=3;codepoint=checked_sub(lead,224);}
            else{if(lead<245){width=4;codepoint=checked_sub(lead,240);}
            else{return 1;}}}
            if(checked_add(index,width)>decoded_length){return 1;}
            var tail:i64=1;
            while(tail<width){
                let next:i64=canonical_mir_decoded_hex_byte(encoded,checked_mul(checked_add(index,tail),4));
                if(next<128){return 1;}
                if(next>191){return 1;}
                codepoint=checked_add(checked_mul(codepoint,64),checked_sub(next,128));
                tail=checked_add(tail,1);
            }
            if(width==2){if(codepoint<128){return 1;}}
            if(width==3){if(codepoint<2048){return 1;}}
            if(width==4){if(codepoint<65536){return 1;}}
        }
        if(canonical_mir_append_json_codepoint(output,codepoint)!=0){return 1;}
        index=checked_add(index,width);
    }
    buffer_push(output,34);
    return 0;
}

// Compare normalized signed decimal spellings without narrowing their value to
// an i64. Numeric descriptor bounds can include the entire u64 domain.
fn canonical_mir_compare_signed_decimal(borrow left:Buffer,borrow right:Buffer)->i32
{
    let left_length:i64=buffer_len(left);
    let right_length:i64=buffer_len(right);
    if(left_length==0){return 2;}
    if(right_length==0){return 2;}
    var left_start:i64=0;
    var right_start:i64=0;
    var left_negative:i32=0;
    var right_negative:i32=0;
    if(buffer_get(left,0)==45){left_start=1;left_negative=1;}
    if(buffer_get(right,0)==45){right_start=1;right_negative=1;}
    if(left_negative!=right_negative){if(left_negative!=0){return -1;}return 1;}
    let left_digits:i64=checked_sub(left_length,left_start);
    let right_digits:i64=checked_sub(right_length,right_start);
    var comparison:i32=0;
    if(left_digits<right_digits){comparison=-1;}
    if(left_digits>right_digits){comparison=1;}
    if(comparison==0){
        var index:i64=0;
        while(index<left_digits){
            let actual:i64=buffer_get(left,checked_add(left_start,index));
            let expected:i64=buffer_get(right,checked_add(right_start,index));
            if(comparison==0){
                if(actual<expected){comparison=-1;}
                if(actual>expected){comparison=1;}
            }
            index=checked_add(index,1);
        }
    }
    if(left_negative!=0){return checked_sub(0,comparison);}
    return comparison;
}

fn canonical_mir_append_scaled_decimal_const(
    borrow_mut output:Buffer,borrow source:Buffer,start:i64,length:i64,
    precision:i64,scale:i64
)->i32
requires_caps [allocate]
{
    if(start<0){return 1;}
    if(length<=0){return 1;}
    let end:i64=checked_add(start,length);
    if(end>buffer_len(source)){return 1;}
    if(precision<1){return 1;}
    if(scale<0){return 1;}
    if(scale>precision){return 1;}
    let allocator:Allocator=system_allocator();
    var digits:Buffer=buffer_new(allocator,length);
    var cursor:i64=start;
    var negative:i32=0;
    let first:i64=buffer_get(source,cursor);
    if(first==45){negative=1;cursor=checked_add(cursor,1);}
    if(first==43){cursor=checked_add(cursor,1);}
    var seen_digit:i32=0;
    var seen_point:i32=0;
    var fraction_count:i64=0;
    var mantissa_done:i32=0;
    var scanning_mantissa:i32=1;
    while(scanning_mantissa!=0){
        if(cursor>=end){scanning_mantissa=0;}
        else{
            let byte:i64=buffer_get(source,cursor);
            if(byte==101){mantissa_done=1;}
            if(byte==69){mantissa_done=1;}
            if(mantissa_done!=0){cursor=checked_add(cursor,1);scanning_mantissa=0;}
            else{
                if(byte==46){
                    if(seen_point!=0){return 2;}
                    seen_point=1;
                }else{
                    if(byte<48){return 2;}
                    if(byte>57){return 2;}
                    buffer_push(digits,string_byte("0123456789",checked_sub(byte,48)));
                    seen_digit=1;
                    if(seen_point!=0){fraction_count=checked_add(fraction_count,1);}
                }
                cursor=checked_add(cursor,1);
            }
        }
    }
    if(seen_digit==0){return 2;}
    var exponent:i64=0;
    var exponent_negative:i32=0;
    if(mantissa_done!=0){
        if(cursor>=end){return 2;}
        let sign_byte:i64=buffer_get(source,cursor);
        if(sign_byte==45){exponent_negative=1;cursor=checked_add(cursor,1);}
        if(sign_byte==43){cursor=checked_add(cursor,1);}
        if(cursor>=end){return 2;}
        while(cursor<end){
            let byte:i64=buffer_get(source,cursor);
            if(byte<48){return 2;}
            if(byte>57){return 2;}
            if(exponent<1001){
                exponent=checked_add(checked_mul(exponent,10),checked_sub(byte,48));
                if(exponent>1001){exponent=1001;}
            }
            cursor=checked_add(cursor,1);
        }
    }
    var first_digit:i64=0;
    var scanning_zero:i32=1;
    while(scanning_zero!=0){
        if(first_digit>=buffer_len(digits)){scanning_zero=0;}
        else{
            if(buffer_get(digits,first_digit)!=48){scanning_zero=0;}
            else{first_digit=checked_add(first_digit,1);}
        }
    }
    if(first_digit==buffer_len(digits)){buffer_push(output,48);return 0;}
    if(exponent>1000){return 3;}
    if(exponent_negative!=0){exponent=checked_sub(0,exponent);}
    let shift:i64=checked_sub(checked_add(scale,exponent),fraction_count);
    var kept_end:i64=buffer_len(digits);
    if(shift<0){
        let dropped:i64=checked_sub(0,shift);
        if(dropped>buffer_len(digits)){return 4;}
        kept_end=checked_sub(kept_end,dropped);
        var dropped_index:i64=kept_end;
        while(dropped_index<buffer_len(digits)){
            if(buffer_get(digits,dropped_index)!=48){return 4;}
            dropped_index=checked_add(dropped_index,1);
        }
        if(first_digit>=kept_end){return 4;}
    }
    var significant:i64=checked_sub(kept_end,first_digit);
    if(shift>0){significant=checked_add(significant,shift);}
    if(significant>precision){return 5;}
    if(negative!=0){buffer_push(output,45);}
    bootstrap_buffer_append(output,digits,first_digit,checked_sub(kept_end,first_digit));
    if(shift>0){
        var zeros:i64=0;
        while(zeros<shift){buffer_push(output,48);zeros=checked_add(zeros,1);}
    }
    drop(digits);
    return 0;
}

fn canonical_mir_append_typed_const_source_with_catalog(
    borrow_mut output:Buffer,borrow source:Buffer,start:i64,length:i64,type_code:i32,
    borrow numeric_type_descriptors:Vec<MirNumericTypeDescriptor>,enforce_bounded_domain:i32
)->i32
requires_caps [allocate]
{
    if(start<0){return 1;}
    if(length<=0){return 1;}
    let end:i64=checked_add(start,length);
    if(end>buffer_len(source)){return 1;}
    if(type_code==function_mir_bool_type_code()){
        return canonical_c_append_boolean_literal(source,start,length,output);
    }
    if(type_code==function_mir_string_type_code()){
        var checked_literal:Buffer=buffer_new(system_allocator(),checked_mul(length,4));
        let decoded:i64=canonical_c_decode_json_string(source,start,length,checked_literal);
        var status:i32=2;
        if(decoded>=0){status=canonical_mir_append_decoded_json_string(output,checked_literal,decoded);}
        drop(checked_literal);
        return status;
    }
    if(function_mir_type_is_integer(type_code)!=0){
        var checked_literal:Buffer=buffer_new(system_allocator(),48);
        let status:i32=canonical_c_append_scalar_integer_literal(source,start,length,type_code,checked_literal);
        drop(checked_literal);
        if(status!=0){return 3;}
    }else{
        if(function_mir_type_is_declared_numeric(type_code)!=0){
            let allocator:Allocator=system_allocator();
            var checked_type:Buffer=buffer_new(allocator,128);
            let type_status:i32=canonical_mir_append_numeric_type(numeric_type_descriptors,type_code,checked_type);
            drop(checked_type);
            if(type_status!=0){return 4;}
            var index:i64=0;
            while(index<vec_len<MirNumericTypeDescriptor>(numeric_type_descriptors)){
                let descriptor:MirNumericTypeDescriptor=vec_get<MirNumericTypeDescriptor>(numeric_type_descriptors,index);
                if(function_mir_numeric_descriptor_code(descriptor)==type_code){
                    if(function_mir_numeric_descriptor_kind(descriptor)==function_mir_numeric_descriptor_decimal_kind()){
                        return canonical_mir_append_scaled_decimal_const(
                            output,source,start,length,
                            function_mir_numeric_descriptor_lower_high_or_precision(descriptor),
                            function_mir_numeric_descriptor_lower_low_or_scale(descriptor)
                        );
                    }
                    if(function_mir_numeric_descriptor_kind(descriptor)==function_mir_numeric_descriptor_bounded_kind()){
                        var value:Buffer=buffer_new(allocator,length);
                        let base_status:i32=canonical_mir_append_typed_const_source_with_catalog(
                            value,source,start,length,function_mir_numeric_descriptor_base(descriptor),
                            numeric_type_descriptors,1
                        );
                        if(base_status!=0){return 5;}
                        if(enforce_bounded_domain!=0){
                            var lower:Buffer=buffer_new(allocator,24);
                            var upper:Buffer=buffer_new(allocator,24);
                            let lower_status:i32=canonical_mir_append_numeric_bound(
                                lower,function_mir_numeric_descriptor_lower_sign(descriptor),
                                function_mir_numeric_descriptor_lower_high_or_precision(descriptor),
                                function_mir_numeric_descriptor_lower_low_or_scale(descriptor)
                            );
                            let upper_status:i32=canonical_mir_append_numeric_bound(
                                upper,function_mir_numeric_descriptor_upper_sign(descriptor),
                                function_mir_numeric_descriptor_upper_high(descriptor),
                                function_mir_numeric_descriptor_upper_low(descriptor)
                            );
                            if(lower_status!=0){return 6;}
                            if(upper_status!=0){return 6;}
                            let below:i32=canonical_mir_compare_signed_decimal(value,lower);
                            let above:i32=canonical_mir_compare_signed_decimal(value,upper);
                            drop(upper);drop(lower);
                            if(below<0){return 7;}
                            if(above>0){return 7;}
                        }
                        bootstrap_buffer_append(output,value,0,buffer_len(value));
                        drop(value);
                        return 0;
                    }
                    return 4;
                }
                index=checked_add(index,1);
            }
            return 4;
        }
        return canonical_mir_append_json_source(output,source,start,length);
    }
    var digit_start:i64=start;
    var negative:i32=0;
    let first:i64=buffer_get(source,start);
    if(first==45){negative=1;digit_start=checked_add(digit_start,1);}
    if(first==43){digit_start=checked_add(digit_start,1);}
    var scanning_zero:i32=1;
    while(scanning_zero!=0){
        if(digit_start>=checked_sub(end,1)){scanning_zero=0;}
        else{
            if(buffer_get(source,digit_start)!=48){scanning_zero=0;}
            else{digit_start=checked_add(digit_start,1);}
        }
    }
    if(buffer_get(source,digit_start)==48){negative=0;}
    if(negative!=0){buffer_push(output,45);}
    bootstrap_buffer_append(output,source,digit_start,checked_sub(end,digit_start));
    return 0;
}

fn canonical_mir_append_typed_const_source(
    borrow_mut output:Buffer,borrow source:Buffer,start:i64,length:i64,type_code:i32
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    var empty:Vec<MirNumericTypeDescriptor>=vec_new<MirNumericTypeDescriptor>(allocator,0);
    let status:i32=canonical_mir_append_typed_const_source_with_catalog(
        output,source,start,length,type_code,empty,1
    );
    drop(empty);
    return status;
}

fn canonical_mir_append_json_string(borrow_mut output:Buffer,value:String)->i32
requires_caps [allocate]
{
    buffer_push(output,34);
    var index:i64=0;
    while(index<string_len(value)){
        let byte:u8=string_byte(value,index);
        if(byte<32){return 1;}
        if(byte==34){return 1;}
        if(byte==92){return 1;}
        buffer_push(output,byte);
        index=checked_add(index,1);
    }
    buffer_push(output,34);
    return 0;
}

pub fn canonical_mir_append_type(borrow_mut output:Buffer,type_code:i32)->i32
requires_caps [allocate]
{
    canonical_mir_append_text(output,"{\"name\":\"");
    if(type_code==function_mir_i64_type_code()){canonical_mir_append_text(output,"i64");}
    else{
        if(type_code==function_mir_bool_type_code()){canonical_mir_append_text(output,"bool");}
        else{
            if(type_code==function_mir_allocator_type_code()){canonical_mir_append_text(output,"Allocator");}
            else{
                if(type_code==function_mir_buffer_type_code()){canonical_mir_append_text(output,"Buffer");}
                else{
                    if(type_code==function_mir_i8_type_code()){canonical_mir_append_text(output,"i8");}
                    else{
                        if(type_code==function_mir_i16_type_code()){canonical_mir_append_text(output,"i16");}
                        else{
                            if(type_code==function_mir_i32_type_code()){canonical_mir_append_text(output,"i32");}
                            else{
                                if(type_code==function_mir_u8_type_code()){canonical_mir_append_text(output,"u8");}
                                else{
                                    if(type_code==function_mir_u16_type_code()){canonical_mir_append_text(output,"u16");}
                                    else{
                                        if(type_code==function_mir_u32_type_code()){canonical_mir_append_text(output,"u32");}
                                        else{
                                            if(type_code==function_mir_u64_type_code()){canonical_mir_append_text(output,"u64");}
                                            else{
                                                if(type_code==function_mir_string_type_code()){canonical_mir_append_text(output,"String");}
                                                else{
                                                    if(type_code==function_mir_byte_slice_type_code()){canonical_mir_append_text(output,"ByteSlice");}
                                                    else{
                                                        if(type_code==function_mir_unit_type_code()){canonical_mir_append_text(output,"unit");}
                                                        else{return 1;}
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    canonical_mir_append_text(output,"\"}");
    return 0;
}

fn canonical_mir_append_hex_span(
    borrow source:Buffer,start:i64,length:i64,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(start<0){return 1;}
    if(length<=0){return 1;}
    if(checked_add(start,length)>buffer_len(source)){return 1;}
    var index:i64=0;
    while(index<length){
        let byte:i64=buffer_get(source,checked_add(start,index));
        let high:i64=byte/16;
        let low:i64=checked_sub(byte,checked_mul(high,16));
        let digits:String="0123456789abcdef";
        buffer_push(output,string_byte(digits,high));
        buffer_push(output,string_byte(digits,low));
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_mir_append_numeric_bound(
    borrow_mut output:Buffer,sign:i32,high:i64,low:i64
)->i32
requires_caps [allocate]
{
    let limb_base:i64=function_mir_numeric_descriptor_limb_base();
    if(high<0){return 1;}
    if(low<0){return 1;}
    if(low>=limb_base){return 1;}
    if(sign<0){canonical_mir_append_text(output,"-");}
    if(high==0){return canonical_mir_append_i64(output,low);}
    canonical_mir_append_i64(output,high);
    var remainder:i64=low;
    var divisor:i64=limb_base/10;
    let digits:String="0123456789";
    while(divisor>0){
        let digit:i64=remainder/divisor;
        buffer_push(output,string_byte(digits,digit));
        remainder=checked_sub(remainder,checked_mul(digit,divisor));
        divisor=divisor/10;
    }
    return 0;
}

fn canonical_mir_append_numeric_type(
    borrow descriptors:Vec<MirNumericTypeDescriptor>,type_code:i32,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    var matches:i32=0;
    var index:i64=0;
    while(index<vec_len<MirNumericTypeDescriptor>(descriptors)){
        let item:MirNumericTypeDescriptor=vec_get<MirNumericTypeDescriptor>(descriptors,index);
        if(function_mir_numeric_descriptor_code(item)==type_code){
            matches=checked_add(matches,1);
            if(matches!=1){return 2;}
            let identity:i32=function_mir_numeric_descriptor_identity(item);
            let kind:i32=function_mir_numeric_descriptor_kind(item);
            if(identity<0){return 2;}
            if(kind==function_mir_numeric_descriptor_decimal_kind()){
                if(type_code!=function_mir_decimal_type_code(identity)){return 2;}
                if(function_mir_numeric_descriptor_base(item)!=0){return 2;}
                if(function_mir_numeric_descriptor_lower_sign(item)!=0){return 2;}
                if(function_mir_numeric_descriptor_upper_sign(item)!=0){return 2;}
                if(function_mir_numeric_descriptor_upper_high(item)!=0){return 2;}
                if(function_mir_numeric_descriptor_upper_low(item)!=0){return 2;}
                let precision:i64=function_mir_numeric_descriptor_lower_high_or_precision(item);
                let scale:i64=function_mir_numeric_descriptor_lower_low_or_scale(item);
                let policy:i32=function_mir_numeric_descriptor_policy(item);
                if(precision<1){return 2;}
                if(scale<0){return 2;}
                if(scale>precision){return 2;}
                if(policy<0){return 2;}
                if(policy>4){return 2;}
                canonical_mir_append_text(output,"{\"name\":\"decimal_");
                canonical_mir_append_i32(output,identity);buffer_push(output,95);
                canonical_mir_append_i64(output,precision);buffer_push(output,95);
                canonical_mir_append_i64(output,scale);buffer_push(output,95);
                canonical_mir_append_i32(output,policy);
                canonical_mir_append_text(output,"\"}");
            }else{if(kind==function_mir_numeric_descriptor_bounded_kind()){
                if(type_code!=function_mir_bounded_type_code(identity)){return 2;}
                let base:i32=function_mir_numeric_descriptor_base(item);
                if(base!=function_mir_i8_type_code()){
                if(base!=function_mir_i16_type_code()){
                if(base!=function_mir_i32_type_code()){
                if(base!=function_mir_i64_type_code()){
                if(base!=function_mir_u8_type_code()){
                if(base!=function_mir_u16_type_code()){
                if(base!=function_mir_u32_type_code()){
                if(base!=function_mir_u64_type_code()){return 2;}
                }}}}}}}
                let lower_sign:i32=function_mir_numeric_descriptor_lower_sign(item);
                let upper_sign:i32=function_mir_numeric_descriptor_upper_sign(item);
                let lower_high:i64=function_mir_numeric_descriptor_lower_high_or_precision(item);
                let lower_low:i64=function_mir_numeric_descriptor_lower_low_or_scale(item);
                let upper_high:i64=function_mir_numeric_descriptor_upper_high(item);
                let upper_low:i64=function_mir_numeric_descriptor_upper_low(item);
                if(lower_sign< -1){return 2;}if(lower_sign>1){return 2;}
                if(upper_sign< -1){return 2;}if(upper_sign>1){return 2;}
                if(lower_high<0){return 2;}if(lower_low<0){return 2;}
                if(upper_high<0){return 2;}if(upper_low<0){return 2;}
                if(lower_low>=function_mir_numeric_descriptor_limb_base()){return 2;}
                if(upper_low>=function_mir_numeric_descriptor_limb_base()){return 2;}
                if(lower_sign==0){if(lower_high!=0){return 2;}if(lower_low!=0){return 2;}}
                else{if(lower_high==0){if(lower_low==0){return 2;}}}
                if(upper_sign==0){if(upper_high!=0){return 2;}if(upper_low!=0){return 2;}}
                else{if(upper_high==0){if(upper_low==0){return 2;}}}
                if(function_mir_numeric_descriptor_policy(item)!=0){return 2;}
                if(lower_sign>upper_sign){return 2;}
                if(lower_sign==upper_sign){
                    if(lower_sign>0){
                        if(lower_high>upper_high){return 2;}
                        if(lower_high==upper_high){if(lower_low>upper_low){return 2;}}
                    }
                    if(lower_sign<0){
                        if(lower_high<upper_high){return 2;}
                        if(lower_high==upper_high){if(lower_low<upper_low){return 2;}}
                    }
                }
                canonical_mir_append_text(output,"{\"arguments\":[");
                if(canonical_mir_append_type(output,base)!=0){return 2;}
                canonical_mir_append_text(output,"],\"name\":\"bounded_");
                canonical_mir_append_i32(output,identity);buffer_push(output,95);
                canonical_mir_append_i32(output,base);buffer_push(output,95);
                if(canonical_mir_append_numeric_bound(output,lower_sign,lower_high,lower_low)!=0){return 2;}
                buffer_push(output,95);
                if(canonical_mir_append_numeric_bound(output,upper_sign,upper_high,upper_low)!=0){return 2;}
                canonical_mir_append_text(output,"\"}");
            }else{return 2;}}
        }
        index=checked_add(index,1);
    }
    if(matches==0){return 1;}
    return 0;
}

// Preserve the snapshot oracle's existing recursive MirType JSON, including
// aggregate ABI identity, without assigning a new meaning to type codes.
fn canonical_mir_append_type_with_catalog(
    borrow source:Buffer,borrow descriptors:Vec<MirTypeDescriptor>,
    borrow numeric_descriptors:Vec<MirNumericTypeDescriptor>,
    type_code:i32,depth:i64,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    // An acyclic descriptor path cannot contain more nodes than the catalog.
    if(depth>vec_len<MirTypeDescriptor>(descriptors)){return 1;}
    var count:i32=0;
    var kind:i32=0;
    var identity:i32=0;
    var destructor_ordinal:i32=-1;
    var name_start:i64=0;
    var name_length:i64=0;
    var abi_flags:i32=0;
    var descriptor_index:i64=0;
    while(descriptor_index<vec_len<MirTypeDescriptor>(descriptors)){
        let item:MirTypeDescriptor=vec_get<MirTypeDescriptor>(descriptors,descriptor_index);
        if(function_mir_type_descriptor_code(item)==type_code){
            if(function_mir_type_descriptor_ordinal(item)!=count){return 2;}
            if(count==0){
                kind=function_mir_type_descriptor_kind(item);
                identity=function_mir_type_descriptor_identity(item);
                name_start=function_mir_type_descriptor_name_start(item);
                name_length=function_mir_type_descriptor_name_length(item);
                abi_flags=function_mir_type_descriptor_abi_flags(item);
            }else{
                if(function_mir_type_descriptor_kind(item)!=kind){return 3;}
                if(function_mir_type_descriptor_identity(item)!=identity){return 3;}
                if(kind==function_mir_type_descriptor_aggregate_struct_kind()){
                    if(function_mir_type_descriptor_name_start(item)!=name_start){return 3;}
                    if(function_mir_type_descriptor_name_length(item)!=name_length){return 3;}
                    if(function_mir_type_descriptor_abi_flags(item)!=abi_flags){return 3;}
                }
            }
            if(function_mir_type_descriptor_child(item)<=0){return 4;}
            if(kind==function_mir_type_descriptor_aggregate_struct_kind()){
                if(function_mir_type_descriptor_destructor_policy(item)!=0){
                    if(function_mir_type_descriptor_destructor_policy(item)!=1){return 5;}
                    if(destructor_ordinal>=0){return 5;}
                    destructor_ordinal=count;
                }
            }else{if(function_mir_type_descriptor_destructor_policy(item)!=0){return 5;}}
            count=checked_add(count,1);
        }
        descriptor_index=checked_add(descriptor_index,1);
    }
    if(count==0){
        if(type_code>=function_mir_decimal_type_code(0)){
            return canonical_mir_append_numeric_type(numeric_descriptors,type_code,output);
        }
        if(type_code>=function_mir_copy_payload_enum_type_code(0)){
            if(type_code<function_mir_i64_struct_type_code(0)){
                canonical_mir_append_text(output,"{\"name\":\"enum_copy_payload_");
                canonical_mir_append_i32(output,checked_sub(type_code,function_mir_copy_payload_enum_type_code(0)));
                canonical_mir_append_text(output,"\"}");return 0;
            }
            if(type_code<function_mir_destructor_i64_struct_type_code(0)){
                canonical_mir_append_text(output,"{\"name\":\"struct_i64_");
                canonical_mir_append_i32(output,checked_sub(type_code,function_mir_i64_struct_type_code(0)));
                canonical_mir_append_text(output,"\"}");return 0;
            }
            if(type_code<function_mir_owned_payload_enum_type_code(0,0)){
                canonical_mir_append_text(output,"{\"name\":\"struct_i64_destructor_");
                canonical_mir_append_i32(output,checked_sub(type_code,function_mir_destructor_i64_struct_type_code(0)));
                canonical_mir_append_text(output,"\"}");return 0;
            }
            if(type_code<function_mir_owned_field_struct_type_code(0)){
                let enum_id:i32=function_mir_owned_payload_enum_id(type_code);
                let payload_id:i32=checked_sub(type_code,function_mir_owned_payload_enum_type_code(enum_id,0));
                canonical_mir_append_text(output,"{\"name\":\"enum_owned_payload_");
                canonical_mir_append_i32(output,enum_id);buffer_push(output,95);
                canonical_mir_append_i32(output,payload_id);
                canonical_mir_append_text(output,"\"}");return 0;
            }
        }
        return canonical_mir_append_type(output,type_code);
    }
    if(identity<0){return 6;}
    if(kind==function_mir_type_descriptor_aggregate_struct_kind()){
        if(type_code!=function_mir_aggregate_struct_type_code(identity)){return 6;}
    }else{if(kind==function_mir_type_descriptor_vector_kind()){
        if(type_code!=function_mir_vector_type_code(identity)){return 6;}
        if(count!=1){return 6;}
    }else{if(kind==function_mir_type_descriptor_copy_payload_enum_kind()){
        if(type_code!=function_mir_copy_payload_enum_type_code(identity)){return 6;}
    }else{if(kind==function_mir_type_descriptor_owned_payload_enum_kind()){
        if(type_code!=function_mir_recursive_owned_payload_enum_type_code(identity)){return 6;}
    }else{if(kind==function_mir_type_descriptor_owned_field_struct_kind()){
        if(type_code!=function_mir_owned_field_struct_type_code(identity)){return 6;}
        if(count!=1){return 6;}
    }else{return 6;}}}}}
    canonical_mir_append_text(output,"{\"arguments\":[");
    descriptor_index=0;
    var emitted:i64=0;
    while(descriptor_index<vec_len<MirTypeDescriptor>(descriptors)){
        let item:MirTypeDescriptor=vec_get<MirTypeDescriptor>(descriptors,descriptor_index);
        if(function_mir_type_descriptor_code(item)==type_code){
            if(emitted>0){buffer_push(output,44);}
            let child_status:i32=canonical_mir_append_type_with_catalog(
                source,descriptors,numeric_descriptors,function_mir_type_descriptor_child(item),
                checked_add(depth,1),output
            );
            if(child_status!=0){return checked_add(10,child_status);}
            emitted=checked_add(emitted,1);
        }
        descriptor_index=checked_add(descriptor_index,1);
    }
    canonical_mir_append_text(output,"],\"name\":\"");
    if(kind==function_mir_type_descriptor_aggregate_struct_kind()){
        canonical_mir_append_text(output,"struct_aggregate_");
        canonical_mir_append_i32(output,identity);
        canonical_mir_append_text(output,"_destructor_");
        canonical_mir_append_i32(output,destructor_ordinal);
        if(abi_flags<0){return 7;}
        if(abi_flags>3){return 7;}
        canonical_mir_append_text(output,"__abi_");
        canonical_mir_append_i32(output,abi_flags);
        buffer_push(output,95);
        if(canonical_mir_append_hex_span(source,name_start,name_length,output)!=0){return 7;}
        descriptor_index=0;
        while(descriptor_index<vec_len<MirTypeDescriptor>(descriptors)){
            let member:MirTypeDescriptor=vec_get<MirTypeDescriptor>(descriptors,descriptor_index);
            if(function_mir_type_descriptor_code(member)==type_code){
                buffer_push(output,95);
                if(canonical_mir_append_hex_span(
                    source,function_mir_type_descriptor_member_start(member),
                    function_mir_type_descriptor_member_length(member),output
                )!=0){return 7;}
            }
            descriptor_index=checked_add(descriptor_index,1);
        }
    }else{if(kind==function_mir_type_descriptor_vector_kind()){
        canonical_mir_append_text(output,"Vec");
    }else{if(kind==function_mir_type_descriptor_copy_payload_enum_kind()){
        canonical_mir_append_text(output,"enum_copy_payload_");
        canonical_mir_append_i32(output,identity);
    }else{if(kind==function_mir_type_descriptor_owned_payload_enum_kind()){
        canonical_mir_append_text(output,"enum_owned_payload_");
        canonical_mir_append_i32(output,identity);
    }else{
        canonical_mir_append_text(output,"struct_owned_field_");
        canonical_mir_append_i32(output,identity);
    }}}}
    canonical_mir_append_text(output,"\"}");
    return 0;
}

fn canonical_mir_append_symbol(borrow_mut output:Buffer,symbol_code:i32)->i32
requires_caps [allocate]
{
    if(symbol_code==function_mir_binary_add_symbol()){canonical_mir_append_text(output,"+");return 0;}
    if(symbol_code==function_mir_binary_subtract_symbol()){canonical_mir_append_text(output,"-");return 0;}
    if(symbol_code==function_mir_binary_multiply_symbol()){canonical_mir_append_text(output,"*");return 0;}
    if(symbol_code==function_mir_binary_divide_symbol()){canonical_mir_append_text(output,"/");return 0;}
    if(symbol_code==function_mir_binary_equal_symbol()){canonical_mir_append_text(output,"==");return 0;}
    if(symbol_code==function_mir_binary_not_equal_symbol()){canonical_mir_append_text(output,"!=");return 0;}
    if(symbol_code==function_mir_binary_greater_equal_symbol()){canonical_mir_append_text(output,">=");return 0;}
    if(symbol_code==function_mir_binary_less_equal_symbol()){canonical_mir_append_text(output,"<=");return 0;}
    if(symbol_code==function_mir_binary_greater_symbol()){canonical_mir_append_text(output,">");return 0;}
    if(symbol_code==function_mir_binary_less_symbol()){canonical_mir_append_text(output,"<");return 0;}
    return 1;
}

fn canonical_mir_append_mode(borrow_mut output:Buffer,mode:i32)->i32
requires_caps [allocate]
{
    if(mode==function_mir_mode_value()){canonical_mir_append_text(output,"value");return 0;}
    if(mode==function_mir_mode_borrowed()){canonical_mir_append_text(output,"borrowed");return 0;}
    if(mode==function_mir_mode_mutable_borrow()){canonical_mir_append_text(output,"mutable_borrow");return 0;}
    return 1;
}

pub fn materialize_bound_straight_line_canonical_mir(
    borrow source:Buffer,module_name:String,borrow records:Vec<MirFunctionRecord>,
    borrow ownership_bindings:Vec<MirOwnershipBinding>,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(validate_function_mir_records(records)!=0){return 1;}
    if(vec_len<MirFunctionRecord>(records)<2){return 2;}
    let header:MirFunctionRecord=vec_get<MirFunctionRecord>(records,0);
    if(function_mir_kind(header)!=function_mir_kind_function()){return 3;}
    var ownership_binding_index:i64=0;
    while(ownership_binding_index<vec_len<MirOwnershipBinding>(ownership_bindings)){
        let ownership_binding_value:MirOwnershipBinding=vec_get<MirOwnershipBinding>(ownership_bindings,ownership_binding_index);
        if(ownership_binding_owned(ownership_binding_value)<0){return 4;}
        if(ownership_binding_owned(ownership_binding_value)>1){return 4;}
        if(ownership_binding_mutable(ownership_binding_value)<0){return 5;}
        if(ownership_binding_mutable(ownership_binding_value)>1){return 5;}
        if(ownership_binding_needs_drop(ownership_binding_value)<0){return 6;}
        if(ownership_binding_needs_drop(ownership_binding_value)>1){return 6;}
        if(ownership_binding_needs_drop(ownership_binding_value)>ownership_binding_owned(ownership_binding_value)){return 7;}
        var ownership_local_matches:i64=0;
        var ownership_record_index:i64=1;
        while(ownership_record_index<vec_len<MirFunctionRecord>(records)){
            let ownership_local:MirFunctionRecord=vec_get<MirFunctionRecord>(records,ownership_record_index);
            if(function_mir_kind(ownership_local)==function_mir_kind_source_local()){
                if(function_mir_binding_id(ownership_local)==ownership_binding_id(ownership_binding_value)){
                    if(function_mir_id(ownership_local)==ownership_binding_local_id(ownership_binding_value)){
                        ownership_local_matches=checked_add(ownership_local_matches,1);
                    }
                }
            }
            ownership_record_index=checked_add(ownership_record_index,1);
        }
        if(ownership_local_matches!=1){return 8;}
        ownership_binding_index=checked_add(ownership_binding_index,1);
    }

    canonical_mir_append_text(output,"{\"functions\":[{\"blocks\":[{\"id\":0,\"instructions\":[");
    var index:i64=1;
    var instruction_count:i64=0;
    while(index<vec_len<MirFunctionRecord>(records)){
        let record:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        let kind:i32=function_mir_kind(record);
        var is_instruction:i32=0;
        if(kind==function_mir_kind_const()){is_instruction=1;}
        if(kind==function_mir_kind_binary()){is_instruction=1;}
        if(kind==function_mir_kind_copy_to_binding()){is_instruction=1;}
        if(kind==function_mir_kind_print()){is_instruction=1;}
        if(kind==function_mir_kind_call()){is_instruction=1;}
        if(is_instruction!=0){
            if(instruction_count>0){buffer_push(output,44);}
            canonical_mir_append_text(output,"{\"contract_kind\":\"none\",\"conversion_policy\":\"none\",\"id\":");
            canonical_mir_append_i64(output,function_mir_id(record));
            if(kind==function_mir_kind_const()){
                canonical_mir_append_text(output,",\"kind\":\"const\",\"numeric_policy\":\"none\",\"operands\":[],\"ownership\":\"value\",\"result\":");
                canonical_mir_append_i64(output,function_mir_result(record));
                canonical_mir_append_text(output,",\"span\":[");
                canonical_mir_append_i64(output,function_mir_start(record));buffer_push(output,44);
                canonical_mir_append_i64(output,function_mir_length(record));
                canonical_mir_append_text(output,"],\"value\":");
                let value_status:i32=canonical_mir_append_typed_const_source(
                    output,source,function_mir_start(record),function_mir_length(record),function_mir_type_code(record)
                );
                if(value_status!=0){return checked_add(20,value_status);}
            }else{
                if(kind==function_mir_kind_binary()){
                    canonical_mir_append_text(output,",\"kind\":\"binary\",\"numeric_policy\":\"");
                    if(function_mir_numeric_policy(record)==function_mir_exact_numeric_policy()){canonical_mir_append_text(output,"exact");}
                    else{if(function_mir_numeric_policy(record)==function_mir_checked_numeric_policy()){canonical_mir_append_text(output,"checked");}else{return 30;}}
                    canonical_mir_append_text(output,"\",\"operands\":[");
                    canonical_mir_append_i64(output,function_mir_left(record));buffer_push(output,44);
                    canonical_mir_append_i64(output,function_mir_right(record));
                    canonical_mir_append_text(output,"],\"ownership\":\"none\",\"result\":");
                    canonical_mir_append_i64(output,function_mir_result(record));
                    canonical_mir_append_text(output,",\"span\":[");
                    canonical_mir_append_i64(output,function_mir_start(record));buffer_push(output,44);
                    canonical_mir_append_i64(output,function_mir_length(record));
                    canonical_mir_append_text(output,"],\"symbol\":\"");
                    let symbol_status:i32=canonical_mir_append_symbol(output,function_mir_symbol_code(record));
                    if(symbol_status!=0){return 31;}
                    buffer_push(output,34);
                }else{
                    if(kind==function_mir_kind_call()){
                        canonical_mir_append_text(output,",\"kind\":\"call\",\"numeric_policy\":\"none\",\"operands\":[");
                        var argument_ordinal:i64=0;
                        var argument_index:i64=1;
                        while(argument_index<vec_len<MirFunctionRecord>(records)){
                            let argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,argument_index);
                            if(function_mir_kind(argument)==function_mir_kind_call_argument()){
                                if(function_mir_id(argument)==function_mir_id(record)){
                                    if(function_mir_ordinal(argument)!=argument_ordinal){return 32;}
                                    if(argument_ordinal>0){buffer_push(output,44);}
                                    canonical_mir_append_i64(output,function_mir_left(argument));
                                    argument_ordinal=checked_add(argument_ordinal,1);
                                }
                            }
                            argument_index=checked_add(argument_index,1);
                        }
                        canonical_mir_append_text(output,"],\"ownership\":\"none\"");
                        if(function_mir_result(record)>=0){
                            canonical_mir_append_text(output,",\"result\":");
                            canonical_mir_append_i64(output,function_mir_result(record));
                        }
                        canonical_mir_append_text(output,",\"span\":[");
                        canonical_mir_append_i64(output,function_mir_start(record));buffer_push(output,44);
                        canonical_mir_append_i64(output,function_mir_length(record));
                        canonical_mir_append_text(output,"],\"symbol\":");
                        let callee_status:i32=canonical_mir_append_json_source(
                            output,source,function_mir_symbol_start(record),function_mir_symbol_length(record)
                        );
                        if(callee_status!=0){return checked_add(33,callee_status);}
                    }else{
                    if(kind==function_mir_kind_print()){
                        canonical_mir_append_text(output,",\"kind\":\"print\",\"numeric_policy\":\"none\",\"operands\":[");
                        canonical_mir_append_i64(output,function_mir_left(record));
                        canonical_mir_append_text(output,"],\"ownership\":\"none\",\"span\":[");
                        canonical_mir_append_i64(output,function_mir_start(record));buffer_push(output,44);
                        canonical_mir_append_i64(output,function_mir_length(record));buffer_push(output,93);
                    }else{
                    canonical_mir_append_text(output,",\"kind\":\"copy\",\"numeric_policy\":\"none\",\"operands\":[");
                    canonical_mir_append_i64(output,function_mir_left(record));
                    canonical_mir_append_text(output,"],\"ownership\":\"none\",\"result\":");
                    canonical_mir_append_i64(output,function_mir_result(record));
                    canonical_mir_append_text(output,",\"span\":[");
                    canonical_mir_append_i64(output,function_mir_start(record));buffer_push(output,44);
                    canonical_mir_append_i64(output,function_mir_length(record));buffer_push(output,93);
                    }
                    }
                }
            }
            buffer_push(output,125);
            instruction_count=checked_add(instruction_count,1);
        }
        index=checked_add(index,1);
    }
    canonical_mir_append_text(output,"],\"terminator\":{\"kind\":\"return\",\"operands\":[");
    let tail:MirFunctionRecord=vec_get<MirFunctionRecord>(records,checked_sub(vec_len<MirFunctionRecord>(records),1));
    if(function_mir_kind(tail)!=function_mir_kind_return()){return 40;}
    if(function_mir_left(tail)>=0){canonical_mir_append_i64(output,function_mir_left(tail));}
    canonical_mir_append_text(output,"],\"span\":[");
    canonical_mir_append_i64(output,function_mir_start(tail));buffer_push(output,44);
    canonical_mir_append_i64(output,function_mir_length(tail));
    canonical_mir_append_text(output,"],\"targets\":[]}}]");
    if(function_mir_symbol_code(header)!=function_mir_mode_value()){
        canonical_mir_append_text(output,",\"borrowed_origin\":");
        canonical_mir_append_i64(output,function_mir_left(header));
    }
    canonical_mir_append_text(output,",\"capabilities\":[],\"entry_block\":0");
    if(function_mir_mutable(header)!=0){canonical_mir_append_text(output,",\"exported\":true");}
    canonical_mir_append_text(output,",\"locals\":[");

    index=1;
    var local_count:i64=0;
    while(index<vec_len<MirFunctionRecord>(records)){
        let local:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        let local_kind:i32=function_mir_kind(local);
        var is_source_local:i32=0;
        if(local_kind==function_mir_kind_source_local()){is_source_local=1;}
        if(local_kind==function_mir_kind_parameter()){is_source_local=1;}
        if(is_source_local!=0){
            if(local_count>0){buffer_push(output,44);}
            canonical_mir_append_text(output,"{\"id\":");canonical_mir_append_i64(output,function_mir_id(local));
            canonical_mir_append_text(output,",\"mutable\":");
            if(function_mir_mutable(local)==0){canonical_mir_append_text(output,"false");}else{canonical_mir_append_text(output,"true");}
            canonical_mir_append_text(output,",\"name\":");
            let name_status:i32=canonical_mir_append_json_source(output,source,function_mir_symbol_start(local),function_mir_symbol_length(local));
            if(name_status!=0){return checked_add(50,name_status);}
            canonical_mir_append_text(output,",\"ownership\":\"");
            if(local_kind==function_mir_kind_parameter()){
                if(canonical_mir_append_mode(output,function_mir_symbol_code(local))!=0){return 52;}
            }else{
                var binding_matches:i64=0;
                var binding_owned:i32=0;
                var binding_index:i64=0;
                while(binding_index<vec_len<MirOwnershipBinding>(ownership_bindings)){
                    let binding:MirOwnershipBinding=vec_get<MirOwnershipBinding>(ownership_bindings,binding_index);
                    if(ownership_binding_id(binding)==function_mir_binding_id(local)){
                        if(ownership_binding_local_id(binding)!=function_mir_id(local)){return 55;}
                        if(ownership_binding_owned(binding)<0){return 56;}
                        if(ownership_binding_owned(binding)>1){return 56;}
                        if(ownership_binding_mutable(binding)!=function_mir_mutable(local)){return 57;}
                        binding_owned=ownership_binding_owned(binding);
                        binding_matches=checked_add(binding_matches,1);
                    }
                    binding_index=checked_add(binding_index,1);
                }
                if(vec_len<MirOwnershipBinding>(ownership_bindings)>0){
                    if(binding_matches!=1){return 58;}
                }
                if(binding_owned==0){canonical_mir_append_text(output,"value");}
                else{canonical_mir_append_text(output,"owned");}
            }
            canonical_mir_append_text(output,"\",\"source_binding_id\":");
            canonical_mir_append_i64(output,function_mir_binding_id(local));
            canonical_mir_append_text(output,",\"type\":");
            if(canonical_mir_append_type(output,function_mir_type_code(local))!=0){return 53;}
            buffer_push(output,125);local_count=checked_add(local_count,1);
        }
        if(local_kind==function_mir_kind_temporary_local()){
            if(local_count>0){buffer_push(output,44);}
            canonical_mir_append_text(output,"{\"id\":");canonical_mir_append_i64(output,function_mir_id(local));
            canonical_mir_append_text(output,",\"mutable\":");
            if(function_mir_numeric_policy(local)==function_mir_mode_mutable_borrow()){
                canonical_mir_append_text(output,"true");
            }else{canonical_mir_append_text(output,"false");}
            canonical_mir_append_text(output,",\"name\":\"_t");
            canonical_mir_append_i64(output,function_mir_hir_node_id(local));
            canonical_mir_append_text(output,"\",\"ownership\":\"");
            if(canonical_mir_append_mode(output,function_mir_numeric_policy(local))!=0){return 54;}
            canonical_mir_append_text(output,"\",\"type\":");
            if(canonical_mir_append_type(output,function_mir_type_code(local))!=0){return 54;}
            buffer_push(output,125);local_count=checked_add(local_count,1);
        }
        index=checked_add(index,1);
    }
    canonical_mir_append_text(output,"],\"name\":");
    let function_name_status:i32=canonical_mir_append_json_source(output,source,function_mir_symbol_start(header),function_mir_symbol_length(header));
    if(function_name_status!=0){return checked_add(60,function_name_status);}
    if(function_mir_ordinal(header)>0){
        canonical_mir_append_text(output,",\"parameters\":[");
        var parameter_ordinal:i64=0;
        while(parameter_ordinal<function_mir_ordinal(header)){
            var parameter_index:i64=1;
            var parameter_found:i32=0;
            while(parameter_index<vec_len<MirFunctionRecord>(records)){
                let parameter:MirFunctionRecord=vec_get<MirFunctionRecord>(records,parameter_index);
                if(function_mir_kind(parameter)==function_mir_kind_parameter()){
                    if(function_mir_ordinal(parameter)==parameter_ordinal){
                        if(parameter_found!=0){return 65;}
                        parameter_found=1;
                        if(parameter_ordinal>0){buffer_push(output,44);}
                        canonical_mir_append_text(output,"{\"local\":");
                        canonical_mir_append_i64(output,function_mir_id(parameter));
                        canonical_mir_append_text(output,",\"mode\":\"");
                        if(canonical_mir_append_mode(output,function_mir_symbol_code(parameter))!=0){return 66;}
                        canonical_mir_append_text(output,"\"}");
                    }
                }
                parameter_index=checked_add(parameter_index,1);
            }
            if(parameter_found==0){return 67;}
            parameter_ordinal=checked_add(parameter_ordinal,1);
        }
        buffer_push(output,93);
    }
    if(function_mir_symbol_code(header)!=function_mir_mode_value()){
        canonical_mir_append_text(output,",\"return_mode\":\"");
        if(canonical_mir_append_mode(output,function_mir_symbol_code(header))!=0){return 68;}
        buffer_push(output,34);
    }
    canonical_mir_append_text(output,",\"return_type\":");
    if(canonical_mir_append_type(output,function_mir_type_code(header))!=0){return 63;}
    canonical_mir_append_text(output,"}],\"name\":");
    if(canonical_mir_append_json_string(output,module_name)!=0){return 64;}
    canonical_mir_append_text(output,",\"schema\":\"bootstrap-mir-v1\"}");
    return 0;
}

pub fn materialize_straight_line_canonical_mir(
    borrow source:Buffer,module_name:String,borrow records:Vec<MirFunctionRecord>,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    var ownership_bindings:Vec<MirOwnershipBinding>=vec_new<MirOwnershipBinding>(allocator,0);
    let status:i32=materialize_bound_straight_line_canonical_mir(
        source,module_name,records,ownership_bindings,output
    );
    drop(ownership_bindings);
    return status;
}

fn canonical_mir_cfg_block_exists(borrow cfg:Vec<MirCfgRecord>,block_id:i64)->i32 {
    var index:i64=0;
    while(index<vec_len<MirCfgRecord>(cfg)){
        let record:MirCfgRecord=vec_get<MirCfgRecord>(cfg,index);
        if(cfg_kind(record)==cfg_block_kind()){
            if(cfg_block_id(record)==block_id){return 1;}
        }
        index=checked_add(index,1);
    }
    return 0;
}

fn canonical_mir_cfg_mark_reachable(
    borrow cfg:Vec<MirCfgRecord>,block_id:i64,borrow_mut reachable:Vec<i64>
)->i32
requires_caps [allocate]
{
    if(canonical_mir_cfg_block_exists(cfg,block_id)==0){return 0;}
    var index:i64=0;
    while(index<vec_len<i64>(reachable)){
        if(vec_get<i64>(reachable,index)==block_id){return 0;}
        index=checked_add(index,1);
    }
    vec_push<i64>(reachable,block_id);
    return 0;
}

// Match the established MIR assembler's reachable-block selection while
// leaving malformed target diagnostics to the terminator validator.
fn canonical_mir_cfg_collect_reachable(
    borrow cfg:Vec<MirCfgRecord>,borrow_mut reachable:Vec<i64>
)->i32
requires_caps [allocate]
{
    if(canonical_mir_cfg_block_exists(cfg,0)==0){return 1;}
    vec_push<i64>(reachable,0);
    var current:i64=0;
    while(current<vec_len<i64>(reachable)){
        let block_id:i64=vec_get<i64>(reachable,current);
        var index:i64=0;
        while(index<vec_len<MirCfgRecord>(cfg)){
            let record:MirCfgRecord=vec_get<MirCfgRecord>(cfg,index);
            if(cfg_block_id(record)==block_id){
                let kind:i32=cfg_kind(record);
                if(kind==cfg_jump_kind()){
                    canonical_mir_cfg_mark_reachable(cfg,cfg_target_a(record),reachable);
                }
                if(kind==cfg_branch_kind()){
                    canonical_mir_cfg_mark_reachable(cfg,cfg_target_a(record),reachable);
                    canonical_mir_cfg_mark_reachable(cfg,cfg_target_b(record),reachable);
                }
                if(kind==cfg_switch_case_kind()){
                    canonical_mir_cfg_mark_reachable(cfg,cfg_target_a(record),reachable);
                }
                if(kind==cfg_switch_default_kind()){
                    canonical_mir_cfg_mark_reachable(cfg,cfg_target_a(record),reachable);
                }
            }
            index=checked_add(index,1);
        }
        current=checked_add(current,1);
    }
    return 0;
}

fn canonical_mir_cfg_validate_terminator(
    borrow cfg:Vec<MirCfgRecord>,block_id:i64
)->i32
{
    var direct_count:i32=0;
    var switch_count:i64=0;
    var switch_default_count:i32=0;
    var switch_default_ordinal:i64=-1;
    var switch_operand:i64=-1;
    var index:i64=0;
    while(index<vec_len<MirCfgRecord>(cfg)){
        let record:MirCfgRecord=vec_get<MirCfgRecord>(cfg,index);
        if(cfg_block_id(record)==block_id){
            let kind:i32=cfg_kind(record);
            if(kind==cfg_jump_kind()){
                direct_count=checked_add(direct_count,1);
                if(canonical_mir_cfg_block_exists(cfg,cfg_target_a(record))==0){return 2;}
            }
            if(kind==cfg_branch_kind()){
                direct_count=checked_add(direct_count,1);
                if(cfg_operand(record)<0){return 4;}
                if(canonical_mir_cfg_block_exists(cfg,cfg_target_a(record))==0){return 2;}
                if(canonical_mir_cfg_block_exists(cfg,cfg_target_b(record))==0){return 2;}
            }
            if(kind==cfg_return_kind()){direct_count=checked_add(direct_count,1);}
            if(kind==cfg_unreachable_kind()){direct_count=checked_add(direct_count,1);}
            if(kind==cfg_switch_case_kind()){
                if(cfg_ordinal(record)!=switch_count){return 5;}
                if(cfg_operand(record)<0){return 5;}
                if(switch_count==0){switch_operand=cfg_operand(record);}
                else{if(cfg_operand(record)!=switch_operand){return 5;}}
                if(switch_default_count!=0){return 5;}
                if(canonical_mir_cfg_block_exists(cfg,cfg_target_a(record))==0){return 2;}
                switch_count=checked_add(switch_count,1);
            }
            if(kind==cfg_switch_default_kind()){
                if(cfg_ordinal(record)!=switch_count){return 5;}
                if(cfg_operand(record)<0){return 5;}
                if(switch_count==0){switch_operand=cfg_operand(record);}
                else{if(cfg_operand(record)!=switch_operand){return 5;}}
                if(canonical_mir_cfg_block_exists(cfg,cfg_target_a(record))==0){return 2;}
                switch_default_count=checked_add(switch_default_count,1);
                switch_default_ordinal=cfg_ordinal(record);
                switch_count=checked_add(switch_count,1);
            }
        }
        index=checked_add(index,1);
    }
    if(direct_count>1){return 1;}
    if(switch_count>0){
        if(direct_count!=0){return 1;}
        if(switch_default_count!=1){return 5;}
        if(switch_default_ordinal!=checked_sub(switch_count,1)){return 5;}
        return 0;
    }
    if(direct_count==0){return 6;}
    return 0;
}

fn canonical_mir_append_empty_cfg_terminator(
    borrow cfg:Vec<MirCfgRecord>,block_id:i64,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    let validation_status:i32=canonical_mir_cfg_validate_terminator(cfg,block_id);
    if(validation_status!=0){return validation_status;}
    var index:i64=0;
    var found:i32=0;
    while(index<vec_len<MirCfgRecord>(cfg)){
        let record:MirCfgRecord=vec_get<MirCfgRecord>(cfg,index);
        if(cfg_block_id(record)==block_id){
            let kind:i32=cfg_kind(record);
            if(kind==cfg_jump_kind()){
                if(found!=0){return 1;}
                if(canonical_mir_cfg_block_exists(cfg,cfg_target_a(record))==0){return 2;}
                canonical_mir_append_text(output,"{\"kind\":\"jump\",\"operands\":[],\"targets\":[");
                canonical_mir_append_i64(output,cfg_target_a(record));canonical_mir_append_text(output,"]}");
                found=1;
            }
            if(kind==cfg_return_kind()){
                if(found!=0){return 1;}
                canonical_mir_append_text(output,"{\"kind\":\"return\",\"operands\":[");
                if(cfg_operand(record)>=0){canonical_mir_append_i64(output,cfg_operand(record));}
                canonical_mir_append_text(output,"],\"targets\":[]}");
                found=1;
            }
            if(kind==cfg_unreachable_kind()){
                if(found!=0){return 1;}
                canonical_mir_append_text(output,"{\"kind\":\"unreachable\",\"operands\":[],\"targets\":[]}");
                found=1;
            }
            if(kind==cfg_branch_kind()){
                if(found!=0){return 1;}
                if(cfg_operand(record)<0){return 4;}
                if(canonical_mir_cfg_block_exists(cfg,cfg_target_a(record))==0){return 2;}
                if(canonical_mir_cfg_block_exists(cfg,cfg_target_b(record))==0){return 2;}
                canonical_mir_append_text(output,"{\"kind\":\"branch\",\"operands\":[");
                canonical_mir_append_i64(output,cfg_operand(record));
                canonical_mir_append_text(output,"],\"targets\":[");
                canonical_mir_append_i64(output,cfg_target_a(record));buffer_push(output,44);
                canonical_mir_append_i64(output,cfg_target_b(record));canonical_mir_append_text(output,"]}");
                found=1;
            }
            var is_switch:i32=0;
            if(kind==cfg_switch_case_kind()){is_switch=1;}
            if(kind==cfg_switch_default_kind()){is_switch=1;}
            if(is_switch!=0){
                if(cfg_ordinal(record)==0){
                    if(found!=0){return 1;}
                    if(cfg_operand(record)<0){return 5;}
                    var switch_index:i64=0;
                    var switch_ordinal:i64=0;
                    var default_count:i64=0;
                    var default_ordinal:i64=-1;
                    while(switch_index<vec_len<MirCfgRecord>(cfg)){
                        let item:MirCfgRecord=vec_get<MirCfgRecord>(cfg,switch_index);
                        if(cfg_block_id(item)==block_id){
                            let item_kind:i32=cfg_kind(item);
                            var is_switch_item:i32=0;
                            if(item_kind==cfg_switch_case_kind()){is_switch_item=1;}
                            if(item_kind==cfg_switch_default_kind()){is_switch_item=1;}
                            if(is_switch_item!=0){
                                if(cfg_ordinal(item)!=switch_ordinal){return 5;}
                                if(cfg_operand(item)!=cfg_operand(record)){return 5;}
                                if(canonical_mir_cfg_block_exists(cfg,cfg_target_a(item))==0){return 2;}
                                if(item_kind==cfg_switch_default_kind()){
                                    default_count=checked_add(default_count,1);
                                    default_ordinal=cfg_ordinal(item);
                                }
                                switch_ordinal=checked_add(switch_ordinal,1);
                            }
                        }
                        switch_index=checked_add(switch_index,1);
                    }
                    if(default_count!=1){return 5;}
                    if(default_ordinal!=checked_sub(switch_ordinal,1)){return 5;}
                    canonical_mir_append_text(output,"{\"cases\":[");
                    switch_index=0;
                    var case_count:i64=0;
                    while(switch_index<vec_len<MirCfgRecord>(cfg)){
                        let item:MirCfgRecord=vec_get<MirCfgRecord>(cfg,switch_index);
                        if(cfg_block_id(item)==block_id){
                            if(cfg_kind(item)==cfg_switch_case_kind()){
                                if(case_count>0){buffer_push(output,44);}
                                canonical_mir_append_i64(output,cfg_case_value(item));
                                case_count=checked_add(case_count,1);
                            }
                        }
                        switch_index=checked_add(switch_index,1);
                    }
                    canonical_mir_append_text(output,"],\"kind\":\"switch\",\"operands\":[");
                    canonical_mir_append_i64(output,cfg_operand(record));
                    canonical_mir_append_text(output,"],\"targets\":[");
                    switch_index=0;
                    var target_count:i64=0;
                    var default_target:i64=0;
                    while(switch_index<vec_len<MirCfgRecord>(cfg)){
                        let item:MirCfgRecord=vec_get<MirCfgRecord>(cfg,switch_index);
                        if(cfg_block_id(item)==block_id){
                            if(cfg_kind(item)==cfg_switch_case_kind()){
                                if(target_count>0){buffer_push(output,44);}
                                canonical_mir_append_i64(output,cfg_target_a(item));
                                target_count=checked_add(target_count,1);
                            }
                            if(cfg_kind(item)==cfg_switch_default_kind()){default_target=cfg_target_a(item);}
                        }
                        switch_index=checked_add(switch_index,1);
                    }
                    if(target_count>0){buffer_push(output,44);}
                    canonical_mir_append_i64(output,default_target);
                    canonical_mir_append_text(output,"]}");
                    found=1;
                }
            }
        }
        index=checked_add(index,1);
    }
    if(found==0){return 6;}
    return 0;
}

fn materialize_canonical_contract_instruction_with_catalog(
    borrow source:Buffer,borrow record:MirFunctionContractRecord,
    borrow source_record:MirFunctionInstructionSource,
    borrow numeric_type_descriptors:Vec<MirNumericTypeDescriptor>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(function_contract_id(record)!=assembly_source_id(source_record)){return 2;}
    if(function_contract_contract_kind(record)!=assembly_source_contract_kind(source_record)){return 3;}
    if(function_contract_clause(record)!=assembly_source_clause(source_record)){return 4;}
    let phase:i32=function_contract_contract_kind(record);
    if(phase!=function_contract_precondition_phase()){
        if(phase!=function_contract_postcondition_phase()){
            if(phase!=function_contract_entry_snapshot_phase()){return 6;}
        }
    }
    let kind:i32=function_contract_kind(record);
    var has_contract_kind:i32=0;
    if(kind==function_contract_const_kind()){has_contract_kind=1;}
    if(kind==function_contract_check_kind()){has_contract_kind=1;}
    canonical_mir_append_text(output,"{\"contract_kind\":\"");
    if(has_contract_kind==0){canonical_mir_append_text(output,"none");}
    else{if(phase==function_contract_precondition_phase()){
        canonical_mir_append_text(output,"precondition");
    }else{canonical_mir_append_text(output,"postcondition");}}
    canonical_mir_append_text(output,"\",\"conversion_policy\":\"none\",\"id\":");
    canonical_mir_append_i64(output,assembly_source_global_id(source_record));
    canonical_mir_append_text(output,",\"kind\":\"");
    if(kind==function_contract_const_kind()){canonical_mir_append_text(output,"const");}
    else{if(kind==function_contract_binary_kind()){canonical_mir_append_text(output,"binary");}
    else{if(kind==function_contract_check_kind()){canonical_mir_append_text(output,"contract_check");}
    else{if(kind==function_contract_call_kind()){canonical_mir_append_text(output,"call");}
    else{if(kind==function_contract_field_load_kind()){canonical_mir_append_text(output,"load_field");}
    else{if(kind==function_contract_result_capture_kind()){canonical_mir_append_text(output,"copy");}
    else{if(kind==function_contract_old_snapshot_kind()){canonical_mir_append_text(output,"copy");}
    else{return 1;}}}}}}}
    canonical_mir_append_text(output,"\",\"numeric_policy\":\"");
    if(kind==function_contract_binary_kind()){
        if(function_contract_policy(record)==function_mir_exact_numeric_policy()){canonical_mir_append_text(output,"exact");}
        else{if(function_contract_policy(record)==function_mir_checked_numeric_policy()){canonical_mir_append_text(output,"checked");}else{return 7;}}
    }else{canonical_mir_append_text(output,"none");}
    canonical_mir_append_text(output,"\",\"operands\":[");
    if(kind==function_contract_binary_kind()){
        if(assembly_source_left(source_record)<0){return 8;}if(assembly_source_right(source_record)<0){return 8;}
        canonical_mir_append_i64(output,assembly_source_left(source_record));buffer_push(output,44);
        canonical_mir_append_i64(output,assembly_source_right(source_record));
    }else{
        if(kind!=function_contract_const_kind()){
            if(assembly_source_left(source_record)<0){return 9;}
            canonical_mir_append_i64(output,assembly_source_left(source_record));
        }
    }
    canonical_mir_append_text(output,"],\"ownership\":\"");
    if(kind==function_contract_const_kind()){canonical_mir_append_text(output,"value");}
    else{canonical_mir_append_text(output,"none");}
    buffer_push(output,34);
    if(kind!=function_contract_check_kind()){
        if(assembly_source_result(source_record)<0){return 5;}
        canonical_mir_append_text(output,",\"result\":");
        canonical_mir_append_i64(output,assembly_source_result(source_record));
    }
    canonical_mir_append_text(output,",\"span\":[");
    canonical_mir_append_i64(output,function_contract_start(record));buffer_push(output,44);
    canonical_mir_append_i64(output,function_contract_length(record));
    buffer_push(output,93);
    if(kind==function_contract_binary_kind()){
        canonical_mir_append_text(output,",\"symbol\":\"");
        if(canonical_mir_append_symbol(output,function_contract_symbol(record))!=0){return 10;}
        buffer_push(output,34);
    }
    if(kind==function_contract_call_kind()){
        if(function_contract_symbol(record)!=13){return 11;}
        canonical_mir_append_text(output,",\"symbol\":\"slice_len\"");
    }
    if(kind==function_contract_field_load_kind()){
        if(function_contract_symbol(record)<0){return 12;}
        canonical_mir_append_text(output,",\"symbol\":\"field_");
        canonical_mir_append_i32(output,function_contract_symbol(record));buffer_push(output,34);
    }
    if(kind==function_contract_const_kind()){
        canonical_mir_append_text(output,",\"value\":");
        let value_status:i32=canonical_mir_append_typed_const_source_with_catalog(
            output,source,function_contract_start(record),function_contract_length(record),
            function_contract_type(record),numeric_type_descriptors,0
        );
        if(value_status!=0){return checked_add(20,value_status);}
    }
    buffer_push(output,125);
    return 0;
}

pub fn materialize_canonical_contract_instruction(
    borrow source:Buffer,borrow record:MirFunctionContractRecord,
    borrow source_record:MirFunctionInstructionSource,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    var empty:Vec<MirNumericTypeDescriptor>=vec_new<MirNumericTypeDescriptor>(allocator,0);
    let status:i32=materialize_canonical_contract_instruction_with_catalog(
        source,record,source_record,empty,output
    );
    drop(empty);
    return status;
}

fn canonical_mir_append_composite_body_tail(
    borrow record:MirFunctionRecord,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    let kind:i32=function_mir_kind(record);
    if(function_mir_result(record)<0){return 1;}
    var output_kind:i32=0;
    if(kind==function_mir_kind_enum_construct()){output_kind=1;}
    if(kind==function_mir_kind_enum_tag_load()){output_kind=2;}
    if(kind==function_mir_kind_enum_payload_load()){output_kind=3;}
    if(kind==function_mir_kind_struct_construct()){output_kind=4;}
    if(kind==function_mir_kind_struct_field_load()){output_kind=5;}
    if(kind==function_mir_kind_struct_field_store()){output_kind=6;}
    if(output_kind==0){return 2;}
    var enum_as_const:i32=0;
    if(output_kind==1){
        if(function_mir_symbol_code(record)<0){return 3;}
        if(function_mir_type_code(record)==function_mir_i64_type_code()){
            if(function_mir_left(record)!=function_mir_absent_record_value()){return 3;}
            enum_as_const=1;
        }else{
            if(function_mir_type_code(record)<function_mir_copy_payload_enum_type_code(0)){return 3;}
            if(function_mir_left(record)<function_mir_absent_record_value()){return 3;}
        }
    }else{if(function_mir_left(record)<0){return 4;}}
    if(output_kind>=4){
        if(function_mir_symbol_code(record)<0){return 5;}
    }
    canonical_mir_append_text(output,",\"kind\":\"");
    if(enum_as_const!=0){canonical_mir_append_text(output,"const");}
    else{if(output_kind==1){canonical_mir_append_text(output,"construct");}
    else{if(output_kind==4){canonical_mir_append_text(output,"construct");}
    else{if(output_kind==6){canonical_mir_append_text(output,"store_field");}
    else{canonical_mir_append_text(output,"load_field");}}}}
    canonical_mir_append_text(output,"\",\"numeric_policy\":\"none\",\"operands\":[");
    if(enum_as_const==0){
        if(output_kind==1){
            if(function_mir_left(record)>=0){canonical_mir_append_i64(output,function_mir_left(record));}
        }else{canonical_mir_append_i64(output,function_mir_left(record));}
    }
    canonical_mir_append_text(output,"],\"ownership\":\"");
    if(enum_as_const!=0){canonical_mir_append_text(output,"value");}
    else{if(output_kind==1){
        if(function_mir_type_code(record)>=function_mir_owned_payload_enum_type_code(0,0)){canonical_mir_append_text(output,"owned");}
        else{canonical_mir_append_text(output,"value");}
    }else{if(output_kind==4){canonical_mir_append_text(output,"owned");}
    else{if(output_kind==6){
        if(function_mir_numeric_policy(record)==function_mir_field_store_replace_policy()){canonical_mir_append_text(output,"moved");}
        else{if(function_mir_numeric_policy(record)==function_mir_field_store_initialize_policy()){canonical_mir_append_text(output,"owned");}else{return 6;}}
    }else{canonical_mir_append_text(output,"none");}}}}
    canonical_mir_append_text(output,"\",\"result\":");
    canonical_mir_append_i64(output,function_mir_result(record));
    canonical_mir_append_text(output,",\"span\":[");
    canonical_mir_append_i64(output,function_mir_start(record));buffer_push(output,44);
    canonical_mir_append_i64(output,function_mir_length(record));buffer_push(output,93);
    if(enum_as_const!=0){
        canonical_mir_append_text(output,",\"value\":");
        canonical_mir_append_i32(output,function_mir_symbol_code(record));
    }else{
        canonical_mir_append_text(output,",\"symbol\":\"");
        if(output_kind==2){canonical_mir_append_text(output,"tag");}
        else{if(output_kind==3){
            canonical_mir_append_text(output,"payload");
            if(function_mir_right(record)>=0){buffer_push(output,95);canonical_mir_append_i64(output,function_mir_right(record));}
        }else{
            if(output_kind==1){canonical_mir_append_text(output,"variant_");}
            else{canonical_mir_append_text(output,"field_");}
            canonical_mir_append_i32(output,function_mir_symbol_code(record));
        }}
        buffer_push(output,34);
    }
    return 0;
}

fn canonical_mir_is_body_instruction(kind:i32)->i32{
    if(kind==function_mir_kind_const()){return 1;}
    if(kind==function_mir_kind_binary()){return 1;}
    if(kind==function_mir_kind_copy_to_binding()){return 1;}
    if(kind==function_mir_kind_print()){return 1;}
    if(kind==function_mir_kind_call()){return 1;}
    if(kind==function_mir_kind_enum_construct()){return 1;}
    if(kind==function_mir_kind_enum_tag_load()){return 1;}
    if(kind==function_mir_kind_enum_payload_load()){return 1;}
    if(kind==function_mir_kind_struct_construct()){return 1;}
    if(kind==function_mir_kind_struct_field_load()){return 1;}
    if(kind==function_mir_kind_struct_field_store()){return 1;}
    return 0;
}

// Bounded CFG slice: materialize explicit block topology plus sourced body,
// contract, and ownership instructions. Every emitted instruction must have
// one explicit placement; later SH3 slices widen the accepted catalogs.
fn materialize_sourced_cfg_canonical_mir_ordered(
    borrow source:Buffer,module_name:String,borrow records:Vec<MirFunctionRecord>,
    borrow contracts:Vec<MirFunctionContractRecord>,
    borrow contract_locals:Vec<MirFunctionContractLocal>,
    borrow ownership_bindings:Vec<MirOwnershipBinding>,
    borrow ownership_records:Vec<MirOwnershipRecord>,
    borrow sources:Vec<MirFunctionInstructionSource>,
    borrow cfg:Vec<MirCfgRecord>,borrow placements:Vec<MirPlacementRecord>,
    borrow required:Vec<i64>,borrow capability_catalog:Vec<CapabilityCatalogEntry>,
    borrow type_descriptors:Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors:Vec<MirNumericTypeDescriptor>,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    // The native C backend uses one epilogue for all early returns. Initialize
    // owned scratch before validation can jump through that epilogue.
    let allocator:Allocator=system_allocator();
    var reachable:Vec<i64>=vec_new<i64>(allocator,vec_len<MirCfgRecord>(cfg));
    if(validate_function_mir_records(records)!=0){return 1;}
    let record_count:i64=vec_len<MirFunctionRecord>(records);
    if(record_count<2){return 2;}
    let sourced:i32=vec_len<MirFunctionInstructionSource>(sources)>0;
    if(sourced==0){if(record_count!=2){if(record_count!=4){return 2;}}}
    let header:MirFunctionRecord=vec_get<MirFunctionRecord>(records,0);
    let tail:MirFunctionRecord=vec_get<MirFunctionRecord>(records,checked_sub(record_count,1));
    if(function_mir_kind(header)!=function_mir_kind_function()){return 4;}
    if(function_mir_kind(tail)!=function_mir_kind_return()){return 5;}
    if(sourced!=0){
        if(validate_function_assembly_sources(sources)!=0){return 36;}
        if(vec_len<MirFunctionContractRecord>(contracts)>0){
            if(validate_function_contract_mir(contracts)!=0){return 35;}
        }
        if(vec_len<MirPlacementRecord>(placements)!=vec_len<MirFunctionInstructionSource>(sources)){return 37;}
        var source_index:i64=0;
        while(source_index<vec_len<MirFunctionInstructionSource>(sources)){
            let source_record:MirFunctionInstructionSource=vec_get<MirFunctionInstructionSource>(sources,source_index);
            var source_placement_count:i64=0;
            var source_placement_index:i64=0;
            while(source_placement_index<vec_len<MirPlacementRecord>(placements)){
                let source_placement:MirPlacementRecord=vec_get<MirPlacementRecord>(placements,source_placement_index);
                if(placement_instruction_id(source_placement)==assembly_source_global_id(source_record)){
                    source_placement_count=checked_add(source_placement_count,1);
                }
                source_placement_index=checked_add(source_placement_index,1);
            }
            if(source_placement_count!=1){return 38;}
            source_index=checked_add(source_index,1);
        }
    }
    if(record_count==2){if(sourced==0){if(vec_len<MirPlacementRecord>(placements)!=0){return 3;}}}
    if(sourced==0){
        if(record_count==4){if(vec_len<MirPlacementRecord>(placements)!=1){return 3;}}
        if(record_count==4){
        let local:MirFunctionRecord=vec_get<MirFunctionRecord>(records,1);
        let instruction:MirFunctionRecord=vec_get<MirFunctionRecord>(records,2);
        let local_kind:i32=function_mir_kind(local);
        if(local_kind!=function_mir_kind_temporary_local()){
            if(local_kind!=function_mir_kind_source_local()){return 8;}
        }
        let instruction_kind:i32=function_mir_kind(instruction);
        if(canonical_mir_is_body_instruction(instruction_kind)==0){return 9;}
        if(sourced==0){if(instruction_kind!=function_mir_kind_const()){return 9;}}
        }
    }
    var binding_validation_index:i64=0;
    while(binding_validation_index<vec_len<MirOwnershipBinding>(ownership_bindings)){
        let binding:MirOwnershipBinding=vec_get<MirOwnershipBinding>(ownership_bindings,binding_validation_index);
        if(ownership_binding_id(binding)<0){return 61;}
        if(ownership_binding_owned(binding)<0){return 63;}if(ownership_binding_owned(binding)>1){return 63;}
        if(ownership_binding_mutable(binding)<0){return 64;}if(ownership_binding_mutable(binding)>1){return 64;}
        if(ownership_binding_needs_drop(binding)<0){return 65;}
        if(ownership_binding_needs_drop(binding)>ownership_binding_owned(binding)){return 65;}
        var binding_local_matches:i64=0;var binding_record_index:i64=1;
        while(binding_record_index<checked_sub(record_count,1)){
            let binding_local:MirFunctionRecord=vec_get<MirFunctionRecord>(records,binding_record_index);
            if(function_mir_kind(binding_local)==function_mir_kind_source_local()){
                if(function_mir_binding_id(binding_local)==ownership_binding_id(binding)){
                    if(function_mir_id(binding_local)!=ownership_binding_local_id(binding)){return 62;}
                    if(function_mir_mutable(binding_local)!=ownership_binding_mutable(binding)){return 64;}
                    binding_local_matches=checked_add(binding_local_matches,1);
                }
            }
            if(function_mir_kind(binding_local)==function_mir_kind_parameter()){
                if(function_mir_binding_id(binding_local)==ownership_binding_id(binding)){
                    if(function_mir_id(binding_local)!=ownership_binding_local_id(binding)){return 62;}
                    binding_local_matches=checked_add(binding_local_matches,1);
                }
            }
            if(function_mir_kind(binding_local)==function_mir_kind_temporary_local()){
                if(function_mir_id(binding_local)==ownership_binding_local_id(binding)){
                    binding_local_matches=checked_add(binding_local_matches,1);
                }
            }
            binding_record_index=checked_add(binding_record_index,1);
        }
        if(binding_local_matches!=1){return 62;}
        binding_validation_index=checked_add(binding_validation_index,1);
    }

    var cfg_validation_index:i64=0;
    while(cfg_validation_index<vec_len<MirCfgRecord>(cfg)){
        let block:MirCfgRecord=vec_get<MirCfgRecord>(cfg,cfg_validation_index);
        if(cfg_kind(block)==cfg_block_kind()){
            if(cfg_block_id(block)<0){return 6;}
            var prior_block_index:i64=0;
            while(prior_block_index<cfg_validation_index){
                let prior:MirCfgRecord=vec_get<MirCfgRecord>(cfg,prior_block_index);
                if(cfg_kind(prior)==cfg_block_kind()){
                    if(cfg_block_id(prior)==cfg_block_id(block)){return 6;}
                }
                prior_block_index=checked_add(prior_block_index,1);
            }
            let terminator_status:i32=canonical_mir_cfg_validate_terminator(cfg,cfg_block_id(block));
            if(terminator_status!=0){return checked_add(10,terminator_status);}
        }
        cfg_validation_index=checked_add(cfg_validation_index,1);
    }
    if(canonical_mir_cfg_collect_reachable(cfg,reachable)!=0){return 20;}
    canonical_mir_append_text(output,"{\"functions\":[{\"blocks\":[");
    var block_count:i64=0;
    var last_block_id:i64=-1;
    var remaining:i64=vec_len<MirCfgRecord>(cfg);
    while(remaining>0){
        var chosen_index:i64=-1;
        var chosen_id:i64=-1;
        var scan_index:i64=0;
        while(scan_index<vec_len<MirCfgRecord>(cfg)){
            let candidate:MirCfgRecord=vec_get<MirCfgRecord>(cfg,scan_index);
            if(cfg_kind(candidate)==cfg_block_kind()){
                let candidate_id:i64=cfg_block_id(candidate);
                if(candidate_id<0){return 6;}
                if(candidate_id>last_block_id){
                    var reachable_index:i64=0;
                    while(reachable_index<vec_len<i64>(reachable)){
                        if(vec_get<i64>(reachable,reachable_index)==candidate_id){
                            if(chosen_index<0){chosen_index=scan_index;chosen_id=candidate_id;}
                            else{if(candidate_id<chosen_id){chosen_index=scan_index;chosen_id=candidate_id;}}
                        }
                        reachable_index=checked_add(reachable_index,1);
                    }
                }
            }
            scan_index=checked_add(scan_index,1);
        }
        if(chosen_index<0){remaining=0;}
        else{
            let record:MirCfgRecord=vec_get<MirCfgRecord>(cfg,chosen_index);
            scan_index=checked_add(chosen_index,1);
            while(scan_index<vec_len<MirCfgRecord>(cfg)){
                let duplicate:MirCfgRecord=vec_get<MirCfgRecord>(cfg,scan_index);
                if(cfg_kind(duplicate)==cfg_block_kind()){
                    if(cfg_block_id(duplicate)==chosen_id){return 6;}
                }
                scan_index=checked_add(scan_index,1);
            }
            if(block_count>0){buffer_push(output,44);}
            canonical_mir_append_text(output,"{\"id\":");
            canonical_mir_append_i64(output,cfg_block_id(record));
            canonical_mir_append_text(output,",\"instructions\":[");
            var placement_index:i64=0;
            var block_placement_count:i64=0;
            while(placement_index<vec_len<MirPlacementRecord>(placements)){
                let placement:MirPlacementRecord=vec_get<MirPlacementRecord>(placements,placement_index);
                if(placement_block_id(placement)==cfg_block_id(record)){
                    if(placement_ordinal(placement)!=block_placement_count){return 21;}
                    var instruction:MirFunctionRecord=vec_get<MirFunctionRecord>(records,1);
                    if(sourced==0){instruction=vec_get<MirFunctionRecord>(records,2);}
                    if(block_placement_count>0){buffer_push(output,44);}
                    if(sourced==0){
                        if(placement_instruction_id(placement)!=function_mir_id(instruction)){return 22;}
                        canonical_mir_append_text(output,"{\"contract_kind\":\"none\",\"conversion_policy\":\"none\",\"id\":");
                        canonical_mir_append_i64(output,function_mir_id(instruction));
                        canonical_mir_append_text(output,",\"kind\":\"const\",\"numeric_policy\":\"none\",\"operands\":[],\"ownership\":\"value\",\"result\":");
                        canonical_mir_append_i64(output,function_mir_result(instruction));
                        canonical_mir_append_text(output,",\"span\":[");
                        canonical_mir_append_i64(output,function_mir_start(instruction));buffer_push(output,44);
                        canonical_mir_append_i64(output,function_mir_length(instruction));
                        canonical_mir_append_text(output,"],\"value\":");
                        let value_status:i32=canonical_mir_append_typed_const_source_with_catalog(
                            output,source,function_mir_start(instruction),function_mir_length(instruction),
                            function_mir_type_code(instruction),numeric_type_descriptors,1
                        );
                        if(value_status!=0){return checked_add(23,value_status);}
                        buffer_push(output,125);
                    }else{
                        let global_id:i64=placement_instruction_id(placement);
                        if(global_id<0){return 38;}
                        if(global_id>=vec_len<MirFunctionInstructionSource>(sources)){return 38;}
                        let source_record:MirFunctionInstructionSource=vec_get<MirFunctionInstructionSource>(sources,global_id);
                        if(assembly_source_global_id(source_record)!=global_id){return 39;}
                        if(assembly_source_kind(source_record)==assembly_source_body_kind()){
                            if(record_count<3){return 40;}
                            var body_match_count:i64=0;
                            var body_record_index:i64=1;
                            while(body_record_index<checked_sub(record_count,1)){
                                let body_candidate:MirFunctionRecord=vec_get<MirFunctionRecord>(records,body_record_index);
                                if(canonical_mir_is_body_instruction(function_mir_kind(body_candidate))!=0){
                                    if(function_mir_id(body_candidate)==assembly_source_id(source_record)){
                                        instruction=body_candidate;body_match_count=checked_add(body_match_count,1);
                                    }
                                }
                                body_record_index=checked_add(body_record_index,1);
                            }
                            if(body_match_count!=1){return 40;}
                            canonical_mir_append_text(output,"{\"contract_kind\":\"none\",\"conversion_policy\":\"none\",\"id\":");
                            canonical_mir_append_i64(output,global_id);
                            if(function_mir_kind(instruction)==function_mir_kind_const()){
                                canonical_mir_append_text(output,",\"kind\":\"const\",\"numeric_policy\":\"none\",\"operands\":[],\"ownership\":\"value\",\"result\":");
                                canonical_mir_append_i64(output,function_mir_result(instruction));
                                canonical_mir_append_text(output,",\"span\":[");
                                canonical_mir_append_i64(output,function_mir_start(instruction));buffer_push(output,44);
                                canonical_mir_append_i64(output,function_mir_length(instruction));
                                canonical_mir_append_text(output,"],\"value\":");
                                let value_status:i32=canonical_mir_append_typed_const_source_with_catalog(
                                    output,source,function_mir_start(instruction),function_mir_length(instruction),
                                    function_mir_type_code(instruction),numeric_type_descriptors,1
                                );
                                if(value_status!=0){return checked_add(41,value_status);}
                            }else{if(function_mir_kind(instruction)==function_mir_kind_binary()){
                                if(function_mir_left(instruction)<0){return 47;}
                                if(function_mir_right(instruction)<0){return 47;}
                                canonical_mir_append_text(output,",\"kind\":\"binary\",\"numeric_policy\":\"");
                                if(function_mir_numeric_policy(instruction)==function_mir_exact_numeric_policy()){
                                    canonical_mir_append_text(output,"exact");
                                }else{if(function_mir_numeric_policy(instruction)==function_mir_checked_numeric_policy()){
                                    canonical_mir_append_text(output,"checked");
                                }else{return 48;}}
                                canonical_mir_append_text(output,"\",\"operands\":[");
                                canonical_mir_append_i64(output,function_mir_left(instruction));buffer_push(output,44);
                                canonical_mir_append_i64(output,function_mir_right(instruction));
                                canonical_mir_append_text(output,"],\"ownership\":\"none\",\"result\":");
                                canonical_mir_append_i64(output,function_mir_result(instruction));
                                canonical_mir_append_text(output,",\"span\":[");
                                canonical_mir_append_i64(output,function_mir_start(instruction));buffer_push(output,44);
                                canonical_mir_append_i64(output,function_mir_length(instruction));
                                canonical_mir_append_text(output,"],\"symbol\":\"");
                                if(canonical_mir_append_symbol(output,function_mir_symbol_code(instruction))!=0){return 49;}
                                buffer_push(output,34);
                            }else{
                                let body_kind:i32=function_mir_kind(instruction);
                                var is_composite:i32=0;
                                if(body_kind==function_mir_kind_enum_construct()){is_composite=1;}
                                if(body_kind==function_mir_kind_enum_tag_load()){is_composite=1;}
                                if(body_kind==function_mir_kind_enum_payload_load()){is_composite=1;}
                                if(body_kind==function_mir_kind_struct_construct()){is_composite=1;}
                                if(body_kind==function_mir_kind_struct_field_load()){is_composite=1;}
                                if(body_kind==function_mir_kind_struct_field_store()){is_composite=1;}
                                if(is_composite!=0){
                                    let composite_status:i32=canonical_mir_append_composite_body_tail(instruction,output);
                                    if(composite_status!=0){return checked_add(80,composite_status);}
                                }else{if(function_mir_kind(instruction)==function_mir_kind_call()){
                                    canonical_mir_append_text(output,",\"kind\":\"call\",\"numeric_policy\":\"none\",\"operands\":[");
                                    var call_argument_ordinal:i64=0;
                                    var call_argument_index:i64=1;
                                    while(call_argument_index<vec_len<MirFunctionRecord>(records)){
                                        let call_argument:MirFunctionRecord=vec_get<MirFunctionRecord>(records,call_argument_index);
                                        if(function_mir_kind(call_argument)==function_mir_kind_call_argument()){
                                            if(function_mir_id(call_argument)==function_mir_id(instruction)){
                                                if(function_mir_ordinal(call_argument)!=call_argument_ordinal){return 50;}
                                                if(call_argument_ordinal>0){buffer_push(output,44);}
                                                canonical_mir_append_i64(output,function_mir_left(call_argument));
                                                call_argument_ordinal=checked_add(call_argument_ordinal,1);
                                            }
                                        }
                                        call_argument_index=checked_add(call_argument_index,1);
                                    }
                                    canonical_mir_append_text(output,"],\"ownership\":\"none\"");
                                    if(function_mir_result(instruction)>=0){
                                        canonical_mir_append_text(output,",\"result\":");
                                        canonical_mir_append_i64(output,function_mir_result(instruction));
                                    }
                                    canonical_mir_append_text(output,",\"span\":[");
                                    canonical_mir_append_i64(output,function_mir_start(instruction));buffer_push(output,44);
                                    canonical_mir_append_i64(output,function_mir_length(instruction));
                                    canonical_mir_append_text(output,"],\"symbol\":");
                                    let call_symbol_status:i32=canonical_mir_append_json_source(
                                        output,source,function_mir_symbol_start(instruction),function_mir_symbol_length(instruction)
                                    );
                                    if(call_symbol_status!=0){return checked_add(51,call_symbol_status);}
                                }else{
                                if(function_mir_left(instruction)<0){return 47;}
                                if(function_mir_kind(instruction)==function_mir_kind_copy_to_binding()){
                                    if(function_mir_result(instruction)<0){return 47;}
                                    canonical_mir_append_text(output,",\"kind\":\"copy\",\"numeric_policy\":\"none\",\"operands\":[");
                                    canonical_mir_append_i64(output,function_mir_left(instruction));
                                    canonical_mir_append_text(output,"],\"ownership\":\"none\",\"result\":");
                                    canonical_mir_append_i64(output,function_mir_result(instruction));
                                }else{
                                    if(function_mir_result(instruction)>=0){return 47;}
                                    canonical_mir_append_text(output,",\"kind\":\"print\",\"numeric_policy\":\"none\",\"operands\":[");
                                    canonical_mir_append_i64(output,function_mir_left(instruction));
                                    canonical_mir_append_text(output,"],\"ownership\":\"none\"");
                                }
                                canonical_mir_append_text(output,",\"span\":[");
                                canonical_mir_append_i64(output,function_mir_start(instruction));buffer_push(output,44);
                                canonical_mir_append_i64(output,function_mir_length(instruction));buffer_push(output,93);
                                }}}
                            }
                            buffer_push(output,125);
                        }else{
                            if(assembly_source_kind(source_record)==assembly_source_contract_record_kind()){
                                var contract_index:i64=0;
                                var contract_matches:i64=0;
                                while(contract_index<vec_len<MirFunctionContractRecord>(contracts)){
                                    let contract_record:MirFunctionContractRecord=vec_get<MirFunctionContractRecord>(contracts,contract_index);
                                    if(function_contract_kind(contract_record)!=function_contract_temporary_local_kind()){
                                        if(function_contract_id(contract_record)==assembly_source_id(source_record)){
                                            let contract_status:i32=materialize_canonical_contract_instruction_with_catalog(
                                                source,contract_record,source_record,numeric_type_descriptors,output
                                            );
                                            if(contract_status!=0){return checked_add(70,contract_status);}
                                            contract_matches=checked_add(contract_matches,1);
                                        }
                                    }
                                    contract_index=checked_add(contract_index,1);
                                }
                                if(contract_matches!=1){return 69;}
                            }else{
                            if(assembly_source_kind(source_record)!=assembly_source_ownership_kind()){return 42;}
                            let ownership_id:i64=assembly_source_id(source_record);
                            if(ownership_id<0){return 43;}
                            if(ownership_id>=vec_len<MirOwnershipRecord>(ownership_records)){return 43;}
                            let ownership_value:MirOwnershipRecord=vec_get<MirOwnershipRecord>(ownership_records,ownership_id);
                            if(assembly_source_left(source_record)!=ownership_record_operand_local(ownership_value)){return 44;}
                            var ownership_local_matches:i64=0;var ownership_local_index:i64=1;
                            while(ownership_local_index<checked_sub(record_count,1)){
                                let ownership_local:MirFunctionRecord=vec_get<MirFunctionRecord>(records,ownership_local_index);
                                let ownership_local_kind:i32=function_mir_kind(ownership_local);
                                if(ownership_local_kind==function_mir_kind_source_local()){
                                    if(ownership_record_operand_local(ownership_value)==function_mir_id(ownership_local)){
                                        ownership_local_matches=checked_add(ownership_local_matches,1);
                                    }
                                }
                                if(ownership_local_kind==function_mir_kind_temporary_local()){
                                    if(ownership_record_operand_local(ownership_value)==function_mir_id(ownership_local)){
                                        ownership_local_matches=checked_add(ownership_local_matches,1);
                                    }
                                }
                                if(ownership_local_kind==function_mir_kind_parameter()){
                                    if(ownership_record_operand_local(ownership_value)==function_mir_id(ownership_local)){
                                        ownership_local_matches=checked_add(ownership_local_matches,1);
                                    }
                                }
                                ownership_local_index=checked_add(ownership_local_index,1);
                            }
                            if(ownership_local_matches!=1){return 46;}
                            let ownership_status:i32=materialize_canonical_ownership_instruction(
                                ownership_value,global_id,assembly_source_result(source_record),output
                            );
                            if(ownership_status!=0){return checked_add(50,ownership_status);}
                            }
                        }
                    }
                    block_placement_count=checked_add(block_placement_count,1);
                }
                placement_index=checked_add(placement_index,1);
            }
            canonical_mir_append_text(output,"],\"terminator\":");
            let term_status:i32=canonical_mir_append_empty_cfg_terminator(cfg,cfg_block_id(record),output);
            if(term_status!=0){return checked_add(10,term_status);}
            buffer_push(output,125);
            block_count=checked_add(block_count,1);
            last_block_id=chosen_id;
        }
        remaining=checked_sub(remaining,1);
    }
    if(block_count==0){return 20;}
    var placement_validation_index:i64=0;
    while(placement_validation_index<vec_len<MirPlacementRecord>(placements)){
        let placement:MirPlacementRecord=vec_get<MirPlacementRecord>(placements,placement_validation_index);
        if(canonical_mir_cfg_block_exists(cfg,placement_block_id(placement))==0){return 28;}
        placement_validation_index=checked_add(placement_validation_index,1);
    }
    buffer_push(output,93);
    if(function_mir_symbol_code(header)!=function_mir_mode_value()){
        canonical_mir_append_text(output,",\"borrowed_origin\":");
        canonical_mir_append_i64(output,function_mir_left(header));
    }
    canonical_mir_append_text(output,",\"capabilities\":");
    let capability_status:i32=materialize_canonical_capabilities(
        source,required,capability_catalog,output
    );
    if(capability_status!=0){return checked_add(40,capability_status);}
    canonical_mir_append_text(output,",\"entry_block\":0");
    if(function_mir_mutable(header)!=0){canonical_mir_append_text(output,",\"exported\":true");}
    canonical_mir_append_text(output,",\"locals\":[");
    var local_record_index:i64=1;var emitted_local_count:i64=0;
    while(local_record_index<checked_sub(record_count,1)){
        let local:MirFunctionRecord=vec_get<MirFunctionRecord>(records,local_record_index);
        let emitted_local_kind:i32=function_mir_kind(local);
        var emit_local:i32=0;
        if(emitted_local_kind==function_mir_kind_source_local()){emit_local=1;}
        if(emitted_local_kind==function_mir_kind_temporary_local()){emit_local=1;}
        if(emitted_local_kind==function_mir_kind_parameter()){emit_local=1;}
        if(emit_local!=0){
        if(emitted_local_count>0){buffer_push(output,44);}
        if(function_mir_id(local)!=emitted_local_count){return 70;}
        canonical_mir_append_text(output,"{\"id\":");canonical_mir_append_i64(output,function_mir_id(local));
        canonical_mir_append_text(output,",\"mutable\":");
        var local_mutable:i32=0;
        var local_owned:i32=0;
        var local_binding_id:i64=-1;
        if(emitted_local_kind==function_mir_kind_parameter()){
            local_mutable=function_mir_mutable(local);local_binding_id=function_mir_binding_id(local);
        }
        var binding_index:i64=0;
        while(binding_index<vec_len<MirOwnershipBinding>(ownership_bindings)){
            let binding:MirOwnershipBinding=vec_get<MirOwnershipBinding>(ownership_bindings,binding_index);
            var binding_matches_local:i32=0;
            if(function_mir_kind(local)==function_mir_kind_source_local()){
                if(ownership_binding_id(binding)==function_mir_binding_id(local)){binding_matches_local=1;}
            }else{if(function_mir_kind(local)==function_mir_kind_temporary_local()){
                if(ownership_binding_local_id(binding)==function_mir_id(local)){binding_matches_local=1;}
            }}
            if(binding_matches_local!=0){
                if(local_binding_id>=0){return 60;}
                local_binding_id=ownership_binding_id(binding);
                local_mutable=ownership_binding_mutable(binding);
                local_owned=ownership_binding_owned(binding);
            }
            binding_index=checked_add(binding_index,1);
        }
        if(function_mir_kind(local)==function_mir_kind_source_local()){
            if(local_binding_id<0){local_binding_id=function_mir_binding_id(local);}
            if(vec_len<MirOwnershipBinding>(ownership_bindings)==0){local_mutable=function_mir_mutable(local);}
        }
        if(local_mutable==0){canonical_mir_append_text(output,"false");}else{canonical_mir_append_text(output,"true");}
        canonical_mir_append_text(output,",\"name\":");
        if(function_mir_kind(local)==function_mir_kind_source_local()){
            let local_name_status:i32=canonical_mir_append_json_source(
                output,source,function_mir_symbol_start(local),function_mir_symbol_length(local)
            );
            if(local_name_status!=0){return 66;}
        }else{if(function_mir_kind(local)==function_mir_kind_parameter()){
            let parameter_name_status:i32=canonical_mir_append_json_source(
                output,source,function_mir_symbol_start(local),function_mir_symbol_length(local)
            );
            if(parameter_name_status!=0){return 66;}
        }else{
            canonical_mir_append_text(output,"\"_t");
            canonical_mir_append_i64(output,function_mir_hir_node_id(local));
            buffer_push(output,34);
        }}
        canonical_mir_append_text(output,",\"ownership\":\"");
        if(function_mir_kind(local)==function_mir_kind_parameter()){
            if(canonical_mir_append_mode(output,function_mir_symbol_code(local))!=0){return 67;}
        }else{if(local_owned==0){canonical_mir_append_text(output,"value");}else{canonical_mir_append_text(output,"owned");}}
        buffer_push(output,34);
        if(local_binding_id>=0){
            canonical_mir_append_text(output,",\"source_binding_id\":");
            canonical_mir_append_i64(output,local_binding_id);
        }
        canonical_mir_append_text(output,",\"type\":");
        if(canonical_mir_append_type_with_catalog(
            source,type_descriptors,numeric_type_descriptors,function_mir_type_code(local),0,output
        )!=0){return 29;}
        buffer_push(output,125);
        emitted_local_count=checked_add(emitted_local_count,1);
        }
        local_record_index=checked_add(local_record_index,1);
    }
    var contract_local_index:i64=0;
    while(contract_local_index<vec_len<MirFunctionContractLocal>(contract_locals)){
        let contract_local:MirFunctionContractLocal=vec_get<MirFunctionContractLocal>(contract_locals,contract_local_index);
        if(assembly_local_id(contract_local)!=emitted_local_count){return 71;}
        if(assembly_local_source_id(contract_local)<0){return 71;}
        if(assembly_local_contract_kind(contract_local)<function_contract_precondition_phase()){return 71;}
        if(assembly_local_contract_kind(contract_local)>function_contract_entry_snapshot_phase()){return 71;}
        if(assembly_local_clause(contract_local)<0){return 71;}
        if(emitted_local_count>0){buffer_push(output,44);}
        canonical_mir_append_text(output,"{\"id\":");canonical_mir_append_i64(output,assembly_local_id(contract_local));
        canonical_mir_append_text(output,",\"mutable\":false,\"name\":\"_contract_");
        canonical_mir_append_i32(output,assembly_local_contract_kind(contract_local));buffer_push(output,95);
        canonical_mir_append_i64(output,assembly_local_source_id(contract_local));
        canonical_mir_append_text(output,"\",\"ownership\":\"value\",\"type\":");
        if(canonical_mir_append_type_with_catalog(
            source,type_descriptors,numeric_type_descriptors,assembly_local_type(contract_local),0,output
        )!=0){return 72;}
        buffer_push(output,125);emitted_local_count=checked_add(emitted_local_count,1);
        contract_local_index=checked_add(contract_local_index,1);
    }
    canonical_mir_append_text(output,"],\"name\":");
    let name_status:i32=canonical_mir_append_json_source(output,source,function_mir_symbol_start(header),function_mir_symbol_length(header));
    if(name_status!=0){return checked_add(30,name_status);}
    if(function_mir_ordinal(header)>0){
        canonical_mir_append_text(output,",\"parameters\":[");
        var parameter_ordinal:i64=0;
        while(parameter_ordinal<function_mir_ordinal(header)){
            var parameter_index:i64=1;var parameter_matches:i64=0;
            while(parameter_index<checked_sub(record_count,1)){
                let parameter:MirFunctionRecord=vec_get<MirFunctionRecord>(records,parameter_index);
                if(function_mir_kind(parameter)==function_mir_kind_parameter()){
                    if(function_mir_ordinal(parameter)==parameter_ordinal){
                        if(parameter_matches>0){return 68;}
                        if(parameter_ordinal>0){buffer_push(output,44);}
                        canonical_mir_append_text(output,"{\"local\":");
                        canonical_mir_append_i64(output,function_mir_id(parameter));
                        canonical_mir_append_text(output,",\"mode\":\"");
                        if(canonical_mir_append_mode(output,function_mir_symbol_code(parameter))!=0){return 68;}
                        canonical_mir_append_text(output,"\"}");parameter_matches=checked_add(parameter_matches,1);
                    }
                }
                parameter_index=checked_add(parameter_index,1);
            }
            if(parameter_matches!=1){return 68;}parameter_ordinal=checked_add(parameter_ordinal,1);
        }
        buffer_push(output,93);
    }
    if(function_mir_symbol_code(header)!=function_mir_mode_value()){
        canonical_mir_append_text(output,",\"return_mode\":\"");
        if(canonical_mir_append_mode(output,function_mir_symbol_code(header))!=0){return 69;}
        buffer_push(output,34);
    }
    canonical_mir_append_text(output,",\"return_type\":");
    if(canonical_mir_append_type_with_catalog(
        source,type_descriptors,numeric_type_descriptors,function_mir_type_code(header),0,output
    )!=0){return 34;}
    canonical_mir_append_text(output,"}],\"name\":");
    if(canonical_mir_append_json_string(output,module_name)!=0){return 35;}
    canonical_mir_append_text(output,",\"schema\":\"bootstrap-mir-v1\"}");
    return 0;
}

// Placement rows are a set of block-local ordinal decisions. The Python
// assembler sorts them before MIR construction; normalize once at this public
// boundary so source-record order cannot change canonical instruction order.
pub fn materialize_sourced_cfg_canonical_mir(
    borrow source:Buffer,module_name:String,borrow records:Vec<MirFunctionRecord>,
    borrow contracts:Vec<MirFunctionContractRecord>,
    borrow contract_locals:Vec<MirFunctionContractLocal>,
    borrow ownership_bindings:Vec<MirOwnershipBinding>,
    borrow ownership_records:Vec<MirOwnershipRecord>,
    borrow sources:Vec<MirFunctionInstructionSource>,
    borrow cfg:Vec<MirCfgRecord>,borrow placements:Vec<MirPlacementRecord>,
    borrow required:Vec<i64>,borrow capability_catalog:Vec<CapabilityCatalogEntry>,
    borrow type_descriptors:Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors:Vec<MirNumericTypeDescriptor>,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    var ordered:Vec<MirPlacementRecord>=vec_new<MirPlacementRecord>(allocator,vec_len<MirPlacementRecord>(placements));
    var last_block:i64=-1;
    var last_ordinal:i64=-1;
    while(vec_len<MirPlacementRecord>(ordered)<vec_len<MirPlacementRecord>(placements)){
        var chosen_index:i64=-1;
        var chosen_block:i64=-1;
        var chosen_ordinal:i64=-1;
        var index:i64=0;
        while(index<vec_len<MirPlacementRecord>(placements)){
            let candidate:MirPlacementRecord=vec_get<MirPlacementRecord>(placements,index);
            let block_id:i64=placement_block_id(candidate);
            let ordinal:i64=placement_ordinal(candidate);
            if(block_id<0){return 28;}
            if(ordinal<0){return 21;}
            var later:i32=0;
            if(block_id>last_block){later=1;}
            else{if(block_id==last_block){if(ordinal>last_ordinal){later=1;}}}
            if(later!=0){
                var earlier:i32=0;
                if(chosen_index<0){earlier=1;}
                else{
                    if(block_id<chosen_block){earlier=1;}
                    else{if(block_id==chosen_block){if(ordinal<chosen_ordinal){earlier=1;}}}
                }
                if(earlier!=0){
                    chosen_index=index;chosen_block=block_id;chosen_ordinal=ordinal;
                }
            }
            index=checked_add(index,1);
        }
        if(chosen_index<0){return 21;}
        if(canonical_mir_cfg_block_exists(cfg,chosen_block)==0){return 28;}
        if(chosen_block==last_block){
            if(chosen_ordinal!=checked_add(last_ordinal,1)){return 21;}
        }else{if(chosen_ordinal!=0){return 21;}}
        vec_push<MirPlacementRecord>(ordered,vec_get<MirPlacementRecord>(placements,chosen_index));
        last_block=chosen_block;last_ordinal=chosen_ordinal;
    }
    let status:i32=materialize_sourced_cfg_canonical_mir_ordered(
        source,module_name,records,contracts,contract_locals,ownership_bindings,
        ownership_records,sources,cfg,ordered,required,capability_catalog,
        type_descriptors,numeric_type_descriptors,output
    );
    drop(ordered);
    return status;
}

pub fn materialize_bounded_cfg_canonical_mir(
    borrow source:Buffer,module_name:String,borrow records:Vec<MirFunctionRecord>,
    borrow cfg:Vec<MirCfgRecord>,borrow placements:Vec<MirPlacementRecord>,
    borrow required:Vec<i64>,borrow capability_catalog:Vec<CapabilityCatalogEntry>,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    let allocator:Allocator=system_allocator();
    var bindings:Vec<MirOwnershipBinding>=vec_new<MirOwnershipBinding>(allocator,0);
    var contracts:Vec<MirFunctionContractRecord>=vec_new<MirFunctionContractRecord>(allocator,0);
    var contract_locals:Vec<MirFunctionContractLocal>=vec_new<MirFunctionContractLocal>(allocator,0);
    var ownership:Vec<MirOwnershipRecord>=vec_new<MirOwnershipRecord>(allocator,0);
    var sources:Vec<MirFunctionInstructionSource>=vec_new<MirFunctionInstructionSource>(allocator,0);
    var type_descriptors:Vec<MirTypeDescriptor>=vec_new<MirTypeDescriptor>(allocator,0);
    var numeric_type_descriptors:Vec<MirNumericTypeDescriptor>=vec_new<MirNumericTypeDescriptor>(allocator,0);
    let status:i32=materialize_sourced_cfg_canonical_mir(
        source,module_name,records,contracts,contract_locals,bindings,ownership,sources,cfg,placements,
        required,capability_catalog,type_descriptors,numeric_type_descriptors,output
    );
    drop(numeric_type_descriptors);drop(type_descriptors);drop(sources);drop(ownership);drop(contract_locals);drop(contracts);drop(bindings);
    return status;
}

// Materialize the canonical resource-effect instruction represented by one
// validated Alpha.2 ownership record. This preserves semantic move/drop effects
// without selecting a physical allocation, pointer, or address-stability policy.
pub fn materialize_canonical_ownership_instruction(
    borrow record:MirOwnershipRecord,global_id:i64,result_local:i64,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(global_id<0){return 1;}
    let operand:i64=ownership_record_operand_local(record);
    if(operand<0){return 2;}
    let kind:i32=ownership_record_kind(record);
    var is_move:i32=0;
    if(kind==ownership_record_kind_move()){is_move=1;}
    if(kind==ownership_record_kind_replace_move()){is_move=1;}
    var is_drop:i32=0;
    if(kind==ownership_record_kind_drop()){is_drop=1;}
    if(kind==ownership_record_kind_replace_drop()){is_drop=1;}
    if(kind==ownership_record_kind_implicit_drop()){is_drop=1;}
    if(is_move==0){if(is_drop==0){return 3;}}
    if(is_move!=0){if(result_local<0){return 4;}}
    if(is_drop!=0){if(result_local>=0){return 5;}}

    canonical_mir_append_text(output,"{\"contract_kind\":\"none\",\"conversion_policy\":\"none\",\"id\":");
    canonical_mir_append_i64(output,global_id);
    canonical_mir_append_text(output,",\"kind\":\"");
    if(is_move!=0){canonical_mir_append_text(output,"move");}
    else{canonical_mir_append_text(output,"drop");}
    canonical_mir_append_text(output,"\",\"numeric_policy\":\"none\",\"operands\":[");
    canonical_mir_append_i64(output,operand);
    canonical_mir_append_text(output,"],\"ownership\":\"owned\"");
    if(is_move!=0){
        canonical_mir_append_text(output,",\"result\":");
        canonical_mir_append_i64(output,result_local);
    }
    buffer_push(output,125);
    return 0;
}

pub fn materialize_canonical_ownership_block_instructions(
    borrow ownership_records:Vec<MirOwnershipRecord>,
    borrow sources:Vec<MirFunctionInstructionSource>,
    borrow placements:Vec<MirPlacementRecord>,block_id:i64,
    borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    if(validate_function_assembly_sources(sources)!=0){return 1;}
    var placement_index:i64=0;
    var block_ordinal:i64=0;
    var emitted:i64=0;
    while(placement_index<vec_len<MirPlacementRecord>(placements)){
        let placement:MirPlacementRecord=vec_get<MirPlacementRecord>(placements,placement_index);
        if(placement_block_id(placement)==block_id){
            if(placement_ordinal(placement)!=block_ordinal){return 2;}
            let global_id:i64=placement_instruction_id(placement);
            if(global_id<0){return 3;}
            if(global_id>=vec_len<MirFunctionInstructionSource>(sources)){return 3;}
            let source_record:MirFunctionInstructionSource=vec_get<MirFunctionInstructionSource>(sources,global_id);
            if(assembly_source_global_id(source_record)!=global_id){return 4;}
            if(assembly_source_kind(source_record)==assembly_source_ownership_kind()){
                let source_id:i64=assembly_source_id(source_record);
                if(source_id<0){return 6;}
                if(source_id>=vec_len<MirOwnershipRecord>(ownership_records)){return 6;}
                let ownership_record_value:MirOwnershipRecord=vec_get<MirOwnershipRecord>(ownership_records,source_id);
                if(assembly_source_left(source_record)!=ownership_record_operand_local(ownership_record_value)){return 7;}
                if(emitted>0){buffer_push(output,44);}
                let status:i32=materialize_canonical_ownership_instruction(
                    ownership_record_value,global_id,assembly_source_result(source_record),output
                );
                if(status!=0){return checked_add(10,status);}
                emitted=checked_add(emitted,1);
            }
            block_ordinal=checked_add(block_ordinal,1);
        }
        placement_index=checked_add(placement_index,1);
    }
    var source_index:i64=0;
    while(source_index<vec_len<MirFunctionInstructionSource>(sources)){
        let source_record:MirFunctionInstructionSource=vec_get<MirFunctionInstructionSource>(sources,source_index);
        if(assembly_source_kind(source_record)==assembly_source_ownership_kind()){
            var source_placement_count:i64=0;
            var source_placement_index:i64=0;
            while(source_placement_index<vec_len<MirPlacementRecord>(placements)){
                let source_placement:MirPlacementRecord=vec_get<MirPlacementRecord>(placements,source_placement_index);
                if(placement_instruction_id(source_placement)==assembly_source_global_id(source_record)){
                    source_placement_count=checked_add(source_placement_count,1);
                }
                source_placement_index=checked_add(source_placement_index,1);
            }
            if(source_placement_count!=1){return 8;}
        }
        source_index=checked_add(source_index,1);
    }
    return 0;
}

pub fn materialize_canonical_capabilities(
    borrow source:Buffer,borrow required:Vec<i64>,
    borrow catalog:Vec<CapabilityCatalogEntry>,borrow_mut output:Buffer
)->i32
requires_caps [allocate]
{
    buffer_push(output,91);
    var index:i64=0;
    while(index<vec_len<i64>(required)){
        let capability_id:i64=vec_get<i64>(required,index);
        if(capability_id<0){return 1;}
        var prior:i64=0;
        while(prior<index){
            if(vec_get<i64>(required,prior)==capability_id){return 2;}
            prior=checked_add(prior,1);
        }
        var catalog_index:i64=0;
        var found:i32=0;
        var name_start:i64=0;
        var name_length:i64=0;
        while(catalog_index<vec_len<CapabilityCatalogEntry>(catalog)){
            let entry:CapabilityCatalogEntry=vec_get<CapabilityCatalogEntry>(catalog,catalog_index);
            if(entry.capability_id==capability_id){
                if(found!=0){return 3;}
                found=1;name_start=entry.name_start;name_length=entry.name_length;
            }
            catalog_index=checked_add(catalog_index,1);
        }
        if(found==0){return 4;}
        if(index>0){buffer_push(output,44);}
        let name_status:i32=canonical_mir_append_json_source(output,source,name_start,name_length);
        if(name_status!=0){return checked_add(5,name_status);}
        index=checked_add(index,1);
    }
    buffer_push(output,93);
    return 0;
}

pub fn print_resolved_source_function_bundle_item_with_source_policy(
    borrow effective_source: Buffer,
    include_effective_source: i32,
    borrow body: Vec<MirFunctionRecord>,
    borrow contracts: Vec<MirFunctionContractRecord>,
    borrow contract_locals: Vec<MirFunctionContractLocal>,
    borrow sources: Vec<MirFunctionInstructionSource>,
    borrow ownership_bindings: Vec<MirOwnershipBinding>,
    borrow ownership_records: Vec<MirOwnershipRecord>,
    borrow cfg: Vec<MirCfgRecord>,
    borrow placements: Vec<MirPlacementRecord>,
    borrow capabilities: Vec<i64>,
    borrow type_descriptors: Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors: Vec<MirNumericTypeDescriptor>,
    borrow destructor_descriptors: Vec<MirDestructorDescriptor>,
    borrow destructor_body: Vec<MirFunctionRecord>,
    borrow destructor_cfg: Vec<MirCfgRecord>,
    borrow destructor_placements: Vec<MirPlacementRecord>
) -> i32 {
    var value_count: i64 = resolved_source_function_snapshot_value_count(
        effective_source, body, contracts, contract_locals, sources, ownership_bindings,
        ownership_records, cfg, placements, capabilities, type_descriptors,
        numeric_type_descriptors,
        destructor_descriptors, destructor_body, destructor_cfg, destructor_placements
    );
    if (include_effective_source == 0) {
        value_count = checked_sub(value_count, buffer_len(effective_source));
    }
    if (value_count < 18) { return 1; }
    print(value_count);
    return print_resolved_source_function_snapshot_with_source_policy(
        effective_source, include_effective_source,
        body, contracts, contract_locals, sources, ownership_bindings,
        ownership_records, cfg, placements, capabilities, type_descriptors,
        numeric_type_descriptors,
        destructor_descriptors, destructor_body, destructor_cfg, destructor_placements
    );
}

pub fn print_resolved_source_function_bundle_item(
    borrow effective_source: Buffer,
    borrow body: Vec<MirFunctionRecord>,
    borrow contracts: Vec<MirFunctionContractRecord>,
    borrow contract_locals: Vec<MirFunctionContractLocal>,
    borrow sources: Vec<MirFunctionInstructionSource>,
    borrow ownership_bindings: Vec<MirOwnershipBinding>,
    borrow ownership_records: Vec<MirOwnershipRecord>,
    borrow cfg: Vec<MirCfgRecord>,
    borrow placements: Vec<MirPlacementRecord>,
    borrow capabilities: Vec<i64>,
    borrow type_descriptors: Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors: Vec<MirNumericTypeDescriptor>,
    borrow destructor_descriptors: Vec<MirDestructorDescriptor>,
    borrow destructor_body: Vec<MirFunctionRecord>,
    borrow destructor_cfg: Vec<MirCfgRecord>,
    borrow destructor_placements: Vec<MirPlacementRecord>
) -> i32 {
    return print_resolved_source_function_bundle_item_with_source_policy(
        effective_source, 1, body, contracts, contract_locals, sources,
        ownership_bindings, ownership_records, cfg, placements, capabilities,
        type_descriptors, numeric_type_descriptors, destructor_descriptors,
        destructor_body, destructor_cfg, destructor_placements
    );
}

pub fn print_resolved_source_function_bundle_metadata(
    borrow source: Buffer,
    module_start: i64,
    module_length: i64,
    borrow capabilities: Vec<CapabilityCatalogEntry>
) -> i32 {
    if (module_length <= 0) { return 1; }
    print(resolved_source_function_bundle_metadata_magic());
    print(module_length);
    var offset: i64 = 0;
    while (offset < module_length) {
        print(buffer_get(source, checked_add(module_start, offset)));
        offset = checked_add(offset, 1);
    }
    print(vec_len<CapabilityCatalogEntry>(capabilities));
    var index: i64 = 0;
    while (index < vec_len<CapabilityCatalogEntry>(capabilities)) {
        let entry: CapabilityCatalogEntry = vec_get<CapabilityCatalogEntry>(capabilities, index);
        print(entry.name_length);
        offset = 0;
        while (offset < entry.name_length) {
            print(buffer_get(source, checked_add(entry.name_start, offset)));
            offset = checked_add(offset, 1);
        }
        index = checked_add(index, 1);
    }
    return 0;
}
