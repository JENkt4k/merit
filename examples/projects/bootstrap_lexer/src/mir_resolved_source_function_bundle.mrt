module bootstrap_mir_resolved_source_function_bundle
import bootstrap_mir_functions;
import bootstrap_mir_function_contracts;
import bootstrap_mir_function_assembly_plan;
import bootstrap_mir_function_instruction_source;
import bootstrap_mir_ownership_flow;
import bootstrap_mir_cfg;
import bootstrap_mir_cfg_placement;
import bootstrap_mir_resolved_source_function_snapshot;
import bootstrap_statement_semantics;

// resolved-source-function-bundle-v3/v4
// magic "MRBF", version, function count, then for each function:
// snapshot value count followed by a bootstrap-resolved-source-function-
// snapshot-v9 payload. The first payload carries the canonical effective
// source; later payloads use an empty source section and inherit the first.

fn resolved_source_function_bundle_magic()->i64{return 1297236550;}
fn resolved_source_function_bundle_version()->i64{return 2;}
fn resolved_source_function_project_bundle_version()->i64{return 3;}
fn resolved_source_function_project_artifact_bundle_version()->i64{return 4;}
fn resolved_source_function_bundle_metadata_magic()->i64{return 1296389185;}
fn resolved_source_function_project_artifact_magic()->i64{return 1296253266;}

pub fn resolved_source_function_snapshot_value_count(
    borrow effective_source: Buffer,
    borrow body: Vec<MirFunctionRecord>,
    borrow contracts: Vec<MirFunctionContractRecord>,
    borrow contract_locals: Vec<MirFunctionContractLocal>,
    borrow sources: Vec<MirFunctionInstructionSource>,
    borrow ownership_bindings: Vec<MirOwnershipBinding>,
    borrow ownership_records: Vec<MirOwnershipRecord>,
    borrow cfg: Vec<MirCfgRecord>,
    borrow placements: Vec<MirPlacementRecord>,
    borrow capabilities: Vec<i64>,
    borrow type_descriptors: Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors: Vec<MirNumericTypeDescriptor>,
    borrow destructor_descriptors: Vec<MirDestructorDescriptor>,
    borrow destructor_body: Vec<MirFunctionRecord>,
    borrow destructor_cfg: Vec<MirCfgRecord>,
    borrow destructor_placements: Vec<MirPlacementRecord>
) -> i64 {
    var count: i64 = 18; // magic + version + sixteen section counts
    count = checked_add(count, checked_mul(vec_len<MirFunctionRecord>(body), 16));
    count = checked_add(count, checked_mul(vec_len<MirFunctionContractRecord>(contracts), 12));
    count = checked_add(count, checked_mul(vec_len<MirFunctionContractLocal>(contract_locals), 5));
    count = checked_add(count, checked_mul(vec_len<MirFunctionInstructionSource>(sources), 8));
    count = checked_add(count, checked_mul(vec_len<MirOwnershipBinding>(ownership_bindings), 4));
    count = checked_add(count, checked_mul(vec_len<MirOwnershipRecord>(ownership_records), 8));
    count = checked_add(count, checked_mul(vec_len<MirCfgRecord>(cfg), 7));
    count = checked_add(count, checked_mul(vec_len<MirPlacementRecord>(placements), 3));
    count = checked_add(count, vec_len<i64>(capabilities));
    count = checked_add(count, checked_mul(vec_len<MirTypeDescriptor>(type_descriptors), 11));
    count = checked_add(count, checked_mul(vec_len<MirNumericTypeDescriptor>(numeric_type_descriptors), 11));
    count = checked_add(count, checked_mul(vec_len<MirDestructorDescriptor>(destructor_descriptors), 7));
    count = checked_add(count, checked_mul(vec_len<MirFunctionRecord>(destructor_body), 16));
    count = checked_add(count, checked_mul(vec_len<MirCfgRecord>(destructor_cfg), 7));
    count = checked_add(count, checked_mul(vec_len<MirPlacementRecord>(destructor_placements), 3));
    count = checked_add(count, buffer_len(effective_source));
    return count;
}

pub fn print_resolved_source_function_bundle_header(function_count: i64) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_bundle_version());
    print(function_count);
    return 0;
}

pub fn print_resolved_source_function_project_bundle_header(function_count: i64) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_project_bundle_version());
    print(function_count);
    return 0;
}

pub fn print_resolved_source_function_project_artifact_bundle_header(
    function_count: i64
) -> i32 {
    if (function_count <= 0) { return 1; }
    print(resolved_source_function_bundle_magic());
    print(resolved_source_function_project_artifact_bundle_version());
    print(function_count);
    return 0;
}

fn print_resolved_source_function_artifact_bytes(borrow value: Buffer) -> i32 {
    if (buffer_len(value) <= 0) { return 1; }
    print(buffer_len(value));
    var offset: i64 = 0;
    while (offset < buffer_len(value)) {
        print(buffer_get(value, offset));
        offset = checked_add(offset, 1);
    }
    return 0;
}

pub fn print_resolved_source_function_project_artifacts(
    borrow canonical_mir: Buffer,
    borrow c_source: Buffer,
    borrow c_header: Buffer
) -> i32 {
    if (buffer_len(canonical_mir) <= 0) { return 1; }
    if (buffer_len(c_source) <= 0) { return 2; }
    if (buffer_len(c_header) <= 0) { return 3; }
    print(resolved_source_function_project_artifact_magic());
    let mir_status: i32 = print_resolved_source_function_artifact_bytes(canonical_mir);
    if (mir_status != 0) { return checked_add(10, mir_status); }
    let source_status: i32 = print_resolved_source_function_artifact_bytes(c_source);
    if (source_status != 0) { return checked_add(20, source_status); }
    let header_status: i32 = print_resolved_source_function_artifact_bytes(c_header);
    if (header_status != 0) { return checked_add(30, header_status); }
    return 0;
}

pub fn print_resolved_source_function_bundle_item_with_source_policy(
    borrow effective_source: Buffer,
    include_effective_source: i32,
    borrow body: Vec<MirFunctionRecord>,
    borrow contracts: Vec<MirFunctionContractRecord>,
    borrow contract_locals: Vec<MirFunctionContractLocal>,
    borrow sources: Vec<MirFunctionInstructionSource>,
    borrow ownership_bindings: Vec<MirOwnershipBinding>,
    borrow ownership_records: Vec<MirOwnershipRecord>,
    borrow cfg: Vec<MirCfgRecord>,
    borrow placements: Vec<MirPlacementRecord>,
    borrow capabilities: Vec<i64>,
    borrow type_descriptors: Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors: Vec<MirNumericTypeDescriptor>,
    borrow destructor_descriptors: Vec<MirDestructorDescriptor>,
    borrow destructor_body: Vec<MirFunctionRecord>,
    borrow destructor_cfg: Vec<MirCfgRecord>,
    borrow destructor_placements: Vec<MirPlacementRecord>
) -> i32 {
    var value_count: i64 = resolved_source_function_snapshot_value_count(
        effective_source, body, contracts, contract_locals, sources, ownership_bindings,
        ownership_records, cfg, placements, capabilities, type_descriptors,
        numeric_type_descriptors,
        destructor_descriptors, destructor_body, destructor_cfg, destructor_placements
    );
    if (include_effective_source == 0) {
        value_count = checked_sub(value_count, buffer_len(effective_source));
    }
    if (value_count < 18) { return 1; }
    print(value_count);
    return print_resolved_source_function_snapshot_with_source_policy(
        effective_source, include_effective_source,
        body, contracts, contract_locals, sources, ownership_bindings,
        ownership_records, cfg, placements, capabilities, type_descriptors,
        numeric_type_descriptors,
        destructor_descriptors, destructor_body, destructor_cfg, destructor_placements
    );
}

pub fn print_resolved_source_function_bundle_item(
    borrow effective_source: Buffer,
    borrow body: Vec<MirFunctionRecord>,
    borrow contracts: Vec<MirFunctionContractRecord>,
    borrow contract_locals: Vec<MirFunctionContractLocal>,
    borrow sources: Vec<MirFunctionInstructionSource>,
    borrow ownership_bindings: Vec<MirOwnershipBinding>,
    borrow ownership_records: Vec<MirOwnershipRecord>,
    borrow cfg: Vec<MirCfgRecord>,
    borrow placements: Vec<MirPlacementRecord>,
    borrow capabilities: Vec<i64>,
    borrow type_descriptors: Vec<MirTypeDescriptor>,
    borrow numeric_type_descriptors: Vec<MirNumericTypeDescriptor>,
    borrow destructor_descriptors: Vec<MirDestructorDescriptor>,
    borrow destructor_body: Vec<MirFunctionRecord>,
    borrow destructor_cfg: Vec<MirCfgRecord>,
    borrow destructor_placements: Vec<MirPlacementRecord>
) -> i32 {
    return print_resolved_source_function_bundle_item_with_source_policy(
        effective_source, 1, body, contracts, contract_locals, sources,
        ownership_bindings, ownership_records, cfg, placements, capabilities,
        type_descriptors, numeric_type_descriptors, destructor_descriptors,
        destructor_body, destructor_cfg, destructor_placements
    );
}

pub fn print_resolved_source_function_bundle_metadata(
    borrow source: Buffer,
    module_start: i64,
    module_length: i64,
    borrow capabilities: Vec<CapabilityCatalogEntry>
) -> i32 {
    if (module_length <= 0) { return 1; }
    print(resolved_source_function_bundle_metadata_magic());
    print(module_length);
    var offset: i64 = 0;
    while (offset < module_length) {
        print(buffer_get(source, checked_add(module_start, offset)));
        offset = checked_add(offset, 1);
    }
    print(vec_len<CapabilityCatalogEntry>(capabilities));
    var index: i64 = 0;
    while (index < vec_len<CapabilityCatalogEntry>(capabilities)) {
        let entry: CapabilityCatalogEntry = vec_get<CapabilityCatalogEntry>(capabilities, index);
        print(entry.name_length);
        offset = 0;
        while (offset < entry.name_length) {
            print(buffer_get(source, checked_add(entry.name_start, offset)));
            offset = checked_add(offset, 1);
        }
        index = checked_add(index, 1);
    }
    return 0;
}
