module bootstrap_mir_functions

// bootstrap-function-mir-v1 is the first whole-function replacement record
// family. It deliberately covers one basic block only; CFG records are a later
// additive contract. Kinds: 1 function, 2 source local, 3 temporary local,
// 4 const, 5 binary, 6 copy-to-binding, 7 return, 8 print,
// 9 Copy-payload enum construct, 10 enum tag load, 11 enum payload load,
// 12 aggregate construct, 13 aggregate field load, 14 aggregate field store,
// 15 function parameter, 16 call, 17 call argument.
pub struct MirFunctionRecord {
    kind: i32;
    start: i64;
    length: i64;
    id: i64;
    result: i64;
    left: i64;
    right: i64;
    symbol_start: i64;
    symbol_length: i64;
    symbol_code: i32;
    type_code: i32;
    numeric_policy: i32;
    binding_id: i64;
    mutable: i32;
    hir_node_id: i64;
    ordinal: i64;
}

// Native-resolved aggregate schema transported beside function records.
// Kinds and numeric type-code bases are canonical bootstrap record encodings;
// consumers must use these symbolic accessors rather than duplicate values.
pub struct MirTypeDescriptor {
    type_code: i32; kind: i32; identity: i32; child_type_code: i32;
    destructor_policy: i32; ordinal: i32;
}
pub struct MirDestructorDescriptor {
    type_code: i32;
    body_start: i64;
    body_count: i64;
    cfg_start: i64;
    cfg_count: i64;
    placement_start: i64;
    placement_count: i64;
}
pub fn function_mir_destructor_descriptor(
    type_code: i32, body_start: i64, body_count: i64,
    cfg_start: i64, cfg_count: i64, placement_start: i64, placement_count: i64
) -> MirDestructorDescriptor {
    return MirDestructorDescriptor {
        type_code:type_code, body_start:body_start, body_count:body_count,
        cfg_start:cfg_start, cfg_count:cfg_count,
        placement_start:placement_start, placement_count:placement_count
    };
}
pub fn function_mir_destructor_type_code(borrow value: MirDestructorDescriptor) -> i32 { return value.type_code; }
pub fn function_mir_destructor_body_start(borrow value: MirDestructorDescriptor) -> i64 { return value.body_start; }
pub fn function_mir_destructor_body_count(borrow value: MirDestructorDescriptor) -> i64 { return value.body_count; }
pub fn function_mir_destructor_cfg_start(borrow value: MirDestructorDescriptor) -> i64 { return value.cfg_start; }
pub fn function_mir_destructor_cfg_count(borrow value: MirDestructorDescriptor) -> i64 { return value.cfg_count; }
pub fn function_mir_destructor_placement_start(borrow value: MirDestructorDescriptor) -> i64 { return value.placement_start; }
pub fn function_mir_destructor_placement_count(borrow value: MirDestructorDescriptor) -> i64 { return value.placement_count; }
pub fn function_mir_type_descriptor_owned_field_struct_kind() -> i32 { return 1; }
pub fn function_mir_type_descriptor_owned_payload_enum_kind() -> i32 { return 2; }
pub fn function_mir_type_descriptor_aggregate_struct_kind() -> i32 { return 3; }
pub fn function_mir_type_descriptor(
    type_code: i32, kind: i32, identity: i32, child_type_code: i32,
    destructor_policy: i32, ordinal: i32
) -> MirTypeDescriptor {
    return MirTypeDescriptor {
        type_code:type_code, kind:kind, identity:identity,
        child_type_code:child_type_code, destructor_policy:destructor_policy, ordinal:ordinal
    };
}
pub fn function_mir_type_descriptor_code(borrow value: MirTypeDescriptor) -> i32 { return value.type_code; }
pub fn function_mir_type_descriptor_kind(borrow value: MirTypeDescriptor) -> i32 { return value.kind; }
pub fn function_mir_type_descriptor_identity(borrow value: MirTypeDescriptor) -> i32 { return value.identity; }
pub fn function_mir_type_descriptor_child(borrow value: MirTypeDescriptor) -> i32 { return value.child_type_code; }
pub fn function_mir_type_descriptor_destructor_policy(borrow value: MirTypeDescriptor) -> i32 { return value.destructor_policy; }
pub fn function_mir_type_descriptor_ordinal(borrow value: MirTypeDescriptor) -> i32 { return value.ordinal; }

pub fn function_mir_kind(borrow node: MirFunctionRecord) -> i32 { return node.kind; }
pub fn function_mir_start(borrow node: MirFunctionRecord) -> i64 { return node.start; }
pub fn function_mir_length(borrow node: MirFunctionRecord) -> i64 { return node.length; }
pub fn function_mir_id(borrow node: MirFunctionRecord) -> i64 { return node.id; }
pub fn function_mir_result(borrow node: MirFunctionRecord) -> i64 { return node.result; }
pub fn function_mir_left(borrow node: MirFunctionRecord) -> i64 { return node.left; }
pub fn function_mir_right(borrow node: MirFunctionRecord) -> i64 { return node.right; }
pub fn function_mir_symbol_start(borrow node: MirFunctionRecord) -> i64 { return node.symbol_start; }
pub fn function_mir_symbol_length(borrow node: MirFunctionRecord) -> i64 { return node.symbol_length; }
pub fn function_mir_symbol_code(borrow node: MirFunctionRecord) -> i32 { return node.symbol_code; }
pub fn function_mir_type_code(borrow node: MirFunctionRecord) -> i32 { return node.type_code; }
pub fn function_mir_numeric_policy(borrow node: MirFunctionRecord) -> i32 { return node.numeric_policy; }
pub fn function_mir_binding_id(borrow node: MirFunctionRecord) -> i64 { return node.binding_id; }
pub fn function_mir_mutable(borrow node: MirFunctionRecord) -> i32 { return node.mutable; }
pub fn function_mir_hir_node_id(borrow node: MirFunctionRecord) -> i64 { return node.hir_node_id; }
pub fn function_mir_ordinal(borrow node: MirFunctionRecord) -> i64 { return node.ordinal; }
pub fn function_mir_kind_struct_construct() -> i32 { return 12; }
pub fn function_mir_kind_struct_field_load() -> i32 { return 13; }
pub fn function_mir_kind_struct_field_store() -> i32 { return 14; }
pub fn function_mir_kind_parameter() -> i32 { return 15; }
pub fn function_mir_kind_call() -> i32 { return 16; }
pub fn function_mir_kind_call_argument() -> i32 { return 17; }
pub fn function_mir_mode_value() -> i32 { return 0; }
pub fn function_mir_mode_borrowed() -> i32 { return 1; }
pub fn function_mir_mode_mutable_borrow() -> i32 { return 2; }
pub fn function_mir_invalid_struct_record_status() -> i32 { return 42; }
pub fn function_mir_invalid_callable_header_status() -> i32 { return 43; }
pub fn function_mir_invalid_parameter_status() -> i32 { return 44; }
pub fn function_mir_invalid_call_status() -> i32 { return 45; }
pub fn function_mir_invalid_call_argument_status() -> i32 { return 46; }
pub fn function_mir_parameter_count_mismatch_status() -> i32 { return 47; }
pub fn function_mir_binary_add_symbol() -> i32 { return 1; }
pub fn function_mir_checked_numeric_policy() -> i32 { return 2; }
pub fn function_mir_field_store_initialize_policy() -> i32 { return 0; }
pub fn function_mir_field_store_replace_policy() -> i32 { return 1; }
pub fn function_mir_destructor_header_error() -> i32 { return 991; }
pub fn function_mir_destructor_type_error() -> i32 { return 992; }
pub fn function_mir_destructor_unopened_body_error() -> i32 { return 993; }
pub fn function_mir_destructor_unclosed_body_error() -> i32 { return 994; }
pub fn function_mir_destructor_statement_error() -> i32 { return 995; }
pub fn function_mir_destructor_body_error(status: i32) -> i32 { return checked_add(996, status); }
pub fn function_mir_destructor_cfg_error(status: i32) -> i32 { return checked_add(1100, status); }
pub fn function_mir_is_construct(borrow node: MirFunctionRecord) -> i32 { if (node.kind == 9) { return 1; } return 0; }
pub fn function_mir_is_enum_tag_load(borrow node: MirFunctionRecord) -> i32 { if (node.kind == 10) { return 1; } return 0; }
pub fn function_mir_is_enum_payload_load(borrow node: MirFunctionRecord) -> i32 { if (node.kind == 11) { return 1; } return 0; }
pub fn function_mir_is_enum_instruction(borrow node: MirFunctionRecord) -> i32 {
    if (function_mir_is_construct(node) != 0) { return 1; }
    if (function_mir_is_enum_tag_load(node) != 0) { return 1; }
    return function_mir_is_enum_payload_load(node);
}

pub fn function_mir_is_struct_construct(borrow node: MirFunctionRecord) -> i32 { if (node.kind == function_mir_kind_struct_construct()) { return 1; } return 0; }
pub fn function_mir_is_struct_field_load(borrow node: MirFunctionRecord) -> i32 { if (node.kind == function_mir_kind_struct_field_load()) { return 1; } return 0; }
pub fn function_mir_is_struct_field_store(borrow node: MirFunctionRecord) -> i32 { if (node.kind == function_mir_kind_struct_field_store()) { return 1; } return 0; }
pub fn function_mir_is_struct_field_instruction(borrow node: MirFunctionRecord) -> i32 {
    if (function_mir_is_struct_field_load(node) != 0) { return 1; }
    return function_mir_is_struct_field_store(node);
}

// bootstrap-function-mir-v1 reserves codes at and above this boundary for
// Copy-payload enum identities. The explicit value is part of the record ABI.
pub fn function_mir_copy_payload_enum_type_code(enum_id: i32) -> i32 {
    return checked_add(1000, enum_id);
}
pub fn function_mir_i64_type_code() -> i32 { return 1; }
// Canonical bootstrap-MIR builtin type identities. These explicit values are
// part of the bootstrap-function-mir-v1 record ABI.
pub fn function_mir_allocator_type_code() -> i32 { return 3; }
pub fn function_mir_buffer_type_code() -> i32 { return 4; }
pub fn function_mir_unresolved_type_code() -> i32 { return 0; }

// Single-i64 non-copy struct identities occupy a disjoint record-ABI range.
// The explicit boundary is part of bootstrap-function-mir-v1.
pub fn function_mir_i64_struct_type_code(struct_id: i32) -> i32 {
    return checked_add(2000, struct_id);
}
// Exactly-one-i64-field structs with the represented print-field destructor
// occupy a distinct record-ABI range. The explicit boundary is contractual.
pub fn function_mir_destructor_i64_struct_type_code(struct_id: i32) -> i32 {
    return checked_add(3000, struct_id);
}
// Owned single-payload enum identities encode both the enum declaration and
// its represented destructor-struct payload in one bootstrap record value.
// The explicit base and stride are bootstrap-function-mir-v1 encoding data.
pub fn function_mir_owned_payload_enum_type_code(enum_id: i32, payload_struct_id: i32) -> i32 {
    return checked_add(4000, checked_add(checked_mul(enum_id, 1000), payload_struct_id));
}
pub fn function_mir_owned_payload_enum_id(type_code: i32) -> i32 {
    if (type_code >= function_mir_recursive_owned_payload_enum_type_code(0)) {
        return checked_sub(type_code, function_mir_recursive_owned_payload_enum_type_code(0));
    }
    return checked_sub(type_code, 4000) / 1000;
}
pub fn function_mir_owned_field_struct_type_code(struct_id: i32) -> i32 {
    return checked_add(1000000, struct_id);
}
pub fn function_mir_recursive_owned_payload_enum_type_code(enum_id: i32) -> i32 {
    return checked_add(1100000, enum_id);
}
// General ordered-field aggregate identities occupy a disjoint v3 record range.
pub fn function_mir_aggregate_struct_type_code(struct_id: i32) -> i32 {
    return checked_add(1200000, struct_id);
}
pub fn function_mir_type_is_owned_payload_enum(type_code: i32) -> i32 {
    if (type_code >= function_mir_recursive_owned_payload_enum_type_code(0)) {
        if (type_code < function_mir_aggregate_struct_type_code(0)) { return 1; }
    }
    if (type_code >= function_mir_owned_payload_enum_type_code(0, 0)) {
        if (type_code < function_mir_owned_field_struct_type_code(0)) { return 1; }
    }
    return 0;
}
pub fn function_mir_type_is_i64_struct(type_code: i32) -> i32 {
    if (type_code >= function_mir_i64_struct_type_code(0)) {
        if (type_code < function_mir_owned_payload_enum_type_code(0, 0)) { return 1; }
    }
    return 0;
}
pub fn function_mir_type_uses_ownership_transfer(type_code: i32) -> i32 {
    if (type_code == function_mir_buffer_type_code()) { return 1; }
    if (function_mir_type_is_i64_struct(type_code) != 0) { return 1; }
    if (type_code >= function_mir_owned_field_struct_type_code(0)) { return 1; }
    return function_mir_type_is_owned_payload_enum(type_code);
}

pub fn function_mir_header(start: i64, length: i64, symbol_start: i64, symbol_length: i64, result_type_code: i32) -> MirFunctionRecord {
    return MirFunctionRecord {
        kind: 1, start: start, length: length, id: 0, result: -1, left: -1, right: -1,
        symbol_start: symbol_start, symbol_length: symbol_length, symbol_code: 0,
        type_code: result_type_code, numeric_policy: 0, binding_id: -1, mutable: 0,
        hir_node_id: -1, ordinal: 0
    };
}

pub fn function_mir_callable_header(
    start: i64, length: i64, symbol_start: i64, symbol_length: i64,
    result_type_code: i32, return_mode: i32, borrowed_origin: i64, parameter_count: i64
) -> MirFunctionRecord {
    return MirFunctionRecord {
        kind: 1, start:start, length:length, id:0, result:-1,
        left:borrowed_origin, right:-1, symbol_start:symbol_start,
        symbol_length:symbol_length, symbol_code:return_mode,
        type_code:result_type_code, numeric_policy:0, binding_id:-1, mutable:0,
        hir_node_id:-1, ordinal:parameter_count
    };
}

pub fn function_mir_parameter(
    start: i64, length: i64, local_id: i64, type_code: i32,
    binding_id: i64, mutable: i32, mode: i32, parameter_ordinal: i64
) -> MirFunctionRecord {
    return MirFunctionRecord {
        kind:function_mir_kind_parameter(), start:start, length:length,
        id:local_id, result:-1, left:-1, right:-1, symbol_start:start,
        symbol_length:length, symbol_code:mode, type_code:type_code,
        numeric_policy:0, binding_id:binding_id, mutable:mutable,
        hir_node_id:-1, ordinal:parameter_ordinal
    };
}

pub fn function_mir_call(
    start: i64, length: i64, instruction_id: i64, result_local: i64,
    symbol_start: i64, symbol_length: i64, result_type_code: i32,
    return_mode: i32, hir_node_id: i64
) -> MirFunctionRecord {
    return MirFunctionRecord {
        kind:function_mir_kind_call(), start:start, length:length,
        id:instruction_id, result:result_local, left:-1, right:-1,
        symbol_start:symbol_start, symbol_length:symbol_length, symbol_code:0,
        type_code:result_type_code, numeric_policy:return_mode, binding_id:-1,
        mutable:0, hir_node_id:hir_node_id, ordinal:instruction_id
    };
}

pub fn function_mir_call_argument(
    instruction_id: i64, operand_local: i64, parameter_mode: i32,
    argument_ordinal: i64
) -> MirFunctionRecord {
    return MirFunctionRecord {
        kind:function_mir_kind_call_argument(), start:0, length:0,
        id:instruction_id, result:-1, left:operand_local, right:-1,
        symbol_start:-1, symbol_length:0, symbol_code:parameter_mode,
        type_code:0, numeric_policy:0, binding_id:-1, mutable:0,
        hir_node_id:-1, ordinal:argument_ordinal
    };
}

pub fn function_mir_source_local(start: i64, length: i64, local_id: i64, type_code: i32, binding_id: i64, mutable: i32) -> MirFunctionRecord {
    return MirFunctionRecord {
        kind: 2, start: start, length: length, id: local_id, result: -1, left: -1, right: -1,
        symbol_start: start, symbol_length: length, symbol_code: 0, type_code: type_code,
        numeric_policy: 0, binding_id: binding_id, mutable: mutable, hir_node_id: -1,
        ordinal: local_id
    };
}

pub fn function_mir_temporary(local_id: i64, type_code: i32, hir_node_id: i64) -> MirFunctionRecord {
    return function_mir_temporary_mode(local_id,type_code,hir_node_id,function_mir_mode_value());
}

pub fn function_mir_temporary_mode(local_id:i64,type_code:i32,hir_node_id:i64,mode:i32)->MirFunctionRecord {
    return MirFunctionRecord {
        kind: 3, start: 0, length: 0, id: local_id, result: -1, left: -1, right: -1,
        symbol_start: -1, symbol_length: 0, symbol_code: 0, type_code: type_code,
        numeric_policy: mode, binding_id: -1, mutable: 0, hir_node_id: hir_node_id,
        ordinal: local_id
    };
}

pub fn function_mir_const(start: i64, length: i64, instruction_id: i64, result_local: i64, type_code: i32, hir_node_id: i64) -> MirFunctionRecord {
