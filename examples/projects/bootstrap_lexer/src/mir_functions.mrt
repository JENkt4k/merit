        left: field_local, right: -1, symbol_start: -1, symbol_length: 0,
        symbol_code: field_ordinal, type_code: struct_type_code, numeric_policy: function_mir_field_store_replace_policy(),
        binding_id: -1, mutable: 0, hir_node_id: hir_node_id, ordinal: instruction_id
    };
}

// Stable structural validation. Semantic local availability is checked by the
// canonical adapter because a flat stream interleaves local declarations with
// instruction records while canonical MIR stores locals separately.
pub fn validate_function_mir_records(borrow nodes: Vec<MirFunctionRecord>) -> i32 {
    if (vec_len<MirFunctionRecord>(nodes) < 2) { return 1; }
    let header: MirFunctionRecord = vec_get<MirFunctionRecord>(nodes, 0);
    if (header.kind != 1) { return 2; }
    if (header.start < 0) { return 3; }
    if (header.length <= 0) { return 3; }
    if (header.symbol_start < 0) { return 4; }
    if (header.symbol_length <= 0) { return 4; }
    if (header.type_code <= 0) { return 5; }
    if (header.symbol_code < function_mir_mode_value()) { return function_mir_invalid_callable_header_status(); }
    if (header.symbol_code > function_mir_mode_mutable_borrow()) { return function_mir_invalid_callable_header_status(); }
    if (header.ordinal < 0) { return function_mir_invalid_callable_header_status(); }
    if (header.symbol_code == function_mir_mode_value()) {
        if (header.left != -1) { return function_mir_invalid_callable_header_status(); }
    } else {
        if (header.left < 0) { return function_mir_invalid_callable_header_status(); }
    }

    var next_local: i64 = 0;
    var next_instruction: i64 = 0;
    var next_parameter: i64 = 0;
    var saw_return: i32 = 0;
    var index: i64 = 1;
    while (index < vec_len<MirFunctionRecord>(nodes)) {
        let node: MirFunctionRecord = vec_get<MirFunctionRecord>(nodes, index);
        if (saw_return != 0) { return 6; }
        if (node.kind == 2) {
            if (node.id != next_local) { return 7; }
            if (node.start < 0) { return 8; }
            if (node.length <= 0) { return 8; }
            if (node.type_code <= 0) { return 9; }
            if (node.binding_id < 0) { return 10; }
            if (node.mutable < 0) { return 11; }
            if (node.mutable > 1) { return 11; }
            next_local = checked_add(next_local, 1);
        } else {
            if (node.kind == function_mir_kind_parameter()) {
                if (node.id != next_local) { return function_mir_invalid_parameter_status(); }
                if (node.start < 0) { return function_mir_invalid_parameter_status(); }
                if (node.length <= 0) { return function_mir_invalid_parameter_status(); }
                if (node.type_code <= 0) { return function_mir_invalid_parameter_status(); }
                if (node.binding_id < 0) { return function_mir_invalid_parameter_status(); }
                if (node.symbol_code < function_mir_mode_value()) { return function_mir_invalid_parameter_status(); }
                if (node.symbol_code > function_mir_mode_mutable_borrow()) { return function_mir_invalid_parameter_status(); }
                if (node.ordinal != next_parameter) { return function_mir_invalid_parameter_status(); }
                next_parameter = checked_add(next_parameter, 1);
                next_local = checked_add(next_local, 1);
            } else {
            if (node.kind == 3) {
                if (node.id != next_local) { return 12; }
                if (node.type_code <= 0) { return 13; }
                if (node.hir_node_id < 0) { return 14; }
                next_local = checked_add(next_local, 1);
            } else {
                if (node.kind == 4) {
                    if (node.id != next_instruction) { return 15; }
                    if (node.result < 0) { return 16; }
                    if (node.start < 0) { return 17; }
                    if (node.length <= 0) { return 17; }
                    if (node.type_code <= 0) { return 18; }
                    if (node.hir_node_id < 0) { return 19; }
                    next_instruction = checked_add(next_instruction, 1);
                } else {
                    if (node.kind == 5) {
                        if (node.id != next_instruction) { return 20; }
                        if (node.result < 0) { return 21; }
                        if (node.left < 0) { return 21; }
                        if (node.right < 0) { return 21; }
                        if (node.symbol_code < 1) { return 22; }
                        if (node.symbol_code > 10) { return 22; }
                        if (node.type_code <= 0) { return 23; }
                        if (node.numeric_policy < 1) { return 24; }
                        if (node.hir_node_id < 0) { return 25; }
                        next_instruction = checked_add(next_instruction, 1);
                    } else {
                        if (node.kind == 6) {
                            if (node.id != next_instruction) { return 26; }
                            if (node.result < 0) { return 27; }
                            if (node.left < 0) { return 27; }
                            if (node.binding_id < 0) { return 28; }
                            if (node.hir_node_id < 0) { return 29; }
                            next_instruction = checked_add(next_instruction, 1);
                        } else {
                            if (node.kind == 7) {
                                if (node.left < -1) { return 30; }
                                if (node.hir_node_id < 0) { return 31; }
                                saw_return = 1;
                            } else {
                                if (node.kind == 8) {
                                    if (node.id != next_instruction) { return 34; }
                                    if (node.left < 0) { return 35; }
                                    if (node.hir_node_id < 0) { return 36; }
                                    next_instruction = checked_add(next_instruction, 1);
                                } else {
                                    if (function_mir_is_enum_instruction(node) != 0) {
                                        if (node.id != next_instruction) { return 37; }
                                        if (node.result < 0) { return 38; }
                                        if (node.left < 0) { return 38; }
                                        if (node.hir_node_id < 0) { return 39; }
                                        if (function_mir_is_construct(node) != 0) {
                                            if (node.type_code < function_mir_copy_payload_enum_type_code(0)) { return 40; }
                                            if (node.symbol_code < 0) { return 41; }
                                        }
                                        next_instruction = checked_add(next_instruction, 1);
                                    } else {
                                        if (function_mir_is_struct_construct(node) != 0) {
                                            if (node.id != next_instruction) { return function_mir_invalid_struct_record_status(); }
                                            if (node.result < 0) { return function_mir_invalid_struct_record_status(); }
                                            if (node.left < 0) { return function_mir_invalid_struct_record_status(); }
                                            if (node.hir_node_id < 0) { return function_mir_invalid_struct_record_status(); }
                                            if (node.type_code < function_mir_i64_struct_type_code(0)) { return function_mir_invalid_struct_record_status(); }
                                            if (node.symbol_code < 0) { return function_mir_invalid_struct_record_status(); }
                                            next_instruction = checked_add(next_instruction, 1);
                                        } else {
                                            if (function_mir_is_struct_field_instruction(node) != 0) {
                                                if (node.id != next_instruction) { return function_mir_invalid_struct_record_status(); }
                                                if (node.result < 0) { return function_mir_invalid_struct_record_status(); }
                                                if (node.left < 0) { return function_mir_invalid_struct_record_status(); }
                                                if (node.hir_node_id < 0) { return function_mir_invalid_struct_record_status(); }
                                                if (node.symbol_code < 0) { return function_mir_invalid_struct_record_status(); }
                                                next_instruction = checked_add(next_instruction, 1);
                                            } else {
                                                if (node.kind == function_mir_kind_call()) {
                                                    if (node.id != next_instruction) { return function_mir_invalid_call_status(); }
                                                    if (node.result < -1) { return function_mir_invalid_call_status(); }
                                                    if (node.symbol_start < 0) { return function_mir_invalid_call_status(); }
                                                    if (node.symbol_length <= 0) { return function_mir_invalid_call_status(); }
                                                    if (node.type_code <= 0) { return function_mir_invalid_call_status(); }
                                                    if (node.numeric_policy < function_mir_mode_value()) { return function_mir_invalid_call_status(); }
                                                    if (node.numeric_policy > function_mir_mode_mutable_borrow()) { return function_mir_invalid_call_status(); }
                                                    next_instruction = checked_add(next_instruction, 1);
                                                } else {
                                                    if (node.kind == function_mir_kind_call_argument()) {
                                                        if (node.id != checked_sub(next_instruction, 1)) { return function_mir_invalid_call_argument_status(); }
                                                        if (node.left < 0) { return function_mir_invalid_call_argument_status(); }
                                                        if (node.ordinal < 0) { return function_mir_invalid_call_argument_status(); }
                                                        if (node.symbol_code < function_mir_mode_value()) { return function_mir_invalid_call_argument_status(); }
                                                        if (node.symbol_code > function_mir_mode_mutable_borrow()) { return function_mir_invalid_call_argument_status(); }
                                                    } else { return 32; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
        }
        index = checked_add(index, 1);
    }
    if (saw_return == 0) { return 33; }
    if (next_parameter != header.ordinal) { return function_mir_parameter_count_mismatch_status(); }
    return 0;
}
