module bootstrap_mir_resolved_source_function_assembly
import bootstrap_tokens;
import bootstrap_statements;
import bootstrap_statement_semantics;
import bootstrap_mir_functions;
import bootstrap_mir_function_clause_metadata;
import bootstrap_mir_function_contracts;
import bootstrap_mir_function_assembly_plan;
import bootstrap_mir_function_instruction_source;
import bootstrap_mir_function_ownership_assembly;
import bootstrap_mir_source_function_record_stats;
import bootstrap_mir_resolved_source_function_pipeline;
import bootstrap_mir_match_capability_flow;
import bootstrap_mir_ownership_flow;
import bootstrap_mir_structured_lowering;
import bootstrap_mir_cfg;
import bootstrap_mir_cfg_placement;

capability allocate;

// Complete native source-function assembly boundary. Semantic lowering owns
// source interpretation; this stage only derives namespace sizes, inserts
// contract/lifecycle provenance, and lowers the resulting structured stream to
// CFG + placement records consumable by bootstrap-mir-v1 materialization.
pub fn lower_resolved_source_function_assembly(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow statements: Vec<StatementRecord>,
    borrow statement_operands: Vec<StatementOperand>,
    borrow enum_catalog: Vec<EnumVariantCatalogEntry>,
    match_enum_id: i64,
    borrow capability_catalog: Vec<CapabilityCatalogEntry>,
    borrow ownership_metadata: Vec<MirOwnershipBinding>,
    allocator: Allocator,
    borrow_mut body_records: Vec<MirFunctionRecord>,
    borrow_mut clause_metadata: Vec<MirFunctionClauseMetadata>,
    borrow_mut contract_records: Vec<MirFunctionContractRecord>,
    borrow_mut resolved_arms: Vec<ResolvedMatchArm>,
    borrow_mut resolved_scopes: Vec<ResolvedCapabilityScope>,
    borrow_mut ownership_events: Vec<MirOwnershipEvent>,
    borrow_mut capability_effects: Vec<MirCapabilityEffect>,
    borrow_mut ownership_records: Vec<MirOwnershipRecord>,
    borrow_mut contract_locals: Vec<MirFunctionContractLocal>,
    borrow_mut required_capabilities: Vec<i64>,
    borrow_mut instruction_sources: Vec<MirFunctionInstructionSource>,
    borrow_mut assembled_events: Vec<MirLowerEvent>,
    borrow_mut cfg_records: Vec<MirCfgRecord>,
    borrow_mut placements: Vec<MirPlacementRecord>
) -> i32
requires_caps [allocate]
{
    var canonical_events: Vec<MirLowerEvent> = vec_new<MirLowerEvent>(allocator, 128);
    let semantic_status: i32 = lower_resolved_source_function_semantics(
        source, tokens, statements, statement_operands,
        enum_catalog, match_enum_id, capability_catalog, ownership_metadata,
        allocator, body_records, clause_metadata, contract_records,
        resolved_arms, resolved_scopes, ownership_events, capability_effects,
        canonical_events, ownership_records
    );
    if (semantic_status != 0) { return checked_add(1000, semantic_status); }

    var stats: Vec<i64> = vec_new<i64>(allocator, 4);
    let stats_status: i32 = source_function_record_stats(body_records, stats);
    if (stats_status != 0) { return checked_add(2000, stats_status); }
    if (vec_len<i64>(stats) != 4) { return 2005; }
    let binding_count: i64 = vec_get<i64>(stats, 0);
    let body_local_count: i64 = vec_get<i64>(stats, 1);
    let body_instruction_count: i64 = vec_get<i64>(stats, 2);
    let return_count: i64 = vec_get<i64>(stats, 3);
    if (return_count <= 0) { return 2006; }

    let plan_status: i32 = plan_function_contract_namespace(
        clause_metadata, contract_records, binding_count, body_local_count,
        contract_locals, required_capabilities
    );
    if (plan_status != 0) { return checked_add(3000, plan_status); }

    let assembly_status: i32 = assemble_function_mir_events_with_ownership(
        contract_records, canonical_events, ownership_records, ownership_metadata,
        binding_count, body_local_count, body_instruction_count, allocator,
        assembled_events, instruction_sources
    );
    if (assembly_status != 0) { return checked_add(4000, assembly_status); }

    let cfg_status: i32 = lower_structured_mir(
        assembled_events, allocator, cfg_records, placements
    );
    if (cfg_status != 0) { return checked_add(5000, cfg_status); }

    if (validate_function_assembly_sources(instruction_sources) != 0) { return 6001; }
    if (vec_len<MirPlacementRecord>(placements) != vec_len<MirFunctionInstructionSource>(instruction_sources)) {
        return 6002;
    }

    drop(stats);
    drop(canonical_events);
    return 0;
}
