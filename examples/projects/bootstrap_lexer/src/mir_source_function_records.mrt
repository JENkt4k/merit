pub fn sfr_builtin_call_return_type(kind: i32) -> i32 {
    if (kind == sfr_builtin_system_allocator_kind()) { return function_mir_allocator_type_code(); }
    if (kind == sfr_builtin_portable_allocator_kind()) { return function_mir_allocator_type_code(); }
    if (kind == sfr_builtin_allocator_compatible_kind()) { return function_mir_i32_type_code(); }
    if (kind == sfr_builtin_buffer_new_kind()) { return function_mir_buffer_type_code(); }
    if (kind == sfr_builtin_buffer_from_string_kind()) { return function_mir_buffer_type_code(); }
    if (kind == sfr_builtin_buffer_push_kind()) { return function_mir_unit_type_code(); }
    if (kind == sfr_builtin_buffer_len_kind()) { return function_mir_i64_type_code(); }
    if (kind == sfr_builtin_buffer_get_kind()) { return function_mir_i64_type_code(); }
    if (kind == sfr_builtin_buffer_slice_kind()) { return function_mir_byte_slice_type_code(); }
    if (kind == sfr_builtin_buffer_allocator_kind()) { return function_mir_allocator_type_code(); }
    if (kind == sfr_builtin_string_len_kind()) { return function_mir_i64_type_code(); }
    if (kind == sfr_builtin_string_byte_kind()) { return function_mir_u8_type_code(); }
    if (kind == sfr_builtin_slice_len_kind()) { return function_mir_i64_type_code(); }
    if (kind == sfr_builtin_slice_get_kind()) { return function_mir_i64_type_code(); }
    return function_mir_unresolved_type_code();
}

pub fn sfr_builtin_requires_allocate(kind:i32)->i32{
    if(kind==sfr_builtin_buffer_new_kind()){return 1;}
    if(kind==sfr_builtin_buffer_from_string_kind()){return 1;}
    if(kind==sfr_builtin_buffer_push_kind()){return 1;}
    return 0;
}

pub fn sfr_unit_expression_result()->i64{return -39;}

fn sfr_builtin_call_parameter_count(kind: i32) -> i64 {
    if (kind == sfr_builtin_system_allocator_kind()) { return 0; }
    if (kind == sfr_builtin_portable_allocator_kind()) { return 0; }
    if (kind == sfr_builtin_allocator_compatible_kind()) { return 2; }
    if (kind == sfr_builtin_buffer_new_kind()) { return 2; }
    if (kind == sfr_builtin_buffer_from_string_kind()) { return 2; }
    if (kind == sfr_builtin_buffer_push_kind()) { return 2; }
    if (kind == sfr_builtin_buffer_len_kind()) { return 1; }
    if (kind == sfr_builtin_buffer_get_kind()) { return 2; }
    if (kind == sfr_builtin_buffer_slice_kind()) { return 3; }
    if (kind == sfr_builtin_buffer_allocator_kind()) { return 1; }
    if (kind == sfr_builtin_string_len_kind()) { return 1; }
    if (kind == sfr_builtin_string_byte_kind()) { return 2; }
    if (kind == sfr_builtin_slice_len_kind()) { return 1; }
    if (kind == sfr_builtin_slice_get_kind()) { return 2; }
    return -1;
}

fn sfr_builtin_call_parameter_mode(kind: i32, ordinal: i64) -> i32 {
    if (kind == sfr_builtin_buffer_len_kind()) { if (ordinal == 0) { return function_mir_mode_borrowed(); } }
    if (kind == sfr_builtin_buffer_get_kind()) { if (ordinal == 0) { return function_mir_mode_borrowed(); } }
    if (kind == sfr_builtin_buffer_slice_kind()) { if (ordinal == 0) { return function_mir_mode_borrowed(); } }
    if (kind == sfr_builtin_buffer_allocator_kind()) { if (ordinal == 0) { return function_mir_mode_borrowed(); } }
    if (kind == sfr_builtin_buffer_push_kind()) { if (ordinal == 0) { return function_mir_mode_mutable_borrow(); } }
    return function_mir_mode_value();
}

fn sfr_builtin_call_parameter_type(kind:i32,ordinal:i64)->i32{
    if(kind==sfr_builtin_allocator_compatible_kind()){return function_mir_allocator_type_code();}
    if(kind==sfr_builtin_buffer_new_kind()){if(ordinal==0){return function_mir_allocator_type_code();}return function_mir_i64_type_code();}
    if(kind==sfr_builtin_buffer_from_string_kind()){if(ordinal==0){return function_mir_allocator_type_code();}return function_mir_string_type_code();}
    if(kind==sfr_builtin_buffer_push_kind()){if(ordinal==0){return function_mir_buffer_type_code();}return function_mir_u8_type_code();}
    if(kind==sfr_builtin_buffer_len_kind()){return function_mir_buffer_type_code();}
    if(kind==sfr_builtin_buffer_get_kind()){if(ordinal==0){return function_mir_buffer_type_code();}return function_mir_i64_type_code();}
    if(kind==sfr_builtin_buffer_slice_kind()){if(ordinal==0){return function_mir_buffer_type_code();}return function_mir_i64_type_code();}
    if(kind==sfr_builtin_buffer_allocator_kind()){return function_mir_buffer_type_code();}
    if(kind==sfr_builtin_string_len_kind()){return function_mir_string_type_code();}
    if(kind==sfr_builtin_string_byte_kind()){if(ordinal==0){return function_mir_string_type_code();}return function_mir_i64_type_code();}
    if(kind==sfr_builtin_slice_len_kind()){return function_mir_byte_slice_type_code();}
    if(kind==sfr_builtin_slice_get_kind()){if(ordinal==0){return function_mir_byte_slice_type_code();}return function_mir_i64_type_code();}
    return function_mir_unresolved_type_code();
}

