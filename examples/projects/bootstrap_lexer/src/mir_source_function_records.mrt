        if(buffer_get(source,checked_add(start,13))!=sfr_ascii_t()){matches=0;}
        if(buffer_get(source,checked_add(start,14))!=sfr_ascii_o()){matches=0;}
        if(buffer_get(source,checked_add(start,15))!=sfr_ascii_r()){matches=0;}
        if(matches!=0){return sfr_builtin_system_allocator_kind();}
    }
    if (length == 10) {
        matches=1;
        if(buffer_get(source,start)!=sfr_ascii_b()){matches=0;}
        if(buffer_get(source,checked_add(start,1))!=sfr_ascii_u()){matches=0;}
        if(buffer_get(source,checked_add(start,2))!=sfr_ascii_f()){matches=0;}
        if(buffer_get(source,checked_add(start,3))!=sfr_ascii_f()){matches=0;}
        if(buffer_get(source,checked_add(start,4))!=sfr_ascii_e()){matches=0;}
        if(buffer_get(source,checked_add(start,5))!=sfr_ascii_r()){matches=0;}
        if(buffer_get(source,checked_add(start,6))!=sfr_ascii_underscore()){matches=0;}
        if(buffer_get(source,checked_add(start,7))!=sfr_ascii_n()){matches=0;}
        if(buffer_get(source,checked_add(start,8))!=sfr_ascii_e()){matches=0;}
        if(buffer_get(source,checked_add(start,9))!=sfr_ascii_w()){matches=0;}
        if(matches!=0){return sfr_builtin_buffer_new_kind();}
        matches=1;
        if(buffer_get(source,start)!=sfr_ascii_b()){matches=0;}
        if(buffer_get(source,checked_add(start,1))!=sfr_ascii_u()){matches=0;}
        if(buffer_get(source,checked_add(start,2))!=sfr_ascii_f()){matches=0;}
        if(buffer_get(source,checked_add(start,3))!=sfr_ascii_f()){matches=0;}
        if(buffer_get(source,checked_add(start,4))!=sfr_ascii_e()){matches=0;}
        if(buffer_get(source,checked_add(start,5))!=sfr_ascii_r()){matches=0;}
        if(buffer_get(source,checked_add(start,6))!=sfr_ascii_underscore()){matches=0;}
        if(buffer_get(source,checked_add(start,7))!=sfr_ascii_l()){matches=0;}
        if(buffer_get(source,checked_add(start,8))!=sfr_ascii_e()){matches=0;}
        if(buffer_get(source,checked_add(start,9))!=sfr_ascii_n()){matches=0;}
        if(matches!=0){return sfr_builtin_buffer_len_kind();}
        matches=1;
        if(buffer_get(source,start)!=sfr_ascii_s()){matches=0;}
        if(buffer_get(source,checked_add(start,1))!=sfr_ascii_t()){matches=0;}
        if(buffer_get(source,checked_add(start,2))!=sfr_ascii_r()){matches=0;}
        if(buffer_get(source,checked_add(start,3))!=sfr_ascii_i()){matches=0;}
        if(buffer_get(source,checked_add(start,4))!=sfr_ascii_n()){matches=0;}
        if(buffer_get(source,checked_add(start,5))!=sfr_ascii_g()){matches=0;}
        if(buffer_get(source,checked_add(start,6))!=sfr_ascii_underscore()){matches=0;}
        if(buffer_get(source,checked_add(start,7))!=sfr_ascii_l()){matches=0;}
        if(buffer_get(source,checked_add(start,8))!=sfr_ascii_e()){matches=0;}
        if(buffer_get(source,checked_add(start,9))!=sfr_ascii_n()){matches=0;}
        if(matches!=0){return sfr_builtin_string_len_kind();}
    }
    return 0;
}

pub fn sfr_builtin_call_return_type(kind: i32) -> i32 {
    if (kind == sfr_builtin_system_allocator_kind()) { return function_mir_allocator_type_code(); }
    if (kind == sfr_builtin_portable_allocator_kind()) { return function_mir_allocator_type_code(); }
    if (kind == sfr_builtin_allocator_compatible_kind()) { return function_mir_i32_type_code(); }
    if (kind == sfr_builtin_buffer_new_kind()) { return function_mir_buffer_type_code(); }
    if (kind == sfr_builtin_buffer_from_string_kind()) { return function_mir_buffer_type_code(); }
    if (kind == sfr_builtin_buffer_push_kind()) { return function_mir_unit_type_code(); }
    if (kind == sfr_builtin_buffer_len_kind()) { return function_mir_i64_type_code(); }
    if (kind == sfr_builtin_buffer_get_kind()) { return function_mir_i64_type_code(); }
    if (kind == sfr_builtin_buffer_slice_kind()) { return function_mir_byte_slice_type_code(); }
    if (kind == sfr_builtin_buffer_allocator_kind()) { return function_mir_allocator_type_code(); }
    if (kind == sfr_builtin_string_len_kind()) { return function_mir_i64_type_code(); }
    if (kind == sfr_builtin_string_byte_kind()) { return function_mir_u8_type_code(); }
    if (kind == sfr_builtin_slice_len_kind()) { return function_mir_i64_type_code(); }
    if (kind == sfr_builtin_slice_get_kind()) { return function_mir_i64_type_code(); }
    return function_mir_unresolved_type_code();
}

pub fn sfr_builtin_requires_allocate(kind:i32)->i32{
    if(kind==sfr_builtin_buffer_new_kind()){return 1;}
    if(kind==sfr_builtin_buffer_from_string_kind()){return 1;}
    if(kind==sfr_builtin_buffer_push_kind()){return 1;}
    return 0;
}

pub fn sfr_unit_expression_result()->i64{return -39;}

fn sfr_builtin_call_parameter_count(kind: i32) -> i64 {
    if (kind == sfr_builtin_system_allocator_kind()) { return 0; }
    if (kind == sfr_builtin_portable_allocator_kind()) { return 0; }
    if (kind == sfr_builtin_allocator_compatible_kind()) { return 2; }
    if (kind == sfr_builtin_buffer_new_kind()) { return 2; }
    if (kind == sfr_builtin_buffer_from_string_kind()) { return 2; }
    if (kind == sfr_builtin_buffer_push_kind()) { return 2; }
    if (kind == sfr_builtin_buffer_len_kind()) { return 1; }
    if (kind == sfr_builtin_buffer_get_kind()) { return 2; }
    if (kind == sfr_builtin_buffer_slice_kind()) { return 3; }
    if (kind == sfr_builtin_buffer_allocator_kind()) { return 1; }
    if (kind == sfr_builtin_string_len_kind()) { return 1; }
    if (kind == sfr_builtin_string_byte_kind()) { return 2; }
    if (kind == sfr_builtin_slice_len_kind()) { return 1; }
    if (kind == sfr_builtin_slice_get_kind()) { return 2; }
    return -1;
}

fn sfr_builtin_call_parameter_mode(kind: i32, ordinal: i64) -> i32 {
    if (kind == sfr_builtin_buffer_len_kind()) { if (ordinal == 0) { return function_mir_mode_borrowed(); } }
    if (kind == sfr_builtin_buffer_get_kind()) { if (ordinal == 0) { return function_mir_mode_borrowed(); } }
    if (kind == sfr_builtin_buffer_slice_kind()) { if (ordinal == 0) { return function_mir_mode_borrowed(); } }
    if (kind == sfr_builtin_buffer_allocator_kind()) { if (ordinal == 0) { return function_mir_mode_borrowed(); } }
    if (kind == sfr_builtin_buffer_push_kind()) { if (ordinal == 0) { return function_mir_mode_mutable_borrow(); } }
    return function_mir_mode_value();
}

fn sfr_builtin_call_parameter_type(kind:i32,ordinal:i64)->i32{
    if(kind==sfr_builtin_allocator_compatible_kind()){return function_mir_allocator_type_code();}
    if(kind==sfr_builtin_buffer_new_kind()){if(ordinal==0){return function_mir_allocator_type_code();}return function_mir_i64_type_code();}
    if(kind==sfr_builtin_buffer_from_string_kind()){if(ordinal==0){return function_mir_allocator_type_code();}return function_mir_string_type_code();}
    if(kind==sfr_builtin_buffer_push_kind()){if(ordinal==0){return function_mir_buffer_type_code();}return function_mir_u8_type_code();}
    if(kind==sfr_builtin_buffer_len_kind()){return function_mir_buffer_type_code();}
    if(kind==sfr_builtin_buffer_get_kind()){if(ordinal==0){return function_mir_buffer_type_code();}return function_mir_i64_type_code();}
    if(kind==sfr_builtin_buffer_slice_kind()){if(ordinal==0){return function_mir_buffer_type_code();}return function_mir_i64_type_code();}
    if(kind==sfr_builtin_buffer_allocator_kind()){return function_mir_buffer_type_code();}
    if(kind==sfr_builtin_string_len_kind()){return function_mir_string_type_code();}
    if(kind==sfr_builtin_string_byte_kind()){if(ordinal==0){return function_mir_string_type_code();}return function_mir_i64_type_code();}
    if(kind==sfr_builtin_slice_len_kind()){return function_mir_byte_slice_type_code();}
    if(kind==sfr_builtin_slice_get_kind()){if(ordinal==0){return function_mir_byte_slice_type_code();}return function_mir_i64_type_code();}
    return function_mir_unresolved_type_code();
}

fn sfr_is_destructor(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != 1) { return 0; }
    if (token_length(token) != 10) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != sfr_ascii_d()) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != sfr_ascii_e()) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != sfr_ascii_s()) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != sfr_ascii_t()) { return 0; }
    if (buffer_get(source, checked_add(start, 4)) != sfr_ascii_r()) { return 0; }
    if (buffer_get(source, checked_add(start, 5)) != sfr_ascii_u()) { return 0; }
    if (buffer_get(source, checked_add(start, 6)) != sfr_ascii_c()) { return 0; }
    if (buffer_get(source, checked_add(start, 7)) != sfr_ascii_t()) { return 0; }
    if (buffer_get(source, checked_add(start, 8)) != sfr_ascii_o()) { return 0; }
    if (buffer_get(source, checked_add(start, 9)) != sfr_ascii_r()) { return 0; }
    return 1;
}
pub fn source_token_is_destructor(borrow source: Buffer, borrow token: Token) -> i32 {
    return sfr_is_destructor(source, token);
}

fn sfr_i64_struct_destructor_count(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow name: Token
) -> i32 {
    var count: i32 = 0;
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (sfr_is_destructor(source, token) != 0) {
            let target_index: i64 = checked_add(index, 1);
            if (target_index >= vec_len<Token>(tokens)) { return -1; }
            let target: Token = vec_get<Token>(tokens, target_index);
            if (sfr_span_equal(source, token_start(target), token_length(target), token_start(name), token_length(name)) != 0) {
                count = checked_add(count, 1);
            }
        }
        index = checked_add(index, 1);
    }
    return count;
}

// Canonical source spellings at the native type-recognition boundary.
fn sfr_integer_type_letter_i() -> i64 { return 105; }
fn sfr_integer_type_letter_u() -> i64 { return 117; }
fn sfr_integer_type_digit_8() -> i64 { return 56; }
fn sfr_integer_type_digit_1() -> i64 { return 49; }
fn sfr_integer_type_digit_6() -> i64 { return 54; }
fn sfr_integer_type_digit_4() -> i64 { return 52; }
fn sfr_integer_type_digit_3() -> i64 { return 51; }
fn sfr_integer_type_digit_2() -> i64 { return 50; }
fn sfr_declared_struct_depth_limit() -> i64 { return 32; }

fn sfr_is_scalar_integer_type(borrow source: Buffer, start: i64, length: i64) -> i32 {
    if (sfr_integer_type_code(source, start, length) == function_mir_unresolved_type_code()) { return 0; }
    return 1;
}

fn sfr_integer_type_code(borrow source: Buffer, start: i64, length: i64) -> i32 {
    if (length == 2) {
        let letter: i64 = buffer_get(source, start);
        if (buffer_get(source, checked_add(start, 1)) != sfr_integer_type_digit_8()) { return function_mir_unresolved_type_code(); }
        if (letter == sfr_integer_type_letter_i()) { return function_mir_i8_type_code(); }
        if (letter == sfr_integer_type_letter_u()) { return function_mir_u8_type_code(); }
        return function_mir_unresolved_type_code();
    }
    if (length != 3) { return function_mir_unresolved_type_code(); }
    let letter: i64 = buffer_get(source, start);
    let tens: i64 = buffer_get(source, checked_add(start, 1));
    let ones: i64 = buffer_get(source, checked_add(start, 2));
    if (letter == sfr_integer_type_letter_i()) {
        if (tens == sfr_integer_type_digit_1()) { if (ones == sfr_integer_type_digit_6()) { return function_mir_i16_type_code(); } }
        if (tens == sfr_integer_type_digit_3()) { if (ones == sfr_integer_type_digit_2()) { return function_mir_i32_type_code(); } }
        if (tens == sfr_integer_type_digit_6()) { if (ones == sfr_integer_type_digit_4()) { return function_mir_i64_type_code(); } }
    }
    if (letter == sfr_integer_type_letter_u()) {
        if (tens == sfr_integer_type_digit_1()) { if (ones == sfr_integer_type_digit_6()) { return function_mir_u16_type_code(); } }
        if (tens == sfr_integer_type_digit_3()) { if (ones == sfr_integer_type_digit_2()) { return function_mir_u32_type_code(); } }
        if (tens == sfr_integer_type_digit_6()) { if (ones == sfr_integer_type_digit_4()) { return function_mir_u64_type_code(); } }
    }
    return function_mir_unresolved_type_code();
}

pub fn sfr_builtin_type_code(borrow source: Buffer, start: i64, length: i64) -> i32 {
    let integer_type_code: i32 = sfr_integer_type_code(source, start, length);
    if (integer_type_code != function_mir_unresolved_type_code()) { return integer_type_code; }
    if (length == 6) {
        if (buffer_get(source, start) == sfr_ascii_upper_s()) {
            if (buffer_get(source, checked_add(start, 1)) == sfr_ascii_t()) {
                if (buffer_get(source, checked_add(start, 2)) == sfr_ascii_r()) {
                    if (buffer_get(source, checked_add(start, 3)) == sfr_ascii_i()) {
                        if (buffer_get(source, checked_add(start, 4)) == sfr_ascii_n()) {
                            if (buffer_get(source, checked_add(start, 5)) == sfr_ascii_g()) { return function_mir_string_type_code(); }
                        }
                    }
                }
            }
        }
        if (buffer_get(source, start) == sfr_ascii_upper_b()) {
            if (buffer_get(source, checked_add(start, 1)) == sfr_ascii_u()) {
                if (buffer_get(source, checked_add(start, 2)) == sfr_ascii_f()) {
                    if (buffer_get(source, checked_add(start, 3)) == sfr_ascii_f()) {
                        if (buffer_get(source, checked_add(start, 4)) == sfr_ascii_e()) {
                            if (buffer_get(source, checked_add(start, 5)) == sfr_ascii_r()) { return function_mir_buffer_type_code(); }
                        }
                    }
                }
            }
        }
    }
    if (length == 9) {
        if (buffer_get(source, start) == sfr_ascii_upper_b()) {
            if (buffer_get(source, checked_add(start, 1)) == sfr_ascii_y()) {
                if (buffer_get(source, checked_add(start, 2)) == sfr_ascii_t()) {
                    if (buffer_get(source, checked_add(start, 3)) == sfr_ascii_e()) {
                        if (buffer_get(source, checked_add(start, 4)) == sfr_ascii_upper_s()) {
                            if (buffer_get(source, checked_add(start, 5)) == sfr_ascii_l()) {
                                if (buffer_get(source, checked_add(start, 6)) == sfr_ascii_i()) {
                                    if (buffer_get(source, checked_add(start, 7)) == sfr_ascii_c()) {
                                        if (buffer_get(source, checked_add(start, 8)) == sfr_ascii_e()) { return function_mir_byte_slice_type_code(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if (buffer_get(source, start) == sfr_ascii_upper_a()) {
            if (buffer_get(source, checked_add(start, 1)) == sfr_ascii_l()) {
                if (buffer_get(source, checked_add(start, 2)) == sfr_ascii_l()) {
                    if (buffer_get(source, checked_add(start, 3)) == sfr_ascii_o()) {
                        if (buffer_get(source, checked_add(start, 4)) == sfr_ascii_c()) {
                            if (buffer_get(source, checked_add(start, 5)) == sfr_ascii_a()) {
                                if (buffer_get(source, checked_add(start, 6)) == sfr_ascii_t()) {
                                    if (buffer_get(source, checked_add(start, 7)) == sfr_ascii_o()) {
                                        if (buffer_get(source, checked_add(start, 8)) == sfr_ascii_r()) { return function_mir_allocator_type_code(); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    return function_mir_unresolved_type_code();
}

// Derive canonical ordered field rows for declared structs. Each field is one
// row so v3 descriptors can represent arbitrary finite aggregate arity without
// embedding a variable-width schema in an implementation-language handoff.
fn sfr_numeric_bound_fits(
    base_type:i32, sign:i32, borrow magnitude:SfrNumericMagnitude
)->i32{
    if(base_type==function_mir_i8_type_code()){
        if(sign<0){return sfr_magnitude_at_most(magnitude,0,128);}
        return sfr_magnitude_at_most(magnitude,0,127);
    }
    if(base_type==function_mir_i16_type_code()){
        if(sign<0){return sfr_magnitude_at_most(magnitude,0,32768);}
        return sfr_magnitude_at_most(magnitude,0,32767);
    }
    if(base_type==function_mir_i32_type_code()){
        if(sign<0){return sfr_magnitude_at_most(magnitude,2,147483648);}
        return sfr_magnitude_at_most(magnitude,2,147483647);
    }
    if(base_type==function_mir_i64_type_code()){
        if(sign<0){return sfr_magnitude_at_most(magnitude,9223372036,854775808);}
        return sfr_magnitude_at_most(magnitude,9223372036,854775807);
    }
    if(sign<0){return 0;}
    if(base_type==function_mir_u8_type_code()){return sfr_magnitude_at_most(magnitude,0,255);}
    if(base_type==function_mir_u16_type_code()){return sfr_magnitude_at_most(magnitude,0,65535);}
    if(base_type==function_mir_u32_type_code()){return sfr_magnitude_at_most(magnitude,4,294967295);}
    if(base_type==function_mir_u64_type_code()){return sfr_magnitude_at_most(magnitude,18446744073,709551615);}
    return 0;
}

pub fn derive_source_numeric_type_descriptors(
    borrow source:Buffer,borrow tokens:Vec<Token>,borrow_mut output:Vec<MirNumericTypeDescriptor>
)->i32
requires_caps [allocate]
{
    var decimal_identity:i32=0;var bounded_identity:i32=0;var index:i64=0;
    while(index<vec_len<Token>(tokens)){
        let keyword:Token=vec_get<Token>(tokens,index);
        if(sfr_is_decimal_declaration(source,keyword)!=0){
            let end:i64=checked_add(index,8);if(end>=vec_len<Token>(tokens)){return 1;}
            let name:Token=vec_get<Token>(tokens,checked_add(index,1));
            let open:Token=vec_get<Token>(tokens,checked_add(index,2));
            let precision_token:Token=vec_get<Token>(tokens,checked_add(index,3));
            let first_comma:Token=vec_get<Token>(tokens,checked_add(index,4));
            let scale_token:Token=vec_get<Token>(tokens,checked_add(index,5));
            let second_comma:Token=vec_get<Token>(tokens,checked_add(index,6));
            let policy_token:Token=vec_get<Token>(tokens,checked_add(index,7));
            let close:Token=vec_get<Token>(tokens,end);
            let semicolon_index:i64=checked_add(end,1);if(semicolon_index>=vec_len<Token>(tokens)){return 1;}
            let semicolon:Token=vec_get<Token>(tokens,semicolon_index);
            if(token_kind(name)!=token_identifier_kind()){return 1;}
            if(sfr_token_byte_is(source,open,sfr_ascii_left_paren())==0){return 1;}
            if(sfr_token_byte_is(source,first_comma,sfr_ascii_comma())==0){return 1;}
            if(sfr_token_byte_is(source,second_comma,sfr_ascii_comma())==0){return 1;}
            if(sfr_token_byte_is(source,close,sfr_ascii_right_paren())==0){return 1;}
            if(sfr_token_byte_is(source,semicolon,sfr_ascii_semicolon())==0){return 1;}
            let precision:SfrNumericMagnitude=sfr_parse_numeric_magnitude(source,precision_token);
            let scale:SfrNumericMagnitude=sfr_parse_numeric_magnitude(source,scale_token);
            let policy:i32=sfr_decimal_policy(source,policy_token);
            if(precision.high!=0){return 1;}if(scale.high!=0){return 1;}
            if(precision.low<1){return 1;}if(scale.low>precision.low){return 1;}if(policy<0){return 1;}
            vec_push<MirNumericTypeDescriptor>(output,function_mir_numeric_descriptor(
                function_mir_decimal_type_code(decimal_identity),function_mir_numeric_descriptor_decimal_kind(),
                decimal_identity,0,0,precision.low,scale.low,0,0,0,policy
            ));
            decimal_identity=checked_add(decimal_identity,1);index=checked_add(semicolon_index,1);
        }else{
        if(sfr_is_bounded_declaration(source,keyword)!=0){
            let name_index:i64=checked_add(index,1);let open_index:i64=checked_add(index,2);
            let base_index:i64=checked_add(index,3);let comma_one_index:i64=checked_add(index,4);
            if(comma_one_index>=vec_len<Token>(tokens)){return 1;}
            let name:Token=vec_get<Token>(tokens,name_index);let open:Token=vec_get<Token>(tokens,open_index);
            let base:Token=vec_get<Token>(tokens,base_index);let comma_one:Token=vec_get<Token>(tokens,comma_one_index);
            if(token_kind(name)!=token_identifier_kind()){return 1;}
            if(sfr_token_byte_is(source,open,sfr_ascii_left_paren())==0){return 1;}
            if(sfr_token_byte_is(source,comma_one,sfr_ascii_comma())==0){return 1;}
            let base_type:i32=sfr_builtin_type_code(source,token_start(base),token_length(base));
            var cursor:i64=checked_add(comma_one_index,1);var lower_sign:i32=1;
            if(cursor>=vec_len<Token>(tokens)){return 1;}
            let lower_first:Token=vec_get<Token>(tokens,cursor);
            if(sfr_token_byte_is(source,lower_first,sfr_ascii_hyphen())!=0){lower_sign=-1;cursor=checked_add(cursor,1);}
            if(cursor>=vec_len<Token>(tokens)){return 1;}
            let lower_token:Token=vec_get<Token>(tokens,cursor);let lower:SfrNumericMagnitude=sfr_parse_numeric_magnitude(source,lower_token);
            cursor=checked_add(cursor,1);if(cursor>=vec_len<Token>(tokens)){return 1;}
            let comma_two:Token=vec_get<Token>(tokens,cursor);if(sfr_token_byte_is(source,comma_two,sfr_ascii_comma())==0){return 1;}
            cursor=checked_add(cursor,1);var upper_sign:i32=1;if(cursor>=vec_len<Token>(tokens)){return 1;}
            let upper_first:Token=vec_get<Token>(tokens,cursor);
            if(sfr_token_byte_is(source,upper_first,sfr_ascii_hyphen())!=0){upper_sign=-1;cursor=checked_add(cursor,1);}
            if(cursor>=vec_len<Token>(tokens)){return 1;}
            let upper_token:Token=vec_get<Token>(tokens,cursor);let upper:SfrNumericMagnitude=sfr_parse_numeric_magnitude(source,upper_token);
            cursor=checked_add(cursor,1);if(cursor>=vec_len<Token>(tokens)){return 1;}
            let close:Token=vec_get<Token>(tokens,cursor);cursor=checked_add(cursor,1);if(cursor>=vec_len<Token>(tokens)){return 1;}
            let semicolon:Token=vec_get<Token>(tokens,cursor);
            if(sfr_token_byte_is(source,close,sfr_ascii_right_paren())==0){return 1;}
            if(sfr_token_byte_is(source,semicolon,sfr_ascii_semicolon())==0){return 1;}
            if(lower.high<0){return 1;}if(upper.high<0){return 1;}
            lower_sign=sfr_numeric_sign(lower_sign,lower);upper_sign=sfr_numeric_sign(upper_sign,upper);
            if(sfr_numeric_bound_fits(base_type,lower_sign,lower)==0){return 1;}
            if(sfr_numeric_bound_fits(base_type,upper_sign,upper)==0){return 1;}
            if(sfr_signed_magnitude_compare(lower_sign,lower,upper_sign,upper)>0){return 1;}
            vec_push<MirNumericTypeDescriptor>(output,function_mir_numeric_descriptor(
                function_mir_bounded_type_code(bounded_identity),function_mir_numeric_descriptor_bounded_kind(),
                bounded_identity,base_type,lower_sign,lower.high,lower.low,upper_sign,upper.high,upper.low,0
            ));
            bounded_identity=checked_add(bounded_identity,1);index=checked_add(cursor,1);
        }else{index=checked_add(index,1);}
        }
    }
    return 0;
}

pub fn derive_i64_struct_catalog(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow_mut output: Vec<I64StructCatalogEntry>
) -> i32
requires_caps [allocate]
{
    var struct_id: i32 = 0;
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (sfr_is_struct(source, token) != 0) {
            let name_index: i64 = checked_add(index, 1);
            if (name_index >= vec_len<Token>(tokens)) { return i64_struct_catalog_invalid_status(); }
            let name: Token = vec_get<Token>(tokens, name_index);
            let open_index: i64 = checked_add(name_index, 1);
            if (open_index >= vec_len<Token>(tokens)) { return i64_struct_catalog_invalid_status(); }
            let open: Token = vec_get<Token>(tokens, open_index);
            if (sfr_token_byte_is(source, open, sfr_ascii_open_brace()) == 0) { return i64_struct_catalog_invalid_status(); }
            var cursor: i64 = checked_add(open_index, 1);
            var field_ordinal: i32 = 0;
            var selected_destructor_policy: i32 = 0;
            let destructor_count: i32 = sfr_i64_struct_destructor_count(source, tokens, name);
            if (destructor_count < 0) { return i64_struct_catalog_invalid_status(); }
            if (destructor_count > 1) { return i64_struct_catalog_invalid_status(); }
            var closed: i32 = 0;
            while (closed == 0) {
                if (cursor >= vec_len<Token>(tokens)) { return i64_struct_catalog_invalid_status(); }
                let candidate: Token = vec_get<Token>(tokens, cursor);
                if (sfr_token_byte_is(source, candidate, sfr_ascii_close_brace()) != 0) {
                    closed = 1;
                } else {
                let field_index: i64 = cursor;
                let colon_index: i64 = checked_add(cursor, 1);
                let type_index: i64 = checked_add(cursor, 2);
                let semicolon_index: i64 = checked_add(cursor, 3);
                if (semicolon_index >= vec_len<Token>(tokens)) { return i64_struct_catalog_invalid_status(); }
                let field: Token = vec_get<Token>(tokens, field_index);
                let colon: Token = vec_get<Token>(tokens, colon_index);
                let field_type: Token = vec_get<Token>(tokens, type_index);
                let semicolon: Token = vec_get<Token>(tokens, semicolon_index);
                if (token_kind(field) != 1) { return i64_struct_catalog_invalid_status(); }
                if (token_kind(field_type) != 1) { return i64_struct_catalog_invalid_status(); }
                if (sfr_token_byte_is(source, colon, sfr_ascii_colon()) == 0) { return i64_struct_catalog_invalid_status(); }
                if (sfr_token_byte_is(source, semicolon, sfr_ascii_semicolon()) == 0) { return i64_struct_catalog_invalid_status(); }
                var destructor_policy: i32 = 0;
                if (destructor_count == 1) {
                    if (field_ordinal == 0) { destructor_policy = 1; }
                }
                if (destructor_policy != 0) { selected_destructor_policy = checked_add(selected_destructor_policy, 1); }
                var resolved_field_type:i32=sfr_builtin_type_code(
                    source,token_start(field_type),token_length(field_type)
                );
                if(sfr_is_scalar_integer_type(source,token_start(field_type),token_length(field_type))!=0){
                    resolved_field_type=function_mir_i64_type_code();
                }
                if(resolved_field_type==function_mir_unresolved_type_code()){
                    resolved_field_type=sfr_declared_numeric_type_code(
                        source,tokens,token_start(field_type),token_length(field_type)
                    );
                }
                vec_push<I64StructCatalogEntry>(output, I64StructCatalogEntry {
                    struct_id: struct_id,
                    field_ordinal: field_ordinal,
                    name_start: token_start(name), name_length: token_length(name),
                    field_start: token_start(field), field_length: token_length(field),
                    field_type_start: token_start(field_type), field_type_length: token_length(field_type),
                    resolved_field_type_code:resolved_field_type,
                    destructor_policy: destructor_policy
                });
                field_ordinal = checked_add(field_ordinal, 1);
                cursor = checked_add(cursor, 4);
                }
            }
            if (field_ordinal == 0) { return i64_struct_catalog_invalid_status(); }
            if (destructor_count != selected_destructor_policy) { return i64_struct_catalog_invalid_status(); }
            struct_id = checked_add(struct_id, 1);
        }
        index = checked_add(index, 1);
    }
    var validate_index: i64 = 0;
    while (validate_index < vec_len<I64StructCatalogEntry>(output)) {
        let entry: I64StructCatalogEntry = vec_get<I64StructCatalogEntry>(output, validate_index);
        if (entry.field_ordinal == 0) {
            let resolved: i32 = source_i64_struct_type_code(source, output, entry.name_start, entry.name_length);
            if (resolved == function_mir_unresolved_type_code()) { return i64_struct_catalog_invalid_status(); }
        }
        validate_index = checked_add(validate_index, 1);
    }
    return 0;
}

fn source_i64_struct_type_code_depth(
    borrow source: Buffer, borrow catalog: Vec<I64StructCatalogEntry>,
    start: i64, length: i64, depth: i64
) -> i32 {
    if (depth >= sfr_declared_struct_depth_limit()) { return function_mir_unresolved_type_code(); }
    var index: i64 = 0;
    while (index < vec_len<I64StructCatalogEntry>(catalog)) {
        let entry: I64StructCatalogEntry = vec_get<I64StructCatalogEntry>(catalog, index);
        if (sfr_span_equal(source, start, length, entry.name_start, entry.name_length) != 0) {
            var field_count: i32 = 0;
            var field_index: i64 = 0;
            var single_child: i32 = function_mir_unresolved_type_code();
            while (field_index < vec_len<I64StructCatalogEntry>(catalog)) {
                let field_entry: I64StructCatalogEntry = vec_get<I64StructCatalogEntry>(catalog, field_index);
                if (field_entry.struct_id == entry.struct_id) {
                    var child:i32=field_entry.resolved_field_type_code;
                    if(child==function_mir_unresolved_type_code()){
                        child = source_i64_struct_type_code_depth(
                            source, catalog, field_entry.field_type_start, field_entry.field_type_length,
                            checked_add(depth, 1)
                        );
                    }
                    if (child == function_mir_unresolved_type_code()) { return child; }
                    single_child = child;
                    field_count = checked_add(field_count, 1);
                }
                field_index = checked_add(field_index, 1);
            }
            if (field_count == 1) {
                if (single_child == function_mir_i64_type_code()) {
                    if (entry.destructor_policy == 1) { return function_mir_destructor_i64_struct_type_code(entry.struct_id); }
                    return function_mir_i64_struct_type_code(entry.struct_id);
                }
                if (entry.destructor_policy != 0) { return function_mir_unresolved_type_code(); }
                if (single_child >= function_mir_aggregate_struct_type_code(0)) {
                    return function_mir_aggregate_struct_type_code(entry.struct_id);
                }
                return function_mir_owned_field_struct_type_code(entry.struct_id);
            }
            return function_mir_aggregate_struct_type_code(entry.struct_id);
        }
        index = checked_add(index, 1);
    }
    return function_mir_unresolved_type_code();
}

pub fn source_i64_struct_type_code(
    borrow source: Buffer, borrow catalog: Vec<I64StructCatalogEntry>, start: i64, length: i64
) -> i32 {
    return source_i64_struct_type_code_depth(source, catalog, start, length, 0);
}

pub fn derive_source_type_descriptors(
    borrow source: Buffer, borrow structs: Vec<I64StructCatalogEntry>,
    borrow variants: Vec<EnumVariantCatalogEntry>, borrow_mut output: Vec<MirTypeDescriptor>
) -> i32
requires_caps [allocate]
{
    var index: i64 = 0;
    while (index < vec_len<I64StructCatalogEntry>(structs)) {
        let entry: I64StructCatalogEntry = vec_get<I64StructCatalogEntry>(structs, index);
        let type_code: i32 = source_i64_struct_type_code(
            source, structs, entry.name_start, entry.name_length
        );
        if (type_code >= function_mir_aggregate_struct_type_code(0)) {
            var child_type_code:i32=entry.resolved_field_type_code;
            if(child_type_code==function_mir_unresolved_type_code()){
                child_type_code = source_i64_struct_type_code(
                    source, structs, entry.field_type_start, entry.field_type_length
                );
            }
            if (child_type_code == function_mir_unresolved_type_code()) { return 1; }
            vec_push<MirTypeDescriptor>(output, function_mir_type_descriptor(
                type_code, function_mir_type_descriptor_aggregate_struct_kind(),
                entry.struct_id, child_type_code, entry.destructor_policy, entry.field_ordinal
            ));
        } else {
            if (type_code >= function_mir_owned_field_struct_type_code(0)) {
                if (entry.field_ordinal == 0) {
                    var child_type_code:i32=entry.resolved_field_type_code;
                    if (child_type_code == function_mir_unresolved_type_code()) {
                        child_type_code = source_i64_struct_type_code(
                            source, structs, entry.field_type_start, entry.field_type_length
                        );
                    }
                    if (child_type_code == function_mir_unresolved_type_code()) { return 1; }
                    vec_push<MirTypeDescriptor>(output, function_mir_type_descriptor(
                        type_code, function_mir_type_descriptor_owned_field_struct_kind(),
                        entry.struct_id, child_type_code, entry.destructor_policy, entry.field_ordinal
                    ));
                }
            }
        }
        index = checked_add(index, 1);
    }
    index = 0;
    var enum_identity: i32 = 0;
    while (index < vec_len<EnumVariantCatalogEntry>(variants)) {
        let entry: EnumVariantCatalogEntry = vec_get<EnumVariantCatalogEntry>(variants, index);
        if (entry.ordinal == 0) {
            if (entry.payload_owned != 0) {
                var variant_index: i64 = index;
                var descriptor_ordinal: i32 = 0;
                while (variant_index < vec_len<EnumVariantCatalogEntry>(variants)) {
                    let variant: EnumVariantCatalogEntry = vec_get<EnumVariantCatalogEntry>(variants, variant_index);
                    if (variant.enum_id == entry.enum_id) {
                        vec_push<MirTypeDescriptor>(output, function_mir_type_descriptor(
                            function_mir_recursive_owned_payload_enum_type_code(enum_identity),
                            function_mir_type_descriptor_owned_payload_enum_kind(),
                            enum_identity, variant.payload_type_code, 0, descriptor_ordinal
                        ));
                        descriptor_ordinal = checked_add(descriptor_ordinal, 1);
                    }
                    variant_index = checked_add(variant_index, 1);
                }
            }
            enum_identity = checked_add(enum_identity, 1);
        }
        index = checked_add(index, 1);
    }
    return 0;
}

fn sfr_i64_struct_field_matches(
    borrow source: Buffer, borrow catalog: Vec<I64StructCatalogEntry>, type_code: i32,
    start: i64, length: i64
) -> i32 {
    var struct_id: i32 = checked_sub(type_code, function_mir_i64_struct_type_code(0));
    if (type_code >= function_mir_destructor_i64_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_destructor_i64_struct_type_code(0));
    }
    if (type_code >= function_mir_owned_field_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_owned_field_struct_type_code(0));
    }
    if (type_code >= function_mir_aggregate_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_aggregate_struct_type_code(0));
    }
    var index: i64 = 0;
    while (index < vec_len<I64StructCatalogEntry>(catalog)) {
        let entry: I64StructCatalogEntry = vec_get<I64StructCatalogEntry>(catalog, index);
        if (entry.struct_id == struct_id) {
            if (sfr_span_equal(source, start, length, entry.field_start, entry.field_length) != 0) { return 1; }
        }
        index = checked_add(index, 1);
    }
    return 0;
}

fn sfr_i64_struct_field_ordinal(
    borrow source: Buffer, borrow catalog: Vec<I64StructCatalogEntry>, type_code: i32,
    start: i64, length: i64
) -> i32 {
    var struct_id: i32 = checked_sub(type_code, function_mir_i64_struct_type_code(0));
    if (type_code >= function_mir_destructor_i64_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_destructor_i64_struct_type_code(0));
    }
    if (type_code >= function_mir_owned_field_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_owned_field_struct_type_code(0));
    }
    if (type_code >= function_mir_aggregate_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_aggregate_struct_type_code(0));
    }
    var index: i64 = 0;
    while (index < vec_len<I64StructCatalogEntry>(catalog)) {
        let entry: I64StructCatalogEntry = vec_get<I64StructCatalogEntry>(catalog, index);
        if (entry.struct_id == struct_id) {
            if (sfr_span_equal(source, start, length, entry.field_start, entry.field_length) != 0) {
                return entry.field_ordinal;
            }
        }
        index = checked_add(index, 1);
    }
    return -1;
}

fn sfr_i64_struct_field_count(
    borrow catalog: Vec<I64StructCatalogEntry>, type_code: i32
) -> i32 {
    var struct_id: i32 = checked_sub(type_code, function_mir_i64_struct_type_code(0));
    if (type_code >= function_mir_destructor_i64_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_destructor_i64_struct_type_code(0));
    }
    if (type_code >= function_mir_owned_field_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_owned_field_struct_type_code(0));
    }
    if (type_code >= function_mir_aggregate_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_aggregate_struct_type_code(0));
    }
    var count: i32 = 0;
    var index: i64 = 0;
    while (index < vec_len<I64StructCatalogEntry>(catalog)) {
        let entry: I64StructCatalogEntry = vec_get<I64StructCatalogEntry>(catalog, index);
        if (entry.struct_id == struct_id) { count = checked_add(count, 1); }
        index = checked_add(index, 1);
    }
    return count;
}

fn sfr_i64_struct_field_type_code(
    borrow source: Buffer, borrow catalog: Vec<I64StructCatalogEntry>, type_code: i32, ordinal: i32
) -> i32 {
    var struct_id: i32 = checked_sub(type_code, function_mir_i64_struct_type_code(0));
    if (type_code >= function_mir_destructor_i64_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_destructor_i64_struct_type_code(0));
    }
    if (type_code >= function_mir_owned_field_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_owned_field_struct_type_code(0));
    }
    if (type_code >= function_mir_aggregate_struct_type_code(0)) {
        struct_id = checked_sub(type_code, function_mir_aggregate_struct_type_code(0));
    }
    var index: i64 = 0;
    while (index < vec_len<I64StructCatalogEntry>(catalog)) {
        let entry: I64StructCatalogEntry = vec_get<I64StructCatalogEntry>(catalog, index);
        if (entry.struct_id == struct_id) {
            if (entry.field_ordinal == ordinal) {
                if(entry.resolved_field_type_code!=function_mir_unresolved_type_code()){
                    return entry.resolved_field_type_code;
                }
                return source_i64_struct_type_code(
                    source, catalog, entry.field_type_start, entry.field_type_length
                );
            }
        }
        index = checked_add(index, 1);
    }
    return function_mir_unresolved_type_code();
}

fn sfr_is_payload_match_subject(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>, borrow arms: Vec<ResolvedMatchArm>,
    binding_start: i64, binding_length: i64
) -> i32 {
    var statement_index: i64 = 0;
    while (statement_index < vec_len<StatementRecord>(statements)) {
        let statement: StatementRecord = vec_get<StatementRecord>(statements, statement_index);
        if (statement_record_is_match(statement) != 0) {
            var payload_match: i32 = 0;
            var arm_index: i64 = 0;
            while (arm_index < vec_len<ResolvedMatchArm>(arms)) {
                let arm: ResolvedMatchArm = vec_get<ResolvedMatchArm>(arms, arm_index);
                if (resolved_match_statement(arm) == statement_index) {
                    if (resolved_match_binding_start(arm) >= 0) { payload_match = 1; }
                }
                arm_index = checked_add(arm_index, 1);
            }
            if (payload_match != 0) {
                var operand_offset: i64 = 0;
                while (operand_offset < statement_record_operand_count(statement)) {
                    let operand_index: i64 = checked_add(statement_record_first_operand(statement), operand_offset);
                    let operand: StatementOperand = vec_get<StatementOperand>(operands, operand_index);
                    if (statement_operand_kind(operand) == 3) {
                        let expression_start: i64 = statement_operand_start(operand);
                        let expression_end: i64 = checked_add(expression_start, statement_operand_length(operand));
                        var token_index: i64 = 0;
                        while (token_index < vec_len<Token>(tokens)) {
                            let token: Token = vec_get<Token>(tokens, token_index);
                            if (token_start(token) >= expression_start) {
                                if (checked_add(token_start(token), token_length(token)) <= expression_end) {
                                    if (sfr_span_equal(source, binding_start, binding_length, token_start(token), token_length(token)) != 0) { return 1; }
                                }
                            }
                            token_index = checked_add(token_index, 1);
                        }
                    }
                    operand_offset = checked_add(operand_offset, 1);
                }
            }
        }
        statement_index = checked_add(statement_index, 1);
    }
    return 0;
}

fn sfr_declared_numeric_type_code(
    borrow source:Buffer,borrow tokens:Vec<Token>,start:i64,length:i64
)->i32{
    var decimal_identity:i32=0;var bounded_identity:i32=0;var index:i64=0;
    while(index<vec_len<Token>(tokens)){
        let token:Token=vec_get<Token>(tokens,index);
        if(sfr_is_decimal_declaration(source,token)!=0){
            let name_index:i64=checked_add(index,1);
            if(name_index>=vec_len<Token>(tokens)){return function_mir_unresolved_type_code();}
            let name:Token=vec_get<Token>(tokens,name_index);
            if(sfr_span_equal(source,start,length,token_start(name),token_length(name))!=0){
                return function_mir_decimal_type_code(decimal_identity);
            }
            decimal_identity=checked_add(decimal_identity,1);
        }
        if(sfr_is_bounded_declaration(source,token)!=0){
            let name_index:i64=checked_add(index,1);
            if(name_index>=vec_len<Token>(tokens)){return function_mir_unresolved_type_code();}
            let name:Token=vec_get<Token>(tokens,name_index);
            if(sfr_span_equal(source,start,length,token_start(name),token_length(name))!=0){
                return function_mir_bounded_type_code(bounded_identity);
            }
            bounded_identity=checked_add(bounded_identity,1);
        }
        index=checked_add(index,1);
    }
    return function_mir_unresolved_type_code();
}

fn sfr_declared_type_code(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow catalog: Vec<EnumVariantCatalogEntry>,
    borrow struct_catalog: Vec<I64StructCatalogEntry>,
    borrow arms: Vec<ResolvedMatchArm>, start: i64, length: i64, payload_match_subject: i32
) -> i32 {
    let builtin_type_code: i32 = sfr_builtin_type_code(source, start, length);
    if (builtin_type_code != function_mir_unresolved_type_code()) { return builtin_type_code; }
    let numeric_type_code:i32=sfr_declared_numeric_type_code(source,tokens,start,length);
    if(numeric_type_code!=function_mir_unresolved_type_code()){return numeric_type_code;}
    let struct_type_code: i32 = source_i64_struct_type_code(source, struct_catalog, start, length);
    if (struct_type_code != 0) { return struct_type_code; }
    var catalog_group: i32 = -1;
    var catalog_scan: i64 = 0;
    while (catalog_scan < vec_len<EnumVariantCatalogEntry>(catalog)) {
        let catalog_entry: EnumVariantCatalogEntry = vec_get<EnumVariantCatalogEntry>(catalog, catalog_scan);
        if (catalog_entry.ordinal == 0) {
            catalog_group = checked_add(catalog_group, 1);
            if (sfr_span_equal(
                source, start, length,
                enum_variant_enum_name_start(catalog_entry), enum_variant_enum_name_length(catalog_entry)
            ) != 0) {
                if (catalog_entry.payload_owned != 0) {
                    return function_mir_recursive_owned_payload_enum_type_code(catalog_group);
                }
                if (enum_variant_payload_type_code(catalog_entry) != function_mir_unresolved_type_code()) {
                    return function_mir_copy_payload_enum_type_code(catalog_group);
                }
                return 1;
            }
        }
        catalog_scan = checked_add(catalog_scan, 1);
    }
    var enum_code: i32 = 0;
    var enum_identity: i64 = 0;
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (sfr_is_enum(source, token) != 0) {
            let name_index: i64 = checked_add(index, 1);
            if (name_index >= vec_len<Token>(tokens)) { return 0; }
            let name: Token = vec_get<Token>(tokens, name_index);
            if (sfr_span_equal(source, start, length, token_start(name), token_length(name)) != 0) {
                var catalog_index: i64 = 0;
                while (catalog_index < vec_len<EnumVariantCatalogEntry>(catalog)) {
                    let catalog_entry: EnumVariantCatalogEntry = vec_get<EnumVariantCatalogEntry>(catalog, catalog_index);
                    if (catalog_entry.enum_id == enum_identity) {
                        if (catalog_entry.payload_owned != 0) {
                            return function_mir_recursive_owned_payload_enum_type_code(enum_code);
                        }
                    }
                    catalog_index = checked_add(catalog_index, 1);
                }
                var cursor: i64 = checked_add(name_index, 1);
                var has_payload: i32 = 0;
                var closed: i32 = 0;
                while (cursor < vec_len<Token>(tokens)) {
                    if (closed == 0) {
                        let member: Token = vec_get<Token>(tokens, cursor);
                        if (token_kind(member) == 4) {
                            if (token_length(member) == 1) {
                                let byte: i64 = buffer_get(source, token_start(member));
                                if (byte == 40) { has_payload = 1; }
                                if (byte == 125) { closed = 1; }
                            }
                        }
                        cursor = checked_add(cursor, 1);
                    } else { cursor = vec_len<Token>(tokens); }
                }
                if (has_payload != 0) { return function_mir_copy_payload_enum_type_code(enum_code); }
                return 1;
            }
            enum_code = checked_add(enum_code, 1);
            enum_identity = checked_add(enum_identity, 1);
        }
        index = checked_add(index, 1);
    }
    if (payload_match_subject != 0) {
        let first_arm: ResolvedMatchArm = vec_get<ResolvedMatchArm>(arms, 0);
        if (resolved_match_binding_start(first_arm) < 0) { return 1; }
        let wanted_enum: i64 = resolved_match_enum_id(first_arm);
        var group_code: i32 = -1;
        index = 0;
        while (index < vec_len<EnumVariantCatalogEntry>(catalog)) {
            let entry: EnumVariantCatalogEntry = vec_get<EnumVariantCatalogEntry>(catalog, index);
            if (entry.ordinal == 0) { group_code = checked_add(group_code, 1); }
            if (entry.enum_id == wanted_enum) {
                if (entry.payload_owned != 0) {
                    return function_mir_recursive_owned_payload_enum_type_code(group_code);
                }
                return function_mir_copy_payload_enum_type_code(group_code);
            }
            index = checked_add(index, 1);
        }
    }
    return 1;
}

fn sfr_try_variant_name_matches(
    borrow source: Buffer, borrow entry: EnumVariantCatalogEntry, ordinal: i64
) -> i32 {
    if (ordinal == 0) {
        if (entry.name_length != 2) { return 0; }
        if (buffer_get(source, entry.name_start) != sfr_ascii_upper_o()) { return 0; }
        if (buffer_get(source, checked_add(entry.name_start, 1)) != sfr_ascii_k()) { return 0; }
        return 1;
    }
    if (ordinal == 1) {
        if (entry.name_length != 3) { return 0; }
        if (buffer_get(source, entry.name_start) != sfr_ascii_upper_e()) { return 0; }
        if (buffer_get(source, checked_add(entry.name_start, 1)) != sfr_ascii_r()) { return 0; }
        if (buffer_get(source, checked_add(entry.name_start, 2)) != sfr_ascii_r()) { return 0; }
        return 1;
    }
    return 0;
}

fn sfr_validate_try_type(
    borrow source: Buffer, borrow catalog: Vec<EnumVariantCatalogEntry>,
    subject_type: i32, destination_type: i32, return_type: i32
) -> i32 {
    if (function_mir_type_is_owned_payload_enum(subject_type) == 0) { return 0; }
    if (subject_type != return_type) { return 0; }
    let enum_id: i32 = function_mir_owned_payload_enum_id(subject_type);
    var count: i64 = 0;
    var index: i64 = 0;
    var catalog_enum_id: i32 = -1;
    while (index < vec_len<EnumVariantCatalogEntry>(catalog)) {
        let entry: EnumVariantCatalogEntry = vec_get<EnumVariantCatalogEntry>(catalog, index);
        if (entry.ordinal == 0) { catalog_enum_id = checked_add(catalog_enum_id, 1); }
        if (catalog_enum_id == enum_id) {
            if (entry.ordinal != count) { return 0; }
            if (sfr_try_variant_name_matches(source, entry, count) == 0) { return 0; }
            if (count == 0) {
                if (entry.payload_type_code != destination_type) { return 0; }
            }
            count = checked_add(count, 1);
        }
        index = checked_add(index, 1);
    }
    if (count != 2) { return 0; }
    return 1;
}

fn sfr_is_borrow_mode(borrow source:Buffer, borrow token:Token)->i32 {
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=6){return 0;}
    let start:i64=token_start(token);
    if(buffer_get(source,start)!=sfr_ascii_b()){return 0;}
    if(buffer_get(source,checked_add(start,1))!=sfr_ascii_o()){return 0;}
    if(buffer_get(source,checked_add(start,2))!=sfr_ascii_r()){return 0;}
    if(buffer_get(source,checked_add(start,3))!=sfr_ascii_r()){return 0;}
    if(buffer_get(source,checked_add(start,4))!=sfr_ascii_o()){return 0;}
    if(buffer_get(source,checked_add(start,5))!=sfr_ascii_w()){return 0;}
    return 1;
}

fn sfr_is_borrow_mut_mode(borrow source:Buffer, borrow token:Token)->i32 {
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=10){return 0;}
    let start:i64=token_start(token);
    if(buffer_get(source,start)!=sfr_ascii_b()){return 0;}
    if(buffer_get(source,checked_add(start,1))!=sfr_ascii_o()){return 0;}
    if(buffer_get(source,checked_add(start,2))!=sfr_ascii_r()){return 0;}
    if(buffer_get(source,checked_add(start,3))!=sfr_ascii_r()){return 0;}
    if(buffer_get(source,checked_add(start,4))!=sfr_ascii_o()){return 0;}
    if(buffer_get(source,checked_add(start,5))!=sfr_ascii_w()){return 0;}
    if(buffer_get(source,checked_add(start,6))!=sfr_ascii_underscore()){return 0;}
    if(buffer_get(source,checked_add(start,7))!=sfr_ascii_m()){return 0;}
    if(buffer_get(source,checked_add(start,8))!=sfr_ascii_u()){return 0;}
    if(buffer_get(source,checked_add(start,9))!=sfr_ascii_t()){return 0;}
    return 1;
}

fn sfr_is_return_word(borrow source:Buffer, borrow token:Token)->i32 {
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=6){return 0;}
    let start:i64=token_start(token);
    if(buffer_get(source,start)!=sfr_ascii_r()){return 0;}
    if(buffer_get(source,checked_add(start,1))!=sfr_ascii_e()){return 0;}
    if(buffer_get(source,checked_add(start,2))!=sfr_ascii_t()){return 0;}
    if(buffer_get(source,checked_add(start,3))!=sfr_ascii_u()){return 0;}
    if(buffer_get(source,checked_add(start,4))!=sfr_ascii_r()){return 0;}
    if(buffer_get(source,checked_add(start,5))!=sfr_ascii_n()){return 0;}
    return 1;
}

fn sfr_callable_mode(borrow source:Buffer, borrow token:Token)->i32 {
    if(sfr_is_borrow_mode(source,token)!=0){return function_mir_mode_borrowed();}
    if(sfr_is_borrow_mut_mode(source,token)!=0){return function_mir_mode_mutable_borrow();}
    return function_mir_mode_value();
}

fn sfr_token_punctuation(borrow source:Buffer, borrow token:Token, byte:i64)->i32 {
    if(token_kind(token)!=4){return 0;}
    if(token_length(token)!=1){return 0;}
    if(buffer_get(source,token_start(token))!=byte){return 0;}
    return 1;
}

fn sfr_token_is_arrow(borrow source:Buffer, borrow token:Token)->i32 {
    if(token_length(token)!=2){return 0;}
    let start:i64=token_start(token);
    if(buffer_get(source,start)!=sfr_ascii_hyphen()){return 0;}
    if(buffer_get(source,checked_add(start,1))!=sfr_ascii_greater()){return 0;}
    return 1;
}

pub fn derive_source_function_signatures(
    borrow source:Buffer, borrow tokens:Vec<Token>,
    borrow enum_catalog:Vec<EnumVariantCatalogEntry>,
    borrow struct_catalog:Vec<I64StructCatalogEntry>, allocator:Allocator,
    borrow_mut signatures:Vec<SourceFunctionSignature>,
    borrow_mut parameters:Vec<SourceFunctionParameter>
)->i32
requires_caps [allocate]
{
    var empty_arms:Vec<ResolvedMatchArm>=vec_new<ResolvedMatchArm>(allocator,0);
    var index:i64=0;
    var depth:i64=0;
    while(index<vec_len<Token>(tokens)){
        let token:Token=vec_get<Token>(tokens,index);
        if(depth==0){
            if(sfr_is_fn(source,token)!=0){
                let name_index:i64=checked_add(index,1);
                let open_index:i64=checked_add(index,2);
                if(open_index>=vec_len<Token>(tokens)){return sfr_signature_missing_header_status();}
                let name:Token=vec_get<Token>(tokens,name_index);
                let open:Token=vec_get<Token>(tokens,open_index);
                if(token_kind(name)!=token_identifier_kind()){return sfr_signature_invalid_name_status();}
                if(sfr_token_punctuation(source,open,sfr_ascii_left_paren())==0){return sfr_signature_missing_parameter_list_status();}
                let parameter_start:i64=vec_len<SourceFunctionParameter>(parameters);
                var cursor:i64=checked_add(open_index,1);
                var parameter_count:i64=0;
                var closed:i32=0;
                var parameter_end:i64=-1;
                while(cursor<vec_len<Token>(tokens)){
                    if(closed==0){
                        let candidate:Token=vec_get<Token>(tokens,cursor);
                        if(sfr_token_punctuation(source,candidate,sfr_ascii_right_paren())!=0){
                            closed=1; parameter_end=checked_add(cursor,1);
                        } else {
                            var mode:i32=sfr_callable_mode(source,candidate);
                            if(mode!=function_mir_mode_value()){
                                cursor=checked_add(cursor,1);
                                if(cursor>=vec_len<Token>(tokens)){return sfr_signature_invalid_parameter_status();}
                            }
                            let parameter_name:Token=vec_get<Token>(tokens,cursor);
                            cursor=checked_add(cursor,1);
                            if(cursor>=vec_len<Token>(tokens)){return sfr_signature_invalid_parameter_status();}
                            let colon:Token=vec_get<Token>(tokens,cursor);
                            cursor=checked_add(cursor,1);
                            if(cursor>=vec_len<Token>(tokens)){return sfr_signature_invalid_parameter_status();}
                            let parameter_type:Token=vec_get<Token>(tokens,cursor);
                            if(token_kind(parameter_name)!=token_identifier_kind()){return sfr_signature_invalid_parameter_status();}
                            if(sfr_token_punctuation(source,colon,sfr_ascii_colon())==0){return sfr_signature_invalid_parameter_status();}
                            let type_code:i32=sfr_declared_type_code(
                                source,tokens,enum_catalog,struct_catalog,empty_arms,
                                token_start(parameter_type),token_length(parameter_type),0
                            );
                            if(type_code==function_mir_unresolved_type_code()){return sfr_signature_unresolved_parameter_type_status();}
                            var mutable:i32=0;
                            if(mode==function_mir_mode_mutable_borrow()){mutable=1;}
                            vec_push<SourceFunctionParameter>(parameters,SourceFunctionParameter{
                                name_start:token_start(parameter_name),name_length:token_length(parameter_name),
                                type_code:type_code,mode:mode,mutable:mutable
                            });
                            parameter_count=checked_add(parameter_count,1);
                            cursor=checked_add(cursor,1);
                            if(cursor<vec_len<Token>(tokens)){
                                let separator:Token=vec_get<Token>(tokens,cursor);
                                if(sfr_token_punctuation(source,separator,sfr_ascii_comma())!=0){cursor=checked_add(cursor,1);}
                            }
                        }
                    } else { cursor=vec_len<Token>(tokens); }
                }
                if(closed==0){return sfr_signature_unclosed_parameter_list_status();}
                cursor=parameter_end;
                if(cursor>=vec_len<Token>(tokens)){return sfr_signature_missing_return_status();}
                let arrow:Token=vec_get<Token>(tokens,cursor);
                if(sfr_token_is_arrow(source,arrow)==0){return sfr_signature_missing_return_status();}
                cursor=checked_add(cursor,1);
                if(cursor>=vec_len<Token>(tokens)){return sfr_signature_missing_return_status();}
                let return_candidate:Token=vec_get<Token>(tokens,cursor);
                let return_mode:i32=sfr_callable_mode(source,return_candidate);
                if(return_mode!=function_mir_mode_value()){cursor=checked_add(cursor,1);}
                if(cursor>=vec_len<Token>(tokens)){return sfr_signature_missing_return_status();}
                let return_type:Token=vec_get<Token>(tokens,cursor);
                let return_type_code:i32=sfr_declared_type_code(
                    source,tokens,enum_catalog,struct_catalog,empty_arms,
                    token_start(return_type),token_length(return_type),0
                );
                if(return_type_code==function_mir_unresolved_type_code()){return sfr_signature_unresolved_return_type_status();}
                var borrowed_origin:i64=-1;
                if(return_mode!=function_mir_mode_value()){
                    var body_scan:i64=checked_add(cursor,1);
                    var body_depth:i64=0;
                    var body_started:i32=0;
                    var body_closed:i32=0;
                    while(body_scan<vec_len<Token>(tokens)){
                        if(body_closed==0){
                            let body_token:Token=vec_get<Token>(tokens,body_scan);
                            if(sfr_token_punctuation(source,body_token,sfr_ascii_open_brace())!=0){
                                body_started=1;body_depth=checked_add(body_depth,1);
                            } else {
                                if(sfr_token_punctuation(source,body_token,sfr_ascii_close_brace())!=0){
                                    if(body_depth>0){body_depth=checked_sub(body_depth,1);}
                                    if(body_started!=0){if(body_depth==0){body_closed=1;}}
                                } else {
                                    if(body_started!=0){
                                        if(sfr_is_return_word(source,body_token)!=0){
                                            let returned_index:i64=checked_add(body_scan,1);
                                            if(returned_index>=vec_len<Token>(tokens)){return sfr_signature_unresolved_borrow_origin_status();}
                                            let returned:Token=vec_get<Token>(tokens,returned_index);
                                            var return_origin:i64=-1;
                                            var origin_ordinal:i64=0;
                                            while(origin_ordinal<parameter_count){
                                                let parameter:SourceFunctionParameter=vec_get<SourceFunctionParameter>(parameters,checked_add(parameter_start,origin_ordinal));
                                                if(sfr_span_equal(source,token_start(returned),token_length(returned),source_function_parameter_name_start(parameter),source_function_parameter_name_length(parameter))!=0){return_origin=origin_ordinal;}
                                                origin_ordinal=checked_add(origin_ordinal,1);
                                            }
                                            if(return_origin<0){
                                                let relay_signature_index:i64=sfr_find_function_signature(
                                                    source,signatures,token_start(returned),token_length(returned)
                                                );
                                                if(relay_signature_index<0){return sfr_signature_unresolved_borrow_origin_status();}
                                                let relay_signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(signatures,relay_signature_index);
                                                if(source_function_signature_return_mode(relay_signature)==function_mir_mode_value()){return sfr_signature_unresolved_borrow_origin_status();}
                                                let relay_origin:i64=source_function_signature_borrowed_origin(relay_signature);
                                                if(relay_origin<0){return sfr_signature_unresolved_borrow_origin_status();}
                                                let relay_open_index:i64=checked_add(returned_index,1);
                                                if(relay_open_index>=vec_len<Token>(tokens)){return sfr_signature_unresolved_borrow_origin_status();}
                                                let relay_open:Token=vec_get<Token>(tokens,relay_open_index);
                                                if(sfr_token_punctuation(source,relay_open,sfr_ascii_left_paren())==0){return sfr_signature_unresolved_borrow_origin_status();}
                                                var relay_cursor:i64=checked_add(relay_open_index,1);
                                                var relay_argument:i64=0;
                                                var origin_token_index:i64=-1;
                                                while(relay_cursor<vec_len<Token>(tokens)){
                                                    let relay_token:Token=vec_get<Token>(tokens,relay_cursor);
                                                    if(sfr_token_punctuation(source,relay_token,sfr_ascii_right_paren())!=0){relay_cursor=vec_len<Token>(tokens);}
                                                    else {
                                                        if(relay_argument==relay_origin){origin_token_index=relay_cursor;}
                                                        relay_argument=checked_add(relay_argument,1);
                                                        relay_cursor=checked_add(relay_cursor,1);
                                                        if(relay_cursor<vec_len<Token>(tokens)){
                                                            let relay_separator:Token=vec_get<Token>(tokens,relay_cursor);
                                                            if(sfr_token_punctuation(source,relay_separator,sfr_ascii_comma())!=0){relay_cursor=checked_add(relay_cursor,1);}
                                                        }
                                                    }
                                                }
                                                if(origin_token_index<0){return sfr_signature_unresolved_borrow_origin_status();}
                                                let origin_token:Token=vec_get<Token>(tokens,origin_token_index);
                                                origin_ordinal=0;
                                                while(origin_ordinal<parameter_count){
                                                    let parameter:SourceFunctionParameter=vec_get<SourceFunctionParameter>(parameters,checked_add(parameter_start,origin_ordinal));
                                                    if(sfr_span_equal(source,token_start(origin_token),token_length(origin_token),source_function_parameter_name_start(parameter),source_function_parameter_name_length(parameter))!=0){return_origin=origin_ordinal;}
                                                    origin_ordinal=checked_add(origin_ordinal,1);
                                                }
                                                if(return_origin<0){return sfr_signature_unresolved_borrow_origin_status();}
                                            }
                                            let origin_parameter:SourceFunctionParameter=vec_get<SourceFunctionParameter>(parameters,checked_add(parameter_start,return_origin));
                                            if(source_function_parameter_mode(origin_parameter)==function_mir_mode_value()){return sfr_signature_owned_borrow_origin_status();}
                                            if(return_mode==function_mir_mode_mutable_borrow()){
                                                if(source_function_parameter_mode(origin_parameter)!=function_mir_mode_mutable_borrow()){return sfr_signature_mutable_origin_required_status();}
                                            }
                                            if(borrowed_origin<0){borrowed_origin=return_origin;}
                                            else {if(borrowed_origin!=return_origin){return sfr_signature_inconsistent_borrow_origin_status();}}
                                        }
                                    }
                                }
                            }
                            body_scan=checked_add(body_scan,1);
                        } else {body_scan=vec_len<Token>(tokens);}
                    }
                    if(body_started==0){return sfr_signature_invalid_body_status();}
                    if(body_closed==0){return sfr_signature_invalid_body_status();}
                    if(borrowed_origin<0){return sfr_signature_unresolved_borrow_origin_status();}
                }
                vec_push<SourceFunctionSignature>(signatures,SourceFunctionSignature{
                    name_start:token_start(name),name_length:token_length(name),
                    return_type_code:return_type_code,return_mode:return_mode,
                    borrowed_origin:borrowed_origin,parameter_start:parameter_start,parameter_count:parameter_count
                });
            }
        }
        if(sfr_token_punctuation(source,token,sfr_ascii_open_brace())!=0){depth=checked_add(depth,1);}
        if(sfr_token_punctuation(source,token,sfr_ascii_close_brace())!=0){if(depth>0){depth=checked_sub(depth,1);}}
        index=checked_add(index,1);
    }
    drop(empty_arms);
    return 0;
}

pub fn derive_source_parameter_ownership(
    borrow source:Buffer, borrow function_tokens:Vec<Token>,
    borrow enum_catalog:Vec<EnumVariantCatalogEntry>,
    borrow struct_catalog:Vec<I64StructCatalogEntry>, allocator:Allocator,
    borrow_mut output:Vec<MirOwnershipBinding>
)->i32
requires_caps [allocate]
{
    let name_index:i64=sfr_function_name_index(source,function_tokens);
    if(name_index<0){return 1;}
    let name:Token=vec_get<Token>(function_tokens,name_index);
    var all_tokens:Vec<Token>=lex(source,allocator);
    var signatures:Vec<SourceFunctionSignature>=vec_new<SourceFunctionSignature>(allocator,8);
    var parameters:Vec<SourceFunctionParameter>=vec_new<SourceFunctionParameter>(allocator,16);
    let status:i32=derive_source_function_signatures(
        source,all_tokens,enum_catalog,struct_catalog,allocator,signatures,parameters
    );
    if(status!=0){return sfr_callable_catalog_status(status);}
    var found:i64=-1;
    var index:i64=0;
    while(index<vec_len<SourceFunctionSignature>(signatures)){
        let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(signatures,index);
        if(sfr_span_equal(source,token_start(name),token_length(name),source_function_signature_name_start(signature),source_function_signature_name_length(signature))!=0){
            if(found>=0){return 20;}
            found=index;
        }
        index=checked_add(index,1);
    }
    if(found<0){return 21;}
    let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(signatures,found);
    var ordinal:i64=0;
    while(ordinal<source_function_signature_parameter_count(signature)){
        let parameter:SourceFunctionParameter=vec_get<SourceFunctionParameter>(
            parameters,checked_add(source_function_signature_parameter_start(signature),ordinal)
        );
        var owned:i32=0;
        if(source_function_parameter_mode(parameter)==function_mir_mode_value()){
            owned=function_mir_type_uses_ownership_transfer(source_function_parameter_type(parameter));
        }
        vec_push<MirOwnershipBinding>(output,ownership_binding(
            ordinal,ordinal,owned,source_function_parameter_mutable(parameter)
        ));
        ordinal=checked_add(ordinal,1);
    }
    drop(parameters);drop(signatures);drop(all_tokens);
    return 0;
}

pub fn collect_source_parameter_spans(
    borrow source:Buffer, borrow function_tokens:Vec<Token>,
    borrow_mut starts:Vec<i64>, borrow_mut lengths:Vec<i64>
)->i32
requires_caps [allocate]
{
    let name_index:i64=sfr_function_name_index(source,function_tokens);
    if(name_index<0){return 1;}
    let open_index:i64=checked_add(name_index,1);
    if(open_index>=vec_len<Token>(function_tokens)){return 2;}
    let open:Token=vec_get<Token>(function_tokens,open_index);
    if(sfr_token_punctuation(source,open,sfr_ascii_left_paren())==0){return 2;}
    var cursor:i64=checked_add(open_index,1);
    var closed:i32=0;
    while(cursor<vec_len<Token>(function_tokens)){
        if(closed==0){
            let candidate:Token=vec_get<Token>(function_tokens,cursor);
            if(sfr_token_punctuation(source,candidate,sfr_ascii_right_paren())!=0){closed=1;}
            else {
                let mode:i32=sfr_callable_mode(source,candidate);
                if(mode!=function_mir_mode_value()){
                    cursor=checked_add(cursor,1);
                    if(cursor>=vec_len<Token>(function_tokens)){return 3;}
                }
                let name:Token=vec_get<Token>(function_tokens,cursor);
                if(token_kind(name)!=token_identifier_kind()){return 3;}
                vec_push<i64>(starts,token_start(name));
                vec_push<i64>(lengths,token_length(name));
                cursor=checked_add(cursor,3);
                if(cursor<vec_len<Token>(function_tokens)){
                    let separator:Token=vec_get<Token>(function_tokens,cursor);
                    if(sfr_token_punctuation(source,separator,sfr_ascii_comma())!=0){cursor=checked_add(cursor,1);}
                }
            }
        } else {cursor=vec_len<Token>(function_tokens);}
    }
    if(closed==0){return 4;}
    return 0;
}

pub fn resolve_source_call_parameter_mode(
    borrow source:Buffer, callee_start:i64, callee_length:i64,
    argument_ordinal:i64, allocator:Allocator
)->i32
requires_caps [allocate]
{
    let builtin_kind:i32=sfr_builtin_call_kind(source,callee_start,callee_length);
    if(builtin_kind!=0){
        if(argument_ordinal<0){return -1;}
        if(argument_ordinal>=sfr_builtin_call_parameter_count(builtin_kind)){return -1;}
        return sfr_builtin_call_parameter_mode(builtin_kind,argument_ordinal);
    }
    var tokens:Vec<Token>=lex(source,allocator);
    var enum_catalog:Vec<EnumVariantCatalogEntry>=vec_new<EnumVariantCatalogEntry>(allocator,0);
    var struct_catalog:Vec<I64StructCatalogEntry>=vec_new<I64StructCatalogEntry>(allocator,0);
    var signatures:Vec<SourceFunctionSignature>=vec_new<SourceFunctionSignature>(allocator,8);
    var parameters:Vec<SourceFunctionParameter>=vec_new<SourceFunctionParameter>(allocator,16);
    let status:i32=derive_source_function_signatures(
        source,tokens,enum_catalog,struct_catalog,allocator,signatures,parameters
    );
    if(status!=0){return -1;}
    let signature_index:i64=sfr_find_function_signature(source,signatures,callee_start,callee_length);
    if(signature_index<0){return -1;}
    let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(signatures,signature_index);
    if(argument_ordinal<0){return -1;}
    if(argument_ordinal>=source_function_signature_parameter_count(signature)){return -1;}
    let parameter:SourceFunctionParameter=vec_get<SourceFunctionParameter>(
        parameters,checked_add(source_function_signature_parameter_start(signature),argument_ordinal)
    );
    let mode:i32=source_function_parameter_mode(parameter);
    drop(parameters);drop(signatures);drop(struct_catalog);drop(enum_catalog);drop(tokens);
    return mode;
}

pub fn resolve_source_call_borrowed_origin(
    borrow source:Buffer, callee_start:i64, callee_length:i64, allocator:Allocator
)->i64
requires_caps [allocate]
{
    var tokens:Vec<Token>=lex(source,allocator);
    var enum_catalog:Vec<EnumVariantCatalogEntry>=vec_new<EnumVariantCatalogEntry>(allocator,0);
    var struct_catalog:Vec<I64StructCatalogEntry>=vec_new<I64StructCatalogEntry>(allocator,0);
    var signatures:Vec<SourceFunctionSignature>=vec_new<SourceFunctionSignature>(allocator,8);
    var parameters:Vec<SourceFunctionParameter>=vec_new<SourceFunctionParameter>(allocator,16);
    let status:i32=derive_source_function_signatures(
        source,tokens,enum_catalog,struct_catalog,allocator,signatures,parameters
    );
    if(status!=0){return -1;}
    let signature_index:i64=sfr_find_function_signature(source,signatures,callee_start,callee_length);
    if(signature_index<0){return -1;}
    let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(signatures,signature_index);
    let origin:i64=source_function_signature_borrowed_origin(signature);
    drop(parameters);drop(signatures);drop(struct_catalog);drop(enum_catalog);drop(tokens);
    return origin;
}

fn sfr_variant_code(
    borrow source: Buffer, borrow catalog: Vec<EnumVariantCatalogEntry>, enum_type_code: i32,
    start: i64, length: i64
) -> i32 {
    var enum_code: i32 = -1;
    var variant_code: i32 = 0;
    var index: i64 = 0;
    while (index < vec_len<EnumVariantCatalogEntry>(catalog)) {
        let entry: EnumVariantCatalogEntry = vec_get<EnumVariantCatalogEntry>(catalog, index);
        if (entry.ordinal == 0) { enum_code = checked_add(enum_code, 1); variant_code = 0; }
        if (function_mir_type_is_owned_payload_enum(enum_type_code) != 0) {
            if (function_mir_owned_payload_enum_id(enum_type_code) == enum_code) {
                if (sfr_span_equal(source, start, length, entry.name_start, entry.name_length) != 0) { return variant_code; }
            }
        } else {
            if (function_mir_copy_payload_enum_type_code(enum_code) == enum_type_code) {
                if (sfr_span_equal(source, start, length, entry.name_start, entry.name_length) != 0) { return variant_code; }
            }
        }
        variant_code = checked_add(variant_code, 1);
        index = checked_add(index, 1);
    }
    return -1;
}

fn sfr_local_type_code(borrow records: Vec<MirFunctionRecord>, local_id: i64) -> i32 {
    var index: i64 = 0;
    while (index < vec_len<MirFunctionRecord>(records)) {
        let record: MirFunctionRecord = vec_get<MirFunctionRecord>(records, index);
        let kind: i32 = function_mir_kind(record);
        if (kind == 2) { if (function_mir_id(record) == local_id) { return function_mir_type_code(record); } }
        if (kind == function_mir_kind_parameter()) { if (function_mir_id(record) == local_id) { return function_mir_type_code(record); } }
        if (kind == 3) { if (function_mir_id(record) == local_id) { return function_mir_type_code(record); } }
        index = checked_add(index, 1);
    }
    return 0;
}

fn sfr_local_mode(borrow records:Vec<MirFunctionRecord>,local_id:i64)->i32 {
    var index:i64=0;
    while(index<vec_len<MirFunctionRecord>(records)){
        let record:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        if(function_mir_id(record)==local_id){
            if(function_mir_kind(record)==function_mir_kind_parameter()){return function_mir_symbol_code(record);}
            if(function_mir_kind(record)==3){return function_mir_numeric_policy(record);}
            if(function_mir_kind(record)==2){return function_mir_mode_value();}
        }
        index=checked_add(index,1);
    }
    return -1;
}

fn sfr_local_mutable(borrow records:Vec<MirFunctionRecord>,local_id:i64)->i32 {
    var index:i64=0;
    while(index<vec_len<MirFunctionRecord>(records)){
        let record:MirFunctionRecord=vec_get<MirFunctionRecord>(records,index);
        if(function_mir_id(record)==local_id){
            let kind:i32=function_mir_kind(record);
            if(kind==2){return function_mir_mutable(record);}
            if(kind==function_mir_kind_parameter()){return function_mir_mutable(record);}
            if(kind==3){if(function_mir_numeric_policy(record)==function_mir_mode_mutable_borrow()){return 1;}return 0;}
        }
        index=checked_add(index,1);
    }
    return 0;
}

fn sfr_hir_type_at(borrow nodes: Vec<HirExpressionRecord>, index: i64) -> i32 {
    let node: HirExpressionRecord = vec_get<HirExpressionRecord>(nodes, index);
    return hir_type_code(node);
}

fn sfr_hir_borrow_root(
    borrow source:Buffer, borrow hir_nodes:Vec<HirExpressionRecord>,
    borrow signatures:Vec<SourceFunctionSignature>, node_index:i64, allocator:Allocator
)->i64
requires_caps [allocate]
{
    if(node_index<0){return -1;}
    let node:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,node_index);
    let kind:i32=hir_kind(node);
    if(kind==3){return sfr_hir_borrow_root(source,hir_nodes,signatures,hir_left(node),allocator);}
    if(kind==4){return hir_binding_id(node);}
    if(kind==7){return sfr_hir_borrow_root(source,hir_nodes,signatures,hir_left(node),allocator);}
    if(hir_is_call(node)!=0){
        let callee:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,hir_left(node));
        let signature_index:i64=sfr_find_function_signature(source,signatures,hir_start(callee),hir_length(callee));
        if(signature_index<0){return -1;}
        let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(signatures,signature_index);
        let origin:i64=source_function_signature_borrowed_origin(signature);
        if(origin<0){return -1;}
        var arguments:Vec<i64>=vec_new<i64>(allocator,4);
        var stack:Vec<i64>=vec_new<i64>(allocator,4);
        if(hir_right(node)>=0){vec_push<i64>(stack,hir_right(node));}
        while(vec_len<i64>(stack)>0){
            let argument_index:i64=vec_pop<i64>(stack);
            let argument:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,argument_index);
            if(hir_kind(argument)==8){
                vec_push<i64>(stack,hir_right(argument));vec_push<i64>(stack,hir_left(argument));
            } else {vec_push<i64>(arguments,argument_index);}
        }
        if(origin>=vec_len<i64>(arguments)){return -1;}
        let result:i64=sfr_hir_borrow_root(source,hir_nodes,signatures,vec_get<i64>(arguments,origin),allocator);
        drop(stack);drop(arguments);return result;
    }
    return -1;
}

fn sfr_operand(
    borrow statement: StatementRecord,
    borrow operands: Vec<StatementOperand>,
    wanted_kind: i32
) -> i64 {
    var offset: i64 = 0;
    while (offset < statement_record_operand_count(statement)) {
        let index: i64 = checked_add(statement_record_first_operand(statement), offset);
        let operand: StatementOperand = vec_get<StatementOperand>(operands, index);
        if (statement_operand_kind(operand) == wanted_kind) { return index; }
        offset = checked_add(offset, 1);
    }
    return -1;
}

fn sfr_operand_ordinal(
    borrow statement: StatementRecord,
    borrow operands: Vec<StatementOperand>,
    wanted_kind: i32,
    wanted_ordinal: i64
) -> i64
{
    var ordinal: i64 = 0;
    var offset: i64 = 0;
    while (offset < statement_record_operand_count(statement)) {
        let index: i64 = checked_add(statement_record_first_operand(statement), offset);
        let operand: StatementOperand = vec_get<StatementOperand>(operands, index);
        if (statement_operand_kind(operand) == wanted_kind) {
            if (ordinal == wanted_ordinal) { return index; }
            ordinal = checked_add(ordinal, 1);
        }
        offset = checked_add(offset, 1);
    }
    return -1;
}

fn sfr_ast_identifier_is_field_label(
    borrow ast_nodes: Vec<AstNodeRecord>, identifier_index: i64
) -> i32 {
    var parent_index: i64 = 0;
    while (parent_index < vec_len<AstNodeRecord>(ast_nodes)) {
        let parent: AstNodeRecord = vec_get<AstNodeRecord>(ast_nodes, parent_index);
        if (ast_kind(parent) == ast_field_initializer_kind()) {
            if (ast_left(parent) == identifier_index) { return 1; }
        }
        parent_index = checked_add(parent_index, 1);
    }
    return 0;
}

fn sfr_find_function_signature(
    borrow source:Buffer, borrow signatures:Vec<SourceFunctionSignature>, start:i64, length:i64
)->i64 {
    var found:i64=-1;
    var index:i64=0;
    while(index<vec_len<SourceFunctionSignature>(signatures)){
        let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(signatures,index);
        if(sfr_span_equal(source,start,length,source_function_signature_name_start(signature),source_function_signature_name_length(signature))!=0){
            if(found>=0){return -2;}
            found=index;
        }
        index=checked_add(index,1);
    }
    return found;
}

fn sfr_emit_expression(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow binding_starts: Vec<i64>,
    borrow binding_lengths: Vec<i64>,
    expression_start: i64,
    expression_length: i64,
    expected_type_code: i32,
    borrow enum_catalog: Vec<EnumVariantCatalogEntry>,
    borrow struct_catalog: Vec<I64StructCatalogEntry>,
    borrow function_signatures:Vec<SourceFunctionSignature>,
    borrow function_parameters:Vec<SourceFunctionParameter>,
    allocator: Allocator,
    borrow_mut output: Vec<MirFunctionRecord>,
    borrow_mut counters: Vec<i64>
) -> i64
requires_caps [allocate]
{
    let expressions: Vec<ExpressionNode> = parse_expression_span(
        source, tokens, expression_start, expression_length, allocator
    );
    let ast_nodes: Vec<AstNodeRecord> = lower_expression_ast_records(expressions, allocator);
    let count: i64 = vec_len<AstNodeRecord>(ast_nodes);
    if (count == 0) { return -1; }
    var hir_nodes: Vec<HirExpressionRecord> = vec_new<HirExpressionRecord>(allocator, count);
    var ast_index: i64 = 0;
    while (ast_index < count) {
        let ast: AstNodeRecord = vec_get<AstNodeRecord>(ast_nodes, ast_index);
        var binding_id: i64 = -1;
        if (ast_kind(ast) == 30) {
            if (sfr_ast_identifier_is_field_label(ast_nodes, ast_index) == 0) {
                binding_id = hir_find_binding_id(
                    source, binding_starts, binding_lengths, ast_start(ast), ast_length(ast)
                );
            }
            if (binding_id < 0) { binding_id = -2; }
        }
        var resolved_type: i32 = 1;
        if(ast_kind(ast)==30){
            if(binding_id>=0){resolved_type=sfr_local_type_code(output,binding_id);}
        }
        if(ast_kind(ast)==35){
            if(ast_left(ast)>=0){
                if(ast_right(ast)>=0){
                    var receiver_index:i64=ast_left(ast);
                    var receiver_hir:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,receiver_index);
                    while(hir_kind(receiver_hir)==3){
                        receiver_index=hir_left(receiver_hir);
                        receiver_hir=vec_get<HirExpressionRecord>(hir_nodes,receiver_index);
                    }
                    var field_index:i64=ast_right(ast);
                    var field_hir:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,field_index);
                    while(hir_kind(field_hir)==3){
                        field_index=hir_left(field_hir);
                        field_hir=vec_get<HirExpressionRecord>(hir_nodes,field_index);
                    }
                    let field_ordinal:i32=sfr_i64_struct_field_ordinal(
                        source,struct_catalog,hir_type_code(receiver_hir),hir_start(field_hir),hir_length(field_hir)
                    );
                    if(field_ordinal>=0){
                        resolved_type=sfr_i64_struct_field_type_code(
                            source,struct_catalog,hir_type_code(receiver_hir),field_ordinal
                        );
                    }
                }
            }
        }
        if (ast_is_call(ast) != 0) {
            resolved_type = expected_type_code;
            if(ast_left(ast)>=0){
                let callee_ast:AstNodeRecord=vec_get<AstNodeRecord>(ast_nodes,ast_left(ast));
                let builtin_kind:i32=sfr_builtin_call_kind(source,ast_start(callee_ast),ast_length(callee_ast));
                if(builtin_kind!=0){resolved_type=sfr_builtin_call_return_type(builtin_kind);}
                let signature_index:i64=sfr_find_function_signature(source,function_signatures,ast_start(callee_ast),ast_length(callee_ast));
                if(signature_index>=0){
                    let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(function_signatures,signature_index);
                    resolved_type=source_function_signature_return_type(signature);
                }
            }
        }
        // Numeric literals and arithmetic results inherit the destination's
        // already-resolved nominal type. This is the native equivalent of the
        // alpha.1 destination-typing rule and prevents narrow/unsigned values
        // from silently falling back to the legacy i64 bootstrap identity.
        if (ast_kind(ast) == 31) {
            if (ast_index == checked_sub(count, 1)) { resolved_type = expected_type_code; }
        }
        if(ast_kind(ast)==ast_string_literal_kind()){resolved_type=function_mir_string_type_code();}
        if (ast_kind(ast) == 50) { resolved_type = expected_type_code; }
        if (ast_kind(ast) == 51) { resolved_type = expected_type_code; }
        if (ast_kind(ast) == 60) { resolved_type = expected_type_code; }
        if (ast_kind(ast) == 61) { resolved_type = expected_type_code; }
        if (ast_kind(ast) == 50) {
            let left_type: i32 = sfr_hir_type_at(hir_nodes, ast_left(ast));
            let right_type: i32 = sfr_hir_type_at(hir_nodes, ast_right(ast));
            if (left_type == right_type) { resolved_type = left_type; }
        }
        if (ast_kind(ast) == 51) {
            let left_type: i32 = sfr_hir_type_at(hir_nodes, ast_left(ast));
            let right_type: i32 = sfr_hir_type_at(hir_nodes, ast_right(ast));
            if (left_type == right_type) { resolved_type = left_type; }
        }
        if (ast_kind(ast) == 60) {
            let left_type: i32 = sfr_hir_type_at(hir_nodes, ast_left(ast));
            let right_type: i32 = sfr_hir_type_at(hir_nodes, ast_right(ast));
            if (left_type == right_type) { resolved_type = left_type; }
        }
        if (ast_kind(ast) == 61) {
            let left_type: i32 = sfr_hir_type_at(hir_nodes, ast_left(ast));
            let right_type: i32 = sfr_hir_type_at(hir_nodes, ast_right(ast));
            if (left_type == right_type) { resolved_type = left_type; }
        }
        if (ast_kind(ast) == 70) { resolved_type = expected_type_code; }
        vec_push<HirExpressionRecord>(hir_nodes, lower_resolved_hir_record(
            ast_kind(ast), ast_start(ast), ast_length(ast), ast_left(ast), ast_right(ast),
            ast_group_start(ast), ast_group_length(ast), ast_group_parent(ast), binding_id, resolved_type
        ));
        ast_index = checked_add(ast_index, 1);
    }

    // Struct initializer expressions inherit their canonical field types. Walk
    // each initializer subtree independently so heterogeneous aggregate fields
    // never collapse into one numeric domain.
    if(expected_type_code>=function_mir_i64_struct_type_code(0)){
        var initializer_index:i64=0;
        while(initializer_index<vec_len<HirExpressionRecord>(hir_nodes)){
            let initializer:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,initializer_index);
            if(hir_kind(initializer)==11){
                let label:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,hir_left(initializer));
                let field_ordinal:i32=sfr_i64_struct_field_ordinal(
                    source,struct_catalog,expected_type_code,hir_start(label),hir_length(label)
                );
                if(field_ordinal<0){return sfr_invalid_struct_initializer_error();}
                let field_type:i32=sfr_i64_struct_field_type_code(
                    source,struct_catalog,expected_type_code,field_ordinal
                );
                if(field_type==function_mir_unresolved_type_code()){return sfr_unresolved_struct_type_error();}
                var field_stack:Vec<i64>=vec_new<i64>(allocator,8);
                vec_push<i64>(field_stack,hir_right(initializer));
                while(vec_len<i64>(field_stack)>0){
                    let field_node_index:i64=vec_pop<i64>(field_stack);
                    let field_node:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,field_node_index);
                    let field_kind:i32=hir_kind(field_node);
                    var propagate_field_type:i32=0;
                    if(field_kind==1){propagate_field_type=1;}
                    if(field_kind==2){propagate_field_type=1;}
                    if(hir_is_call(field_node)!=0){propagate_field_type=1;}
                    if(propagate_field_type!=0){
                        vec_set<HirExpressionRecord>(hir_nodes,field_node_index,hir_with_type(field_node,field_type));
                    }
                    if(field_kind==2){
                        vec_push<i64>(field_stack,hir_right(field_node));vec_push<i64>(field_stack,hir_left(field_node));
                    }
                    if(field_kind==3){vec_push<i64>(field_stack,hir_left(field_node));}
                    if(hir_is_call(field_node)!=0){if(hir_right(field_node)>=0){vec_push<i64>(field_stack,hir_right(field_node));}}
                    if(field_kind==8){
                        vec_push<i64>(field_stack,hir_right(field_node));vec_push<i64>(field_stack,hir_left(field_node));
                    }
                    if(field_kind==11){vec_push<i64>(field_stack,hir_right(field_node));}
                    if(field_kind==7){vec_push<i64>(field_stack,hir_left(field_node));}
                }
                drop(field_stack);
            }
            initializer_index=checked_add(initializer_index,1);
        }
    }

    // A print/expression context has no nominal destination type. Infer the
    // single declared numeric domain from resolved identifiers and propagate it
    // to literals, arithmetic results, and numeric builtin calls. Distinct
    // nominal domains never unify implicitly.
    var inferred_numeric_type:i32=function_mir_unresolved_type_code();
    var infer_expression_domain:i32=1;
    let root_hir:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,checked_sub(count,1));
    if(hir_is_struct_constructor(root_hir)!=0){infer_expression_domain=0;}
    // Declared decimal/bounded destinations are nominal and therefore
    // authoritative. Primitive i64 is also the context-free expression
    // default, so primitive domains are instead inferred from bindings/calls.
    if(function_mir_type_is_declared_numeric(expected_type_code)!=0){
        inferred_numeric_type=expected_type_code;
    }
    var inference_index:i64=0;
    while(inference_index<vec_len<HirExpressionRecord>(hir_nodes)){
        let inference_node:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,inference_index);
        let candidate_type:i32=hir_type_code(inference_node);
        var authoritative_candidate:i32=0;
        if(hir_kind(inference_node)==4){authoritative_candidate=1;}
        if(infer_expression_domain!=0){if(authoritative_candidate!=0){if(function_mir_type_is_numeric(candidate_type)!=0){
            if(inferred_numeric_type==function_mir_unresolved_type_code()){
                inferred_numeric_type=candidate_type;
            }else{
                if(inferred_numeric_type!=candidate_type){
                    return -38;
                }
            }
        }}}
        inference_index=checked_add(inference_index,1);
    }
    if(inferred_numeric_type!=function_mir_unresolved_type_code()){
        inference_index=0;
        while(inference_index<vec_len<HirExpressionRecord>(hir_nodes)){
            let inference_node:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,inference_index);
            let inference_kind:i32=hir_kind(inference_node);
            var propagate:i32=0;
            if(inference_kind==1){propagate=1;}
            if(inference_kind==2){propagate=1;}
            if(hir_is_call(inference_node)!=0){
                let inference_callee:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,hir_left(inference_node));
                if(sfr_checked_numeric_symbol(source,inference_callee)!=0){propagate=1;}
            }
            if(propagate!=0){
                vec_set<HirExpressionRecord>(hir_nodes,inference_index,hir_with_type(inference_node,inferred_numeric_type));
            }
            inference_index=checked_add(inference_index,1);
        }
    }

    var canonical_ids: Vec<i64> = vec_new<i64>(allocator, count);
    var local_ids: Vec<i64> = vec_new<i64>(allocator, count);
    var initialize: i64 = 0;
    while (initialize < count) {
        vec_push<i64>(canonical_ids, -1);
        vec_push<i64>(local_ids, -1);
        initialize = checked_add(initialize, 1);
    }

    var next_hir: i64 = vec_get<i64>(counters, 2);
    var canonical_index: i64 = 0;
    while (canonical_index < count) {
        let hir: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, canonical_index);
        if (hir_kind(hir) == 3) {
            vec_set<i64>(canonical_ids, canonical_index, vec_get<i64>(canonical_ids, hir_left(hir)));
        } else {
            let canonical_kind: i32 = hir_kind(hir);
            if (canonical_kind != 8) {
                if (canonical_kind != 9) {
                    if (canonical_kind != 11) {
                        vec_set<i64>(canonical_ids, canonical_index, next_hir);
                        next_hir = checked_add(next_hir, 1);
                    }
                }
            }
        }
        canonical_index = checked_add(canonical_index, 1);
    }
    vec_set<i64>(counters, 2, next_hir);

    var stack: Vec<i64> = vec_new<i64>(allocator, count);
    vec_push<i64>(stack, checked_sub(count, 1));
    while (vec_len<i64>(stack) > 0) {
        let current_index: i64 = vec_pop<i64>(stack);
        let hir: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, current_index);
        let kind: i32 = hir_kind(hir);
        if (kind == 3) {
            vec_push<i64>(stack, hir_left(hir));
        } else {
            if (kind == 4) {
                vec_set<i64>(local_ids, current_index, hir_binding_id(hir));
            } else {
                if (hir_is_symbol_reference(hir) != 0) {
                    vec_set<i64>(local_ids, current_index, -1);
                } else {
                if (kind == 8) {
                    vec_push<i64>(stack, hir_right(hir));
                    vec_push<i64>(stack, hir_left(hir));
                } else {
                if (kind == 11) {
                    vec_push<i64>(stack, hir_right(hir));
                } else {
                if (vec_get<i64>(local_ids, current_index) < 0) {
                    var unit_call:i32=0;
                    if(hir_is_call(hir)!=0){if(hir_type_code(hir)==function_mir_unit_type_code()){unit_call=1;}}
                    if(unit_call==0){
                    let next_local: i64 = vec_get<i64>(counters, 0);
                    vec_set<i64>(local_ids, current_index, next_local);
                    var local_mode:i32=function_mir_mode_value();
                    if(hir_is_call(hir)!=0){
                        let callee_hir:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,hir_left(hir));
                        let signature_index:i64=sfr_find_function_signature(source,function_signatures,hir_start(callee_hir),hir_length(callee_hir));
                        if(signature_index>=0){
                            let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(function_signatures,signature_index);
                            local_mode=source_function_signature_return_mode(signature);
                        }
                    }
                    vec_push<MirFunctionRecord>(output,function_mir_temporary_mode(
                        next_local,hir_type_code(hir),vec_get<i64>(canonical_ids,current_index),local_mode
                    ));
                    vec_set<i64>(counters, 0, checked_add(next_local, 1));
                    }
                }
                if (kind == 2) {
                    vec_push<i64>(stack, hir_right(hir));
                    vec_push<i64>(stack, hir_left(hir));
                }
                if (kind == 5) {
                    vec_push<i64>(stack, hir_right(hir));
                    vec_push<i64>(stack, hir_left(hir));
                }
                if (hir_is_call(hir) != 0) {
                    if (hir_right(hir) >= 0) { vec_push<i64>(stack, hir_right(hir)); }
                }
                if (kind == 7) { vec_push<i64>(stack, hir_left(hir)); }
                if (kind == 10) { if (hir_right(hir) >= 0) { vec_push<i64>(stack, hir_right(hir)); } }
                }
                }
                }
            }
        }
    }

    var alias_index: i64 = 0;
    while (alias_index < count) {
        let alias: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, alias_index);
        if (hir_kind(alias) == 3) {
            vec_set<i64>(local_ids, alias_index, vec_get<i64>(local_ids, hir_left(alias)));
        }
        alias_index = checked_add(alias_index, 1);
    }

    var hir_index: i64 = 0;
    while (hir_index < count) {
        let hir: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, hir_index);
        let kind: i32 = hir_kind(hir);
        if (kind == 1) {
            let instruction_id: i64 = vec_get<i64>(counters, 1);
            vec_push<MirFunctionRecord>(output, function_mir_const(
                hir_start(hir), hir_length(hir), instruction_id,
                vec_get<i64>(local_ids, hir_index), hir_type_code(hir),
                vec_get<i64>(canonical_ids, hir_index)
            ));
            vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
        }
        if(hir_is_string_literal(hir)!=0){
            let instruction_id:i64=vec_get<i64>(counters,1);
            vec_push<MirFunctionRecord>(output,function_mir_const(
                hir_start(hir),hir_length(hir),instruction_id,
                vec_get<i64>(local_ids,hir_index),hir_type_code(hir),
                vec_get<i64>(canonical_ids,hir_index)
            ));
            vec_set<i64>(counters,1,checked_add(instruction_id,1));
        }
        if (kind == 2) {
            let instruction_id: i64 = vec_get<i64>(counters, 1);
            vec_push<MirFunctionRecord>(output, function_mir_binary(
                hir_start(hir), hir_length(hir), instruction_id,
                vec_get<i64>(local_ids, hir_index),
                vec_get<i64>(local_ids, hir_left(hir)), vec_get<i64>(local_ids, hir_right(hir)),
                hir_symbol(hir), hir_type_code(hir), hir_numeric_policy(hir),
                vec_get<i64>(canonical_ids, hir_index)
            ));
            vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
        }
        if (kind == 5) {
            let instruction_id: i64 = vec_get<i64>(counters, 1);
            vec_push<MirFunctionRecord>(output, function_mir_binary(
                hir_start(hir), hir_length(hir), instruction_id,
                vec_get<i64>(local_ids, hir_index),
                vec_get<i64>(local_ids, hir_left(hir)), vec_get<i64>(local_ids, hir_right(hir)),
                hir_symbol(hir), hir_type_code(hir), hir_numeric_policy(hir),
                vec_get<i64>(canonical_ids, hir_index)
            ));
            vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
        }
        if (hir_is_call(hir) != 0) {
            let callee: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, hir_left(hir));
            if (hir_is_symbol_reference(callee) == 0) { return -20; }
            let instruction_id: i64 = vec_get<i64>(counters, 1);
            let checked_symbol: i32 = sfr_checked_numeric_symbol(source, callee);
            if (checked_symbol != 0) {
                let arguments: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, hir_right(hir));
                if (hir_is_pair(arguments) == 0) { return -21; }
                vec_push<MirFunctionRecord>(output, function_mir_binary(
                    hir_start(hir), hir_length(hir), instruction_id,
                    vec_get<i64>(local_ids, hir_index),
                    vec_get<i64>(local_ids, hir_left(arguments)), vec_get<i64>(local_ids, hir_right(arguments)),
                    checked_symbol, hir_type_code(hir),
                    function_mir_checked_numeric_policy(), vec_get<i64>(canonical_ids, hir_index)
                ));
            } else {
                let signature_index:i64=sfr_find_function_signature(
                    source,function_signatures,hir_start(callee),hir_length(callee)
                );
                if(signature_index>=0){
                    let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(function_signatures,signature_index);
                    var call_result:i64=vec_get<i64>(local_ids,hir_index);
                    if(hir_type_code(hir)==function_mir_unit_type_code()){call_result=-1;}
                    vec_push<MirFunctionRecord>(output,function_mir_call(
                        hir_start(hir),hir_length(hir),instruction_id,
                        call_result,hir_start(callee),hir_length(callee),
                        source_function_signature_return_type(signature),source_function_signature_return_mode(signature),
                        vec_get<i64>(canonical_ids,hir_index)
                    ));
                    var argument_nodes:Vec<i64>=vec_new<i64>(allocator,source_function_signature_parameter_count(signature));
                    var argument_stack:Vec<i64>=vec_new<i64>(allocator,source_function_signature_parameter_count(signature));
                    if(hir_right(hir)>=0){vec_push<i64>(argument_stack,hir_right(hir));}
                    while(vec_len<i64>(argument_stack)>0){
                        let argument_index:i64=vec_pop<i64>(argument_stack);
                        let argument:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,argument_index);
                        if(hir_kind(argument)==8){
                            vec_push<i64>(argument_stack,hir_right(argument));
                            vec_push<i64>(argument_stack,hir_left(argument));
                        } else {vec_push<i64>(argument_nodes,argument_index);}
                    }
                    if(vec_len<i64>(argument_nodes)!=source_function_signature_parameter_count(signature)){return sfr_call_argument_count_error();}
                    var loan_roots:Vec<i64>=vec_new<i64>(allocator,vec_len<i64>(argument_nodes));
                    var loan_modes:Vec<i32>=vec_new<i32>(allocator,vec_len<i64>(argument_nodes));
                    var moved_roots:Vec<i64>=vec_new<i64>(allocator,vec_len<i64>(argument_nodes));
                    var argument_ordinal:i64=0;
                    while(argument_ordinal<vec_len<i64>(argument_nodes)){
                        let parameter_index:i64=checked_add(source_function_signature_parameter_start(signature),argument_ordinal);
                        let parameter:SourceFunctionParameter=vec_get<SourceFunctionParameter>(function_parameters,parameter_index);
                        let argument_node:i64=vec_get<i64>(argument_nodes,argument_ordinal);
                        let argument_local:i64=vec_get<i64>(local_ids,argument_node);
                        if(argument_local<0){return sfr_call_argument_expression_error();}
                        if(sfr_local_type_code(output,argument_local)!=source_function_parameter_type(parameter)){return sfr_call_argument_type_error();}
                        let parameter_mode:i32=source_function_parameter_mode(parameter);
                        let argument_mode:i32=sfr_local_mode(output,argument_local);
                        let argument_root:i64=sfr_hir_borrow_root(
                            source,hir_nodes,function_signatures,argument_node,allocator
                        );
                        if(parameter_mode==function_mir_mode_value()){
                            if(argument_mode!=function_mir_mode_value()){return sfr_borrowed_argument_passed_by_value_error();}
                            if(argument_root>=0){
                                if(function_mir_type_uses_ownership_transfer(sfr_local_type_code(output,argument_local))!=0){
                                    var loan_scan:i64=0;
                                    while(loan_scan<vec_len<i64>(loan_roots)){
                                        if(vec_get<i64>(loan_roots,loan_scan)==argument_root){return sfr_move_while_loaned_error();}
                                        loan_scan=checked_add(loan_scan,1);
                                    }
                                    vec_push<i64>(moved_roots,argument_root);
                                }
                            }
                        } else {
                            if(argument_root<0){return sfr_unresolved_borrow_root_error();}
                            if(parameter_mode==function_mir_mode_mutable_borrow()){
                                if(argument_mode==function_mir_mode_borrowed()){return sfr_shared_to_mutable_borrow_error();}
                                if(sfr_local_mutable(output,argument_root)==0){return sfr_immutable_mutable_borrow_error();}
                            }
                            var moved_scan:i64=0;
                            while(moved_scan<vec_len<i64>(moved_roots)){
                                if(vec_get<i64>(moved_roots,moved_scan)==argument_root){return sfr_borrow_of_moved_value_error();}
                                moved_scan=checked_add(moved_scan,1);
                            }
                            var loan_scan:i64=0;
                            while(loan_scan<vec_len<i64>(loan_roots)){
                                if(vec_get<i64>(loan_roots,loan_scan)==argument_root){
                                    if(parameter_mode==function_mir_mode_mutable_borrow()){return sfr_conflicting_loan_error();}
                                    if(vec_get<i32>(loan_modes,loan_scan)==function_mir_mode_mutable_borrow()){return sfr_conflicting_loan_error();}
                                }
                                loan_scan=checked_add(loan_scan,1);
                            }
                            vec_push<i64>(loan_roots,argument_root);
                            vec_push<i32>(loan_modes,parameter_mode);
                        }
                        vec_push<MirFunctionRecord>(output,function_mir_call_argument(
                            instruction_id,argument_local,parameter_mode,argument_ordinal
                        ));
                        argument_ordinal=checked_add(argument_ordinal,1);
                    }
                    drop(moved_roots);drop(loan_modes);drop(loan_roots);
                    drop(argument_stack);drop(argument_nodes);
                } else {
                let builtin_kind:i32=sfr_builtin_call_kind(source,hir_start(callee),hir_length(callee));
                if(builtin_kind!=0){
                    var builtin_result:i64=vec_get<i64>(local_ids,hir_index);
                    if(sfr_builtin_call_return_type(builtin_kind)==function_mir_unit_type_code()){builtin_result=-1;}
                    vec_push<MirFunctionRecord>(output,function_mir_call(
                        hir_start(hir),hir_length(hir),instruction_id,
                        builtin_result,hir_start(callee),hir_length(callee),
                        sfr_builtin_call_return_type(builtin_kind),function_mir_mode_value(),
                        vec_get<i64>(canonical_ids,hir_index)
                    ));
                    var builtin_arguments:Vec<i64>=vec_new<i64>(allocator,sfr_builtin_call_parameter_count(builtin_kind));
                    var builtin_stack:Vec<i64>=vec_new<i64>(allocator,sfr_builtin_call_parameter_count(builtin_kind));
                    if(hir_right(hir)>=0){vec_push<i64>(builtin_stack,hir_right(hir));}
                    while(vec_len<i64>(builtin_stack)>0){
                        let argument_index:i64=vec_pop<i64>(builtin_stack);
                        let argument:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,argument_index);
                        if(hir_kind(argument)==8){
                            vec_push<i64>(builtin_stack,hir_right(argument));
                            vec_push<i64>(builtin_stack,hir_left(argument));
                        } else {vec_push<i64>(builtin_arguments,argument_index);}
                    }
                    if(vec_len<i64>(builtin_arguments)!=sfr_builtin_call_parameter_count(builtin_kind)){return sfr_call_argument_count_error();}
                    var builtin_ordinal:i64=0;
                    while(builtin_ordinal<vec_len<i64>(builtin_arguments)){
                        let argument_node:i64=vec_get<i64>(builtin_arguments,builtin_ordinal);
                        let argument_local:i64=vec_get<i64>(local_ids,argument_node);
                        if(argument_local<0){return sfr_call_argument_expression_error();}
                        let expected_argument_type:i32=sfr_builtin_call_parameter_type(builtin_kind,builtin_ordinal);
                        if(sfr_local_type_code(output,argument_local)!=expected_argument_type){return sfr_call_argument_type_error();}
                        vec_push<MirFunctionRecord>(output,function_mir_call_argument(
                            instruction_id,argument_local,sfr_builtin_call_parameter_mode(builtin_kind,builtin_ordinal),builtin_ordinal
                        ));
                        builtin_ordinal=checked_add(builtin_ordinal,1);
                    }
                    drop(builtin_stack);drop(builtin_arguments);
                } else {
                    let variant: i32 = sfr_variant_code(
                        source, enum_catalog, hir_type_code(hir), hir_start(callee), hir_length(callee)
                    );
                    if (variant < 0) { return -21; }
                    vec_push<MirFunctionRecord>(output, function_mir_construct(
                        hir_start(hir), hir_length(hir), instruction_id,
                        vec_get<i64>(local_ids, hir_index), vec_get<i64>(local_ids, hir_right(hir)),
                        variant, hir_type_code(hir), vec_get<i64>(canonical_ids, hir_index)
                    ));
                }
                }
            }
            vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
        }
        if (kind == 10) {
            let constructor_symbol: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, hir_left(hir));
            if (hir_is_symbol_reference(constructor_symbol) == 0) { return sfr_invalid_struct_symbol_error(); }
            if (source_i64_struct_type_code(
                source, struct_catalog, hir_start(constructor_symbol), hir_length(constructor_symbol)
            ) != hir_type_code(hir)) { return sfr_unresolved_struct_type_error(); }
            if (hir_right(hir) < 0) { return sfr_missing_struct_initializer_error(); }
            let field_count: i32 = sfr_i64_struct_field_count(struct_catalog, hir_type_code(hir));
            if (field_count <= 0) { return sfr_invalid_struct_initializer_error(); }
            var seen: Vec<i32> = vec_new<i32>(allocator, 0);
            var initializer_stack: Vec<i64> = vec_new<i64>(allocator, 0);
            vec_push<i64>(initializer_stack, hir_right(hir));
            var emitted_fields: i32 = 0;
            while (vec_len<i64>(initializer_stack) > 0) {
                let initializer_index: i64 = vec_pop<i64>(initializer_stack);
                let initializer: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, initializer_index);
                if (hir_kind(initializer) == 8) {
                    vec_push<i64>(initializer_stack, hir_right(initializer));
                    vec_push<i64>(initializer_stack, hir_left(initializer));
                } else {
                    if (hir_kind(initializer) != 11) { return sfr_invalid_struct_initializer_error(); }
                    let initializer_symbol: HirExpressionRecord = vec_get<HirExpressionRecord>(hir_nodes, hir_left(initializer));
                    if (hir_is_symbol_reference(initializer_symbol) == 0) { return sfr_invalid_struct_initializer_error(); }
                    let field_ordinal: i32 = sfr_i64_struct_field_ordinal(
                        source, struct_catalog, hir_type_code(hir),
                        hir_start(initializer_symbol), hir_length(initializer_symbol)
                    );
                    if (field_ordinal < 0) { return sfr_invalid_struct_initializer_error(); }
                    if (field_ordinal >= field_count) { return sfr_invalid_struct_initializer_error(); }
                    var seen_scan: i64 = 0;
                    while (seen_scan < vec_len<i32>(seen)) {
                        if (vec_get<i32>(seen, seen_scan) == field_ordinal) { return sfr_invalid_struct_initializer_error(); }
                        seen_scan = checked_add(seen_scan, 1);
                    }
                    vec_push<i32>(seen, field_ordinal);
                    let instruction_id: i64 = vec_get<i64>(counters, 1);
                    if (emitted_fields == 0) {
                        vec_push<MirFunctionRecord>(output, function_mir_struct_construct(
                            hir_start(hir), hir_length(hir), instruction_id,
                            vec_get<i64>(local_ids, hir_index), vec_get<i64>(local_ids, hir_right(initializer)),
                            field_ordinal, hir_type_code(hir), vec_get<i64>(canonical_ids, hir_index)
                        ));
                    } else {
                        vec_push<MirFunctionRecord>(output, function_mir_struct_field_store(
                            hir_start(initializer), hir_length(initializer), instruction_id,
                            vec_get<i64>(local_ids, hir_index), vec_get<i64>(local_ids, hir_right(initializer)),
                            field_ordinal, hir_type_code(hir), vec_get<i64>(canonical_ids, hir_index)
                        ));
                    }
                    vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
                    emitted_fields = checked_add(emitted_fields, 1);
                }
            }
            drop(initializer_stack); drop(seen);
            if (emitted_fields != field_count) { return sfr_invalid_struct_initializer_error(); }
        }
        if (kind == 7) {
            var receiver_index:i64=hir_left(hir);
            var receiver_hir:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,receiver_index);
            while(hir_kind(receiver_hir)==3){
                receiver_index=hir_left(receiver_hir);
                receiver_hir=vec_get<HirExpressionRecord>(hir_nodes,receiver_index);
            }
            let receiver_local: i64 = vec_get<i64>(local_ids, receiver_index);
            if (receiver_local < 0) { return sfr_invalid_struct_receiver_error(); }
            let receiver_type_code: i32 = sfr_local_type_code(output, receiver_local);
            if (receiver_type_code < function_mir_i64_struct_type_code(0)) { return sfr_unresolved_struct_receiver_error(); }
            var field_index:i64=hir_right(hir);
            var field_symbol:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,field_index);
            while(hir_kind(field_symbol)==3){
                field_index=hir_left(field_symbol);
                field_symbol=vec_get<HirExpressionRecord>(hir_nodes,field_index);
            }
            let field_ordinal: i32 = sfr_i64_struct_field_ordinal(
                source, struct_catalog, receiver_type_code,
                hir_start(field_symbol), hir_length(field_symbol)
            );
            if (field_ordinal < 0) { return sfr_invalid_struct_receiver_error(); }
            let instruction_id: i64 = vec_get<i64>(counters, 1);
            vec_push<MirFunctionRecord>(output, function_mir_struct_field_load(
                hir_start(hir), hir_length(hir), instruction_id,
                vec_get<i64>(local_ids, hir_index), receiver_local,
                field_ordinal,
                vec_get<i64>(canonical_ids, hir_index)
            ));
            vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
        }
        hir_index = checked_add(hir_index, 1);
    }

    var result_local: i64 = vec_get<i64>(local_ids, checked_sub(count, 1));
    let result_hir:HirExpressionRecord=vec_get<HirExpressionRecord>(hir_nodes,checked_sub(count,1));
    if(hir_is_call(result_hir)!=0){if(hir_type_code(result_hir)==function_mir_unit_type_code()){result_local=sfr_unit_expression_result();}}
    drop(stack); drop(local_ids); drop(canonical_ids); drop(hir_nodes); drop(ast_nodes); drop(expressions);
    return result_local;
}

pub fn lower_source_function_body_records(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow statements: Vec<StatementRecord>,
    borrow operands: Vec<StatementOperand>,
    borrow enum_catalog: Vec<EnumVariantCatalogEntry>,
    borrow struct_catalog: Vec<I64StructCatalogEntry>,
    borrow resolved_arms: Vec<ResolvedMatchArm>,
    allocator: Allocator,
    borrow_mut records: Vec<MirFunctionRecord>,
    borrow_mut events: Vec<MirLowerEvent>
) -> i32
requires_caps [allocate]
{
    var destructor_body: i32 = 0;
    var name_index: i64 = sfr_function_name_index(source, tokens);
    if (name_index < 0) {
        name_index = sfr_destructor_name_index(source, tokens);
        if (name_index >= 0) { destructor_body = 1; }
    }
    if (name_index < 0) { return 1; }
    let name_token: Token = vec_get<Token>(tokens, name_index);
    var result_type_code: i32 = function_mir_i64_type_code();
    var function_signatures:Vec<SourceFunctionSignature>=vec_new<SourceFunctionSignature>(allocator,8);
    var function_parameters:Vec<SourceFunctionParameter>=vec_new<SourceFunctionParameter>(allocator,16);
    var source_tokens:Vec<Token>=lex(source,allocator);
    var current_signature:i64=-1;
    if (destructor_body != 0) {
        result_type_code = source_i64_struct_type_code(
            source, struct_catalog, token_start(name_token), token_length(name_token)
        );
        if (result_type_code < function_mir_i64_struct_type_code(0)) { return 1; }
    } else {
        let signature_status:i32=derive_source_function_signatures(
            source,source_tokens,enum_catalog,struct_catalog,allocator,function_signatures,function_parameters
        );
        if(signature_status!=0){return sfr_function_signature_status(signature_status);}
        var signature_index:i64=0;
        while(signature_index<vec_len<SourceFunctionSignature>(function_signatures)){
            let candidate:SourceFunctionSignature=vec_get<SourceFunctionSignature>(function_signatures,signature_index);
            if(sfr_span_equal(source,token_start(name_token),token_length(name_token),source_function_signature_name_start(candidate),source_function_signature_name_length(candidate))!=0){
                if(current_signature>=0){return sfr_duplicate_current_signature_status();}
                current_signature=signature_index;
            }
            signature_index=checked_add(signature_index,1);
        }
        if(current_signature<0){return sfr_missing_current_signature_status();}
        let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(function_signatures,current_signature);
        result_type_code=source_function_signature_return_type(signature);
    }
    if(destructor_body!=0){
        vec_push<MirFunctionRecord>(records,function_mir_header(
            token_start(name_token),token_length(name_token),token_start(name_token),token_length(name_token),result_type_code
        ));
    } else {
        let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(function_signatures,current_signature);
        vec_push<MirFunctionRecord>(records,function_mir_callable_header(
            token_start(name_token),token_length(name_token),token_start(name_token),token_length(name_token),result_type_code,
            source_function_signature_return_mode(signature),source_function_signature_borrowed_origin(signature),
            source_function_signature_parameter_count(signature)
        ));
    }

    var binding_starts: Vec<i64> = vec_new<i64>(allocator, 8);
    var binding_lengths: Vec<i64> = vec_new<i64>(allocator, 8);
    if (destructor_body != 0) {
        var self_index: i64 = sfr_self_token_index(source, tokens);
        if (self_index < 0) { self_index = name_index; }
        let self_token: Token = vec_get<Token>(tokens, self_index);
        vec_push<i64>(binding_starts, token_start(self_token));
        vec_push<i64>(binding_lengths, token_length(self_token));
        vec_push<MirFunctionRecord>(records, function_mir_source_local(
            token_start(self_token), token_length(self_token), 0, result_type_code, 0, 1
        ));
    } else {
        let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(function_signatures,current_signature);
        var parameter_ordinal:i64=0;
        while(parameter_ordinal<source_function_signature_parameter_count(signature)){
            let parameter_index:i64=checked_add(source_function_signature_parameter_start(signature),parameter_ordinal);
            let parameter:SourceFunctionParameter=vec_get<SourceFunctionParameter>(function_parameters,parameter_index);
            let local_id:i64=vec_len<i64>(binding_starts);
            vec_push<i64>(binding_starts,source_function_parameter_name_start(parameter));
            vec_push<i64>(binding_lengths,source_function_parameter_name_length(parameter));
            vec_push<MirFunctionRecord>(records,function_mir_parameter(
                source_function_parameter_name_start(parameter),source_function_parameter_name_length(parameter),local_id,
                source_function_parameter_type(parameter),local_id,source_function_parameter_mutable(parameter),
                source_function_parameter_mode(parameter),parameter_ordinal
            ));
            parameter_ordinal=checked_add(parameter_ordinal,1);
        }
    }
    var statement_index: i64 = 0;
    while (statement_index < vec_len<StatementRecord>(statements)) {
        let statement: StatementRecord = vec_get<StatementRecord>(statements, statement_index);
        let kind: i32 = statement_record_kind(statement);
        if (kind == 20) {
            let binding_index: i64 = sfr_operand(statement, operands, 1);
            if (binding_index < 0) { return 2; }
            let binding: StatementOperand = vec_get<StatementOperand>(operands, binding_index);
            let binding_id: i64 = vec_len<i64>(binding_starts);
            vec_push<i64>(binding_starts, statement_operand_start(binding));
            vec_push<i64>(binding_lengths, statement_operand_length(binding));
            let type_index: i64 = sfr_operand(statement, operands, 2);
            if (type_index < 0) { return 4; }
            let declared: StatementOperand = vec_get<StatementOperand>(operands, type_index);
            let payload_subject: i32 = sfr_is_payload_match_subject(
                source, tokens, statements, operands, resolved_arms,
                statement_operand_start(binding), statement_operand_length(binding)
            );
            let type_code: i32 = sfr_declared_type_code(source, source_tokens, enum_catalog, struct_catalog, resolved_arms, statement_operand_start(declared), statement_operand_length(declared), payload_subject);
            vec_push<MirFunctionRecord>(records, function_mir_source_local(
                statement_operand_start(binding), statement_operand_length(binding), binding_id, type_code, binding_id, 0
            ));
        }
        if (kind == 21) {
            let binding_index: i64 = sfr_operand(statement, operands, 1);
            if (binding_index < 0) { return 3; }
            let binding: StatementOperand = vec_get<StatementOperand>(operands, binding_index);
            let binding_id: i64 = vec_len<i64>(binding_starts);
            vec_push<i64>(binding_starts, statement_operand_start(binding));
            vec_push<i64>(binding_lengths, statement_operand_length(binding));
            let type_index: i64 = sfr_operand(statement, operands, 2);
            if (type_index < 0) { return 5; }
            let declared: StatementOperand = vec_get<StatementOperand>(operands, type_index);
            let payload_subject: i32 = sfr_is_payload_match_subject(
                source, tokens, statements, operands, resolved_arms,
                statement_operand_start(binding), statement_operand_length(binding)
            );
            let type_code: i32 = sfr_declared_type_code(source, source_tokens, enum_catalog, struct_catalog, resolved_arms, statement_operand_start(declared), statement_operand_length(declared), payload_subject);
            vec_push<MirFunctionRecord>(records, function_mir_source_local(
                statement_operand_start(binding), statement_operand_length(binding), binding_id, type_code, binding_id, 1
            ));
        }
        statement_index = checked_add(statement_index, 1);
    }

    var arm_index: i64 = 0;
    while (arm_index < vec_len<ResolvedMatchArm>(resolved_arms)) {
        let arm: ResolvedMatchArm = vec_get<ResolvedMatchArm>(resolved_arms, arm_index);
        if (resolved_match_binding_start(arm) >= 0) {
            let local_id: i64 = vec_len<i64>(binding_starts);
            vec_push<i64>(binding_starts, resolved_match_binding_start(arm));
            vec_push<i64>(binding_lengths, resolved_match_binding_length(arm));
            vec_push<MirFunctionRecord>(records, function_mir_source_local(
                resolved_match_binding_start(arm), resolved_match_binding_length(arm),
                local_id, resolved_match_payload_type_code(arm), local_id, 0
            ));
        }
        arm_index = checked_add(arm_index, 1);
    }

    var counters: Vec<i64> = vec_new<i64>(allocator, 3);
    vec_push<i64>(counters, vec_len<i64>(binding_starts));
    vec_push<i64>(counters, 0);
    vec_push<i64>(counters, 0);

    statement_index = 0;
    while (statement_index < vec_len<StatementRecord>(statements)) {
        let statement: StatementRecord = vec_get<StatementRecord>(statements, statement_index);
        let kind: i32 = statement_record_kind(statement);
        if (kind == 20) {
            let expression_index: i64 = sfr_operand(statement, operands, 3);
            let binding_index: i64 = sfr_operand(statement, operands, 1);
            if (expression_index < 0) { return 10; }
            if (binding_index < 0) { return 10; }
            let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
            let binding: StatementOperand = vec_get<StatementOperand>(operands, binding_index);
            let destination: i64 = hir_find_binding_id(source, binding_starts, binding_lengths,
                statement_operand_start(binding), statement_operand_length(binding));
            var expression_start: i64 = statement_operand_start(expression);
            var expression_length: i64 = statement_operand_length(expression);
            let try_binding: i32 = statement_operand_is_try(source, tokens, expression);
            var expected_type: i32 = sfr_local_type_code(records, destination);
            if (try_binding != 0) {
                expression_start = statement_try_value_start(tokens, expression);
                expression_length = statement_try_value_length(tokens, expression);
                expected_type = result_type_code;
                if (expression_start < 0) { return 10; }
                if (expression_length <= 0) { return 10; }
            }
            let source_local: i64 = sfr_emit_expression(source, tokens, binding_starts, binding_lengths,
                expression_start, expression_length, expected_type, enum_catalog, struct_catalog,
                function_signatures, function_parameters, allocator, records, counters);
            if (source_local < 0) { return sfr_expression_failure_status(source_local); }
            if(sfr_local_mode(records,source_local)!=function_mir_mode_value()){return sfr_borrowed_value_storage_status();}
            if (try_binding != 0) {
                if (sfr_validate_try_type(
                    source, enum_catalog, sfr_local_type_code(records, source_local),
                    sfr_local_type_code(records, destination), result_type_code
                ) == 0) { return sfr_try_result_shape_status(); }
                let tag_local: i64 = vec_get<i64>(counters, 0);
                vec_push<MirFunctionRecord>(records, function_mir_temporary(
                    tag_local, function_mir_i64_type_code(), vec_get<i64>(counters, 2)
                ));
                vec_set<i64>(counters, 0, checked_add(tag_local, 1));
                let tag_instruction: i64 = vec_get<i64>(counters, 1);
                vec_push<MirFunctionRecord>(records, function_mir_enum_tag_load(
                    statement_record_start(statement), statement_record_length(statement), tag_instruction,
                    tag_local, source_local, vec_get<i64>(counters, 2)
                ));
                vec_set<i64>(counters, 1, checked_add(tag_instruction, 1));
                vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
                let payload_instruction: i64 = vec_get<i64>(counters, 1);
                vec_push<MirFunctionRecord>(records, function_mir_enum_payload_load(
                    statement_record_start(statement), statement_record_length(statement),
                    payload_instruction, destination, source_local, 0, vec_get<i64>(counters, 2)
                ));
                vec_set<i64>(counters, 1, checked_add(payload_instruction, 1));
                vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
                vec_push<MirFunctionRecord>(records, function_mir_return(
                    statement_record_start(statement), statement_record_length(statement),
                    source_local, vec_get<i64>(counters, 2)
                ));
                vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
            } else {
                var body_owns_transfer: i32 = 1;
                if (source_local < vec_len<i64>(binding_starts)) {
                    if (function_mir_type_uses_ownership_transfer(sfr_local_type_code(records, destination)) != 0) {
                        body_owns_transfer = 0;
                    }
                }
                if (body_owns_transfer != 0) {
                    let instruction_id: i64 = vec_get<i64>(counters, 1);
                    vec_push<MirFunctionRecord>(records, function_mir_copy(
                        statement_record_start(statement), statement_record_length(statement), instruction_id,
                        destination, source_local, destination, vec_get<i64>(counters, 2)
                    ));
                    vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
                    vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
                }
            }
        } else {
            if (kind == 21) {
                let expression_index: i64 = sfr_operand(statement, operands, 3);
                let binding_index: i64 = sfr_operand(statement, operands, 1);
                if (expression_index < 0) { return 12; }
                if (binding_index < 0) { return 12; }
                let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
                let binding: StatementOperand = vec_get<StatementOperand>(operands, binding_index);
                let destination: i64 = hir_find_binding_id(source, binding_starts, binding_lengths,
                    statement_operand_start(binding), statement_operand_length(binding));
                let source_local: i64 = sfr_emit_expression(source, tokens, binding_starts, binding_lengths,
                    statement_operand_start(expression), statement_operand_length(expression),
                    sfr_local_type_code(records, destination), enum_catalog, struct_catalog, function_signatures, function_parameters, allocator, records, counters);
                if (source_local < 0) { return sfr_expression_failure_status(source_local); }
                if(sfr_local_mode(records,source_local)!=function_mir_mode_value()){return sfr_borrowed_value_storage_status();}
                var body_owns_transfer: i32 = 1;
                if (source_local < vec_len<i64>(binding_starts)) {
                    if (function_mir_type_uses_ownership_transfer(sfr_local_type_code(records, destination)) != 0) {
                        body_owns_transfer = 0;
                    }
                }
                if (body_owns_transfer != 0) {
                    let instruction_id: i64 = vec_get<i64>(counters, 1);
                    vec_push<MirFunctionRecord>(records, function_mir_copy(
                        statement_record_start(statement), statement_record_length(statement), instruction_id,
                        destination, source_local, destination, vec_get<i64>(counters, 2)
                    ));
                    vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
                    vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
                }
            } else {
                if (kind == 22) {
                    let expression_index: i64 = sfr_operand(statement, operands, 3);
                    if (expression_index < 0) { return 14; }
                    let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
                    let result_local: i64 = sfr_emit_expression(source, tokens, binding_starts, binding_lengths,
                        statement_operand_start(expression), statement_operand_length(expression),
                        result_type_code, enum_catalog, struct_catalog, function_signatures, function_parameters, allocator, records, counters);
                    if (result_local < 0) { return sfr_expression_failure_status(result_local); }
                    vec_push<MirFunctionRecord>(records, function_mir_return(
                        statement_record_start(statement), statement_record_length(statement), result_local, vec_get<i64>(counters, 2)
                    ));
                    vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
                } else {
                    if (kind == 23) {
                        let expression_index: i64 = sfr_operand(statement, operands, 3);
                        if (expression_index < 0) { return 25; }
                        let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
                        let result_local: i64 = sfr_emit_expression(
                            source, tokens, binding_starts, binding_lengths,
                            statement_operand_start(expression), statement_operand_length(expression),
                            1, enum_catalog, struct_catalog, function_signatures, function_parameters, allocator, records, counters
                        );
                        if (result_local < 0) { return 26; }
                        let instruction_id: i64 = vec_get<i64>(counters, 1);
                        vec_push<MirFunctionRecord>(records, function_mir_print(
                            statement_record_start(statement), statement_record_length(statement),
                            instruction_id, result_local, vec_get<i64>(counters, 2)
                        ));
                        vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
                        vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
                    } else {
                    if (kind == 25) {
                        let expression_index: i64 = sfr_operand(statement, operands, 3);
                        if (expression_index < 0) { return 16; }
                        let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
                        if (sfr_emit_expression(source, tokens, binding_starts, binding_lengths,
                            statement_operand_start(expression), statement_operand_length(expression),
                            1, enum_catalog, struct_catalog, function_signatures, function_parameters, allocator, records, counters) < 0) { return 17; }
                    } else {
                        if (kind == 26) {
                            let expression_index: i64 = sfr_operand(statement, operands, 3);
                            if (expression_index < 0) { return 18; }
                            let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
                            if (sfr_emit_expression(source, tokens, binding_starts, binding_lengths,
                                statement_operand_start(expression), statement_operand_length(expression),
                                1, enum_catalog, struct_catalog, function_signatures, function_parameters, allocator, records, counters) < 0) { return 19; }
                        } else {
                            if (kind == 29) {
                                let target_index: i64 = sfr_operand_ordinal(statement, operands, 3, 0);
                                let value_index: i64 = sfr_operand_ordinal(statement, operands, 3, 1);
                                if (target_index < 0) { return 20; }
                                if (value_index < 0) { return 20; }
                                let target: StatementOperand = vec_get<StatementOperand>(operands, target_index);
                                let target_record_start:i64=vec_len<MirFunctionRecord>(records);
                                let target_result:i64=sfr_emit_expression(
                                    source,tokens,binding_starts,binding_lengths,
                                    statement_operand_start(target),statement_operand_length(target),
                                    function_mir_i64_type_code(),enum_catalog,struct_catalog,
                                    function_signatures,function_parameters,allocator,records,counters
                                );
                                if(target_result<0){return 21;}
                                if(vec_len<MirFunctionRecord>(records)>target_record_start){
                                    let omitted_load:MirFunctionRecord=vec_pop<MirFunctionRecord>(records);
                                    if(function_mir_kind(omitted_load)!=function_mir_kind_struct_field_load()){return 21;}
                                    let destination:i64=function_mir_left(omitted_load);
                                    let field_ordinal:i32=function_mir_symbol_code(omitted_load);
                                    vec_set<i64>(counters,1,checked_sub(vec_get<i64>(counters,1),1));
                                    let destination_type:i32=sfr_i64_struct_field_type_code(
                                        source,struct_catalog,sfr_local_type_code(records,destination),field_ordinal
                                    );
                                    if(destination_type==function_mir_unresolved_type_code()){return 21;}
                                    let value:StatementOperand=vec_get<StatementOperand>(operands,value_index);
                                    let source_local:i64=sfr_emit_expression(
                                        source,tokens,binding_starts,binding_lengths,
                                        statement_operand_start(value),statement_operand_length(value),
                                        destination_type,enum_catalog,struct_catalog,function_signatures,
                                        function_parameters,allocator,records,counters
                                    );
                                    if(source_local<0){return 22;}
                                    let instruction_id:i64=vec_get<i64>(counters,1);
                                    vec_push<MirFunctionRecord>(records,function_mir_struct_field_replace(
                                        statement_record_start(statement),statement_record_length(statement),
                                        instruction_id,destination,source_local,field_ordinal,
                                        sfr_local_type_code(records,destination),vec_get<i64>(counters,2)
                                    ));
                                    vec_set<i64>(counters,1,checked_add(instruction_id,1));
                                    vec_set<i64>(counters,2,checked_add(vec_get<i64>(counters,2),1));
                                }
                            } else {
                            if (kind == 30) {
                                let target_index: i64 = sfr_operand_ordinal(statement, operands, 3, 0);
                                let value_index: i64 = sfr_operand_ordinal(statement, operands, 3, 1);
                                if (target_index < 0) { return 20; }
                                if (value_index < 0) { return 20; }
                                let target: StatementOperand = vec_get<StatementOperand>(operands, target_index);
                                var destination: i64 = hir_find_binding_id(
                                    source, binding_starts, binding_lengths,
                                    statement_operand_start(target), statement_operand_length(target)
                                );
                                var field_ordinal: i32 = -1;
                                if (destination < 0) {
                                    let target_end:i64=checked_add(statement_operand_start(target),statement_operand_length(target));
                                    var target_scan:i64=0;
                                    while(target_scan<vec_len<Token>(tokens)){
                                        let receiver_token:Token=vec_get<Token>(tokens,target_scan);
                                        if(token_start(receiver_token)==statement_operand_start(target)){
                                            let dot_index:i64=checked_add(target_scan,1);
                                            let field_index:i64=checked_add(target_scan,2);
                                            if(field_index<vec_len<Token>(tokens)){
                                                let dot_token:Token=vec_get<Token>(tokens,dot_index);
                                                let field_token:Token=vec_get<Token>(tokens,field_index);
                                                if(checked_add(token_start(field_token),token_length(field_token))==target_end){
                                                    if(sfr_token_byte_is(source,dot_token,sfr_ascii_dot())!=0){
                                                        destination=hir_find_binding_id(source,binding_starts,binding_lengths,token_start(receiver_token),token_length(receiver_token));
                                                        if(destination>=0){
                                                            field_ordinal=sfr_i64_struct_field_ordinal(source,struct_catalog,sfr_local_type_code(records,destination),token_start(field_token),token_length(field_token));
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        target_scan=checked_add(target_scan,1);
                                    }
                                    if(destination<0){
                                        let target_record_start:i64=vec_len<MirFunctionRecord>(records);
                                        let target_result:i64=sfr_emit_expression(
                                            source,tokens,binding_starts,binding_lengths,
                                            statement_operand_start(target),statement_operand_length(target),
                                            function_mir_i64_type_code(),enum_catalog,struct_catalog,
                                            function_signatures,function_parameters,allocator,records,counters
                                        );
                                        if(target_result<0){return 21;}
                                        if(vec_len<MirFunctionRecord>(records)<=target_record_start){return 21;}
                                        let omitted_load:MirFunctionRecord=vec_pop<MirFunctionRecord>(records);
                                        if(function_mir_kind(omitted_load)!=function_mir_kind_struct_field_load()){return 21;}
                                        destination=function_mir_left(omitted_load);
                                        field_ordinal=function_mir_symbol_code(omitted_load);
                                        vec_set<i64>(counters,1,checked_sub(vec_get<i64>(counters,1),1));
                                    }
                                }
                                if (destination < 0) { return 21; }
                                var destination_type: i32 = sfr_local_type_code(records, destination);
                                if (field_ordinal >= 0) {
                                    destination_type = sfr_i64_struct_field_type_code(
                                        source, struct_catalog, destination_type, field_ordinal
                                    );
                                    if (destination_type == function_mir_unresolved_type_code()) { return 21; }
                                }
                                let value: StatementOperand = vec_get<StatementOperand>(operands, value_index);
                                let source_local: i64 = sfr_emit_expression(
                                    source, tokens, binding_starts, binding_lengths,
                                    statement_operand_start(value), statement_operand_length(value),
                                    destination_type, enum_catalog, struct_catalog, function_signatures, function_parameters, allocator, records, counters
                                );
                                if (source_local < 0) { return 22; }
                                let instruction_id: i64 = vec_get<i64>(counters, 1);
                                if (field_ordinal >= 0) {
                                    vec_push<MirFunctionRecord>(records, function_mir_struct_field_store(
                                        statement_record_start(statement), statement_record_length(statement),
                                        instruction_id, destination, source_local, field_ordinal,
                                        sfr_local_type_code(records, destination), vec_get<i64>(counters, 2)
                                    ));
                                    vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
                                    vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
                                } else {
                                    vec_push<MirFunctionRecord>(records, function_mir_copy(
                                        statement_record_start(statement), statement_record_length(statement),
                                        instruction_id, destination, source_local, destination,
                                        vec_get<i64>(counters, 2)
                                    ));
                                    vec_set<i64>(counters, 1, checked_add(instruction_id, 1));
                                    vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
                                }
                            } else {
                                if (kind == 31) {
                                    let expression_index: i64 = sfr_operand(statement, operands, 3);
                                    if (expression_index < 0) { return 23; }
                                    let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
                                    let expression_result:i64=sfr_emit_expression(
                                        source, tokens, binding_starts, binding_lengths,
                                        statement_operand_start(expression), statement_operand_length(expression),
                                        1, enum_catalog, struct_catalog, function_signatures, function_parameters, allocator, records, counters
                                    );
                                    if(expression_result<0){if(expression_result!=sfr_unit_expression_result()){return 24;}}
                                } else {
                                    if (kind == 27) {
                                        let expression_index: i64 = sfr_operand(statement, operands, 3);
                                        if (expression_index < 0) { return 27; }
                                        let expression: StatementOperand = vec_get<StatementOperand>(operands, expression_index);
                                        let enum_local: i64 = sfr_emit_expression(
                                            source, tokens, binding_starts, binding_lengths,
                                            statement_operand_start(expression), statement_operand_length(expression),
                                            1, enum_catalog, struct_catalog, function_signatures, function_parameters, allocator, records, counters
                                        );
                                        if (enum_local < 0) { return 28; }
                                        var has_payload: i32 = 0;
                                        var payload_arm: i64 = 0;
                                        while (payload_arm < vec_len<ResolvedMatchArm>(resolved_arms)) {
                                            let arm: ResolvedMatchArm = vec_get<ResolvedMatchArm>(resolved_arms, payload_arm);
                                            if (resolved_match_statement(arm) == statement_index) {
                                                if (resolved_match_binding_start(arm) >= 0) { has_payload = 1; }
                                            }
                                            payload_arm = checked_add(payload_arm, 1);
                                        }
                                        if (has_payload != 0) {
                                        let tag_local: i64 = vec_get<i64>(counters, 0);
                                        vec_push<MirFunctionRecord>(records, function_mir_temporary(tag_local, 1, vec_get<i64>(counters, 2)));
                                        vec_set<i64>(counters, 0, checked_add(tag_local, 1));
                                        let tag_instruction: i64 = vec_get<i64>(counters, 1);
                                        vec_push<MirFunctionRecord>(records, function_mir_enum_tag_load(
                                            statement_record_start(statement), statement_record_length(statement),
                                            tag_instruction, tag_local, enum_local, vec_get<i64>(counters, 2)
                                        ));
                                        vec_set<i64>(counters, 1, checked_add(tag_instruction, 1));
                                        vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
                                        payload_arm = 0;
                                        while (payload_arm < vec_len<ResolvedMatchArm>(resolved_arms)) {
                                            let arm: ResolvedMatchArm = vec_get<ResolvedMatchArm>(resolved_arms, payload_arm);
                                            if (resolved_match_statement(arm) == statement_index) {
                                                if (resolved_match_binding_start(arm) >= 0) {
                                                    let payload_local: i64 = hir_find_binding_id(
                                                        source, binding_starts, binding_lengths,
                                                        resolved_match_binding_start(arm), resolved_match_binding_length(arm)
                                                    );
                                                    let payload_instruction: i64 = vec_get<i64>(counters, 1);
                                                    vec_push<MirFunctionRecord>(records, function_mir_enum_payload_load(
                                                        statement_record_start(statement), statement_record_length(statement),
                                                        payload_instruction, payload_local, enum_local,
                                                        resolved_match_variant_ordinal(arm), vec_get<i64>(counters, 2)
                                                    ));
                                                    vec_set<i64>(counters, 1, checked_add(payload_instruction, 1));
                                                    vec_set<i64>(counters, 2, checked_add(vec_get<i64>(counters, 2), 1));
                                                }
                                            }
                                            payload_arm = checked_add(payload_arm, 1);
                                        }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
            }
        }
        statement_index = checked_add(statement_index, 1);
    }

    var event_statements: Vec<StatementRecord> = vec_new<StatementRecord>(allocator, vec_len<StatementRecord>(statements));
    var event_index: i64 = 0;
    while (event_index < vec_len<StatementRecord>(statements)) {
        let event_statement: StatementRecord = vec_get<StatementRecord>(statements, event_index);
        if (statement_lowering_supports_kind(statement_record_kind(event_statement)) != 0) {
            vec_push<StatementRecord>(event_statements, event_statement);
        }
        event_index = checked_add(event_index, 1);
    }
    var status: i32 = 0;
    // Destructor bodies in this Alpha.2 slice cannot contain enum/match
    // operations, so unrelated enums in the module must not suppress their
    // structured placement stream.
    var lower_structured_events: i32 = destructor_body;
    if (vec_len<EnumVariantCatalogEntry>(enum_catalog) == 0) {
        lower_structured_events = 1;
    }
    if (lower_structured_events != 0) {
        var event_binding_starts:Vec<i64>=vec_new<i64>(allocator,8);
        var event_binding_lengths:Vec<i64>=vec_new<i64>(allocator,8);
        if (destructor_body != 0) {
            vec_push<i64>(event_binding_starts,vec_get<i64>(binding_starts,0));
            vec_push<i64>(event_binding_lengths,vec_get<i64>(binding_lengths,0));
        } else {
            let signature:SourceFunctionSignature=vec_get<SourceFunctionSignature>(function_signatures,current_signature);
            var parameter_ordinal:i64=0;
            while(parameter_ordinal<source_function_signature_parameter_count(signature)){
                vec_push<i64>(event_binding_starts,vec_get<i64>(binding_starts,parameter_ordinal));
                vec_push<i64>(event_binding_lengths,vec_get<i64>(binding_lengths,parameter_ordinal));
                parameter_ordinal=checked_add(parameter_ordinal,1);
            }
        }
        status = lower_typed_statements_with_bindings_to_mir_events(
            source, tokens, event_statements, operands,
            event_binding_starts,event_binding_lengths,allocator,events
        );
        drop(event_binding_lengths);drop(event_binding_starts);
    }
    drop(event_statements);
    drop(counters); drop(binding_lengths); drop(binding_starts);
    return status;
}
