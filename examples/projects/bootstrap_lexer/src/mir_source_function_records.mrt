}

fn sfr_is_read_ok_name(borrow source:Buffer,borrow token:Token)->i32{
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=6){return 0;}
    if(sfr_byte(source,token,0)!=sfr_ascii_upper_r()){return 0;}
    if(sfr_byte(source,token,1)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,2)!=sfr_ascii_a()){return 0;}
    if(sfr_byte(source,token,3)!=sfr_ascii_d()){return 0;}
    if(sfr_byte(source,token,4)!=sfr_ascii_upper_o()){return 0;}
    if(sfr_byte(source,token,5)!=sfr_ascii_k()){return 0;}
    return 1;
}

fn sfr_is_read_err_name(borrow source:Buffer,borrow token:Token)->i32{
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=7){return 0;}
    if(sfr_byte(source,token,0)!=sfr_ascii_upper_r()){return 0;}
    if(sfr_byte(source,token,1)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,2)!=sfr_ascii_a()){return 0;}
    if(sfr_byte(source,token,3)!=sfr_ascii_d()){return 0;}
    if(sfr_byte(source,token,4)!=sfr_ascii_upper_e()){return 0;}
    if(sfr_byte(source,token,5)!=sfr_ascii_r()){return 0;}
    if(sfr_byte(source,token,6)!=sfr_ascii_r()){return 0;}
    return 1;
}

fn sfr_is_write_ok_name(borrow source:Buffer,borrow token:Token)->i32{
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=7){return 0;}
    if(sfr_byte(source,token,0)!=sfr_ascii_upper_w()){return 0;}
    if(sfr_byte(source,token,1)!=sfr_ascii_r()){return 0;}
    if(sfr_byte(source,token,2)!=sfr_ascii_i()){return 0;}
    if(sfr_byte(source,token,3)!=sfr_ascii_t()){return 0;}
    if(sfr_byte(source,token,4)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,5)!=sfr_ascii_upper_o()){return 0;}
    if(sfr_byte(source,token,6)!=sfr_ascii_k()){return 0;}
    return 1;
}

fn sfr_is_write_err_name(borrow source:Buffer,borrow token:Token)->i32{
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=8){return 0;}
    if(sfr_byte(source,token,0)!=sfr_ascii_upper_w()){return 0;}
    if(sfr_byte(source,token,1)!=sfr_ascii_r()){return 0;}
    if(sfr_byte(source,token,2)!=sfr_ascii_i()){return 0;}
    if(sfr_byte(source,token,3)!=sfr_ascii_t()){return 0;}
    if(sfr_byte(source,token,4)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,5)!=sfr_ascii_upper_e()){return 0;}
    if(sfr_byte(source,token,6)!=sfr_ascii_r()){return 0;}
    if(sfr_byte(source,token,7)!=sfr_ascii_r()){return 0;}
    return 1;
}

pub fn derive_predefined_filesystem_result_catalog(
    borrow source:Buffer,borrow tokens:Vec<Token>,borrow_mut output:Vec<EnumVariantCatalogEntry>
)->i32
requires_caps [allocate]
{
    var read_type_start:i64=-1;var read_type_length:i64=0;
    var write_type_start:i64=-1;var write_type_length:i64=0;
    var read_ok_start:i64=-1;var read_ok_length:i64=0;
    var read_err_start:i64=-1;var read_err_length:i64=0;
    var write_ok_start:i64=-1;var write_ok_length:i64=0;
    var write_err_start:i64=-1;var write_err_length:i64=0;
    var token_index:i64=0;
    while(token_index<vec_len<Token>(tokens)){
        let token:Token=vec_get<Token>(tokens,token_index);
        if(read_type_start<0){if(sfr_is_file_read_result_name(source,token)!=0){read_type_start=token_start(token);read_type_length=token_length(token);}}
        if(write_type_start<0){if(sfr_is_file_write_result_name(source,token)!=0){write_type_start=token_start(token);write_type_length=token_length(token);}}
        if(read_ok_start<0){if(sfr_is_read_ok_name(source,token)!=0){read_ok_start=token_start(token);read_ok_length=token_length(token);}}
        if(read_err_start<0){if(sfr_is_read_err_name(source,token)!=0){read_err_start=token_start(token);read_err_length=token_length(token);}}
        if(write_ok_start<0){if(sfr_is_write_ok_name(source,token)!=0){write_ok_start=token_start(token);write_ok_length=token_length(token);}}
        if(write_err_start<0){if(sfr_is_write_err_name(source,token)!=0){write_err_start=token_start(token);write_err_length=token_length(token);}}
        token_index=checked_add(token_index,1);
    }
    var next_enum_id:i64=0;var next_variant_id:i64=0;var catalog_index:i64=0;
    while(catalog_index<vec_len<EnumVariantCatalogEntry>(output)){
        let entry:EnumVariantCatalogEntry=vec_get<EnumVariantCatalogEntry>(output,catalog_index);
        if(entry.enum_id>=next_enum_id){next_enum_id=checked_add(entry.enum_id,1);}
        if(entry.variant_id>=next_variant_id){next_variant_id=checked_add(entry.variant_id,1);}
        catalog_index=checked_add(catalog_index,1);
    }
    if(read_type_start>=0){
        if(read_ok_start<0){read_ok_start=read_type_start;read_ok_length=read_type_length;}
        if(read_err_start<0){read_err_start=read_type_start;read_err_length=read_type_length;}
        vec_push<EnumVariantCatalogEntry>(output,EnumVariantCatalogEntry{
            enum_id:next_enum_id,enum_name_start:read_type_start,enum_name_length:read_type_length,
            variant_id:next_variant_id,ordinal:0,name_start:read_ok_start,name_length:read_ok_length,
            payload_owned:1,payload_type_code:function_mir_buffer_type_code()
        });
        next_variant_id=checked_add(next_variant_id,1);
        vec_push<EnumVariantCatalogEntry>(output,EnumVariantCatalogEntry{
            enum_id:next_enum_id,enum_name_start:read_type_start,enum_name_length:read_type_length,
            variant_id:next_variant_id,ordinal:1,name_start:read_err_start,name_length:read_err_length,
            payload_owned:0,payload_type_code:function_mir_i64_type_code()
        });
        next_enum_id=checked_add(next_enum_id,1);next_variant_id=checked_add(next_variant_id,1);
    }
    if(write_type_start>=0){
        if(write_ok_start<0){write_ok_start=write_type_start;write_ok_length=write_type_length;}
        if(write_err_start<0){write_err_start=write_type_start;write_err_length=write_type_length;}
        vec_push<EnumVariantCatalogEntry>(output,EnumVariantCatalogEntry{
            enum_id:next_enum_id,enum_name_start:write_type_start,enum_name_length:write_type_length,
            variant_id:next_variant_id,ordinal:0,name_start:write_ok_start,name_length:write_ok_length,
            payload_owned:0,payload_type_code:function_mir_i64_type_code()
        });
        next_variant_id=checked_add(next_variant_id,1);
        vec_push<EnumVariantCatalogEntry>(output,EnumVariantCatalogEntry{
            enum_id:next_enum_id,enum_name_start:write_type_start,enum_name_length:write_type_length,
            variant_id:next_variant_id,ordinal:1,name_start:write_err_start,name_length:write_err_length,
            payload_owned:0,payload_type_code:function_mir_i64_type_code()
        });
    }
    return 0;
}

fn sfr_checked_numeric_symbol(borrow source: Buffer, borrow token: HirExpressionRecord) -> i32 {
    if (hir_length(token) != 11) { return 0; }
    let start: i64 = hir_start(token);
    if (buffer_get(source, start) == sfr_ascii_d()) {
        if (buffer_get(source, checked_add(start, 1)) == sfr_ascii_e()) {
            if (buffer_get(source, checked_add(start, 2)) == sfr_ascii_c()) {
                if (buffer_get(source, checked_add(start, 3)) == sfr_ascii_i()) {
                    if (buffer_get(source, checked_add(start, 4)) == sfr_ascii_m()) {
                        if (buffer_get(source, checked_add(start, 5)) == sfr_ascii_a()) {
                            if (buffer_get(source, checked_add(start, 6)) == sfr_ascii_l()) {
                                if (buffer_get(source, checked_add(start, 7)) == sfr_ascii_underscore()) {
                                    if (buffer_get(source, checked_add(start, 8)) == sfr_ascii_d()) {
                                        if (buffer_get(source, checked_add(start, 9)) == sfr_ascii_i()) {
                                            if (buffer_get(source, checked_add(start, 10)) == sfr_ascii_v()) {
                                                return function_mir_binary_divide_symbol();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        return 0;
    }
    if (buffer_get(source, start) != sfr_ascii_c()) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != sfr_ascii_h()) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != sfr_ascii_e()) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != sfr_ascii_c()) { return 0; }
    if (buffer_get(source, checked_add(start, 4)) != sfr_ascii_k()) { return 0; }
    if (buffer_get(source, checked_add(start, 5)) != sfr_ascii_e()) { return 0; }
    if (buffer_get(source, checked_add(start, 6)) != sfr_ascii_d()) { return 0; }
    if (buffer_get(source, checked_add(start, 7)) != sfr_ascii_underscore()) { return 0; }
    let suffix_first: i64 = buffer_get(source, checked_add(start, 8));
    let suffix_second: i64 = buffer_get(source, checked_add(start, 9));
    let suffix_third: i64 = buffer_get(source, checked_add(start, 10));
    if (suffix_first == sfr_ascii_a()) {
        if (suffix_second == sfr_ascii_d()) {
            if (suffix_third == sfr_ascii_d()) { return function_mir_binary_add_symbol(); }
        }
    }
    if (suffix_first == sfr_ascii_s()) {
        if (suffix_second == sfr_ascii_u()) {
            if (suffix_third == sfr_ascii_b()) { return function_mir_binary_subtract_symbol(); }
        }
    }
    if (suffix_first == sfr_ascii_m()) {
        if (suffix_second == sfr_ascii_u()) {
            if (suffix_third == sfr_ascii_l()) { return function_mir_binary_multiply_symbol(); }
        }
    }
    return 0;
}

