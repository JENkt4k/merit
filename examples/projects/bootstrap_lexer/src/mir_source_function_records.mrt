    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=15){return 0;}
    if(sfr_byte(source,token,0)!=sfr_ascii_upper_f()){return 0;}
    if(sfr_byte(source,token,1)!=sfr_ascii_i()){return 0;}
    if(sfr_byte(source,token,2)!=sfr_ascii_l()){return 0;}
    if(sfr_byte(source,token,3)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,4)!=sfr_ascii_upper_w()){return 0;}
    if(sfr_byte(source,token,5)!=sfr_ascii_r()){return 0;}
    if(sfr_byte(source,token,6)!=sfr_ascii_i()){return 0;}
    if(sfr_byte(source,token,7)!=sfr_ascii_t()){return 0;}
    if(sfr_byte(source,token,8)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,9)!=sfr_ascii_upper_r()){return 0;}
    if(sfr_byte(source,token,10)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,11)!=sfr_ascii_s()){return 0;}
    if(sfr_byte(source,token,12)!=sfr_ascii_u()){return 0;}
    if(sfr_byte(source,token,13)!=sfr_ascii_l()){return 0;}
    if(sfr_byte(source,token,14)!=sfr_ascii_t()){return 0;}
