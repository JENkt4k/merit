fn sfr_invalid_struct_symbol_error() -> i64 { return -22; }
fn sfr_unresolved_struct_type_error() -> i64 { return -23; }
fn sfr_missing_struct_initializer_error() -> i64 { return -24; }
fn sfr_invalid_struct_initializer_error() -> i64 { return -25; }
