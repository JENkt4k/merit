fn sfr_ascii_close_brace() -> i64 { return 125; }

pub struct SfrNumericMagnitude { high: i64; low: i64; }
fn sfr_numeric_limb_base() -> i64 { return 1000000000; }
fn sfr_invalid_numeric_magnitude() -> SfrNumericMagnitude { return SfrNumericMagnitude { high:-1, low:-1 }; }
fn sfr_parse_numeric_magnitude(borrow source: Buffer, borrow token: Token) -> SfrNumericMagnitude {
    if (token_kind(token) != token_number_kind()) { return sfr_invalid_numeric_magnitude(); }
    if (token_length(token) <= 0) { return sfr_invalid_numeric_magnitude(); }
    var high: i64 = 0;
    var low: i64 = 0;
    var offset: i64 = 0;
    while (offset < token_length(token)) {
        let byte: i64 = buffer_get(source, checked_add(token_start(token), offset));
        if (byte < 48) { return sfr_invalid_numeric_magnitude(); }
        if (byte > 57) { return sfr_invalid_numeric_magnitude(); }
        let expanded_low: i64 = checked_add(checked_mul(low, 10), checked_sub(byte, 48));
        let carry: i64 = expanded_low / sfr_numeric_limb_base();
        low = expanded_low - checked_mul(carry, sfr_numeric_limb_base());
        high = checked_add(checked_mul(high, 10), carry);
        if (high > 18446744073) { return sfr_invalid_numeric_magnitude(); }
        offset = checked_add(offset, 1);
    }
    return SfrNumericMagnitude { high:high, low:low };
}
fn sfr_magnitude_is_zero(borrow value: SfrNumericMagnitude) -> i32 {
    if (value.high == 0) { if (value.low == 0) { return 1; } }
    return 0;
}
fn sfr_magnitude_at_most(borrow value: SfrNumericMagnitude, high: i64, low: i64) -> i32 {
    if (value.high < high) { return 1; }
    if (value.high > high) { return 0; }
    if (value.low <= low) { return 1; }
    return 0;
}
fn sfr_signed_magnitude_compare(
    left_sign:i32, borrow left:SfrNumericMagnitude,
    right_sign:i32, borrow right:SfrNumericMagnitude
) -> i32 {
    if (left_sign < right_sign) { return -1; }
    if (left_sign > right_sign) { return 1; }
    if (left_sign == 0) { return 0; }
    var magnitude:i32=0;
    if (left.high < right.high) { magnitude=-1; }
    if (left.high > right.high) { magnitude=1; }
    if (left.high == right.high) {
        if (left.low < right.low) { magnitude=-1; }
        if (left.low > right.low) { magnitude=1; }
    }
    if (left_sign < 0) { return 0-magnitude; }
    return magnitude;
}
fn sfr_numeric_sign(sign:i32, borrow value:SfrNumericMagnitude)->i32 {
    if (sfr_magnitude_is_zero(value) != 0) { return 0; }
    return sign;
}
fn sfr_decimal_policy(borrow source:Buffer,borrow token:Token)->i32{
    let start:i64=token_start(token);let length:i64=token_length(token);
    if(length==9){
        if(buffer_get(source,start)==104){if(buffer_get(source,checked_add(start,1))==97){if(buffer_get(source,checked_add(start,2))==108){if(buffer_get(source,checked_add(start,3))==102){if(buffer_get(source,checked_add(start,4))==95){if(buffer_get(source,checked_add(start,5))==101){if(buffer_get(source,checked_add(start,6))==118){if(buffer_get(source,checked_add(start,7))==101){if(buffer_get(source,checked_add(start,8))==110){return 0;}}}}}}}}}
    }
    if(length==7){
        if(buffer_get(source,start)==104){if(buffer_get(source,checked_add(start,1))==97){if(buffer_get(source,checked_add(start,2))==108){if(buffer_get(source,checked_add(start,3))==102){if(buffer_get(source,checked_add(start,4))==95){if(buffer_get(source,checked_add(start,5))==117){if(buffer_get(source,checked_add(start,6))==112){return 1;}}}}}}}
        if(buffer_get(source,start)==99){if(buffer_get(source,checked_add(start,1))==101){if(buffer_get(source,checked_add(start,2))==105){if(buffer_get(source,checked_add(start,3))==108){if(buffer_get(source,checked_add(start,4))==105){if(buffer_get(source,checked_add(start,5))==110){if(buffer_get(source,checked_add(start,6))==103){return 3;}}}}}}}
    }
    if(length==4){if(buffer_get(source,start)==100){if(buffer_get(source,checked_add(start,1))==111){if(buffer_get(source,checked_add(start,2))==119){if(buffer_get(source,checked_add(start,3))==110){return 2;}}}}}
    if(length==5){if(buffer_get(source,start)==102){if(buffer_get(source,checked_add(start,1))==108){if(buffer_get(source,checked_add(start,2))==111){if(buffer_get(source,checked_add(start,3))==111){if(buffer_get(source,checked_add(start,4))==114){return 4;}}}}}}
    return -1;
}

fn sfr_is_file_read_result_name(borrow source:Buffer,borrow token:Token)->i32{
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=14){return 0;}
    if(sfr_byte(source,token,0)!=sfr_ascii_upper_f()){return 0;}
    if(sfr_byte(source,token,1)!=sfr_ascii_i()){return 0;}
    if(sfr_byte(source,token,2)!=sfr_ascii_l()){return 0;}
    if(sfr_byte(source,token,3)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,4)!=sfr_ascii_upper_r()){return 0;}
    if(sfr_byte(source,token,5)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,6)!=sfr_ascii_a()){return 0;}
    if(sfr_byte(source,token,7)!=sfr_ascii_d()){return 0;}
    if(sfr_byte(source,token,8)!=sfr_ascii_upper_r()){return 0;}
    if(sfr_byte(source,token,9)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,10)!=sfr_ascii_s()){return 0;}
    if(sfr_byte(source,token,11)!=sfr_ascii_u()){return 0;}
    if(sfr_byte(source,token,12)!=sfr_ascii_l()){return 0;}
    if(sfr_byte(source,token,13)!=sfr_ascii_t()){return 0;}
    return 1;
}

