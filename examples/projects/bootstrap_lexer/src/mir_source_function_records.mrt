fn sfr_signature_missing_header_status() -> i32 { return 1; }
fn sfr_signature_invalid_name_status() -> i32 { return 2; }
fn sfr_signature_missing_parameter_list_status() -> i32 { return 3; }
fn sfr_signature_invalid_parameter_status() -> i32 { return 4; }
fn sfr_signature_unresolved_parameter_type_status() -> i32 { return 5; }
fn sfr_signature_unclosed_parameter_list_status() -> i32 { return 6; }
fn sfr_signature_missing_return_status() -> i32 { return 7; }
fn sfr_signature_unresolved_return_type_status() -> i32 { return 8; }
fn sfr_signature_unresolved_borrow_origin_status() -> i32 { return 9; }
fn sfr_signature_owned_borrow_origin_status() -> i32 { return 10; }
fn sfr_signature_mutable_origin_required_status() -> i32 { return 11; }
fn sfr_signature_inconsistent_borrow_origin_status() -> i32 { return 12; }
fn sfr_signature_invalid_body_status() -> i32 { return 13; }
fn sfr_callable_catalog_status(status:i32) -> i32 { return checked_add(10,status); }
fn sfr_function_signature_status(status:i32) -> i32 { return checked_add(70,status); }
fn sfr_parameter_ownership_status(status:i32) -> i32 { return checked_add(80,status); }
fn sfr_borrowed_value_storage_status() -> i32 { return 69; }
fn sfr_try_result_shape_status() -> i32 { return 81; }
fn sfr_duplicate_current_signature_status() -> i32 { return 79; }
fn sfr_missing_current_signature_status() -> i32 { return 80; }
fn sfr_expression_failure_status(status: i64) -> i32 {
    if (status == sfr_invalid_struct_symbol_error()) { return 62; }
    if (status == sfr_unresolved_struct_type_error()) { return 63; }
    if (status == sfr_missing_struct_initializer_error()) { return 64; }
    if (status == sfr_invalid_struct_initializer_error()) { return 65; }
    if (status == sfr_invalid_struct_receiver_error()) { return 66; }
    if (status == sfr_unresolved_struct_receiver_error()) { return 67; }
    return 68;
}

pub struct I64StructCatalogEntry {
    struct_id: i32;
    field_ordinal: i32;
    name_start: i64;
    name_length: i64;
    field_start: i64;
    field_length: i64;
    field_type_start: i64;
    field_type_length: i64;
    resolved_field_type_code: i32;
    destructor_policy: i32;
}

pub fn i64_struct_catalog_id(borrow value: I64StructCatalogEntry) -> i32 { return value.struct_id; }
pub fn i64_struct_catalog_field_ordinal(borrow value: I64StructCatalogEntry) -> i32 { return value.field_ordinal; }
pub fn i64_struct_catalog_name_start(borrow value: I64StructCatalogEntry) -> i64 { return value.name_start; }
pub fn i64_struct_catalog_name_length(borrow value: I64StructCatalogEntry) -> i64 { return value.name_length; }
pub fn i64_struct_catalog_field_start(borrow value: I64StructCatalogEntry) -> i64 { return value.field_start; }
pub fn i64_struct_catalog_field_length(borrow value: I64StructCatalogEntry) -> i64 { return value.field_length; }
pub fn i64_struct_catalog_field_type_start(borrow value: I64StructCatalogEntry) -> i64 { return value.field_type_start; }
pub fn i64_struct_catalog_field_type_length(borrow value: I64StructCatalogEntry) -> i64 { return value.field_type_length; }
pub fn i64_struct_catalog_resolved_field_type(borrow value:I64StructCatalogEntry)->i32{return value.resolved_field_type_code;}
pub fn i64_struct_catalog_destructor_policy(borrow value: I64StructCatalogEntry) -> i32 { return value.destructor_policy; }
pub fn i64_struct_catalog_invalid_status() -> i32 { return 1; }
pub fn i64_struct_catalog_replace_unsupported_status() -> i32 { return 2; }
pub fn i64_struct_catalog_driver_status(status: i32) -> i32 { return checked_add(970, status); }
pub fn source_type_descriptor_driver_status(status: i32) -> i32 { return checked_add(980, status); }

// One source-unit catalog is the canonical callable boundary used by both
// function-entry lowering and call lowering. Parameter rows are contiguous in
// declaration order; return origins are parameter ordinals, not source names.
pub struct SourceFunctionSignature {
    name_start:i64; name_length:i64; return_type_code:i32; return_mode:i32;
    borrowed_origin:i64; parameter_start:i64; parameter_count:i64;
}
pub struct SourceFunctionParameter {
    name_start:i64; name_length:i64; type_code:i32; mode:i32; mutable:i32;
}
pub fn source_function_signature_name_start(borrow value:SourceFunctionSignature)->i64{return value.name_start;}
pub fn source_function_signature_name_length(borrow value:SourceFunctionSignature)->i64{return value.name_length;}
pub fn source_function_signature_return_type(borrow value:SourceFunctionSignature)->i32{return value.return_type_code;}
pub fn source_function_signature_return_mode(borrow value:SourceFunctionSignature)->i32{return value.return_mode;}
pub fn source_function_signature_borrowed_origin(borrow value:SourceFunctionSignature)->i64{return value.borrowed_origin;}
pub fn source_function_signature_parameter_start(borrow value:SourceFunctionSignature)->i64{return value.parameter_start;}
pub fn source_function_signature_parameter_count(borrow value:SourceFunctionSignature)->i64{return value.parameter_count;}
pub fn source_function_parameter_name_start(borrow value:SourceFunctionParameter)->i64{return value.name_start;}
pub fn source_function_parameter_name_length(borrow value:SourceFunctionParameter)->i64{return value.name_length;}
pub fn source_function_parameter_type(borrow value:SourceFunctionParameter)->i32{return value.type_code;}
pub fn source_function_parameter_mode(borrow value:SourceFunctionParameter)->i32{return value.mode;}
pub fn source_function_parameter_mutable(borrow value:SourceFunctionParameter)->i32{return value.mutable;}

fn sfr_byte(borrow source: Buffer, borrow token: Token, offset: i64) -> i64 {
    return buffer_get(source, checked_add(token_start(token), offset));
}

fn sfr_is_fn(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != 1) { return 0; }
    if (token_length(token) != 2) { return 0; }
    if (sfr_byte(source, token, 0) != 102) { return 0; }
    if (sfr_byte(source, token, 1) != 110) { return 0; }
    return 1;
}

fn sfr_function_name_index(borrow source: Buffer, borrow tokens: Vec<Token>) -> i64 {
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (sfr_is_fn(source, token) != 0) {
            let name_index: i64 = checked_add(index, 1);
            if (name_index < vec_len<Token>(tokens)) { return name_index; }
        }
        index = checked_add(index, 1);
    }
    return -1;
}

fn sfr_destructor_name_index(borrow source: Buffer, borrow tokens: Vec<Token>) -> i64 {
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (sfr_is_destructor(source, token) != 0) {
            let name_index: i64 = checked_add(index, 1);
            if (name_index < vec_len<Token>(tokens)) { return name_index; }
        }
        index = checked_add(index, 1);
    }
    return -1;
}

fn sfr_self_token_index(borrow source: Buffer, borrow tokens: Vec<Token>) -> i64 {
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (token_kind(token) == token_identifier_kind()) {
            if (token_length(token) == 4) {
                if (sfr_byte(source, token, 0) == sfr_ascii_s()) {
                    if (sfr_byte(source, token, 1) == sfr_ascii_e()) {
                        if (sfr_byte(source, token, 2) == sfr_ascii_l()) {
                            if (sfr_byte(source, token, 3) == sfr_ascii_f()) { return index; }
                        }
                    }
                }
            }
        }
        index = checked_add(index, 1);
    }
    return -1;
}

fn sfr_span_equal(borrow source: Buffer, left_start: i64, left_length: i64, right_start: i64, right_length: i64) -> i32 {
    if (left_length != right_length) { return 0; }
    var offset: i64 = 0;
    while (offset < left_length) {
        if (buffer_get(source, checked_add(left_start, offset)) != buffer_get(source, checked_add(right_start, offset))) { return 0; }
        offset = checked_add(offset, 1);
    }
    return 1;
}

fn sfr_is_enum(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != 1) { return 0; }
    if (token_length(token) != 4) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != 101) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != 110) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != 117) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != 109) { return 0; }
    return 1;
}

fn sfr_is_struct(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != 1) { return 0; }
    if (token_length(token) != 6) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != 115) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != 116) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != 114) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != 117) { return 0; }
    if (buffer_get(source, checked_add(start, 4)) != 99) { return 0; }
    if (buffer_get(source, checked_add(start, 5)) != 116) { return 0; }
    return 1;
}

fn sfr_is_decimal_declaration(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != token_identifier_kind()) { return 0; }
    if (token_length(token) != 7) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != 100) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != 101) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != 99) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != 105) { return 0; }
    if (buffer_get(source, checked_add(start, 4)) != 109) { return 0; }
    if (buffer_get(source, checked_add(start, 5)) != 97) { return 0; }
    if (buffer_get(source, checked_add(start, 6)) != 108) { return 0; }
    return 1;
}

fn sfr_is_bounded_declaration(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != token_identifier_kind()) { return 0; }
    if (token_length(token) != 7) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != 98) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != 111) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != 117) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != 110) { return 0; }
    if (buffer_get(source, checked_add(start, 4)) != 100) { return 0; }
    if (buffer_get(source, checked_add(start, 5)) != 101) { return 0; }
    if (buffer_get(source, checked_add(start, 6)) != 100) { return 0; }
    return 1;
}

fn sfr_token_byte_is(borrow source: Buffer, borrow token: Token, expected: i64) -> i32 {
    if (token_kind(token) != 4) { return 0; }
    if (token_length(token) != 1) { return 0; }
    if (buffer_get(source, token_start(token)) != expected) { return 0; }
    return 1;
}

// Canonical source-encoding bytes used by the destructor policy recognizer.
// Merit character literals are not available at this bootstrap stage.
fn sfr_ascii_a() -> i64 { return 97; }
fn sfr_ascii_b() -> i64 { return 98; }
fn sfr_ascii_upper_a() -> i64 { return 65; }
fn sfr_ascii_upper_b() -> i64 { return 66; }
fn sfr_ascii_c() -> i64 { return 99; }
fn sfr_ascii_d() -> i64 { return 100; }
fn sfr_ascii_e() -> i64 { return 101; }
fn sfr_ascii_f() -> i64 { return 102; }
fn sfr_ascii_g() -> i64 { return 103; }
fn sfr_ascii_h() -> i64 { return 104; }
fn sfr_ascii_i() -> i64 { return 105; }
fn sfr_ascii_k() -> i64 { return 107; }
fn sfr_ascii_l() -> i64 { return 108; }
fn sfr_ascii_m() -> i64 { return 109; }
fn sfr_ascii_n() -> i64 { return 110; }
fn sfr_ascii_o() -> i64 { return 111; }
fn sfr_ascii_upper_e() -> i64 { return 69; }
fn sfr_ascii_upper_f() -> i64 { return 70; }
fn sfr_ascii_upper_l() -> i64 { return 76; }
fn sfr_ascii_upper_o() -> i64 { return 79; }
fn sfr_ascii_upper_r() -> i64 { return 82; }
fn sfr_ascii_upper_s() -> i64 { return 83; }
fn sfr_ascii_upper_t() -> i64 { return 84; }
fn sfr_ascii_upper_w() -> i64 { return 87; }
fn sfr_ascii_p() -> i64 { return 112; }
fn sfr_ascii_r() -> i64 { return 114; }
fn sfr_ascii_s() -> i64 { return 115; }
fn sfr_ascii_t() -> i64 { return 116; }
fn sfr_ascii_u() -> i64 { return 117; }
fn sfr_ascii_v() -> i64 { return 118; }
fn sfr_ascii_w() -> i64 { return 119; }
fn sfr_ascii_y() -> i64 { return 121; }
fn sfr_ascii_comma() -> i64 { return 44; }
fn sfr_ascii_hyphen() -> i64 { return 45; }
fn sfr_ascii_greater() -> i64 { return 62; }
fn sfr_ascii_left_paren() -> i64 { return 40; }
fn sfr_ascii_right_paren() -> i64 { return 41; }
fn sfr_ascii_dot() -> i64 { return 46; }
fn sfr_ascii_colon() -> i64 { return 58; }
fn sfr_ascii_semicolon() -> i64 { return 59; }
