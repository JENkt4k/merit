fn sfr_invalid_struct_symbol_error() -> i64 { return -22; }
fn sfr_unresolved_struct_type_error() -> i64 { return -23; }
fn sfr_missing_struct_initializer_error() -> i64 { return -24; }
fn sfr_invalid_struct_initializer_error() -> i64 { return -25; }
fn sfr_invalid_struct_receiver_error() -> i64 { return -26; }
fn sfr_unresolved_struct_receiver_error() -> i64 { return -27; }
fn sfr_call_argument_count_error() -> i64 { return -28; }
fn sfr_call_argument_expression_error() -> i64 { return -29; }
fn sfr_call_argument_type_error() -> i64 { return -30; }
fn sfr_borrowed_argument_passed_by_value_error() -> i64 { return -31; }
fn sfr_move_while_loaned_error() -> i64 { return -32; }
fn sfr_unresolved_borrow_root_error() -> i64 { return -33; }
fn sfr_shared_to_mutable_borrow_error() -> i64 { return -34; }
fn sfr_immutable_mutable_borrow_error() -> i64 { return -35; }
fn sfr_borrow_of_moved_value_error() -> i64 { return -36; }
fn sfr_conflicting_loan_error() -> i64 { return -37; }
fn sfr_expression_call_argument_count_status() -> i32 { return 90; }
fn sfr_expression_call_argument_expression_status() -> i32 { return 91; }
fn sfr_expression_call_argument_type_status() -> i32 { return 92; }
fn sfr_expression_borrowed_argument_by_value_status() -> i32 { return 93; }
fn sfr_expression_move_while_loaned_status() -> i32 { return 94; }
fn sfr_expression_unresolved_borrow_root_status() -> i32 { return 95; }
fn sfr_expression_shared_to_mutable_borrow_status() -> i32 { return 96; }
fn sfr_expression_immutable_mutable_borrow_status() -> i32 { return 97; }
fn sfr_expression_borrow_of_moved_value_status() -> i32 { return 98; }
fn sfr_expression_conflicting_loan_status() -> i32 { return 99; }
fn sfr_signature_missing_header_status() -> i32 { return 1; }
fn sfr_signature_invalid_name_status() -> i32 { return 2; }
fn sfr_signature_missing_parameter_list_status() -> i32 { return 3; }
fn sfr_signature_invalid_parameter_status() -> i32 { return 4; }
fn sfr_signature_unresolved_parameter_type_status() -> i32 { return 5; }
fn sfr_signature_unclosed_parameter_list_status() -> i32 { return 6; }
fn sfr_signature_missing_return_status() -> i32 { return 7; }
fn sfr_signature_unresolved_return_type_status() -> i32 { return 8; }
fn sfr_signature_unresolved_borrow_origin_status() -> i32 { return 9; }
fn sfr_signature_owned_borrow_origin_status() -> i32 { return 10; }
fn sfr_signature_mutable_origin_required_status() -> i32 { return 11; }
fn sfr_signature_inconsistent_borrow_origin_status() -> i32 { return 12; }
fn sfr_signature_invalid_body_status() -> i32 { return 13; }
fn sfr_callable_catalog_status(status:i32) -> i32 { return checked_add(10,status); }
fn sfr_function_signature_status(status:i32) -> i32 { return checked_add(70,status); }
fn sfr_parameter_ownership_status(status:i32) -> i32 { return checked_add(80,status); }
fn sfr_borrowed_value_storage_status() -> i32 { return 69; }
fn sfr_try_result_shape_status() -> i32 { return 81; }
fn sfr_duplicate_current_signature_status() -> i32 { return 79; }
fn sfr_missing_current_signature_status() -> i32 { return 80; }
fn sfr_expression_failure_status(status: i64) -> i32 {
    if (status == sfr_invalid_struct_symbol_error()) { return 62; }
    if (status == sfr_unresolved_struct_type_error()) { return 63; }
    if (status == sfr_missing_struct_initializer_error()) { return 64; }
    if (status == sfr_invalid_struct_initializer_error()) { return 65; }
    if (status == sfr_invalid_struct_receiver_error()) { return 66; }
    if (status == sfr_unresolved_struct_receiver_error()) { return 67; }
    if (status == sfr_call_argument_count_error()) { return sfr_expression_call_argument_count_status(); }
    if (status == sfr_call_argument_expression_error()) { return sfr_expression_call_argument_expression_status(); }
    if (status == sfr_call_argument_type_error()) { return sfr_expression_call_argument_type_status(); }
    if (status == sfr_borrowed_argument_passed_by_value_error()) { return sfr_expression_borrowed_argument_by_value_status(); }
    if (status == sfr_move_while_loaned_error()) { return sfr_expression_move_while_loaned_status(); }
    if (status == sfr_unresolved_borrow_root_error()) { return sfr_expression_unresolved_borrow_root_status(); }
    if (status == sfr_shared_to_mutable_borrow_error()) { return sfr_expression_shared_to_mutable_borrow_status(); }
    if (status == sfr_immutable_mutable_borrow_error()) { return sfr_expression_immutable_mutable_borrow_status(); }
    if (status == sfr_borrow_of_moved_value_error()) { return sfr_expression_borrow_of_moved_value_status(); }
    if (status == sfr_conflicting_loan_error()) { return sfr_expression_conflicting_loan_status(); }
    return 68;
}

pub struct I64StructCatalogEntry {
    struct_id: i32;
    field_ordinal: i32;
    name_start: i64;
    name_length: i64;
    field_start: i64;
    field_length: i64;
    field_type_start: i64;
    field_type_length: i64;
    resolved_field_type_code: i32;
    destructor_policy: i32;
    abi_flags:i32;
}

pub fn i64_struct_catalog_id(borrow value: I64StructCatalogEntry) -> i32 { return value.struct_id; }
pub fn i64_struct_catalog_field_ordinal(borrow value: I64StructCatalogEntry) -> i32 { return value.field_ordinal; }
pub fn i64_struct_catalog_name_start(borrow value: I64StructCatalogEntry) -> i64 { return value.name_start; }
pub fn i64_struct_catalog_name_length(borrow value: I64StructCatalogEntry) -> i64 { return value.name_length; }
pub fn i64_struct_catalog_field_start(borrow value: I64StructCatalogEntry) -> i64 { return value.field_start; }
pub fn i64_struct_catalog_field_length(borrow value: I64StructCatalogEntry) -> i64 { return value.field_length; }
pub fn i64_struct_catalog_field_type_start(borrow value: I64StructCatalogEntry) -> i64 { return value.field_type_start; }
pub fn i64_struct_catalog_field_type_length(borrow value: I64StructCatalogEntry) -> i64 { return value.field_type_length; }
pub fn i64_struct_catalog_resolved_field_type(borrow value:I64StructCatalogEntry)->i32{return value.resolved_field_type_code;}
pub fn i64_struct_catalog_destructor_policy(borrow value: I64StructCatalogEntry) -> i32 { return value.destructor_policy; }
pub fn i64_struct_catalog_abi_flags(borrow value:I64StructCatalogEntry)->i32{return value.abi_flags;}
pub fn i64_struct_catalog_invalid_status() -> i32 { return 1; }
pub fn i64_struct_catalog_replace_unsupported_status() -> i32 { return 2; }
pub fn i64_struct_catalog_driver_status(status: i32) -> i32 { return checked_add(970, status); }
pub fn source_type_descriptor_driver_status(status: i32) -> i32 { return checked_add(980, status); }

// One source-unit catalog is the canonical callable boundary used by both
// function-entry lowering and call lowering. Parameter rows are contiguous in
// declaration order; return origins are parameter ordinals, not source names.
pub struct SourceFunctionSignature {
    name_start:i64; name_length:i64; return_type_code:i32; return_mode:i32;
    borrowed_origin:i64; parameter_start:i64; parameter_count:i64;
}
pub struct SourceFunctionParameter {
    name_start:i64; name_length:i64; type_code:i32; mode:i32; mutable:i32;
}
pub fn source_function_signature_name_start(borrow value:SourceFunctionSignature)->i64{return value.name_start;}
pub fn source_function_signature_name_length(borrow value:SourceFunctionSignature)->i64{return value.name_length;}
pub fn source_function_signature_return_type(borrow value:SourceFunctionSignature)->i32{return value.return_type_code;}
pub fn source_function_signature_return_mode(borrow value:SourceFunctionSignature)->i32{return value.return_mode;}
pub fn source_function_signature_borrowed_origin(borrow value:SourceFunctionSignature)->i64{return value.borrowed_origin;}
pub fn source_function_signature_parameter_start(borrow value:SourceFunctionSignature)->i64{return value.parameter_start;}
pub fn source_function_signature_parameter_count(borrow value:SourceFunctionSignature)->i64{return value.parameter_count;}
pub fn source_function_parameter_name_start(borrow value:SourceFunctionParameter)->i64{return value.name_start;}
pub fn source_function_parameter_name_length(borrow value:SourceFunctionParameter)->i64{return value.name_length;}
pub fn source_function_parameter_type(borrow value:SourceFunctionParameter)->i32{return value.type_code;}
pub fn source_function_parameter_mode(borrow value:SourceFunctionParameter)->i32{return value.mode;}
pub fn source_function_parameter_mutable(borrow value:SourceFunctionParameter)->i32{return value.mutable;}

fn sfr_byte(borrow source: Buffer, borrow token: Token, offset: i64) -> i64 {
    return buffer_get(source, checked_add(token_start(token), offset));
}

fn sfr_is_fn(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != 1) { return 0; }
    if (token_length(token) != 2) { return 0; }
    if (sfr_byte(source, token, 0) != 102) { return 0; }
    if (sfr_byte(source, token, 1) != 110) { return 0; }
    return 1;
}

fn sfr_function_name_index(borrow source: Buffer, borrow tokens: Vec<Token>) -> i64 {
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (sfr_is_fn(source, token) != 0) {
            let name_index: i64 = checked_add(index, 1);
            if (name_index < vec_len<Token>(tokens)) { return name_index; }
        }
        index = checked_add(index, 1);
    }
    return -1;
}

fn sfr_destructor_name_index(borrow source: Buffer, borrow tokens: Vec<Token>) -> i64 {
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (sfr_is_destructor(source, token) != 0) {
            let name_index: i64 = checked_add(index, 1);
            if (name_index < vec_len<Token>(tokens)) { return name_index; }
        }
        index = checked_add(index, 1);
    }
    return -1;
}

fn sfr_self_token_index(borrow source: Buffer, borrow tokens: Vec<Token>) -> i64 {
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (token_kind(token) == token_identifier_kind()) {
            if (token_length(token) == 4) {
                if (sfr_byte(source, token, 0) == sfr_ascii_s()) {
                    if (sfr_byte(source, token, 1) == sfr_ascii_e()) {
                        if (sfr_byte(source, token, 2) == sfr_ascii_l()) {
                            if (sfr_byte(source, token, 3) == sfr_ascii_f()) { return index; }
                        }
                    }
                }
            }
        }
        index = checked_add(index, 1);
    }
    return -1;
}

fn sfr_span_equal(borrow source: Buffer, left_start: i64, left_length: i64, right_start: i64, right_length: i64) -> i32 {
    if (left_length != right_length) { return 0; }
    var offset: i64 = 0;
    while (offset < left_length) {
        if (buffer_get(source, checked_add(left_start, offset)) != buffer_get(source, checked_add(right_start, offset))) { return 0; }
        offset = checked_add(offset, 1);
    }
    return 1;
}

fn sfr_span_compare(borrow source:Buffer,left_start:i64,left_length:i64,right_start:i64,right_length:i64)->i32{
    var offset:i64=0;var limit:i64=left_length;if(right_length<limit){limit=right_length;}
    while(offset<limit){
        let left:i64=buffer_get(source,checked_add(left_start,offset));
        let right:i64=buffer_get(source,checked_add(right_start,offset));
        if(left<right){return -1;}if(left>right){return 1;}offset=checked_add(offset,1);
    }
    if(left_length<right_length){return -1;}if(left_length>right_length){return 1;}return 0;
}

fn sfr_is_concrete_vector_type(borrow source:Buffer,start:i64,length:i64)->i32{
    if(length<=5){return 0;}
    if(buffer_get(source,start)!=86){return 0;}
    if(buffer_get(source,checked_add(start,1))!=101){return 0;}
    if(buffer_get(source,checked_add(start,2))!=99){return 0;}
    if(buffer_get(source,checked_add(start,3))!=95){return 0;}
    if(buffer_get(source,checked_add(start,4))!=95){return 0;}
    return 1;
}

fn sfr_concrete_vector_type_code(
    borrow source:Buffer,borrow tokens:Vec<Token>,start:i64,length:i64
)->i32{
    if(sfr_is_concrete_vector_type(source,start,length)==0){return function_mir_unresolved_type_code();}
    var rank:i32=0;var token_index:i64=0;
    while(token_index<vec_len<Token>(tokens)){
        let token:Token=vec_get<Token>(tokens,token_index);
        if(token_kind(token)==token_identifier_kind()){
            var candidate_start:i64=token_start(token);var candidate_length:i64=token_length(token);
            while(sfr_is_concrete_vector_type(source,candidate_start,candidate_length)!=0){
                var first:i32=1;var prior_index:i64=0;
                while(prior_index<token_index){
                    let prior:Token=vec_get<Token>(tokens,prior_index);
                    if(token_kind(prior)==token_identifier_kind()){
                        var prior_start:i64=token_start(prior);var prior_length:i64=token_length(prior);
                        while(sfr_is_concrete_vector_type(source,prior_start,prior_length)!=0){
                            if(sfr_span_equal(source,candidate_start,candidate_length,prior_start,prior_length)!=0){first=0;}
                            prior_start=checked_add(prior_start,5);prior_length=checked_sub(prior_length,5);
                        }
                    }
                    prior_index=checked_add(prior_index,1);
                }
                if(first!=0){if(sfr_span_compare(source,candidate_start,candidate_length,start,length)<0){rank=checked_add(rank,1);}}
                candidate_start=checked_add(candidate_start,5);candidate_length=checked_sub(candidate_length,5);
            }
        }
        token_index=checked_add(token_index,1);
    }
    return function_mir_vector_type_code(rank);
}

fn sfr_is_enum(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != 1) { return 0; }
    if (token_length(token) != 4) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != 101) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != 110) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != 117) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != 109) { return 0; }
    return 1;
}

fn sfr_is_struct(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != 1) { return 0; }
    if (token_length(token) != 6) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != 115) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != 116) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != 114) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != 117) { return 0; }
    if (buffer_get(source, checked_add(start, 4)) != 99) { return 0; }
    if (buffer_get(source, checked_add(start, 5)) != 116) { return 0; }
    return 1;
}

fn sfr_is_pub(borrow source:Buffer,borrow token:Token)->i32{
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=3){return 0;}
    if(sfr_byte(source,token,0)!=sfr_ascii_p()){return 0;}
    if(sfr_byte(source,token,1)!=sfr_ascii_u()){return 0;}
    if(sfr_byte(source,token,2)!=sfr_ascii_b()){return 0;}
    return 1;
}
fn sfr_is_stable(borrow source:Buffer,borrow token:Token)->i32{
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=6){return 0;}
    if(sfr_byte(source,token,0)!=sfr_ascii_s()){return 0;}
    if(sfr_byte(source,token,1)!=sfr_ascii_t()){return 0;}
    if(sfr_byte(source,token,2)!=sfr_ascii_a()){return 0;}
    if(sfr_byte(source,token,3)!=sfr_ascii_b()){return 0;}
    if(sfr_byte(source,token,4)!=sfr_ascii_l()){return 0;}
    if(sfr_byte(source,token,5)!=sfr_ascii_e()){return 0;}
    return 1;
}
fn sfr_struct_abi_public_flag()->i32{return 1;}
fn sfr_struct_abi_stable_flag()->i32{return 2;}

fn sfr_is_decimal_declaration(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != token_identifier_kind()) { return 0; }
    if (token_length(token) != 7) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != 100) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != 101) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != 99) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != 105) { return 0; }
    if (buffer_get(source, checked_add(start, 4)) != 109) { return 0; }
    if (buffer_get(source, checked_add(start, 5)) != 97) { return 0; }
    if (buffer_get(source, checked_add(start, 6)) != 108) { return 0; }
    return 1;
}

fn sfr_is_bounded_declaration(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != token_identifier_kind()) { return 0; }
    if (token_length(token) != 7) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != 98) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != 111) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != 117) { return 0; }
    if (buffer_get(source, checked_add(start, 3)) != 110) { return 0; }
    if (buffer_get(source, checked_add(start, 4)) != 100) { return 0; }
    if (buffer_get(source, checked_add(start, 5)) != 101) { return 0; }
    if (buffer_get(source, checked_add(start, 6)) != 100) { return 0; }
    return 1;
}

fn sfr_token_byte_is(borrow source: Buffer, borrow token: Token, expected: i64) -> i32 {
    if (token_kind(token) != 4) { return 0; }
    if (token_length(token) != 1) { return 0; }
    if (buffer_get(source, token_start(token)) != expected) { return 0; }
    return 1;
}

// Canonical source-encoding bytes used by the destructor policy recognizer.
// Merit character literals are not available at this bootstrap stage.
fn sfr_ascii_a() -> i64 { return 97; }
fn sfr_ascii_b() -> i64 { return 98; }
fn sfr_ascii_upper_a() -> i64 { return 65; }
fn sfr_ascii_upper_b() -> i64 { return 66; }
fn sfr_ascii_c() -> i64 { return 99; }
fn sfr_ascii_d() -> i64 { return 100; }
fn sfr_ascii_e() -> i64 { return 101; }
fn sfr_ascii_f() -> i64 { return 102; }
fn sfr_ascii_g() -> i64 { return 103; }
fn sfr_ascii_h() -> i64 { return 104; }
fn sfr_ascii_i() -> i64 { return 105; }
fn sfr_ascii_k() -> i64 { return 107; }
fn sfr_ascii_l() -> i64 { return 108; }
fn sfr_ascii_m() -> i64 { return 109; }
fn sfr_ascii_n() -> i64 { return 110; }
fn sfr_ascii_o() -> i64 { return 111; }
fn sfr_ascii_upper_e() -> i64 { return 69; }
fn sfr_ascii_upper_f() -> i64 { return 70; }
fn sfr_ascii_upper_l() -> i64 { return 76; }
fn sfr_ascii_upper_o() -> i64 { return 79; }
fn sfr_ascii_upper_r() -> i64 { return 82; }
fn sfr_ascii_upper_s() -> i64 { return 83; }
fn sfr_ascii_upper_t() -> i64 { return 84; }
fn sfr_ascii_upper_w() -> i64 { return 87; }
fn sfr_ascii_p() -> i64 { return 112; }
fn sfr_ascii_r() -> i64 { return 114; }
fn sfr_ascii_s() -> i64 { return 115; }
fn sfr_ascii_t() -> i64 { return 116; }
fn sfr_ascii_u() -> i64 { return 117; }
fn sfr_ascii_v() -> i64 { return 118; }
fn sfr_ascii_w() -> i64 { return 119; }
fn sfr_ascii_y() -> i64 { return 121; }
fn sfr_ascii_comma() -> i64 { return 44; }
fn sfr_ascii_hyphen() -> i64 { return 45; }

fn sfr_token_is_pub(borrow source: Buffer, borrow token: Token) -> i32 {
    if (token_kind(token) != token_identifier_kind()) { return 0; }
    if (token_length(token) != 3) { return 0; }
    let start: i64 = token_start(token);
    if (buffer_get(source, start) != sfr_ascii_p()) { return 0; }
    if (buffer_get(source, checked_add(start, 1)) != sfr_ascii_u()) { return 0; }
    if (buffer_get(source, checked_add(start, 2)) != sfr_ascii_b()) { return 0; }
    return 1;
}
fn sfr_ascii_greater() -> i64 { return 62; }
fn sfr_ascii_left_paren() -> i64 { return 40; }
fn sfr_ascii_right_paren() -> i64 { return 41; }
fn sfr_ascii_dot() -> i64 { return 46; }
fn sfr_ascii_colon() -> i64 { return 58; }
fn sfr_ascii_semicolon() -> i64 { return 59; }
fn sfr_ascii_underscore() -> i64 { return 95; }
fn sfr_ascii_open_brace() -> i64 { return 123; }
fn sfr_ascii_close_brace() -> i64 { return 125; }

fn sfr_vector_new_operation()->i32{return 1;}
fn sfr_vector_push_operation()->i32{return 2;}
fn sfr_vector_len_operation()->i32{return 3;}
fn sfr_vector_get_operation()->i32{return 4;}
fn sfr_vector_set_operation()->i32{return 5;}
fn sfr_vector_replace_operation()->i32{return 6;}
fn sfr_vector_pop_operation()->i32{return 7;}
fn sfr_vector_drop_operation()->i32{return 8;}
fn sfr_vector_transfer_operation()->i32{return 9;}
fn sfr_vector_allocator_operation()->i32{return 10;}

fn sfr_vector_call_operation(borrow source:Buffer,start:i64,length:i64)->i32{
    if(length<=9){return 0;}
    if(buffer_get(source,start)!=sfr_ascii_v()){return 0;}
    if(buffer_get(source,checked_add(start,1))!=sfr_ascii_e()){return 0;}
    if(buffer_get(source,checked_add(start,2))!=sfr_ascii_c()){return 0;}
    if(buffer_get(source,checked_add(start,3))!=sfr_ascii_underscore()){return 0;}
    if(buffer_get(source,checked_add(start,7))==sfr_ascii_underscore()){
        if(buffer_get(source,checked_add(start,8))==sfr_ascii_underscore()){
            if(buffer_get(source,checked_add(start,4))==sfr_ascii_n()){if(buffer_get(source,checked_add(start,5))==sfr_ascii_e()){if(buffer_get(source,checked_add(start,6))==sfr_ascii_w()){return sfr_vector_new_operation();}}}
            if(buffer_get(source,checked_add(start,4))==sfr_ascii_l()){if(buffer_get(source,checked_add(start,5))==sfr_ascii_e()){if(buffer_get(source,checked_add(start,6))==sfr_ascii_n()){return sfr_vector_len_operation();}}}
            if(buffer_get(source,checked_add(start,4))==sfr_ascii_g()){if(buffer_get(source,checked_add(start,5))==sfr_ascii_e()){if(buffer_get(source,checked_add(start,6))==sfr_ascii_t()){return sfr_vector_get_operation();}}}
            if(buffer_get(source,checked_add(start,4))==sfr_ascii_s()){if(buffer_get(source,checked_add(start,5))==sfr_ascii_e()){if(buffer_get(source,checked_add(start,6))==sfr_ascii_t()){return sfr_vector_set_operation();}}}
            if(buffer_get(source,checked_add(start,4))==sfr_ascii_p()){if(buffer_get(source,checked_add(start,5))==sfr_ascii_o()){if(buffer_get(source,checked_add(start,6))==sfr_ascii_p()){return sfr_vector_pop_operation();}}}
        }
    }
    if(length>10){if(buffer_get(source,checked_add(start,8))==sfr_ascii_underscore()){if(buffer_get(source,checked_add(start,9))==sfr_ascii_underscore()){
        if(buffer_get(source,checked_add(start,4))==sfr_ascii_p()){if(buffer_get(source,checked_add(start,5))==sfr_ascii_u()){if(buffer_get(source,checked_add(start,6))==sfr_ascii_s()){if(buffer_get(source,checked_add(start,7))==sfr_ascii_h()){return sfr_vector_push_operation();}}}}
        if(buffer_get(source,checked_add(start,4))==sfr_ascii_d()){if(buffer_get(source,checked_add(start,5))==sfr_ascii_r()){if(buffer_get(source,checked_add(start,6))==sfr_ascii_o()){if(buffer_get(source,checked_add(start,7))==sfr_ascii_p()){return sfr_vector_drop_operation();}}}}
    }}}
    if(length>13){if(buffer_get(source,checked_add(start,11))==sfr_ascii_underscore()){if(buffer_get(source,checked_add(start,12))==sfr_ascii_underscore()){
        if(buffer_get(source,checked_add(start,4))==sfr_ascii_r()){if(buffer_get(source,checked_add(start,5))==sfr_ascii_e()){if(buffer_get(source,checked_add(start,6))==sfr_ascii_p()){if(buffer_get(source,checked_add(start,7))==sfr_ascii_l()){if(buffer_get(source,checked_add(start,8))==sfr_ascii_a()){if(buffer_get(source,checked_add(start,9))==sfr_ascii_c()){if(buffer_get(source,checked_add(start,10))==sfr_ascii_e()){return sfr_vector_replace_operation();}}}}}}}
    }}}
    if(length>14){if(buffer_get(source,checked_add(start,12))==sfr_ascii_underscore()){if(buffer_get(source,checked_add(start,13))==sfr_ascii_underscore()){
        if(buffer_get(source,checked_add(start,4))==sfr_ascii_t()){if(buffer_get(source,checked_add(start,5))==sfr_ascii_r()){if(buffer_get(source,checked_add(start,6))==sfr_ascii_a()){if(buffer_get(source,checked_add(start,7))==sfr_ascii_n()){if(buffer_get(source,checked_add(start,8))==sfr_ascii_s()){if(buffer_get(source,checked_add(start,9))==sfr_ascii_f()){if(buffer_get(source,checked_add(start,10))==sfr_ascii_e()){if(buffer_get(source,checked_add(start,11))==sfr_ascii_r()){return sfr_vector_transfer_operation();}}}}}}}}
    }}}
    if(length>15){if(buffer_get(source,checked_add(start,13))==sfr_ascii_underscore()){if(buffer_get(source,checked_add(start,14))==sfr_ascii_underscore()){
        if(buffer_get(source,checked_add(start,4))==sfr_ascii_a()){if(buffer_get(source,checked_add(start,5))==sfr_ascii_l()){if(buffer_get(source,checked_add(start,6))==sfr_ascii_l()){if(buffer_get(source,checked_add(start,7))==sfr_ascii_o()){if(buffer_get(source,checked_add(start,8))==sfr_ascii_c()){if(buffer_get(source,checked_add(start,9))==sfr_ascii_a()){if(buffer_get(source,checked_add(start,10))==sfr_ascii_t()){if(buffer_get(source,checked_add(start,11))==sfr_ascii_o()){if(buffer_get(source,checked_add(start,12))==sfr_ascii_r()){return sfr_vector_allocator_operation();}}}}}}}}}
    }}}
    return 0;
}

fn sfr_vector_call_prefix_length(operation:i32)->i64{
    if(operation==sfr_vector_push_operation()){return 10;}
    if(operation==sfr_vector_drop_operation()){return 10;}
    if(operation==sfr_vector_replace_operation()){return 13;}
    if(operation==sfr_vector_transfer_operation()){return 14;}
    if(operation==sfr_vector_allocator_operation()){return 15;}
    return 9;
}

pub fn sfr_vector_requires_allocate(borrow source:Buffer,start:i64,length:i64)->i32{
    let operation:i32=sfr_vector_call_operation(source,start,length);
    if(operation==sfr_vector_new_operation()){return 1;}
    if(operation==sfr_vector_push_operation()){return 1;}
    return 0;
}

pub struct SfrNumericMagnitude { high: i64; low: i64; }
fn sfr_numeric_limb_base() -> i64 { return 1000000000; }
fn sfr_invalid_numeric_magnitude() -> SfrNumericMagnitude { return SfrNumericMagnitude { high:-1, low:-1 }; }
fn sfr_parse_numeric_magnitude(borrow source: Buffer, borrow token: Token) -> SfrNumericMagnitude {
    if (token_kind(token) != token_number_kind()) { return sfr_invalid_numeric_magnitude(); }
    if (token_length(token) <= 0) { return sfr_invalid_numeric_magnitude(); }
    var high: i64 = 0;
    var low: i64 = 0;
    var offset: i64 = 0;
    while (offset < token_length(token)) {
        let byte: i64 = buffer_get(source, checked_add(token_start(token), offset));
        if (byte < 48) { return sfr_invalid_numeric_magnitude(); }
        if (byte > 57) { return sfr_invalid_numeric_magnitude(); }
        let expanded_low: i64 = checked_add(checked_mul(low, 10), checked_sub(byte, 48));
        let carry: i64 = expanded_low / sfr_numeric_limb_base();
        low = expanded_low - checked_mul(carry, sfr_numeric_limb_base());
        high = checked_add(checked_mul(high, 10), carry);
        if (high > 18446744073) { return sfr_invalid_numeric_magnitude(); }
        offset = checked_add(offset, 1);
    }
    return SfrNumericMagnitude { high:high, low:low };
}
fn sfr_magnitude_is_zero(borrow value: SfrNumericMagnitude) -> i32 {
    if (value.high == 0) { if (value.low == 0) { return 1; } }
    return 0;
}
fn sfr_magnitude_at_most(borrow value: SfrNumericMagnitude, high: i64, low: i64) -> i32 {
    if (value.high < high) { return 1; }
    if (value.high > high) { return 0; }
    if (value.low <= low) { return 1; }
    return 0;
}
fn sfr_signed_magnitude_compare(
    left_sign:i32, borrow left:SfrNumericMagnitude,
    right_sign:i32, borrow right:SfrNumericMagnitude
) -> i32 {
    if (left_sign < right_sign) { return -1; }
    if (left_sign > right_sign) { return 1; }
    if (left_sign == 0) { return 0; }
    var magnitude:i32=0;
    if (left.high < right.high) { magnitude=-1; }
    if (left.high > right.high) { magnitude=1; }
    if (left.high == right.high) {
        if (left.low < right.low) { magnitude=-1; }
        if (left.low > right.low) { magnitude=1; }
    }
    if (left_sign < 0) { return 0-magnitude; }
    return magnitude;
}
fn sfr_numeric_sign(sign:i32, borrow value:SfrNumericMagnitude)->i32 {
    if (sfr_magnitude_is_zero(value) != 0) { return 0; }
    return sign;
}
fn sfr_decimal_policy(borrow source:Buffer,borrow token:Token)->i32{
    let start:i64=token_start(token);let length:i64=token_length(token);
    if(length==9){
        if(buffer_get(source,start)==104){if(buffer_get(source,checked_add(start,1))==97){if(buffer_get(source,checked_add(start,2))==108){if(buffer_get(source,checked_add(start,3))==102){if(buffer_get(source,checked_add(start,4))==95){if(buffer_get(source,checked_add(start,5))==101){if(buffer_get(source,checked_add(start,6))==118){if(buffer_get(source,checked_add(start,7))==101){if(buffer_get(source,checked_add(start,8))==110){return 0;}}}}}}}}}
    }
    if(length==7){
        if(buffer_get(source,start)==104){if(buffer_get(source,checked_add(start,1))==97){if(buffer_get(source,checked_add(start,2))==108){if(buffer_get(source,checked_add(start,3))==102){if(buffer_get(source,checked_add(start,4))==95){if(buffer_get(source,checked_add(start,5))==117){if(buffer_get(source,checked_add(start,6))==112){return 1;}}}}}}}
        if(buffer_get(source,start)==99){if(buffer_get(source,checked_add(start,1))==101){if(buffer_get(source,checked_add(start,2))==105){if(buffer_get(source,checked_add(start,3))==108){if(buffer_get(source,checked_add(start,4))==105){if(buffer_get(source,checked_add(start,5))==110){if(buffer_get(source,checked_add(start,6))==103){return 3;}}}}}}}
    }
    if(length==4){if(buffer_get(source,start)==100){if(buffer_get(source,checked_add(start,1))==111){if(buffer_get(source,checked_add(start,2))==119){if(buffer_get(source,checked_add(start,3))==110){return 2;}}}}}
    if(length==5){if(buffer_get(source,start)==102){if(buffer_get(source,checked_add(start,1))==108){if(buffer_get(source,checked_add(start,2))==111){if(buffer_get(source,checked_add(start,3))==111){if(buffer_get(source,checked_add(start,4))==114){return 4;}}}}}}
    return -1;
}

fn sfr_is_file_read_result_name(borrow source:Buffer,borrow token:Token)->i32{
    if(token_kind(token)!=token_identifier_kind()){return 0;}
    if(token_length(token)!=14){return 0;}
    if(sfr_byte(source,token,0)!=sfr_ascii_upper_f()){return 0;}
    if(sfr_byte(source,token,1)!=sfr_ascii_i()){return 0;}
    if(sfr_byte(source,token,2)!=sfr_ascii_l()){return 0;}
    if(sfr_byte(source,token,3)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,4)!=sfr_ascii_upper_r()){return 0;}
    if(sfr_byte(source,token,5)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,6)!=sfr_ascii_a()){return 0;}
    if(sfr_byte(source,token,7)!=sfr_ascii_d()){return 0;}
    if(sfr_byte(source,token,8)!=sfr_ascii_upper_r()){return 0;}
    if(sfr_byte(source,token,9)!=sfr_ascii_e()){return 0;}
    if(sfr_byte(source,token,10)!=sfr_ascii_s()){return 0;}
    if(sfr_byte(source,token,11)!=sfr_ascii_u()){return 0;}
    if(sfr_byte(source,token,12)!=sfr_ascii_l()){return 0;}
    if(sfr_byte(source,token,13)!=sfr_ascii_t()){return 0;}
    return 1;
}

