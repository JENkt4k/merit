module bootstrap_statements
import bootstrap_tokens;

capability allocate;

// bootstrap-statement-v1 keeps statement envelopes separate from typed operands.
pub struct StatementRecord {
    kind: i32;
    start: i64;
    length: i64;
    first_operand: i64;
    operand_count: i64;
}

// Operand kinds: 1 binding name, 2 declared type, 3 expression, 4 capability name.
pub struct StatementOperand {
    kind: i32;
    start: i64;
    length: i64;
}

pub fn statement_record_kind(borrow record: StatementRecord) -> i32 { return record.kind; }
pub fn statement_record_let_kind() -> i32 { return 20; }
pub fn statement_record_var_kind() -> i32 { return 21; }
pub fn statement_record_print_kind() -> i32 { return 23; }
pub fn statement_record_if_kind() -> i32 { return 25; }
pub fn statement_record_while_kind() -> i32 { return 26; }
pub fn statement_record_assign_kind() -> i32 { return 30; }
pub fn statement_record_expression_kind() -> i32 { return 31; }
pub fn statement_record_is_match(borrow record: StatementRecord) -> i32 { if (record.kind == 27) { return 1; } return 0; }
pub fn statement_record_start(borrow record: StatementRecord) -> i64 { return record.start; }
pub fn statement_record_length(borrow record: StatementRecord) -> i64 { return record.length; }
pub fn statement_record_first_operand(borrow record: StatementRecord) -> i64 { return record.first_operand; }
pub fn statement_record_operand_count(borrow record: StatementRecord) -> i64 { return record.operand_count; }
pub fn statement_operand_kind(borrow operand: StatementOperand) -> i32 { return operand.kind; }
pub fn statement_operand_start(borrow operand: StatementOperand) -> i64 { return operand.start; }
pub fn statement_operand_length(borrow operand: StatementOperand) -> i64 { return operand.length; }

fn statement_ascii_t() -> i64 { return 116; }
fn statement_ascii_r() -> i64 { return 114; }
fn statement_ascii_y() -> i64 { return 121; }

pub fn statement_operand_is_try(
    borrow source: Buffer, borrow tokens: Vec<Token>, borrow operand: StatementOperand
) -> i32 {
    if (statement_operand_kind(operand) != 3) { return 0; }
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (token_start(token) == statement_operand_start(operand)) {
            if (token_kind(token) != 1) { return 0; }
            if (token_length(token) != 3) { return 0; }
            if (buffer_get(source, token_start(token)) != statement_ascii_t()) { return 0; }
            if (buffer_get(source, checked_add(token_start(token), 1)) != statement_ascii_r()) { return 0; }
            if (buffer_get(source, checked_add(token_start(token), 2)) != statement_ascii_y()) { return 0; }
            return 1;
        }
        index = checked_add(index, 1);
    }
    return 0;
}

pub fn statement_try_value_start(
    borrow tokens: Vec<Token>, borrow operand: StatementOperand
) -> i64 {
    var index: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (token_start(token) == statement_operand_start(operand)) {
            let value_index: i64 = checked_add(index, 1);
            if (value_index >= vec_len<Token>(tokens)) { return -1; }
            let value_token: Token = vec_get<Token>(tokens, value_index);
            return token_start(value_token);
        }
        index = checked_add(index, 1);
    }
    return -1;
}

pub fn statement_try_value_length(
    borrow tokens: Vec<Token>, borrow operand: StatementOperand
) -> i64 {
    let start: i64 = statement_try_value_start(tokens, operand);
    if (start < 0) { return -1; }
    return checked_sub(
        checked_add(statement_operand_start(operand), statement_operand_length(operand)), start
    );
}

fn stmt_token_byte(borrow source: Buffer, borrow token: Token, offset: i64) -> i64 {
    return buffer_get(source, checked_add(token_start(token), offset));
}

fn stmt_matches_ascii(borrow source: Buffer, borrow token: Token, packed: i64, length: i64) -> i32 {
    if (token_length(token) != length) { return 0; }
    if packed == 7628140 {
        if stmt_token_byte(source, token, 0) != 108 { return 0; }
        if stmt_token_byte(source, token, 1) != 101 { return 0; }
        if stmt_token_byte(source, token, 2) != 116 { return 0; }
        return 1;
    }
    if packed == 7496054 {
        if stmt_token_byte(source, token, 0) != 118 { return 0; }
        if stmt_token_byte(source, token, 1) != 97 { return 0; }
        if stmt_token_byte(source, token, 2) != 114 { return 0; }
        return 1;
    }
    if packed == 121437875889522 {
        if stmt_token_byte(source, token, 0) != 114 { return 0; }
        if stmt_token_byte(source, token, 1) != 101 { return 0; }
        if stmt_token_byte(source, token, 2) != 116 { return 0; }
        if stmt_token_byte(source, token, 3) != 117 { return 0; }
        if stmt_token_byte(source, token, 4) != 114 { return 0; }
        if stmt_token_byte(source, token, 5) != 110 { return 0; }
        return 1;
    }
    if packed == 500068610672 {
        if stmt_token_byte(source, token, 0) != 112 { return 0; }
        if stmt_token_byte(source, token, 1) != 114 { return 0; }
        if stmt_token_byte(source, token, 2) != 105 { return 0; }
        if stmt_token_byte(source, token, 3) != 110 { return 0; }
        if stmt_token_byte(source, token, 4) != 116 { return 0; }
        return 1;
    }
    if packed == 1886351972 {
        if stmt_token_byte(source, token, 0) != 100 { return 0; }
        if stmt_token_byte(source, token, 1) != 114 { return 0; }
        if stmt_token_byte(source, token, 2) != 111 { return 0; }
        if stmt_token_byte(source, token, 3) != 112 { return 0; }
        return 1;
    }
    if packed == 26217 {
        if stmt_token_byte(source, token, 0) != 105 { return 0; }
        if stmt_token_byte(source, token, 1) != 102 { return 0; }
        return 1;
    }
    if packed == 435610544247 {
        if stmt_token_byte(source, token, 0) != 119 { return 0; }
        if stmt_token_byte(source, token, 1) != 104 { return 0; }
        if stmt_token_byte(source, token, 2) != 105 { return 0; }
        if stmt_token_byte(source, token, 3) != 108 { return 0; }
        if stmt_token_byte(source, token, 4) != 101 { return 0; }
        return 1;
    }
    if packed == 448345170285 {
        if stmt_token_byte(source, token, 0) != 109 { return 0; }
        if stmt_token_byte(source, token, 1) != 97 { return 0; }
        if stmt_token_byte(source, token, 2) != 116 { return 0; }
        if stmt_token_byte(source, token, 3) != 99 { return 0; }
        if stmt_token_byte(source, token, 4) != 104 { return 0; }
        return 1;
    }
    if packed == 1752459639 {
        if stmt_token_byte(source, token, 0) != 119 { return 0; }
        if stmt_token_byte(source, token, 1) != 105 { return 0; }
        if stmt_token_byte(source, token, 2) != 116 { return 0; }
        if stmt_token_byte(source, token, 3) != 104 { return 0; }
        return 1;
    }
    if packed == 28538242730059122 {
        if stmt_token_byte(source, token, 0) != 114 { return 0; }
        if stmt_token_byte(source, token, 1) != 101 { return 0; }
        if stmt_token_byte(source, token, 2) != 112 { return 0; }
        if stmt_token_byte(source, token, 3) != 108 { return 0; }
        if stmt_token_byte(source, token, 4) != 97 { return 0; }
        if stmt_token_byte(source, token, 5) != 99 { return 0; }
        if stmt_token_byte(source, token, 6) != 101 { return 0; }
        return 1;
    }
    return 0;
}

fn stmt_kind(borrow source: Buffer, borrow token: Token) -> i32 {
    if stmt_matches_ascii(source, token, 7628140, 3) { return 20; }
    if stmt_matches_ascii(source, token, 7496054, 3) { return 21; }
    if stmt_matches_ascii(source, token, 121437875889522, 6) { return 22; }
    if stmt_matches_ascii(source, token, 500068610672, 5) { return 23; }
    if stmt_matches_ascii(source, token, 1886351972, 4) { return 24; }
    if stmt_matches_ascii(source, token, 26217, 2) { return 25; }
    if stmt_matches_ascii(source, token, 435610544247, 5) { return 26; }
    if stmt_matches_ascii(source, token, 448345170285, 5) { return 27; }
    if stmt_matches_ascii(source, token, 1752459639, 4) { return 28; }
    if stmt_matches_ascii(source, token, 28538242730059122, 7) { return 29; }
    return 0;
}

fn stmt_punctuation(borrow source: Buffer, borrow token: Token, byte: i64) -> i32 {
    if token_kind(token) != 4 { return 0; }
    if token_length(token) != 1 { return 0; }
    if (stmt_token_byte(source, token, 0) != byte) { return 0; }
    return 1;
}

fn stmt_token_end(borrow token: Token) -> i64 {
    return checked_add(token_start(token), token_length(token));
}

fn stmt_end(borrow source: Buffer, borrow tokens: Vec<Token>, start_index: i64, kind: i32) -> i64 {
    var index: i64 = checked_add(start_index, 1);
    var parens: i64 = 0;
    var brackets: i64 = 0;
    while index < vec_len<Token>(tokens) {
        let token: Token = vec_get<Token>(tokens, index);
        if stmt_punctuation(source, token, 40) { parens = checked_add(parens, 1); }
        if stmt_punctuation(source, token, 41) { if parens > 0 { parens = checked_sub(parens, 1); } }
        if stmt_punctuation(source, token, 91) { brackets = checked_add(brackets, 1); }
        if stmt_punctuation(source, token, 93) { if brackets > 0 { brackets = checked_sub(brackets, 1); } }
        if parens == 0 {
            if brackets == 0 {
                if kind >= 25 {
                    if kind <= 28 {
                        if stmt_punctuation(source, token, 123) { return stmt_token_end(token); }
                    }
                }
                if stmt_punctuation(source, token, 59) { return stmt_token_end(token); }
            }
        }
        index = checked_add(index, 1);
    }
    return buffer_len(source);
}

fn stmt_find_top_level(borrow source: Buffer, borrow tokens: Vec<Token>, start_index: i64, byte: i64) -> i64 {
    var index: i64 = start_index;
    var parens: i64 = 0;
    var brackets: i64 = 0;
    var braces: i64 = 0;
    while index < vec_len<Token>(tokens) {
        let token: Token = vec_get<Token>(tokens, index);
        if stmt_punctuation(source, token, byte) {
            if parens == 0 { if brackets == 0 { if braces == 0 { return index; } } }
        }
        if stmt_punctuation(source, token, 40) { parens = checked_add(parens, 1); }
        if stmt_punctuation(source, token, 41) { if parens > 0 { parens = checked_sub(parens, 1); } }
        if stmt_punctuation(source, token, 91) { brackets = checked_add(brackets, 1); }
        if stmt_punctuation(source, token, 93) { if brackets > 0 { brackets = checked_sub(brackets, 1); } }
        if stmt_punctuation(source, token, 123) { braces = checked_add(braces, 1); }
        if stmt_punctuation(source, token, 125) { if braces > 0 { braces = checked_sub(braces, 1); } }
        index = checked_add(index, 1);
    }
    return -1;
}

fn stmt_statement_boundary(
    borrow source: Buffer, borrow tokens: Vec<Token>, index: i64
) -> i32 {
    if (index <= 0) { return 0; }
    let previous: Token = vec_get<Token>(tokens, checked_sub(index, 1));
    if (stmt_punctuation(source, previous, 123)) { return 1; }
    if (stmt_punctuation(source, previous, 125)) { return 1; }
    if (stmt_punctuation(source, previous, 59)) { return 1; }
    return 0;
}

fn stmt_find_statement_semicolon(
    borrow source: Buffer, borrow tokens: Vec<Token>, start_index: i64
) -> i64 {
    var index: i64 = start_index;
    var parens: i64 = 0;
    var brackets: i64 = 0;
    var braces: i64 = 0;
    while (index < vec_len<Token>(tokens)) {
        let token: Token = vec_get<Token>(tokens, index);
        if (parens == 0) {
            if (brackets == 0) {
                if (braces == 0) {
                    if (stmt_punctuation(source, token, 59)) { return index; }
                    if (stmt_punctuation(source, token, 125)) { return -1; }
                }
            }
        }
        if (stmt_punctuation(source, token, 40)) { parens = checked_add(parens, 1); }
        if (stmt_punctuation(source, token, 41)) { if parens > 0 { parens = checked_sub(parens, 1); } }
        if (stmt_punctuation(source, token, 91)) { brackets = checked_add(brackets, 1); }
        if (stmt_punctuation(source, token, 93)) { if brackets > 0 { brackets = checked_sub(brackets, 1); } }
        if (stmt_punctuation(source, token, 123)) { braces = checked_add(braces, 1); }
        if (stmt_punctuation(source, token, 125)) { if braces > 0 { braces = checked_sub(braces, 1); } }
        index = checked_add(index, 1);
    }
    return -1;
}

fn stmt_assignment_equals(
    borrow source: Buffer, borrow tokens: Vec<Token>, index: i64
) -> i64 {
    let equals: i64 = stmt_find_top_level(source, tokens, index, 61);
    if (equals < 0) { return -1; }
    if (equals > index) {
        let previous: Token = vec_get<Token>(tokens, checked_sub(equals, 1));
        if (stmt_punctuation(source, previous, 61)) { return -1; }
        if (stmt_punctuation(source, previous, 33)) { return -1; }
        if (stmt_punctuation(source, previous, 60)) { return -1; }
        if (stmt_punctuation(source, previous, 62)) { return -1; }
    }
    let next_index: i64 = checked_add(equals, 1);
    if (next_index < vec_len<Token>(tokens)) {
        let next: Token = vec_get<Token>(tokens, next_index);
        if (stmt_punctuation(source, next, 61)) { return -1; }
        if (stmt_punctuation(source, next, 62)) { return -1; }
    }
    return equals;
}

// Additive statement identities beyond the original keyword-introducer slice:
// 30 assignment, 31 expression statement. Classification is restricted to a
// lexical statement boundary so identifiers inside declarations/expressions
// cannot be reinterpreted as statements.
fn stmt_classify(
    borrow source: Buffer, borrow tokens: Vec<Token>, index: i64
) -> i32 {
    let candidate: Token = vec_get<Token>(tokens, index);
    let keyword_kind: i32 = stmt_kind(source, candidate);
    if (keyword_kind != 0) { return keyword_kind; }
    // Punctuation may follow a semicolon or closing body, but cannot begin the
    // currently supported assignment/expression-statement surface. In
    // particular, do not reinterpret a closing brace as an expression whose
    // span reaches the next statement's semicolon.
    if (token_kind(candidate) == 4) { return 0; }
    if (stmt_statement_boundary(source, tokens, index) == 0) { return 0; }
    let semicolon: i64 = stmt_find_statement_semicolon(source, tokens, index);
    if (semicolon <= index) { return 0; }
    let opening_body: i64 = stmt_find_top_level(source, tokens, index, 123);
    if (opening_body >= 0) {
        if (opening_body < semicolon) { return 0; }
    }
    let colon: i64 = stmt_find_top_level(source, tokens, index, 58);
    if (colon >= 0) {
        if (colon < semicolon) { return 0; }
    }
    let equals: i64 = stmt_assignment_equals(source, tokens, index);
    if (equals >= 0) {
        if (equals < semicolon) { return 30; }
    }
    return 31;
}

fn stmt_push_span(borrow_mut operands: Vec<StatementOperand>, kind: i32, borrow tokens: Vec<Token>, first: i64, last_exclusive: i64) -> i32
requires_caps [allocate]
{
    if first < 0 { return 0; }
    if (last_exclusive <= first) { return 0; }
    if first >= vec_len<Token>(tokens) { return 0; }
    let last_index: i64 = checked_sub(last_exclusive, 1);
    if last_index >= vec_len<Token>(tokens) { return 0; }
    let first_token: Token = vec_get<Token>(tokens, first);
    let last_token: Token = vec_get<Token>(tokens, last_index);
    let operand: StatementOperand = StatementOperand {
        kind: kind,
        start: token_start(first_token),
        length: stmt_token_end(last_token) - token_start(first_token)
    };
    vec_push<StatementOperand>(operands, operand);
    return 1;
}

fn stmt_binding_count(borrow source: Buffer, borrow tokens: Vec<Token>, index: i64) -> i64 {
    var count: i64 = 0;
    let name_index: i64 = checked_add(index, 1);
    if name_index < vec_len<Token>(tokens) {
        let name: Token = vec_get<Token>(tokens, name_index);
        if token_kind(name) == 1 { count = checked_add(count, 1); }
    }
    let colon_index: i64 = checked_add(index, 2);
    let type_index: i64 = checked_add(index, 3);
    if type_index < vec_len<Token>(tokens) {
        let colon: Token = vec_get<Token>(tokens, colon_index);
        let type_token: Token = vec_get<Token>(tokens, type_index);
        if stmt_punctuation(source, colon, 58) {
            if token_kind(type_token) == 1 { count = checked_add(count, 1); }
        }
    }
    let equals: i64 = stmt_find_top_level(source, tokens, checked_add(index, 1), 61);
    if equals >= 0 {
        let first: i64 = checked_add(equals, 1);
        let semicolon: i64 = stmt_find_top_level(source, tokens, first, 59);
        if (semicolon > first) { count = checked_add(count, 1); }
    }
    return count;
}

fn stmt_operand_count(borrow source: Buffer, borrow tokens: Vec<Token>, index: i64, kind: i32) -> i64 {
    if kind == 20 { return stmt_binding_count(source, tokens, index); }
    if kind == 21 { return stmt_binding_count(source, tokens, index); }
    if kind == 28 {
        let cap_index: i64 = checked_add(index, 2);
        if cap_index < vec_len<Token>(tokens) {
            let cap: Token = vec_get<Token>(tokens, cap_index);
            if token_kind(cap) == 1 { return 1; }
        }
        return 0;
    }
    if kind == 29 {
        let open_index: i64 = checked_add(index, 1);
        if open_index >= vec_len<Token>(tokens) { return 0; }
        let open: Token = vec_get<Token>(tokens, open_index);
        if stmt_punctuation(source, open, 40) == 0 { return 0; }
        let first: i64 = checked_add(open_index, 1);
        let comma: i64 = stmt_find_top_level(source, tokens, first, 44);
        if comma < 0 { return 0; }
        let second: i64 = checked_add(comma, 1);
        let close: i64 = stmt_find_top_level(source, tokens, second, 41);
        var count: i64 = 0;
        if (comma > first) { count = checked_add(count, 1); }
        if (close > second) { count = checked_add(count, 1); }
        return count;
    }
    if kind == 30 {
        let equals: i64 = stmt_assignment_equals(source, tokens, index);
        if (equals <= index) { return 0; }
        let value_start: i64 = checked_add(equals, 1);
        let semicolon: i64 = stmt_find_statement_semicolon(source, tokens, value_start);
        if (semicolon <= value_start) { return 0; }
        return 2;
    }
    if kind == 31 {
        let semicolon: i64 = stmt_find_statement_semicolon(source, tokens, index);
        if (semicolon > index) { return 1; }
        return 0;
    }
    let first: i64 = checked_add(index, 1);
    if first >= vec_len<Token>(tokens) { return 0; }
    var delimiter: i64 = 59;
    if kind >= 25 { if kind <= 27 { delimiter = 123; } }
    let end_index: i64 = stmt_find_top_level(source, tokens, first, delimiter);
    if (end_index > first) { return 1; }
    return 0;
}

pub fn parse_statement_records(borrow source: Buffer, borrow tokens: Vec<Token>, allocator: Allocator) -> Vec<StatementRecord>
requires_caps [allocate]
{
    var records: Vec<StatementRecord> = vec_new<StatementRecord>(allocator, 8);
    var index: i64 = 0;
    var depth: i64 = 0;
    var operand_cursor: i64 = 0;
    while index < vec_len<Token>(tokens) {
        let token: Token = vec_get<Token>(tokens, index);
        if stmt_punctuation(source, token, 125) { if depth > 0 { depth = checked_sub(depth, 1); } }
        if depth > 0 {
            let kind: i32 = stmt_classify(source, tokens, index);
            if kind != 0 {
                let count: i64 = stmt_operand_count(source, tokens, index, kind);
                let record: StatementRecord = StatementRecord {
                    kind: kind,
                    start: token_start(token),
                    length: stmt_end(source, tokens, index, kind) - token_start(token),
                    first_operand: operand_cursor,
                    operand_count: count
                };
                vec_push<StatementRecord>(records, record);
                operand_cursor = checked_add(operand_cursor, count);
            }
        }
        if stmt_punctuation(source, token, 123) { depth = checked_add(depth, 1); }
        index = checked_add(index, 1);
    }
    return records;
}

fn stmt_emit_binding(borrow source: Buffer, borrow tokens: Vec<Token>, index: i64, borrow_mut operands: Vec<StatementOperand>) -> i32
requires_caps [allocate]
{
    let name_index: i64 = checked_add(index, 1);
    if name_index < vec_len<Token>(tokens) {
        let name: Token = vec_get<Token>(tokens, name_index);
        if token_kind(name) == 1 {
            let pushed_name: i32 = stmt_push_span(operands, 1, tokens, name_index, checked_add(name_index, 1));
        }
    }
    let colon_index: i64 = checked_add(index, 2);
    let type_index: i64 = checked_add(index, 3);
    if type_index < vec_len<Token>(tokens) {
        let colon: Token = vec_get<Token>(tokens, colon_index);
        let type_token: Token = vec_get<Token>(tokens, type_index);
        if stmt_punctuation(source, colon, 58) {
            if token_kind(type_token) == 1 {
                let pushed_type: i32 = stmt_push_span(operands, 2, tokens, type_index, checked_add(type_index, 1));
            }
        }
    }
    let equals: i64 = stmt_find_top_level(source, tokens, checked_add(index, 1), 61);
    if equals >= 0 {
        let first: i64 = checked_add(equals, 1);
        let semicolon: i64 = stmt_find_top_level(source, tokens, first, 59);
        if (semicolon > first) {
            let pushed_initializer: i32 = stmt_push_span(operands, 3, tokens, first, semicolon);
        }
    }
    return 0;
}

fn stmt_emit_operands(borrow source: Buffer, borrow tokens: Vec<Token>, index: i64, kind: i32, borrow_mut operands: Vec<StatementOperand>) -> i32
requires_caps [allocate]
{
    if kind == 20 {
        let emitted_let: i32 = stmt_emit_binding(source, tokens, index, operands);
        return 0;
    }
    if kind == 21 {
        let emitted_var: i32 = stmt_emit_binding(source, tokens, index, operands);
        return 0;
    }
    if kind == 28 {
        let cap_index: i64 = checked_add(index, 2);
        if cap_index < vec_len<Token>(tokens) {
            let cap: Token = vec_get<Token>(tokens, cap_index);
            if token_kind(cap) == 1 {
                let pushed_capability: i32 = stmt_push_span(operands, 4, tokens, cap_index, checked_add(cap_index, 1));
            }
        }
        return 0;
    }
    if kind == 29 {
        let open_index: i64 = checked_add(index, 1);
        if open_index >= vec_len<Token>(tokens) { return 0; }
        let open: Token = vec_get<Token>(tokens, open_index);
        if stmt_punctuation(source, open, 40) == 0 { return 0; }
        let first: i64 = checked_add(open_index, 1);
        let comma: i64 = stmt_find_top_level(source, tokens, first, 44);
        if comma < 0 { return 0; }
        if (comma > first) {
            let pushed_target: i32 = stmt_push_span(operands, 3, tokens, first, comma);
        }
        let second: i64 = checked_add(comma, 1);
        let close: i64 = stmt_find_top_level(source, tokens, second, 41);
        if (close > second) {
            let pushed_replacement: i32 = stmt_push_span(operands, 3, tokens, second, close);
        }
        return 0;
    }
    if kind == 30 {
        let equals: i64 = stmt_assignment_equals(source, tokens, index);
        if (equals <= index) { return 0; }
        let pushed_target: i32 = stmt_push_span(operands, 3, tokens, index, equals);
        let value_start: i64 = checked_add(equals, 1);
        let semicolon: i64 = stmt_find_statement_semicolon(source, tokens, value_start);
        if (semicolon > value_start) {
            let pushed_value: i32 = stmt_push_span(operands, 3, tokens, value_start, semicolon);
        }
        return 0;
    }
    if kind == 31 {
        let semicolon: i64 = stmt_find_statement_semicolon(source, tokens, index);
        if (semicolon > index) {
            let pushed_statement: i32 = stmt_push_span(operands, 3, tokens, index, semicolon);
        }
        return 0;
    }
    if kind == 23 {
        let open_index: i64 = checked_add(index, 1);
        if open_index >= vec_len<Token>(tokens) { return 0; }
        let open: Token = vec_get<Token>(tokens, open_index);
        if stmt_punctuation(source, open, 40) == 0 { return 0; }
        let first_argument: i64 = checked_add(open_index, 1);
        let close: i64 = stmt_find_top_level(source, tokens, first_argument, 41);
        if (close > first_argument) {
            let pushed_print_argument: i32 = stmt_push_span(operands, 3, tokens, first_argument, close);
        }
        return 0;
    }
    let first: i64 = checked_add(index, 1);
    if first >= vec_len<Token>(tokens) { return 0; }
    var delimiter: i64 = 59;
    if kind >= 25 { if kind <= 27 { delimiter = 123; } }
    let end_index: i64 = stmt_find_top_level(source, tokens, first, delimiter);
    if (end_index > first) {
        let pushed_expression: i32 = stmt_push_span(operands, 3, tokens, first, end_index);
    }
    return 0;
}

pub fn parse_statement_operands(borrow source: Buffer, borrow tokens: Vec<Token>, allocator: Allocator) -> Vec<StatementOperand>
requires_caps [allocate]
{
    var operands: Vec<StatementOperand> = vec_new<StatementOperand>(allocator, 16);
    var index: i64 = 0;
    var depth: i64 = 0;
    while index < vec_len<Token>(tokens) {
        let token: Token = vec_get<Token>(tokens, index);
        if stmt_punctuation(source, token, 125) { if depth > 0 { depth = checked_sub(depth, 1); } }
        if depth > 0 {
            let kind: i32 = stmt_classify(source, tokens, index);
            if kind != 0 {
                let emitted: i32 = stmt_emit_operands(source, tokens, index, kind, operands);
            }
        }
        if stmt_punctuation(source, token, 123) { depth = checked_add(depth, 1); }
        index = checked_add(index, 1);
    }
    return operands;
}
