module bootstrap_mir_resolved_source_function_pipeline
import bootstrap_tokens;
import bootstrap_lexer_core;
import bootstrap_statements;
import bootstrap_statement_structure;
import bootstrap_statement_semantics;
import bootstrap_mir_functions;
import bootstrap_mir_structured_lowering;
import bootstrap_mir_function_clause_metadata;
import bootstrap_mir_function_contracts;
import bootstrap_mir_source_function_pipeline;
import bootstrap_mir_match_capability_flow;
import bootstrap_mir_ownership_flow;
import bootstrap_mir_source_ownership_lowering;

capability allocate;

// The source-function body-record stage currently owns these statement kinds.
// Resolved ownership/control owns the wider effect surface (drop, match,
// capability scopes, replace). Keep that boundary explicit until the shared
// expression traversal replaces both implementations.
fn resolved_pipeline_body_kind(kind: i32) -> i32 {
    if (kind == 20) { return 1; }
    if (kind == 21) { return 1; }
    if (kind == 22) { return 1; }
    if (kind == 25) { return 1; }
    if (kind == 26) { return 1; }
    return 0;
}

fn resolved_pipeline_filter_body_statements(
    borrow statements: Vec<StatementRecord>,
    borrow_mut output: Vec<StatementRecord>
) -> i32
requires_caps [allocate]
{
    var index: i64 = 0;
    while (index < vec_len<StatementRecord>(statements)) {
        let statement: StatementRecord = vec_get<StatementRecord>(statements, index);
        if (resolved_pipeline_body_kind(statement_record_kind(statement)) != 0) {
            vec_push<StatementRecord>(output, statement);
        }
        index = checked_add(index, 1);
    }
    return 0;
}

// Cross-stream guard for the duplicated traversal that still exists today.
// Instruction placement differs because ownership inserts lifecycle operations,
// so compare the semantic return surface only. Match/capability structure is
// authoritative from the resolved ownership stream.
pub fn validate_resolved_function_return_surface(
    borrow body_records: Vec<MirFunctionRecord>,
    borrow canonical_events: Vec<MirLowerEvent>
) -> i32 {
    var body_returns: i64 = 0;
    var index: i64 = 0;
    while (index < vec_len<MirFunctionRecord>(body_records)) {
        let record: MirFunctionRecord = vec_get<MirFunctionRecord>(body_records, index);
        if (function_mir_kind(record) == 7) { body_returns = checked_add(body_returns, 1); }
        index = checked_add(index, 1);
    }
    var canonical_returns: i64 = 0;
    index = 0;
    while (index < vec_len<MirLowerEvent>(canonical_events)) {
        let event: MirLowerEvent = vec_get<MirLowerEvent>(canonical_events, index);
        if (lower_event_kind(event) == 2) { canonical_returns = checked_add(canonical_returns, 1); }
        index = checked_add(index, 1);
    }
    if (body_returns != canonical_returns) { return 1; }
    return 0;
}

// One production entrypoint for the currently separate real-source semantic
// stages. The caller supplies typed declaration catalogs and ownership metadata;
// all statement structure, resolved match/capability identities, clauses,
// contracts, ownership effects, and canonical structured events are derived
// from the same source/tokens/statements in this function.
pub fn lower_resolved_source_function_semantics(
    borrow source: Buffer,
    borrow tokens: Vec<Token>,
    borrow statements: Vec<StatementRecord>,
    borrow statement_operands: Vec<StatementOperand>,
    borrow enum_catalog: Vec<EnumVariantCatalogEntry>,
    match_enum_id: i64,
    borrow capability_catalog: Vec<CapabilityCatalogEntry>,
    borrow ownership_metadata: Vec<MirOwnershipBinding>,
    allocator: Allocator,
    borrow_mut body_records: Vec<MirFunctionRecord>,
    borrow_mut clause_metadata: Vec<MirFunctionClauseMetadata>,
    borrow_mut contract_records: Vec<MirFunctionContractRecord>,
    borrow_mut resolved_arms: Vec<ResolvedMatchArm>,
    borrow_mut resolved_scopes: Vec<ResolvedCapabilityScope>,
    borrow_mut ownership_events: Vec<MirOwnershipEvent>,
    borrow_mut capability_effects: Vec<MirCapabilityEffect>,
    borrow_mut canonical_events: Vec<MirLowerEvent>,
    borrow_mut ownership_records: Vec<MirOwnershipRecord>
) -> i32
requires_caps [allocate]
{
    var body_statements: Vec<StatementRecord> = vec_new<StatementRecord>(
        allocator, vec_len<StatementRecord>(statements)
    );
    let filter_status: i32 = resolved_pipeline_filter_body_statements(statements, body_statements);
    if (filter_status != 0) { return checked_add(100, filter_status); }

    // #64 body + function-clause path. Its structured events are deliberately
    // scratch here: canonical structure for resolved effects comes from the
    // path-sensitive ownership reducer below.
    var body_events: Vec<MirLowerEvent> = vec_new<MirLowerEvent>(allocator, 64);
    let function_status: i32 = lower_source_function_semantics(
        source, tokens, body_statements, statement_operands, capability_catalog,
        allocator, body_records, body_events, clause_metadata, contract_records
    );
    if (function_status != 0) { return checked_add(200, function_status); }

    var raw_arms: Vec<MatchArmRecord> = vec_new<MatchArmRecord>(allocator, 8);
    var raw_scopes: Vec<CapabilityScopeRecord> = vec_new<CapabilityScopeRecord>(allocator, 8);
    let arm_status: i32 = lower_match_arm_records(source, tokens, statements, raw_arms);
    if (arm_status != 0) { return checked_add(300, arm_status); }
    let scope_status: i32 = lower_capability_scope_records(
        source, tokens, statements, statement_operands, raw_scopes
    );
    if (scope_status != 0) { return checked_add(400, scope_status); }

    if (vec_len<MatchArmRecord>(raw_arms) > 0) {
        // Transitional typed-subject boundary. A negative caller enum id asks
        // this stage to derive the semantic enum identity from a simple local
        // match subject and that local's declared type. The declaration lookup
        // uses a fresh full-source token stream so bounded function token views
        // from the concrete replacement driver do not hide top-level enums.
        // Explicit non-negative ids remain supported for staged/differential
        // callers until the scalar parameter is removed entirely.
        var effective_match_enum_id: i64 = match_enum_id;
        var identity_status: i32 = 0;
        if (effective_match_enum_id < 0) {
            var match_statement_index: i64 = -1;
            var match_statement_count: i64 = 0;
            var statement_scan: i64 = 0;
            while (statement_scan < vec_len<StatementRecord>(statements)) {
                let statement_value: StatementRecord = vec_get<StatementRecord>(statements, statement_scan);
                if (statement_record_kind(statement_value) == 27) {
                    match_statement_index = statement_scan;
                    match_statement_count = checked_add(match_statement_count, 1);
                }
                statement_scan = checked_add(statement_scan, 1);
            }
            if (match_statement_count != 1) { identity_status = 1; }

            var subject_start: i64 = -1;
            var subject_length: i64 = 0;
            if (identity_status == 0) {
                let match_statement: StatementRecord = vec_get<StatementRecord>(statements, match_statement_index);
                var match_token_index: i64 = -1;
                var token_scan: i64 = 0;
                while (token_scan < vec_len<Token>(tokens)) {
                    let token_value: Token = vec_get<Token>(tokens, token_scan);
                    if (token_start(token_value) == statement_record_start(match_statement)) {
                        match_token_index = token_scan;
                    }
                    token_scan = checked_add(token_scan, 1);
                }
                if (match_token_index < 0) {
                    identity_status = 2;
                } else {
                    let first_index: i64 = checked_add(match_token_index, 1);
                    if (first_index >= vec_len<Token>(tokens)) {
                        identity_status = 2;
                    } else {
                        let first_token: Token = vec_get<Token>(tokens, first_index);
                        var subject_index: i64 = first_index;
                        if (token_kind(first_token) == 4) {
                            if (token_length(first_token) == 1) {
                                if (buffer_get(source, token_start(first_token)) == 40) {
                                    subject_index = checked_add(first_index, 1);
                                    let close_index: i64 = checked_add(subject_index, 1);
                                    if (close_index >= vec_len<Token>(tokens)) {
                                        identity_status = 2;
                                    } else {
                                        let close_token: Token = vec_get<Token>(tokens, close_index);
                                        if (token_kind(close_token) != 4) { identity_status = 2; }
                                        if (token_length(close_token) != 1) { identity_status = 2; }
                                        if (identity_status == 0) {
                                            if (buffer_get(source, token_start(close_token)) != 41) {
                                                identity_status = 2;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if (identity_status == 0) {
                            if (subject_index >= vec_len<Token>(tokens)) {
                                identity_status = 2;
                            } else {
                                let subject_token: Token = vec_get<Token>(tokens, subject_index);
                                if (token_kind(subject_token) != 1) {
                                    identity_status = 3;
                                } else {
                                    subject_start = token_start(subject_token);
                                    subject_length = token_length(subject_token);
                                }
                            }
                        }
                    }
                }
            }

            var type_start: i64 = -1;
            var type_length: i64 = 0;
            if (identity_status == 0) {
                var binding_statement: i64 = 0;
                while (binding_statement < match_statement_index) {
                    let binding_record: StatementRecord = vec_get<StatementRecord>(statements, binding_statement);
                    let binding_kind: i32 = statement_record_kind(binding_record);
                    if (binding_kind == 20) {
                        var name_start: i64 = -1;
                        var name_length: i64 = 0;
                        var declared_type_start: i64 = -1;
                        var declared_type_length: i64 = 0;
                        var operand_offset: i64 = 0;
                        while (operand_offset < statement_record_operand_count(binding_record)) {
                            let operand_index: i64 = checked_add(statement_record_first_operand(binding_record), operand_offset);
                            let operand_value: StatementOperand = vec_get<StatementOperand>(statement_operands, operand_index);
                            if (statement_operand_kind(operand_value) == 1) {
                                name_start = statement_operand_start(operand_value);
                                name_length = statement_operand_length(operand_value);
                            }
                            if (statement_operand_kind(operand_value) == 2) {
                                declared_type_start = statement_operand_start(operand_value);
                                declared_type_length = statement_operand_length(operand_value);
                            }
                            operand_offset = checked_add(operand_offset, 1);
                        }
                        if (name_start >= 0) {
                            if (name_length == subject_length) {
                                var same_name: i32 = 1;
                                var name_offset: i64 = 0;
                                while (name_offset < subject_length) {
                                    if (buffer_get(source, checked_add(name_start, name_offset)) != buffer_get(source, checked_add(subject_start, name_offset))) {
                                        same_name = 0;
                                    }
                                    name_offset = checked_add(name_offset, 1);
                                }
                                if (same_name != 0) {
                                    type_start = declared_type_start;
                                    type_length = declared_type_length;
                                }
                            }
                        }
                    }
                    if (binding_kind == 21) {
                        var var_name_start: i64 = -1;
                        var var_name_length: i64 = 0;
                        var var_type_start: i64 = -1;
                        var var_type_length: i64 = 0;
                        var var_operand_offset: i64 = 0;
                        while (var_operand_offset < statement_record_operand_count(binding_record)) {
                            let var_operand_index: i64 = checked_add(statement_record_first_operand(binding_record), var_operand_offset);
                            let var_operand_value: StatementOperand = vec_get<StatementOperand>(statement_operands, var_operand_index);
                            if (statement_operand_kind(var_operand_value) == 1) {
                                var_name_start = statement_operand_start(var_operand_value);
                                var_name_length = statement_operand_length(var_operand_value);
                            }
                            if (statement_operand_kind(var_operand_value) == 2) {
                                var_type_start = statement_operand_start(var_operand_value);
                                var_type_length = statement_operand_length(var_operand_value);
                            }
                            var_operand_offset = checked_add(var_operand_offset, 1);
                        }
                        if (var_name_start >= 0) {
                            if (var_name_length == subject_length) {
                                var same_var_name: i32 = 1;
                                var var_name_offset: i64 = 0;
                                while (var_name_offset < subject_length) {
                                    if (buffer_get(source, checked_add(var_name_start, var_name_offset)) != buffer_get(source, checked_add(subject_start, var_name_offset))) {
                                        same_var_name = 0;
                                    }
                                    var_name_offset = checked_add(var_name_offset, 1);
                                }
                                if (same_var_name != 0) {
                                    type_start = var_type_start;
                                    type_length = var_type_length;
                                }
                            }
                        }
                    }
                    binding_statement = checked_add(binding_statement, 1);
                }
                if (type_start < 0) { identity_status = 4; }
            }

            var declaration_tokens: Vec<Token> = lex(source, allocator);
            if (identity_status == 0) {
                var declaration_scan: i64 = 0;
                var declaration_depth: i64 = 0;
                var enum_ordinal: i64 = 0;
                var matching_enum_count: i64 = 0;
                while (declaration_scan < vec_len<Token>(declaration_tokens)) {
                    let declaration_token: Token = vec_get<Token>(declaration_tokens, declaration_scan);
                    let declaration_kind: i32 = token_kind(declaration_token);
                    let declaration_length: i64 = token_length(declaration_token);
                    var is_enum: i32 = 0;
                    if (declaration_depth == 0) {
                        if (declaration_kind == 1) {
                            if (declaration_length == 4) {
                                is_enum = 1;
                                let declaration_start: i64 = token_start(declaration_token);
                                if (buffer_get(source, declaration_start) != 101) { is_enum = 0; }
                                if (buffer_get(source, checked_add(declaration_start, 1)) != 110) { is_enum = 0; }
                                if (buffer_get(source, checked_add(declaration_start, 2)) != 117) { is_enum = 0; }
                                if (buffer_get(source, checked_add(declaration_start, 3)) != 109) { is_enum = 0; }
                            }
                        }
                    }
                    if (is_enum != 0) {
                        let enum_name_index: i64 = checked_add(declaration_scan, 1);
                        if (enum_name_index >= vec_len<Token>(declaration_tokens)) {
                            identity_status = 5;
                        } else {
                            let enum_name: Token = vec_get<Token>(declaration_tokens, enum_name_index);
                            if (token_kind(enum_name) != 1) {
                                identity_status = 5;
                            } else {
                                if (token_length(enum_name) == type_length) {
                                    var same_type: i32 = 1;
                                    var type_offset: i64 = 0;
                                    while (type_offset < type_length) {
                                        if (buffer_get(source, checked_add(token_start(enum_name), type_offset)) != buffer_get(source, checked_add(type_start, type_offset))) {
                                            same_type = 0;
                                        }
                                        type_offset = checked_add(type_offset, 1);
                                    }
                                    if (same_type != 0) {
                                        effective_match_enum_id = enum_ordinal;
                                        matching_enum_count = checked_add(matching_enum_count, 1);
                                    }
                                }
                            }
                        }
                        enum_ordinal = checked_add(enum_ordinal, 1);
                    }
                    if (declaration_kind == 4) {
                        if (declaration_length == 1) {
                            let declaration_byte: i64 = buffer_get(source, token_start(declaration_token));
                            if (declaration_byte == 123) {
                                declaration_depth = checked_add(declaration_depth, 1);
                            } else {
                                if (declaration_byte == 125) {
                                    if (declaration_depth > 0) {
                                        declaration_depth = checked_sub(declaration_depth, 1);
                                    }
                                }
                            }
                        }
                    }
                    declaration_scan = checked_add(declaration_scan, 1);
                }
                if (matching_enum_count != 1) { identity_status = 6; }
            }
            drop(declaration_tokens);
        }

        if (identity_status != 0) { return checked_add(500, identity_status); }
        let resolve_arms_status: i32 = resolve_match_arms(
            source, raw_arms, enum_catalog, effective_match_enum_id, resolved_arms
        );
        if (resolve_arms_status != 0) { return checked_add(520, resolve_arms_status); }
    }
    let resolve_scopes_status: i32 = resolve_capability_scopes(
        source, raw_scopes, capability_catalog, resolved_scopes
    );
    if (resolve_scopes_status != 0) { return checked_add(600, resolve_scopes_status); }

    let ownership_source_status: i32 = lower_resolved_source_ownership_events(
        source, tokens, statements, statement_operands, ownership_metadata,
        resolved_arms, resolved_scopes, allocator, ownership_events, capability_effects
    );
    if (ownership_source_status != 0) { return checked_add(700, ownership_source_status); }

    let ownership_status: i32 = lower_ownership_flow(
        ownership_events, ownership_metadata, allocator,
        canonical_events, ownership_records
    );
    if (ownership_status != 0) { return checked_add(800, ownership_status); }
    let ownership_validation: i32 = validate_ownership_records(
        ownership_records, ownership_metadata
    );
    if (ownership_validation != 0) { return checked_add(900, ownership_validation); }

    let return_surface: i32 = validate_resolved_function_return_surface(
        body_records, canonical_events
    );
    if (return_surface != 0) { return checked_add(1000, return_surface); }

    drop(raw_scopes);
    drop(raw_arms);
    drop(body_events);
    drop(body_statements);
    return 0;
}
